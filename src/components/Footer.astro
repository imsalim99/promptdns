---
import { TOOL_CATEGORIES, TOTAL_TOOLS } from '../data/tools';

const year = new Date().getFullYear();

const toolLinks: [string, string][] = [
  ['All Tools', '/tools/'],
  ...TOOL_CATEGORIES.flatMap((c) => c.tools.slice(0, 3).map((t) => [t.name, t.href] as [string, string])),
];

const learnLinks: [string, string][] = [
  ['How it works', '/how-it-works/'],
  ['Provider Playbooks', '/dns-providers/'],
  ['Service Setup Guides', '/email-authentication/'],
  ['Email Deliverability', '/email-deliverability/'],
  ['IP & Networking', '/ip-and-networking/'],
  ['SSL/TLS Guides', '/ssl-tls/'],
  ['AI Web Infrastructure', '/ai-web-infrastructure/'],
  ['DNS Security', '/dns-hijacking/'],
  ['DNSSEC Guide', '/what-is-dnssec/'],
  ['DNS Error Messages', '/dns-error-messages/'],
];

const companyLinks: [string, string][] = [
  ['Pricing', '/pricing/'],
  ['DMARC Monitoring', '/dmarc-monitoring/'],
  ['DNS Monitoring', '/dns-monitoring/'],
  ['Support', '/support/'],
  ['Contact', '/contact/'],
  ['About', '/about/'],
  ['Careers', '/careers/'],
  ['Press', '/press/'],
];

const legalLinks: [string, string][] = [
  ['Privacy Policy', '/privacy/'],
  ['Terms of Service', '/terms/'],
  ['Refund Policy', '/refund-policy/'],
  ['Security', '/security/'],
  ['Subprocessors', '/subprocessors/'],
  ['Methodology', '/methodology/'],
  ['Editorial Policy', '/editorial-policy/'],
  ['Changelog', '/changelog/'],
];
---
<footer class="relative overflow-hidden border-t border-line/60 bg-panel/20">
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-72" aria-hidden="true">
    <div class="aura aura-2 -left-24 -bottom-32"></div>
    <div class="aura aura-1 -right-24 -bottom-40"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 pt-16 lg:px-8">
    <div class="grid gap-10 pb-12 md:grid-cols-2 lg:grid-cols-6">
      <!-- Brand column -->
      <div class="lg:col-span-2">
        <a href="/" class="flex items-center gap-2.5 font-display text-lg font-bold tracking-tight">
          <span class="grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br from-accent to-violet font-mono text-[10px] font-bold text-canvas">DNS</span>
          Prompt<span class="gradient-text">DNS</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-ink-dim">
          Free DNS, email authentication, and domain health tools, with guides for every record
          type. {TOTAL_TOOLS} tools, no signup, lookups run in your browser.
        </p>
        <a href="/" class="btn-cta btn-shimmer mt-6 inline-flex px-4 py-2 text-xs">Scan your domain free</a>
      </div>

      <!-- Tools column -->
      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent">Free Tools</p>
        <ul class="mt-4 space-y-2 text-sm">
          {toolLinks.map(([label, href]) => (
            <li><a class="text-ink-dim transition-colors hover:text-ink" href={href}>{label}</a></li>
          ))}
          <li><a class="font-medium text-accent hover:text-accent-soft" href="/tools/">+ {TOTAL_TOOLS - toolLinks.length + 1} more tools →</a></li>
        </ul>
      </div>

      <!-- Learn column -->
      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent">Learn</p>
        <ul class="mt-4 space-y-2 text-sm">
          {learnLinks.map(([label, href]) => (
            <li><a class="text-ink-dim transition-colors hover:text-ink" href={href}>{label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Company + Legal column -->
      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent">Company</p>
        <ul class="mt-4 space-y-2 text-sm">
          {companyLinks.map(([label, href]) => (
            <li><a class="text-ink-dim transition-colors hover:text-ink" href={href}>{label}</a></li>
          ))}
        </ul>
        <p class="mt-6 font-mono text-[10px] uppercase tracking-[0.18em] text-accent">Legal</p>
        <ul class="mt-4 space-y-2 text-sm">
          {legalLinks.map(([label, href]) => (
            <li><a class="text-ink-dim transition-colors hover:text-ink" href={href}>{label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Trust column -->
      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent">Why free?</p>
        <p class="mt-4 text-sm leading-relaxed text-ink-dim">
          Every one-off check is free forever. Paid plans sell automation only: monitoring,
          alerts, and reports.
        </p>
        <a href="/pricing/" class="mt-3 inline-block font-mono text-xs text-accent hover:text-accent-soft">see pricing →</a>
        <p class="mt-6 text-xs leading-relaxed text-ink-dim">
          Lookups run client-side via public DoH resolvers. Domains you check are never sent
          to our servers.
        </p>
      </div>
    </div>

    <!-- Giant animated wordmark -->
    <div class="flex justify-center overflow-hidden pb-2" aria-hidden="true">
      <span class="footer-wordmark">PromptDNS</span>
    </div>
  </div>

  <div class="relative border-t border-line/60 py-5 text-center text-xs text-ink-dim">
    © {year} PromptDNS - free DNS, email authentication & AI readiness tools. Nothing is logged.
  </div>
</footer>
