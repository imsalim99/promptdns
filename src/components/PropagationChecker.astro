---
/**
 * DNS Propagation Checker, flagship tool (Phase 1, launch batch).
 * Vanilla TS island: queries multiple public resolvers over DoH in parallel,
 * then renders per-resolver results + agreement summary. Dark theme.
 */
import { RECORD_TYPES } from '../lib/doh';
import ResultCard from './ResultCard.astro';
const types = RECORD_TYPES;
---
<section id="propagation-checker" class="not-prose">
  <div class="glass rounded-xl p-5 shadow-lg">
    <form id="pdns-form" class="flex flex-col gap-3 sm:flex-row">
      <label class="sr-only" for="pdns-domain">Domain name</label>
      <input
        id="pdns-domain"
        name="domain"
        type="text"
        inputmode="url"
        autocomplete="off"
        spellcheck="false"
        placeholder="example.com"
        required
        class="flex-1 rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
      />
      <label class="sr-only" for="pdns-type">Record type</label>
      <select
        id="pdns-type"
        class="rounded-md border border-line bg-panel px-3 py-2.5 text-sm text-ink focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
      >
        {types.map((t) => <option value={t.value}>{t.label}</option>)}
      </select>
      <button
        type="submit"
        class="btn-cta btn-shimmer px-6 py-2.5 text-sm disabled:opacity-50"
      >
        Check
      </button>
    </form>

    <div id="pdns-status" class="mt-4 hidden rounded-md px-4 py-3 text-sm font-medium"></div>

    <div id="pdns-summary" class="mt-4 hidden grid gap-3 sm:grid-cols-3"></div>

    <div id="pdns-results" class="mt-6 hidden overflow-x-auto rounded-lg border border-line/60">
      <table class="pdns-table">
        <thead>
          <tr>
            <th>Resolver</th>
            <th>Status</th>
            <th>Time</th>
            <th>TTL</th>
            <th>Answer</th>
          </tr>
        </thead>
        <tbody id="pdns-tbody"></tbody>
      </table>
    </div>

    <p class="mt-4 text-xs text-ink-faint">
      Lookups run in your browser against public DNS-over-HTTPS resolvers (Cloudflare, Google,
      Quad9). Nothing is sent to our servers.
    </p>

    <ResultCard tool="dns-propagation-checker" />
  </div>
</section>

<script>
  import {
    propagationCheck,
    summarize,
    normalizeDomain,
    type RecordType,
  } from '../lib/doh';
  import type { PdnsResult, PdnsFinding, Severity } from '../data/findings';

  const form = document.getElementById('pdns-form') as HTMLFormElement;
  const input = document.getElementById('pdns-domain') as HTMLInputElement;
  const typeSel = document.getElementById('pdns-type') as HTMLSelectElement;
  const statusEl = document.getElementById('pdns-status')!;
  const summaryEl = document.getElementById('pdns-summary')!;
  const resultsEl = document.getElementById('pdns-results')!;
  const tbody = document.getElementById('pdns-tbody')!;
  const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;

  const TOOL = 'dns-propagation-checker';

  const emit = (verdict: Severity, verdictLine: string, findings: PdnsFinding[], domain: string) => {
    const detail: PdnsResult = {
      tool: TOOL, domain, verdict, verdictLine, findings,
      ctaLabel: 'Know when this record changes',
      related: [
        { label: 'DNS monitoring', href: '/dns-monitoring/' },
        { label: 'TTL checker', href: '/ttl-checker/' },
        { label: 'Record lookup', href: '/dns-record-lookup/' },
      ],
    };
    window.dispatchEvent(new CustomEvent('pdns:result', { detail }));
  };

  const q = new URLSearchParams(location.search).get('domain');
  if (q) input.value = q;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const domain = normalizeDomain(input.value);
    if (!domain || !domain.includes('.')) {
      statusEl.textContent = 'Please enter a valid domain name, e.g. example.com';
      statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-fail/10 text-fail border border-fail/30';
      statusEl.classList.remove('hidden');
      return;
    }
    btn.disabled = true;
    btn.textContent = 'Checking…';
    statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-panel-2 text-accent border border-line';
    statusEl.textContent = `Querying ${domain} (${typeSel.value}) across public resolvers…`;
    window.dispatchEvent(new CustomEvent('pdns:clear', { detail: { tool: TOOL } }));

    const { results, agreeRatio, propagated } = await propagationCheck(
      domain,
      typeSel.value as RecordType,
    );

    const okCount = results.filter((r) => r.ok).length;
    const agreePct = Math.round(agreeRatio * 100);

    statusEl.className = propagated
      ? 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-pass/10 text-pass border border-pass/30'
      : 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-warn/10 text-warn border border-warn/30';
    statusEl.textContent = propagated
      ? `Propagated, ${okCount}/${results.length} resolvers return the same ${typeSel.value} records.`
      : `Propagating, resolvers agree ${agreePct}% (${okCount}/${results.length} resolved). Mismatched answers mean old records are still cached somewhere.`;

    // ResultCard
    if (okCount === 0) {
      emit('warn', `No resolver returned ${typeSel.value} records for ${domain}.`,
        [{ code: 'PROP_NO_ANSWERS', detail: `0 of ${results.length} resolvers returned an answer` }], domain);
    } else if (propagated) {
      emit('pass', `Propagated: ${okCount}/${results.length} resolvers agree on ${typeSel.value}.`,
        [{ code: 'PROP_PROPAGATED', detail: `${agreePct}% agreement across ${results.length} resolvers` }], domain);
    } else {
      emit('warn', `Propagating: resolvers agree ${agreePct}%.`,
        [{ code: 'PROP_PROPAGATING', detail: `${agreePct}% agreement; resolvers still serve different answers` }], domain);
    }

    summaryEl.innerHTML = '';
    summaryEl.classList.remove('hidden');
    const cards: [string, string][] = [
      ['Resolvers queried', String(results.length)],
      ['Resolved successfully', `${okCount}/${results.length}`],
      ['Answer agreement', `${agreePct}%`],
    ];
    for (const [label, value] of cards) {
      summaryEl.insertAdjacentHTML(
        'beforeend',
        `<div class="rounded-lg border border-line bg-panel/60 p-4">
           <div class="font-display text-2xl font-bold text-accent">${value}</div>
           <div class="text-xs text-ink-faint">${label}</div>
         </div>`,
      );
    }

    tbody.innerHTML = '';
    for (const r of results) {
      const ttl = r.answers.length ? String(Math.min(...r.answers.map((a) => a.TTL))) : 'n/a';
      const statusBadge = r.ok
        ? '<span class="inline-flex rounded bg-pass/15 px-2 py-0.5 text-xs font-semibold text-pass">OK</span>'
        : `<span class="inline-flex rounded bg-fail/15 px-2 py-0.5 text-xs font-semibold text-fail">${r.statusText}</span>`;
      tbody.insertAdjacentHTML(
        'beforeend',
        `<tr>
           <td class="font-medium text-ink">${r.resolver}</td>
           <td>${statusBadge}</td>
           <td class="font-mono text-xs text-ink-dim">${r.ms} ms</td>
           <td class="font-mono text-xs text-ink-dim">${ttl}</td>
           <td><code>${summarize(r.answers)}</code></td>
         </tr>`,
      );
    }
    resultsEl.classList.remove('hidden');
    btn.disabled = false;
    btn.textContent = 'Check';
  });
</script>
