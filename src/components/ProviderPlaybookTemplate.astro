---
/**
 * Shared template for provider DNS playbook pages (manage | nameservers |
 * troubleshooting | connect | comparison). Koray document-template method.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion from './FaqAccordion.astro';

export interface ProviderPage {
  kind: 'manage' | 'nameservers' | 'troubleshooting' | 'connect' | 'comparison';
  provider?: string;      // for kind=comparison: "A vs B"
  name: string;
  title: string;
  description: string;
  intro: string;
  panel?: string;         // where DNS records live
  steps?: [string, string][];
  issues?: [string, string][];  // troubleshooting: symptom -> fix
  rows?: [string, string, string][]; // comparison rows: label, a, b
  colA?: string; colB?: string;
  quirk?: string;
  faqs?: [string, string][];
  related?: [string, string][];
}

interface Props { data: ProviderPage }
const { data } = Astro.props;
const d = data;
const faq = d.faqs?.length ? {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: d.faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
} : undefined;
const schemas = faq ? [faq] : [];
---
<BaseLayout title={d.title} description={d.description} schema={schemas}>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a> <span aria-hidden="true">/</span>
      <a href="/dns/" class="hover:text-accent">DNS Guide</a> <span aria-hidden="true">/</span>
      <a href="/dns-providers/" class="hover:text-accent">Provider Guides</a> <span aria-hidden="true">/</span>
      <span class="text-ink-dim">{d.name}</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">{d.title}</h1>
    <p class="mt-5 text-lg leading-relaxed text-ink-dim">{d.intro}</p>

    {d.quirk && (
      <div class="mt-8 rounded-xl border border-warn/30 bg-warn/10 p-5">
        <p class="text-sm leading-relaxed text-ink-dim"><strong class="text-warn">Watch out:</strong> {d.quirk}</p>
      </div>
    )}

    {d.panel && (
      <div class="rich-text mt-10">
        <h2>Where the records live</h2>
        <p>{d.panel}</p>
      </div>
    )}

    {d.steps && d.steps.length > 0 && (
      <div class="rich-text mt-10">
        <h2>{d.kind === 'nameservers' ? 'Changing nameservers, step by step' : d.kind === 'connect' ? 'Connecting your domain, step by step' : d.kind === 'comparison' ? 'The comparison' : 'Adding and managing records, step by step'}</h2>
        <ol class="mt-3 grid gap-3">
          {d.steps.map(([t, desc], i) => (
            <li class="flex gap-3">
              <span class="grid h-7 w-7 shrink-0 place-items-center rounded-lg bg-gradient-to-br from-accent to-violet font-display text-xs font-bold text-canvas">{i + 1}</span>
              <span><strong class="text-ink">{t}.</strong> <span class="text-ink-dim">{desc}</span></span>
            </li>
          ))}
        </ol>
      </div>
    )}

    {d.rows && (
      <div class="mt-10 overflow-x-auto rounded-xl border border-line bg-panel/60">
        <table class="pdns-table">
          <thead><tr><th></th><th>{d.colA}</th><th>{d.colB}</th></tr></thead>
          <tbody>
            {d.rows.map(([label, a, b]) => (
              <tr><td class="text-sm font-medium text-ink">{label}</td><td class="text-sm text-ink-dim">{a}</td><td class="text-sm text-ink-dim">{b}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    {d.issues && (
      <div class="rich-text mt-10">
        <h2>Common problems and fixes</h2>
        <div class="mt-3 grid gap-3">
          {d.issues.map(([symptom, fix]) => (
            <div class="rounded-xl border border-line bg-panel/60 p-4">
              <p class="font-semibold text-ink">{symptom}</p>
              <p class="mt-1 text-sm leading-relaxed text-ink-dim">{fix}</p>
            </div>
          ))}
        </div>
      </div>
    )}

    {d.faqs && d.faqs.length > 0 && <FaqAccordion faqs={d.faqs} heading="Frequently asked questions" />}

    <div class="mt-10 rounded-xl border border-accent/25 bg-gradient-to-br from-accent/10 to-violet/10 p-5">
      <p class="text-sm leading-relaxed text-ink-dim">
        <strong class="text-ink">Verify your work:</strong> confirm every record with the
        <a href="/dns-record-lookup/" class="font-medium text-accent hover:text-accent-soft">DNS record lookup</a>
        and check changes worldwide with the
        <a href="/dns-propagation-checker/" class="font-medium text-accent hover:text-accent-soft">propagation checker</a>.
      </p>
    </div>

    {d.related && d.related.length > 0 && (
      <div class="rich-text mt-8">
        <h2>Related</h2>
        <ul class="grid gap-2">
          {d.related.map(([label, href]) => <li><a href={href} class="text-accent hover:text-accent-soft">{label} →</a></li>)}
        </ul>
      </div>
    )}
  </div>
</BaseLayout>
