---
/**
 * SpecCard (spec section 3.8): the honest spec-sheet pattern for entity pages.
 * A <dl> with fixed fields plus a required last-verified date and evidence status.
 * data-vs="speccard" for the audit script.
 */
interface Props {
  name: string;
  operator: string;
  token: string;
  purpose: string;
  robots: string;
  verify: string;
  evidence: 'Documented' | 'Reported';
  verified: string;
  href?: string;
}
const { name, operator, token, purpose, robots, verify, evidence, verified, href } = Astro.props;
const evidenceStyle =
  evidence === 'Documented'
    ? 'bg-pass/15 text-pass border border-pass/30'
    : 'bg-warn/15 text-warn border border-warn/30';
---
<div class="rounded-xl border border-line bg-panel/60 p-5" data-vs="speccard">
  <div class="flex items-center justify-between gap-3">
    <h3 class="font-mono text-sm font-bold text-accent">{href ? <a href={href} class="hover:text-accent-soft">{name}</a> : name}</h3>
    <span class={`inline-flex rounded-full px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide ${evidenceStyle}`}>{evidence}</span>
  </div>
  <dl class="mt-3 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2">
    <div class="flex justify-between gap-3"><dt class="text-ink-faint">Operator</dt><dd class="text-ink">{operator}</dd></div>
    <div class="flex justify-between gap-3"><dt class="text-ink-faint">User-agent token</dt><dd class="font-mono text-xs text-ink">{token}</dd></div>
    <div class="flex justify-between gap-3"><dt class="text-ink-faint">Purpose</dt><dd class="text-ink">{purpose}</dd></div>
    <div class="flex justify-between gap-3"><dt class="text-ink-faint">robots.txt behaviour</dt><dd class="text-ink">{robots}</dd></div>
    <div class="flex justify-between gap-3 sm:col-span-2"><dt class="text-ink-faint">How to verify</dt><dd class="text-ink">{verify}</dd></div>
  </dl>
  <p class="mt-3 text-[11px] text-ink-faint">Last verified {verified}. {evidence === 'Documented' ? 'Behaviour documented by the operator.' : 'Behaviour reported by operators and the community; treat as advisory.'}</p>
</div>
