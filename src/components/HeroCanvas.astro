---
/**
 * HeroCanvas, "Relit DNS Terrain" (raw WebGL, no libraries).
 * Inspired by Codrops RelightingImages (mouse = virtual light over a
 * relief field) + Xylophone (pointer-driven physical interaction):
 *
 *   - Procedural topographic relief (fbm) with cyan contour lines
 *   - The cursor is a floating point light: Lambert + specular shading
 *     from normals derived from the height field
 *   - Pointer moves and clicks inject ripples that propagate through
 *     the terrain and are lit by the same light
 *   - Aurora undertone + vignette (Cerebrium-style polish)
 *
 * Reduced motion: static frame. No WebGL: falls back to CSS auras.
 */
---
<canvas id="hero-canvas" class="absolute inset-0 h-full w-full" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
  if (!canvas) throw new Error('hero canvas missing');
  const gl = canvas.getContext('webgl', { alpha: true, antialias: true, depth: false });
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!gl) {
    canvas.remove();
  } else {
    const G = gl;
    const MAX_RIPPLES = 8;

    const vs = `attribute vec2 p; void main() { gl_Position = vec4(p, 0.0, 1.0); }`;
    const fs = `
      precision highp float;
      uniform vec2 u_res;
      uniform float u_time;
      uniform vec2 u_mouse;      // smoothed, world coords
      uniform vec4 u_ripples[${MAX_RIPPLES}]; // x, y, startTime, strength

      float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1,311.7))) * 43758.5453123); }
      float noise(vec2 p){
        vec2 i=floor(p), f=fract(p); vec2 u=f*f*(3.0-2.0*f);
        return mix(mix(hash(i),hash(i+vec2(1,0)),u.x), mix(hash(i+vec2(0,1)),hash(i+vec2(1,1)),u.x), u.y);
      }
      float fbm(vec2 p){
        float v=0.0,a=0.5;
        for(int i=0;i<5;i++){ v+=a*noise(p); p=p*2.07+vec2(13.7,7.1); a*=0.5; }
        return v;
      }

      float terrain(vec2 q, float t){
        float h = fbm(q * 1.9 + vec2(t*0.012, -t*0.009) + u_mouse*0.05);
        // gentle rolling animation of the relief itself
        h += 0.22 * sin(q.x*1.4 + t*0.10) * cos(q.y*1.2 - t*0.08);
        // ripples
        for (int i = 0; i < ${MAX_RIPPLES}; i++) {
          vec4 r = u_ripples[i];
          float age = t - r.z;
          if (r.w <= 0.0 || age < 0.0 || age > 3.5) continue;
          float d = length(q - r.xy);
          float wavefront = d - age * 0.55;
          h += r.w * sin(wavefront * 26.0)
               * exp(-wavefront * wavefront * 6.0)
               * exp(-age * 1.6)
               * exp(-d * 1.2);
        }
        return h;
      }

      void main(){
        vec2 uv = gl_FragCoord.xy / u_res.xy;
        float aspect = u_res.x / u_res.y;
        vec2 q = (uv - 0.5) * vec2(aspect, 1.0);
        float t = u_time;

        // height field + normals via finite differences
        float e = 0.012;
        float h  = terrain(q, t);
        float hx = terrain(q + vec2(e, 0.0), t);
        float hy = terrain(q + vec2(0.0, e), t);
        vec3 n = normalize(vec3(-(hx - h) / e * 0.22, -(hy - h) / e * 0.22, 1.0));

        // virtual light follows the cursor
        vec3 lightPos = vec3(u_mouse * vec2(aspect, 1.0), 0.42);
        vec3 fragPos = vec3(q, 0.0);
        vec3 l = normalize(lightPos - fragPos);
        vec3 viewDir = vec3(0.0, 0.0, 1.0);

        float diff = max(dot(n, l), 0.0);
        float dist = length(lightPos - fragPos);
        float atten = 1.0 / (1.0 + dist * dist * 2.2);
        vec3 refl = reflect(-l, n);
        float spec = pow(max(dot(refl, viewDir), 0.0), 42.0);

        // albedo: deep panel tones + cyan contour lines (the "DNS map")
        vec3 deep    = vec3(0.016, 0.026, 0.052);
        vec3 panel   = vec3(0.043, 0.070, 0.129);
        vec3 albedo  = mix(deep, panel, smoothstep(0.2, 0.8, h));
        float contour = smoothstep(0.035, 0.0, abs(fract(h * 9.0 + 0.5) - 0.5) / 9.0 * 9.0 * 0.5);
        contour = pow(contour, 1.4);
        vec3 lineCol = vec3(0.13, 0.83, 0.93);

        // ambient aurora undertone (Cerebrium-style calm)
        float amb = 0.16;
        vec3 col = albedo * (amb + diff * 1.35 * atten);
        col += lineCol * contour * (0.10 + diff * 1.1 * atten);
        col += vec3(0.42, 0.30, 0.95) * spec * 0.45 * atten;

        // soft aurora glow at the light position
        col += lineCol * exp(-2.6 * dist) * 0.06;

        // vignette
        col *= mix(0.60, 1.0, smoothstep(1.45, 0.30, length(q)));
        gl_FragColor = vec4(col, 1.0);
      }
    `;

    function compile(type: number, src: string) {
      const s = G.createShader(type)!;
      G.shaderSource(s, src);
      G.compileShader(s);
      if (!G.getShaderParameter(s, G.COMPILE_STATUS)) throw new Error(G.getShaderInfoLog(s) ?? 'shader error');
      return s;
    }
    const prog = G.createProgram()!;
    G.attachShader(prog, compile(G.VERTEX_SHADER, vs));
    G.attachShader(prog, compile(G.FRAGMENT_SHADER, fs));
    G.linkProgram(prog);
    G.useProgram(prog);

    const buf = G.createBuffer();
    G.bindBuffer(G.ARRAY_BUFFER, buf);
    G.bufferData(G.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), G.STATIC_DRAW);
    const loc = G.getAttribLocation(prog, 'p');
    G.enableVertexAttribArray(loc);
    G.vertexAttribPointer(loc, 2, G.FLOAT, false, 0, 0);

    const uRes = G.getUniformLocation(prog, 'u_res')!;
    const uTime = G.getUniformLocation(prog, 'u_time')!;
    const uMouse = G.getUniformLocation(prog, 'u_mouse')!;
    const uRipples = G.getUniformLocation(prog, 'u_ripples')!;

    function resize() {
      const dpr = Math.min(devicePixelRatio || 1, 1.5);
      canvas!.width = Math.round(canvas!.clientWidth * dpr);
      canvas!.height = Math.round(canvas!.clientHeight * dpr);
      G.viewport(0, 0, canvas!.width, canvas!.height);
    }
    resize();
    addEventListener('resize', resize);

    // Pointer state (world coords, smoothed)
    let mx = 0, my = 0, smx = 0, smy = 0;
    const rippleData = new Float32Array(MAX_RIPPLES * 4); // x,y,start,strength
    let rippleSlot = 0;
    let lastRipple = 0;
    const t0 = performance.now();
    const now = () => (performance.now() - t0) / 1000;

    function toWorld(clientX: number, clientY: number): [number, number] {
      const rect = canvas!.getBoundingClientRect();
      const x = ((clientX - rect.left) / rect.width) * 2 - 1;
      const y = -(((clientY - rect.top) / rect.height) * 2 - 1);
      return [x, y];
    }
    function addRipple(x: number, y: number, strength: number) {
      const i = rippleSlot;
      rippleData[i * 4] = x; rippleData[i * 4 + 1] = y;
      rippleData[i * 4 + 2] = now(); rippleData[i * 4 + 3] = strength;
      rippleSlot = (rippleSlot + 1) % MAX_RIPPLES;
    }

    const hero = canvas.closest('section') ?? canvas.parentElement!;
    hero.addEventListener('pointermove', (e) => {
      [mx, my] = toWorld(e.clientX, e.clientY);
      // traveling ripples while the cursor sweeps the terrain
      if (!reduced && now() - lastRipple > 0.14) {
        lastRipple = now();
        addRipple(mx * 0.98, my * 0.98, 0.05);
      }
    }, { passive: true });
    hero.addEventListener('pointerdown', (e) => {
      const [x, y] = toWorld(e.clientX, e.clientY);
      addRipple(x, y, 0.16); // xylophone-style strike
    }, { passive: true });
    // idle entry ripple so first paint shows the effect
    addRipple(0.1, 0.15, 0.12);

    let running = true;
    document.addEventListener('visibilitychange', () => { running = !document.hidden; if (running) frame(); });

    function frame() {
      if (!running) return;
      smx += (mx - smx) * 0.06;
      smy += (my - smy) * 0.06;
      G.uniform2f(uRes, canvas!.width, canvas!.height);
      G.uniform1f(uTime, now());
      G.uniform2f(uMouse, smx, smy);
      G.uniform4fv(uRipples, rippleData);
      G.drawArrays(G.TRIANGLES, 0, 3);
      if (!reduced) requestAnimationFrame(frame);
    }
    frame();
  }
</script>
