---
/** Deep editorial article layer for tool pages (process, interpretation,
 *  CLI method, errors, audience, FAQs) — the Koray semantic-node content. */
import FaqAccordion from './FaqAccordion.astro';
import { TOOL_CONTENT } from '../data/tool-content';

interface Props { slug: string }
const { slug } = Astro.props;
const c = TOOL_CONTENT[slug];
---
{c && (
  <div class="mx-auto max-w-3xl px-4">
    <article class="rich-text mt-14">
      <h2>How this tool works</h2>
    {c.process.map((p) => <p class="mt-3">{p}</p>)}

    <h2>How to read the results</h2>
    <ul class="list-disc space-y-1.5 pl-5">
      {c.interpret.map((p) => <li class="leading-relaxed">{p}</li>)}
    </ul>

    <h2>The command-line equivalent</h2>
    <p>Prefer a terminal? This is exactly what the tool does, using dig:</p>
    <pre class="overflow-x-auto rounded-lg border border-line bg-panel-2 p-4 font-mono text-xs leading-relaxed text-accent-soft">{c.cli}</pre>

    <h2>Common errors and what they mean</h2>
    <div class="grid gap-3">
      {c.errors.map(([symptom, fix]) => (
        <div class="rounded-xl border border-line bg-panel/60 p-4">
          <p class="font-semibold text-ink">{symptom}</p>
          <p class="mt-1 text-sm leading-relaxed text-ink-dim">{fix}</p>
        </div>
      ))}
    </div>

    <h2>Who needs this</h2>
    <p>{c.who}</p>

    <FaqAccordion faqs={c.faqs} heading="Frequently asked questions" />
    </article>
  </div>
)}
