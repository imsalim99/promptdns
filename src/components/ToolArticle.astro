---
/** Deep editorial article layer for tool pages (process, interpretation,
 *  CLI method, errors, audience, FAQs) - the Koray semantic-node content. */
import FaqAccordion from './FaqAccordion.astro';
import { TOOL_CONTENT } from '../data/tool-content';

interface Props { slug: string }
const { slug } = Astro.props;
const c = TOOL_CONTENT[slug];

const DEFAULT_RELATED: [string, string][] = [
  ['All tools', '/tools/'],
  ['DNS: the complete guide', '/dns/'],
  ['Email authentication guides', '/email-authentication/'],
];
const PER_TOOL: Record<string, [string, string][]> = {
  'ttl-checker': [['TTL explained', '/what-is-ttl-in-dns/'], ['DNS propagation', '/dns-propagation/']],
  'dns-speed-test': [['DoH vs DoT', '/doh-vs-dot/'], ['Resolver tester', '/dns-resolver-tester/']],
  'dns-resolver-tester': [['DNS speed test', '/dns-speed-test/'], ['DoH vs DoT', '/doh-vs-dot/']],
  'dns-response-time-test': [['DNS speed test', '/dns-speed-test/'], ['Record lookup', '/dns-record-lookup/']],
  'delegation-checker': [['NS records', '/ns-record/'], ['Glue record checker', '/glue-record-checker/']],
  'glue-record-checker': [['Glue records explained', '/ns-record/'], ['Delegation checker', '/delegation-checker/']],
  'wildcard-dns-tester': [['Record types hub', '/dns-records/'], ['Record lookup', '/dns-record-lookup/']],
  'axfr-checker': [['What is DNSSEC', '/what-is-dnssec/'], ['DNSSEC checker', '/dnssec-checker/']],
  'dnssec-checker': [['What is DNSSEC', '/what-is-dnssec/'], ['DS records', '/ds-record/']],
  'smtp-tester': [['MX records', '/mx-record/'], ['Blacklist checker', '/blacklist-checker/']],
  'ip-reputation-checker': [['Blacklist checker', '/blacklist-checker/'], ['Why emails go to spam', '/why-emails-go-to-spam/']],
  'autodiscover-checker': [['MX records', '/mx-record/'], ['Email authentication hub', '/email-authentication/']],
  'schema-validator': [['AI readiness checker', '/ai-readiness-checker/'], ['AI readiness guide', '/ai-readiness-guide/']],
  'ai-log-analyzer': [['AI crawlers list', '/ai-crawlers-list/'], ['AI crawler checker', '/ai-crawler-checker/']],
  'agents-txt-checker': [['What is llms.txt', '/what-is-llms-txt/'], ['llms.txt generator', '/llms-txt-generator/']],
  'reverse-ip-lookup': [['PTR records', '/ptr-record/'], ['IP lookup', '/ip-lookup/']],
  'nameserver-lookup': [['NS records', '/ns-record/'], ['Delegation checker', '/delegation-checker/']],
  'domain-age-checker': [['WHOIS lookup', '/whois-lookup/'], ['Provider guides', '/dns-providers/']],
  'whois-lookup': [['What is RDAP', '/domain-age-checker/'], ['Domain age checker', '/domain-age-checker/']],
  'my-ip': [['IP lookup', '/ip-lookup/'], ['PTR records', '/ptr-record/']],
  'ip-lookup': [['What Is My IP', '/my-ip/'], ['PTR records', '/ptr-record/']],
};
const related = PER_TOOL[slug] ?? DEFAULT_RELATED;
---
{c && (
    <article class="rich-text mt-12 max-w-none">
      <h2>How it works</h2>
    {c.process.map((p) => <p class="mt-3">{p}</p>)}

    <h2>Reading the results</h2>
    <ul class="list-disc space-y-1.5 pl-5">
      {c.interpret.map((p) => <li class="leading-relaxed">{p}</li>)}
    </ul>

    <aside class="mt-8 rounded-xl border-l-3 border-l-violet/50 bg-violet/5 p-5" aria-label="Practitioner field notes">
      <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-violet mb-2">Field notes</p>
      {c.interpret.slice(0, 1).map((p) => <p class="text-sm leading-relaxed text-ink-dim italic">{p}</p>)}
    </aside>

    <h2>Common errors</h2>
    <div class="grid gap-3">
      {c.errors.map(([symptom, fix]) => (
        <div class="rounded-xl border border-line bg-panel/60 p-4">
          <p class="font-semibold text-ink">{symptom}</p>
          <p class="mt-1 text-sm leading-relaxed text-ink-dim">{fix}</p>
        </div>
      ))}
    </div>

    <FaqAccordion faqs={c.faqs.slice(0, 4)} heading="FAQs" />

    <h2>Related</h2>
    <ul>
      {related.map(([label, href]) => <li><a href={href} class="text-accent hover:text-accent-soft">{label}</a></li>)}
    </ul>
    </article>
  </div>
)}
