---
/** Table of contents with jump links — for pages over 1,200 words. */
interface Props { items: [string, string][] }
const { items } = Astro.props;
---
<nav class="mt-8 rounded-xl border border-line bg-panel/60 p-5" aria-label="Table of contents">
  <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent mb-3">On this page</p>
  <ol class="space-y-1.5 text-sm">
    {items.map(([label], i) => (
      <li>
        <a href={'#sec-' + i} class="text-ink-dim transition-colors hover:text-accent">{i + 1}. {label}</a>
      </li>
    ))}
  </ol>
</nav>
