          <text x="190" y="74" text-anchor="middle" fill="#fbbf24" font-size="9">wildcard</text>
          <line x1="170" y1="120" x2="210" y2="142" stroke="#4ade80" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <text x="190" y="152" text-anchor="middle" fill="#4ade80" font-size="9">exact miss</text>
          <rect x="210" y="60" width="140" height="36" rx="8" fill="#0b1222" stroke="#fbbf2455"/>
          <text x="280" y="82" text-anchor="middle" fill="#fbbf24" font-size="11">*.example.com</text>
          <rect x="210" y="112" width="140" height="36" rx="8" fill="#0b1222" stroke="#1c2a47"/>
          <text x="280" y="134" text-anchor="middle" fill="#9dabc4" font-size="11">NXDOMAIN</text>
          <line x1="350" y1="78" x2="395" y2="90" stroke="#fbbf24" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <line x1="350" y1="130" x2="395" y2="118" stroke="#4ade80" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <rect x="400" y="66" width="120" height="24" rx="6" fill="#fbbf2422" stroke="#fbbf2455"/>
          <text x="460" y="82" text-anchor="middle" fill="#fbbf24" font-size="10" font-weight="600">RETURNS IP</text>
          <rect x="400" y="110" width="120" height="24" rx="6" fill="#4ade8022" stroke="#4ade8055"/>
          <text x="460" y="126" text-anchor="middle" fill="#4ade80" font-size="10" font-weight="600">NXDOMAIN</text>
          <text x="360" y="175" text-anchor="middle" fill="#9dabc4" font-size="10">wildcards match every unlisted subdomain: useful for multi-tenant apps, dangerous when accidental</text>
        </g>
      )}

      {name === 'ttl-lifecycle' && (
        <g font-family="ui-monospace,monospace" font-size="12">
          <rect x="10" y="20" width="150" height="44" rx="10" fill="#0b1222" stroke="#22d3ee"/>
          <text x="85" y="38" text-anchor="middle" fill="#f1f5f9" font-size="12" font-weight="600">Record Published</text>
          <text x="85" y="54" text-anchor="middle" fill="#9dabc4" font-size="9">TTL = 3600s</text>
          <line x1="85" y1="64" x2="85" y2="90" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <rect x="10" y="90" width="150" height="44" rx="10" fill="#0b1222" stroke="#8b5cf6"/>
          <text x="85" y="108" text-anchor="middle" fill="#f1f5f9" font-size="12" font-weight="600">Resolver Caches</text>
          <text x="85" y="124" text-anchor="middle" fill="#9dabc4" font-size="9">for 1 hour</text>
          <line x1="85" y1="134" x2="85" y2="158" stroke="#fbbf24" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <text x="110" y="150" fill="#fbbf24" font-size="9">you edit record</text>
          <rect x="10" y="158" width="150" height="44" rx="10" fill="#0b1222" stroke="#fbbf2455"/>
          <text x="85" y="176" text-anchor="middle" fill="#fbbf24" font-size="12" font-weight="600">You Edit Record</text>
          <text x="85" y="192" text-anchor="middle" fill="#9dabc4" font-size="9">new value + TTL</text>
          <line x1="160" y1="42" x2="220" y2="42" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <rect x="220" y="20" width="160" height="44" rx="10" fill="#0b1222" stroke="#fbbf2455"/>
          <text x="300" y="38" text-anchor="middle" fill="#fbbf24" font-size="12" font-weight="600">Old Answer Served</text>
          <text x="300" y="54" text-anchor="middle" fill="#9dabc4" font-size="9">until cache expires</text>
          <line x1="300" y1="64" x2="300" y2="90" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <text x="330" y="80" fill="#9dabc4" font-size="9">TTL expires</text>
          <rect x="220" y="90" width="160" height="44" rx="10" fill="#0b1222" stroke="#4ade8055"/>
          <text x="300" y="108" text-anchor="middle" fill="#4ade80" font-size="12" font-weight="600">New Answer Served</text>
          <text x="300" y="124" text-anchor="middle" fill="#9dabc4" font-size="9">propagation complete</text>
          <line x1="300" y1="134" x2="300" y2="160" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <text x="330" y="150" fill="#9dabc4" font-size="9">raise TTL</text>
          <rect x="220" y="160" width="160" height="44" rx="10" fill="#0b1222" stroke="#4ade8055"/>
          <text x="300" y="178" text-anchor="middle" fill="#4ade80" font-size="12" font-weight="600">Back to Normal</text>
          <text x="300" y="194" text-anchor="middle" fill="#9dabc4" font-size="9">TTL 3600</text>
          <text x="360" y="220" text-anchor="middle" fill="#9dabc4" font-size="10">the old TTL governs the window: lower it BEFORE the change, not after</text>
        </g>
      )}

      {name === 'autodiscover' && (
        <g font-family="ui-monospace,monospace" font-size="12">
          <rect x="10" y="78" width="130" height="44" rx="10" fill="#0b1222" stroke="#22d3ee"/>
