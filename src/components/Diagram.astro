---
/** PromptDNS SVG Diagram Library - direct Astro templating, no string helpers.
 *  Usage: <Diagram name="resolution" caption="..." />
 */
interface Props { name: string; caption: string }
const { name, caption } = Astro.props;
---
<figure class="my-8 not-prose">
  <div class="overflow-x-auto rounded-xl border border-line bg-panel/60 p-4">
    <svg viewBox="0 0 720 210" class="min-w-[560px]" role="img" aria-label={caption}>
      <defs>
        <marker id="pdns-arr" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
          <path d="M0,0 L6,3 L0,6" fill="none" stroke="#22d3ee"/>
        </marker>
      </defs>

      {name === 'resolution' && (
        <g font-family="ui-monospace,monospace" font-size="12">
          <rect x="10" y="78" width="100" height="44" rx="10" fill="#0b1222" stroke="#1c2a47"/>
          <text x="60" y="100" text-anchor="middle" fill="#f1f5f9" font-size="13" font-weight="600">Browser</text>
          <rect x="160" y="78" width="110" height="44" rx="10" fill="#0b1222" stroke="#1c2a47"/>
          <text x="215" y="100" text-anchor="middle" fill="#f1f5f9" font-size="13" font-weight="600">Resolver</text>
          <rect x="320" y="78" width="100" height="44" rx="10" fill="#0b1222" stroke="#1c2a47"/>
          <text x="370" y="100" text-anchor="middle" fill="#f1f5f9" font-size="13" font-weight="600">Root+TLD</text>
          <rect x="470" y="78" width="120" height="44" rx="10" fill="#0b1222" stroke="#1c2a47"/>
          <text x="530" y="100" text-anchor="middle" fill="#f1f5f9" font-size="13" font-weight="600">Authoritative</text>
          <rect x="630" y="78" width="80" height="44" rx="10" fill="#0b1222" stroke="#1c2a47"/>
          <text x="670" y="100" text-anchor="middle" fill="#f1f5f9" font-size="13" font-weight="600">Website</text>
          <line x1="110" y1="95" x2="155" y2="95" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <text x="132" y="88" text-anchor="middle" fill="#9dabc4" font-size="9">query</text>
          <line x1="270" y1="95" x2="315" y2="95" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <line x1="420" y1="95" x2="465" y2="95" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <line x1="590" y1="95" x2="625" y2="95" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <line x1="625" y1="115" x2="590" y2="115" stroke="#8b5cf6" stroke-width="1.5" stroke-dasharray="4 3"/>
          <line x1="465" y1="115" x2="420" y2="115" stroke="#8b5cf6" stroke-width="1.5" stroke-dasharray="4 3"/>
          <line x1="315" y1="115" x2="270" y2="115" stroke="#8b5cf6" stroke-width="1.5" stroke-dasharray="4 3"/>
          <line x1="155" y1="115" x2="110" y2="115" stroke="#8b5cf6" stroke-width="1.5" stroke-dasharray="4 3"/>
          <text x="360" y="155" text-anchor="middle" fill="#9dabc4" font-size="10">solid = query · dashed = cached response · every hop caches until TTL</text>
        </g>
      )}

      {name === 'authtrio' && (
        <g font-family="ui-monospace,monospace" font-size="12">
          <rect x="10" y="16" width="150" height="40" rx="10" fill="#0b1222" stroke="#22d3ee"/>
          <text x="85" y="34" text-anchor="middle" fill="#f1f5f9" font-size="14" font-weight="600">SPF</text>
          <text x="85" y="50" text-anchor="middle" fill="#9dabc4" font-size="9">which servers may send</text>
          <rect x="10" y="80" width="150" height="40" rx="10" fill="#0b1222" stroke="#22d3ee"/>
          <text x="85" y="98" text-anchor="middle" fill="#f1f5f9" font-size="14" font-weight="600">DKIM</text>
          <text x="85" y="114" text-anchor="middle" fill="#9dabc4" font-size="9">proves mail is intact</text>
          <rect x="10" y="144" width="150" height="40" rx="10" fill="#0b1222" stroke="#22d3ee"/>
          <text x="85" y="162" text-anchor="middle" fill="#f1f5f9" font-size="14" font-weight="600">DMARC</text>
          <text x="85" y="178" text-anchor="middle" fill="#9dabc4" font-size="9">policy + reports</text>
          <line x1="160" y1="36" x2="280" y2="92" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <line x1="160" y1="100" x2="280" y2="100" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <line x1="160" y1="164" x2="280" y2="108" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <rect x="280" y="78" width="160" height="48" rx="10" fill="#0b1222" stroke="#8b5cf6"/>
          <text x="360" y="98" text-anchor="middle" fill="#f1f5f9" font-size="14" font-weight="600">Receiver</text>
          <text x="360" y="116" text-anchor="middle" fill="#9dabc4" font-size="9">checks all three</text>
          <line x1="440" y1="90" x2="510" y2="90" stroke="#4ade80" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <text x="475" y="82" text-anchor="middle" fill="#4ade80" font-size="10">pass</text>
          <rect x="510" y="76" width="100" height="28" rx="6" fill="#4ade8022" stroke="#4ade8055"/>
          <text x="560" y="94" text-anchor="middle" fill="#4ade80" font-size="11" font-weight="600">INBOX</text>
          <line x1="440" y1="110" x2="510" y2="140" stroke="#f87171" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <text x="475" y="134" text-anchor="middle" fill="#f87171" font-size="10">fail</text>
          <rect x="510" y="130" width="140" height="28" rx="6" fill="#f8717122" stroke="#f8717155"/>
          <text x="580" y="148" text-anchor="middle" fill="#f87171" font-size="11" font-weight="600">SPAM / REJECT</text>
          <text x="360" y="200" text-anchor="middle" fill="#9dabc4" font-size="10">DMARC requires at least one pass (SPF or DKIM) with domain alignment</text>
        </g>
      )}

      {name === 'propagation' && (
        <g font-family="ui-monospace,monospace" font-size="11">
          <line x1="30" y1="90" x2="690" y2="90" stroke="#1c2a47" stroke-width="2"/>
          <circle cx="40" cy="90" r="6" fill="#22d3ee"/>
          <text x="40" y="72" text-anchor="middle" fill="#f1f5f9" font-size="10">T=0</text>
          <circle cx="160" cy="90" r="6" fill="#22d3ee"/>
          <text x="160" y="72" text-anchor="middle" fill="#f1f5f9" font-size="10">T+5min</text>
          <circle cx="320" cy="90" r="6" fill="#22d3ee"/>
          <text x="320" y="72" text-anchor="middle" fill="#f1f5f9" font-size="10">T+1hr</text>
          <circle cx="490" cy="90" r="6" fill="#22d3ee"/>
          <text x="490" y="72" text-anchor="middle" fill="#f1f5f9" font-size="10">T+24hr</text>
          <circle cx="640" cy="90" r="8" fill="#4ade80"/>
          <text x="640" y="72" text-anchor="middle" fill="#4ade80" font-size="10">done</text>
          <rect x="180" y="104" width="300" height="28" rx="6" fill="#101a30" stroke="#1c2a47"/>
          <text x="330" y="122" text-anchor="middle" fill="#fbbf24" font-size="10">old answers still served from resolver caches</text>
          <text x="360" y="160" text-anchor="middle" fill="#9dabc4" font-size="10">lower TTL to 300s a day before planned changes</text>
        </g>
      )}

      {name === 'dnssec-chain' && (
        <g font-family="ui-monospace,monospace" font-size="12">
          <rect x="10" y="20" width="140" height="40" rx="10" fill="#0b1222" stroke="#8b5cf6"/>
          <text x="80" y="38" text-anchor="middle" fill="#f1f5f9" font-size="13" font-weight="600">Root Zone</text>
          <text x="80" y="54" text-anchor="middle" fill="#9dabc4" font-size="9">trust anchor</text>
          <rect x="10" y="100" width="140" height="40" rx="10" fill="#0b1222" stroke="#8b5cf6"/>
          <text x="80" y="118" text-anchor="middle" fill="#f1f5f9" font-size="13" font-weight="600">.com Registry</text>
          <text x="80" y="134" text-anchor="middle" fill="#9dabc4" font-size="9">TLD</text>
          <rect x="10" y="180" width="140" height="40" rx="10" fill="#0b1222" stroke="#8b5cf6"/>
          <text x="80" y="198" text-anchor="middle" fill="#f1f5f9" font-size="13" font-weight="600">Your Domain</text>
          <text x="80" y="214" text-anchor="middle" fill="#9dabc4" font-size="9">example.com</text>
          <line x1="80" y1="60" x2="80" y2="95" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <text x="110" y="80" fill="#22d3ee" font-size="10">DS</text>
          <line x1="80" y1="140" x2="80" y2="175" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <text x="110" y="160" fill="#22d3ee" font-size="10">DS</text>
          <rect x="280" y="20" width="160" height="40" rx="10" fill="#0b1222" stroke="#22d3ee"/>
          <text x="360" y="38" text-anchor="middle" fill="#f1f5f9" font-size="13" font-weight="600">Validating Resolver</text>
          <text x="360" y="54" text-anchor="middle" fill="#9dabc4" font-size="9">checks every link</text>
          <line x1="270" y1="40" x2="275" y2="40" stroke="#22d3ee" stroke-width="1.5"/>
          <rect x="280" y="100" width="200" height="44" rx="10" fill="#0b1222" stroke="#22d3ee"/>
          <text x="380" y="118" text-anchor="middle" fill="#f1f5f9" font-size="13" font-weight="600">DNSKEY</text>
          <text x="380" y="136" text-anchor="middle" fill="#9dabc4" font-size="9">KSK + ZSK</text>
          <line x1="380" y1="144" x2="380" y2="175" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <text x="410" y="162" fill="#22d3ee" font-size="10">signs</text>
          <rect x="380" y="180" width="220" height="40" rx="10" fill="#0b1222" stroke="#1c2a47"/>
          <text x="490" y="198" text-anchor="middle" fill="#9dabc4" font-size="12">Your Records (signed with ZSK)</text>
          <text x="360" y="260" text-anchor="middle" fill="#f87171" font-size="10">every link must verify: one break = SERVFAIL for the entire domain</text>
        </g>
      )}

      {name === 'dmarc-tree' && (
        <g font-family="ui-monospace,monospace" font-size="12">
          <rect x="10" y="90" width="160" height="44" rx="10" fill="#0b1222" stroke="#22d3ee"/>
          <text x="90" y="112" text-anchor="middle" fill="#f1f5f9" font-size="13" font-weight="600">Message arrives</text>
          <text x="90" y="128" text-anchor="middle" fill="#9dabc4" font-size="9">From: your domain</text>
          <line x1="170" y1="100" x2="210" y2="82" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <line x1="170" y1="124" x2="210" y2="142" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <rect x="210" y="60" width="120" height="36" rx="8" fill="#0b1222" stroke="#1c2a47"/>
          <text x="270" y="82" text-anchor="middle" fill="#f1f5f9" font-size="11">SPF pass?</text>
          <rect x="210" y="120" width="120" height="36" rx="8" fill="#0b1222" stroke="#1c2a47"/>
          <text x="270" y="142" text-anchor="middle" fill="#f1f5f9" font-size="11">DKIM pass?</text>
          <line x1="330" y1="78" x2="370" y2="95" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <line x1="330" y1="138" x2="370" y2="110" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <rect x="370" y="90" width="140" height="36" rx="8" fill="#0b1222" stroke="#8b5cf6"/>
          <text x="440" y="112" text-anchor="middle" fill="#f1f5f9" font-size="11">Aligned? domain match</text>
          <line x1="510" y1="98" x2="540" y2="98" stroke="#4ade80" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <text x="525" y="90" text-anchor="middle" fill="#4ade80" font-size="10">yes</text>
          <rect x="540" y="84" width="100" height="28" rx="6" fill="#4ade8022" stroke="#4ade8055"/>
          <text x="590" y="102" text-anchor="middle" fill="#4ade80" font-size="11" font-weight="600">ACCEPT</text>
          <line x1="510" y1="125" x2="540" y2="155" stroke="#f87171" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <text x="525" y="147" text-anchor="middle" fill="#f87171" font-size="10">no</text>
          <rect x="540" y="146" width="120" height="28" rx="6" fill="#f8717122" stroke="#f8717155"/>
          <text x="600" y="164" text-anchor="middle" fill="#f87171" font-size="11" font-weight="600">p= POLICY</text>
          <text x="360" y="230" text-anchor="middle" fill="#9dabc4" font-size="10">p=none delivers anyway · p=quarantine to spam · p=reject drops the message</text>
        </g>
      )}

      {name === 'spf-eval' && (
        <g font-family="ui-monospace,monospace" font-size="11">
          <rect x="10" y="78" width="140" height="44" rx="10" fill="#0b1222" stroke="#22d3ee"/>
          <text x="80" y="100" text-anchor="middle" fill="#f1f5f9" font-size="12" font-weight="600">Incoming mail</text>
          <text x="80" y="116" text-anchor="middle" fill="#9dabc4" font-size="9">connects from an IP</text>
          <line x1="150" y1="100" x2="180" y2="100" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <rect x="180" y="78" width="200" height="44" rx="10" fill="#0b1222" stroke="#8b5cf6"/>
          <text x="280" y="100" text-anchor="middle" fill="#f1f5f9" font-size="12" font-weight="600">Read SPF: v=spf1 ...</text>
          <text x="280" y="116" text-anchor="middle" fill="#9dabc4" font-size="9">first match wins</text>
          <line x1="380" y1="90" x2="420" y2="52" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <text x="400" y="60" text-anchor="middle" fill="#9dabc4" font-size="9">match</text>
          <line x1="380" y1="100" x2="420" y2="100" stroke="#fbbf24" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <text x="400" y="92" text-anchor="middle" fill="#9dabc4" font-size="9">no match</text>
          <line x1="380" y1="112" x2="420" y2="148" stroke="#f87171" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <text x="400" y="138" text-anchor="middle" fill="#f87171" font-size="9">&gt;10 lookups</text>
          <rect x="420" y="30" width="110" height="32" rx="8" fill="#4ade8022" stroke="#4ade8055"/>
          <text x="475" y="50" text-anchor="middle" fill="#4ade80" font-size="11" font-weight="600">MATCH</text>
          <rect x="420" y="84" width="110" height="32" rx="8" fill="#fbbf2422" stroke="#fbbf2455"/>
          <text x="475" y="104" text-anchor="middle" fill="#fbbf24" font-size="11" font-weight="600">NO MATCH</text>
          <rect x="420" y="138" width="110" height="32" rx="8" fill="#f8717122" stroke="#f8717155"/>
          <text x="475" y="158" text-anchor="middle" fill="#f87171" font-size="11" font-weight="600">PERMERROR</text>
          <text x="580" y="45" text-anchor="middle" fill="#4ade80" font-size="10">pass</text>
          <text x="580" y="105" text-anchor="middle" fill="#fbbf24" font-size="10">softfail</text>
          <text x="580" y="160" text-anchor="middle" fill="#f87171" font-size="10">broken</text>
        </g>
      )}

      {name === 'delegation' && (
        <g font-family="ui-monospace,monospace" font-size="12">
          <rect x="10" y="78" width="120" height="44" rx="10" fill="#0b1222" stroke="#22d3ee"/>
          <text x="70" y="100" text-anchor="middle" fill="#f1f5f9" font-size="12" font-weight="600">Visitor</text>
          <line x1="130" y1="100" x2="175" y2="100" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <rect x="175" y="78" width="130" height="44" rx="10" fill="#0b1222" stroke="#8b5cf6"/>
          <text x="240" y="100" text-anchor="middle" fill="#f1f5f9" font-size="12" font-weight="600">Resolver</text>
          <line x1="305" y1="100" x2="345" y2="100" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <text x="325" y="92" text-anchor="middle" fill="#9dabc4" font-size="9">NS query</text>
          <rect x="345" y="78" width="140" height="44" rx="10" fill="#0b1222" stroke="#8b5cf6"/>
          <text x="415" y="100" text-anchor="middle" fill="#f1f5f9" font-size="12" font-weight="600">Registry/Parent</text>
          <line x1="485" y1="100" x2="525" y2="100" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <text x="505" y="92" text-anchor="middle" fill="#9dabc4" font-size="9">referral</text>
          <rect x="525" y="78" width="160" height="44" rx="10" fill="#0b1222" stroke="#1c2a47"/>
          <text x="605" y="100" text-anchor="middle" fill="#f1f5f9" font-size="12" font-weight="600">Your Nameservers</text>
          <line x1="605" y1="122" x2="605" y2="155" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <text x="630" y="142" fill="#22d3ee" font-size="10">A record</text>
          <rect x="560" y="160" width="120" height="24" rx="6" fill="#4ade8022" stroke="#4ade8055"/>
          <text x="620" y="176" text-anchor="middle" fill="#4ade80" font-size="10" font-weight="600">IP ADDRESS</text>
          <text x="360" y="200" text-anchor="middle" fill="#9dabc4" font-size="10">the referral chain must be unbroken: one dead nameserver = intermittent failures</text>
        </g>
      )}

      {name === 'dkim-signing' && (
        <g font-family="ui-monospace,monospace" font-size="12">
          <rect x="10" y="20" width="140" height="40" rx="10" fill="#0b1222" stroke="#22d3ee"/>
          <text x="80" y="38" text-anchor="middle" fill="#f1f5f9" font-size="12" font-weight="600">Your Server</text>
          <text x="80" y="54" text-anchor="middle" fill="#9dabc4" font-size="9">holds private key</text>
          <line x1="80" y1="60" x2="80" y2="85" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <text x="110" y="76" fill="#9dabc4" font-size="9">signs headers + body</text>
          <rect x="10" y="85" width="140" height="40" rx="10" fill="#0b1222" stroke="#8b5cf6"/>
          <text x="80" y="103" text-anchor="middle" fill="#f1f5f9" font-size="12" font-weight="600">Signed Email</text>
          <text x="80" y="119" text-anchor="middle" fill="#9dabc4" font-size="9">DKIM-Signature header</text>
          <line x1="80" y1="125" x2="80" y2="150" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <text x="110" y="142" fill="#9dabc4" font-size="9">sends via SMTP</text>
          <rect x="10" y="150" width="140" height="40" rx="10" fill="#0b1222" stroke="#1c2a47"/>
          <text x="80" y="168" text-anchor="middle" fill="#f1f5f9" font-size="12" font-weight="600">Recipient Server</text>
          <text x="80" y="184" text-anchor="middle" fill="#9dabc4" font-size="9">wants to verify</text>
          <line x1="150" y1="170" x2="195" y2="170" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <text x="172" y="162" text-anchor="middle" fill="#9dabc4" font-size="9">1. reads s= selector</text>
          <rect x="200" y="150" width="200" height="40" rx="10" fill="#0b1222" stroke="#22d3ee"/>
          <text x="300" y="170" text-anchor="middle" fill="#f1f5f9" font-size="12" font-weight="600">DNS TXT</text>
          <text x="300" y="186" text-anchor="middle" fill="#9dabc4" font-size="9">selector._domainkey</text>
          <line x1="400" y1="170" x2="445" y2="170" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <text x="422" y="162" text-anchor="middle" fill="#9dabc4" font-size="9">2. fetches key</text>
          <rect x="450" y="150" width="160" height="40" rx="10" fill="#0b1222" stroke="#8b5cf6"/>
          <text x="530" y="170" text-anchor="middle" fill="#f1f5f9" font-size="12" font-weight="600">Verify signature</text>
          <text x="530" y="186" text-anchor="middle" fill="#9dabc4" font-size="9">pass or fail</text>
          <rect x="440" y="120" width="80" height="24" rx="6" fill="#4ade8022" stroke="#4ade8055"/>
          <text x="480" y="136" text-anchor="middle" fill="#4ade80" font-size="10" font-weight="600">PASS</text>
          <rect x="530" y="120" width="80" height="24" rx="6" fill="#f8717122" stroke="#f8717155"/>
          <text x="570" y="136" text-anchor="middle" fill="#f87171" font-size="10" font-weight="600">FAIL</text>
        </g>
      )}

      {name === 'blocklist-query' && (
        <g font-family="ui-monospace,monospace" font-size="12">
          <rect x="10" y="78" width="140" height="44" rx="10" fill="#0b1222" stroke="#22d3ee"/>
          <text x="80" y="100" text-anchor="middle" fill="#f1f5f9" font-size="12" font-weight="600">Mail Server</text>
          <text x="80" y="116" text-anchor="middle" fill="#9dabc4" font-size="9">checks sending IP</text>
          <line x1="150" y1="100" x2="185" y2="100" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <text x="167" y="92" text-anchor="middle" fill="#9dabc4" font-size="9">1. reverse IP</text>
          <rect x="190" y="78" width="170" height="44" rx="10" fill="#0b1222" stroke="#8b5cf6"/>
