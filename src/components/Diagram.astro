          <rect x="175" y="122" width="170" height="36" rx="8" fill="#0b1222" stroke="#fbbf2455"/>
          <text x="260" y="144" text-anchor="middle" fill="#fbbf24" font-size="11">_autodiscover._tcp SRV</text>
          <line x1="345" y1="60" x2="390" y2="85" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <line x1="345" y1="100" x2="390" y2="95" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <line x1="345" y1="140" x2="390" y2="110" stroke="#22d3ee" stroke-width="1.5" marker-end="url(#pdns-arr)"/>
          <rect x="390" y="78" width="180" height="44" rx="10" fill="#0b1222" stroke="#4ade8055"/>
          <text x="480" y="98" text-anchor="middle" fill="#f1f5f9" font-size="12" font-weight="600">Server Settings</text>
          <text x="480" y="116" text-anchor="middle" fill="#4ade80" font-size="9">found: hostname, port, TLS</text>
          <text x="360" y="185" text-anchor="middle" fill="#9dabc4" font-size="10">clients try all three paths; any hit provides the settings</text>
        </g>
      )}
    </svg>
  </div>
  <figcaption class="mt-2 text-center text-xs text-ink-faint">{caption}</figcaption>
