---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { TOOL_CATEGORIES } from '../data/tools';
import '../styles/global.css';
import { isHeld } from '../data/publish-queue';
import gitDates from '../data/git-dates.json';

interface Props {
  /** Visible breadcrumb trail as [name, href?] pairs; emits BreadcrumbList JSON-LD. */
  breadcrumb?: [string, string?][];
  publishOn?: string;
  title: string;
  description: string;
  /** Optional JSON-LD objects appended to <head> */
  schema?: object[];
  /** Exclude from indexing (app/account pages). */
  noindex?: boolean;
  /** Set false for app screens: no site header/footer, full-bleed slot. */
  chrome?: boolean;
}

const { title, description, schema = [], noindex = false, chrome = true, breadcrumb } = Astro.props;
const fullTitle = title.endsWith(' | PromptDNS') ? title : `${title} | PromptDNS`;

// Self-referencing canonical: every page declares its one true URL so variant
// hosts (www, pages.dev) and slash forms can never be treated as duplicates.
const SITE = 'https://promptdns.com';
let path = Astro.url.pathname || '/';
if (!path.endsWith('/')) path += '/';
if (path === '/index.html') path = '/';
const canonicalUrl = SITE + path;

// Per-route content dates from the committed git-date manifest (see
// src/data/git-dates.lib.mjs). dateModified is the page's last content commit;
// datePublished is the commit that added it. The visible "Last verified" line,
// Article JSON-LD, and the sitemap lastmod all read the same values.
const contentDates = gitDates[path] || null;
const createdDay = contentDates ? contentDates.created.slice(0, 10) : '';
const modifiedDay = contentDates ? contentDates.modified.slice(0, 10) : '';
// These two exact dates were batch-stamped across generated pages; they are
// build artifacts, not editorial choices, so the manifest replaces them.
const BATCH_DATES = new Set(['2026-10-27', '2026-10-28']);

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'PromptDNS',
  url: 'https://promptdns.com',
  description: 'Free DNS, email authentication, and domain health tools, check propagation, SPF, DKIM, DMARC, and AI readiness.',
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'PromptDNS',
  url: 'https://promptdns.com',
  logo: 'https://promptdns.com/favicon.svg',
  description: 'Free browser-based DNS, email authentication, and AI accessibility tools with setup guides for every provider. Domain and email security monitoring in development.',
  sameAs: ['https://github.com/imsalim99/promptdns'],
  contactPoint: [{
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: 'support@promptdns.com',
    url: 'https://promptdns.com/support/',
  }],
};

// WebApplication schema on every registered tool page, straight from the
// tools registry (single source of truth), with no per-page wiring needed.
const toolEntry = TOOL_CATEGORIES.flatMap((c) => c.tools).find((t) => t.href === path);
const webAppSchema = toolEntry
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: toolEntry.name,
      url: SITE + toolEntry.href,
      description: toolEntry.desc,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any (runs in a web browser)',
      browserRequirements: 'Requires JavaScript',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    }
  : null;

// BreadcrumbList mirroring the visible breadcrumb on registry tool pages:
// Home / Tools / {Tool Name}. Guides emit their own via the page schema prop.
const crumbSchema = toolEntry
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE + '/' },
        { '@type': 'ListItem', position: 2, name: 'Tools', item: SITE + '/tools/' },
        { '@type': 'ListItem', position: 3, name: toolEntry.name, item: SITE + toolEntry.href },
      ],
    }
  : null;

// Article schema for content pages (guides) that do not provide their own.
// Organization author per the owner byline decision (standby, 2026-10-24).
const hasArticle = schema.some((s) => s['@type'] === 'Article');
// Marketing, commercial, and app pages are not articles.
const NON_ARTICLE_PATHS = new Set([
  '/how-it-works/', '/pricing/', '/changelog/', '/careers/', '/press/', '/editorial-policy/',
  '/dmarc-monitoring/', '/dns-monitoring/', '/early-access/', '/support/', '/about/', '/contact/',
  '/privacy/', '/terms/', '/refund-policy/', '/subprocessors/', '/security/', '/dpa/',
  '/acceptable-use/', '/login/', '/tools/', '/dns-providers/', '/dns/', '/dns-records/', '/email-authentication/', '/dns-security/', '/ai-web-infrastructure/', '/email-deliverability/', '/ip-and-networking/', '/ssl-tls/', '/dns-error-messages/',
]);
const articleSchema = !toolEntry && !noindex && !hasArticle && path !== '/' && !path.startsWith('/app') && !NON_ARTICLE_PATHS.has(path)
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      inLanguage: 'en',
      author: { '@type': 'Organization', name: 'PromptDNS', url: SITE + '/' },
      publisher: { '@type': 'Organization', name: 'PromptDNS', url: SITE + '/', logo: { '@type': 'ImageObject', url: SITE + '/favicon.svg' } },
      datePublished: createdDay || '2026-10-28',
      dateModified: modifiedDay || '2026-10-28',
      mainEntityOfPage: canonicalUrl,
    }
  : null;

// Pages that pass their own Article schema keep it, but missing or
// batch-stamped dates are replaced with the route's true git dates.
function withTrueDates(s) {
  const isArticle = ['Article', 'TechArticle', 'BlogPosting'].includes(s['@type']);
  if (!isArticle) return s;
  const out = { ...s };
  if (!out.dateModified || BATCH_DATES.has(out.dateModified)) {
    out.dateModified = modifiedDay || out.dateModified || '2026-10-28';
  }
  if (!out.datePublished || BATCH_DATES.has(out.datePublished)) {
    out.datePublished = createdDay || out.datePublished || out.dateModified || '2026-10-28';
  }
  return out;
}

const held = isHeld(path);

// BreadcrumbList from the visible trail prop (guides); skipped when the page
// already emits its own. Mirrors the visible breadcrumb, never invents one.
const hasCrumbSchema = schema.some((s) => s['@type'] === 'BreadcrumbList');
const trailSchema = breadcrumb && !hasCrumbSchema
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumb.map(([name, href], i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name,
        ...(href ? { item: SITE + href } : {}),
      })),
    }
  : null;

const allSchema = [siteSchema, orgSchema, ...(webAppSchema ? [webAppSchema] : []), ...(crumbSchema ? [crumbSchema] : []), ...(trailSchema ? [trailSchema] : []), ...(articleSchema ? [articleSchema] : []), ...schema].map(withTrueDates);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/clash-display-600.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/satoshi-400.woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {(noindex || held) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={toolEntry || !articleSchema ? 'website' : 'article'} />
    <meta property="og:site_name" content="PromptDNS" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={SITE + '/og-default.png'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="PromptDNS: free DNS and email authentication tools" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={SITE + '/og-default.png'} />
    {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body class="flex min-h-screen flex-col">
    {chrome && <Header />}
    <main class="flex-1">
      <slot />
      {(toolEntry || articleSchema || hasArticle) && modifiedDay && (
        <p class="pd-last-verified">Last verified: {modifiedDay}</p>
      )}
    </main>
    {chrome && <Footer />}
  </body>
</html>
<style>
  .pd-last-verified {
    max-width: 48rem;
    margin: 0 auto;
    padding: 1.25rem 1.5rem 2.5rem;
    font-size: 0.75rem;
    opacity: 0.55;
  }
</style>
