---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolArticle from '../components/ToolArticle.astro';
import ToolPanel from '../components/ToolPanel.astro';
import ResultCard from '../components/ResultCard.astro';
---
<BaseLayout title="DNSSEC Checker and Validator" description="Free DNSSEC checker: verify a domain has DS and DNSKEY records, check algorithms, and confirm the chain of trust is publishable.">
  <div class="mx-auto max-w-4xl px-4 py-12">
        <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a>
       <span aria-hidden="true">/</span>
      <a href="/tools/" class="hover:text-accent">Tools</a>
       <span aria-hidden="true">/</span>
      <span class="text-ink-dim">DNSSEC Checker</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">DNSSEC Checker: Validate DS, DNSKEY and the Chain of Trust</h1>
    <p class="mt-4 text-lg text-ink-dim">Free DNSSEC checker: verify DS records, DNSKEY algorithms, and chain of trust.</p>
    <div class="mt-8">
<ToolPanel>
  <form id="ds-form" class="flex flex-col gap-3 sm:flex-row">
    <input id="ds-domain" type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder="example.com" class="flex-1 rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none" />
    <button type="submit" class="btn-cta btn-shimmer px-6 py-2.5 text-sm">Check DNSSEC</button>
  </form>
  <div id="ds-status" class="mt-4 hidden rounded-md px-4 py-3 text-sm font-medium"></div>
        <p id="ds-sample-note" data-vs="example" class="mt-6 text-xs text-ink-faint">
        Sample diagnostic for <code>example.com</code>. Enter any domain above for live results.
      </p>
<div id="ds-results" class="pd-results mt-6 overflow-x-auto rounded-lg border border-line/60" aria-live="polite">
    <table class="pdns-table"><thead><tr><th>Check</th><th>Result</th></tr></thead><tbody id="ds-tbody"><tr><td class="font-medium text-ink">DS record at parent (.com)</td><td><span class="inline-flex rounded bg-pass/15 px-2 py-0.5 text-xs font-semibold text-pass">Present</span></td></tr><tr><td class="font-medium text-ink">DNSKEY algorithm</td><td class="text-sm text-ink-dim">RSASHA256, 2048-bit</td></tr><tr><td class="font-medium text-ink">Chain of trust</td><td><span class="inline-flex rounded bg-pass/15 px-2 py-0.5 text-xs font-semibold text-pass">Valid</span></td></tr></tbody></table>
  </div>
  <ResultCard tool="dnssec-checker" />
</ToolPanel>

    <ToolArticle slug="dnssec-checker" />
    </div>
</div>
</BaseLayout>
<script>
  import { lookup, RESOLVERS, normalizeDomain } from '../lib/doh';
  import type { PdnsResult, PdnsFinding, Severity } from '../data/findings';
  const form = document.getElementById('ds-form') as HTMLFormElement;
  const input = document.getElementById('ds-domain') as HTMLInputElement;
  const statusEl = document.getElementById('ds-status')!;
  const resultsEl = document.getElementById('ds-results')!;
  const tbody = document.getElementById('ds-tbody')!;
  const TOOL = 'dnssec-checker';
  const emit = (verdict: Severity, verdictLine: string, findings: PdnsFinding[], domain: string) => {
    const detail: PdnsResult = {
      tool: TOOL, domain, verdict, verdictLine, findings,
      related: [
        { label: 'Enable DNSSEC in Cloudflare', href: '/enable-dnssec-cloudflare/' },
        { label: 'What is DNSSEC', href: '/what-is-dnssec/' },
      ],
    };
    window.dispatchEvent(new CustomEvent('pdns:result', { detail }));
  };
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const domain = normalizeDomain(input.value);
    if (!domain.includes('.')) { statusEl.textContent = 'Enter a valid domain.'; statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-fail/10 text-fail border border-fail/30'; statusEl.classList.remove('hidden'); return; }
    statusEl.textContent = `Checking DNSSEC for ${domain}…`; statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-panel-2 text-accent border border-line'; statusEl.classList.remove('hidden');
    window.dispatchEvent(new CustomEvent('pdns:clear', { detail: { tool: TOOL } }));
    let ds, dk;
    try {
      [ds, dk] = await Promise.all([lookup(domain, 'DS', RESOLVERS[0]), lookup(domain, 'DNSKEY', RESOLVERS[0])]);
    } catch {
      statusEl.textContent = `Could not reach the DNS resolver for ${domain}. This is an inconclusive result - not a pass or fail.`;
      statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-warn/10 text-warn border border-warn/30';
      emit('info', 'DNS query did not complete. Nothing is known about this domain\u2019s DNSSEC.', [{ code: 'DNS_QUERY_FAILED' }], domain);
      return;
    }
    const dsOk = ds.ok && ds.answers.length > 0;
    const keys = dk.answers.filter(a => a.type === 48);
    const ksk = keys.find(k => k.data.includes(' 257 '));
    const algo = ds.answers[0]?.data.split(/\s+/)[1];
    const ALGOS: Record<string, string> = { '8': 'RSA/SHA-256', '13': 'ECDSA P-256', '15': 'Ed25519' };
    document.getElementById('ds-sample-note')?.classList.add('hidden');
    tbody.innerHTML = '';
    const rows: [string, string][] = [
      ['DS record (chain of trust)', dsOk ? `Present, algorithm ${algo} (${ALGOS[algo] ?? 'other'})` : 'Missing: the zone may be signed but the parent does not vouch for it'],
      ['DNSKEY records', keys.length ? `${keys.length} key(s)${ksk ? ' incl. KSK' : ''}` : 'None found'],
      ['Algorithm strength', algo === '13' || algo === '15' ? 'Modern' : algo === '8' ? 'Acceptable (RSA)' : algo ? 'Check algorithm' : 'n/a'],
    ];
    for (const [k, v] of rows) tbody.insertAdjacentHTML('beforeend', `<tr><td class="text-ink-dim">${k}</td><td class="text-sm">${v}</td></tr>`);
    statusEl.textContent = dsOk ? `${domain} is signed: DS present at the parent.` : keys.length ? 'Zone has keys but no DS at the parent: DNSSEC is not active end-to-end.' : `${domain} is not signed.`;
    statusEl.className = `mt-4 rounded-md px-4 py-3 text-sm font-medium ${dsOk ? 'bg-pass/10 text-pass border border-pass/30' : 'bg-warn/10 text-warn border border-warn/30'}`;
    resultsEl.classList.remove('hidden');

    if (dsOk) {
      emit('pass', `${domain} is signed: DS present at the parent.`,
        [{ code: 'DNSSEC_SIGNED', detail: `DS present, algorithm ${algo} (${ALGOS[algo] ?? 'other'})` }], domain);
    } else if (keys.length) {
      emit('warn', `${domain} has DNSKEY records but no DS at the parent: DNSSEC is not active end-to-end.`,
        [{ code: 'DNSSEC_KEYS_NO_DS', detail: `${keys.length} key(s) in the zone, but no DS record at the parent` }], domain);
    } else {
      emit('warn', `${domain} is not signed.`,
        [{ code: 'DNSSEC_UNSIGNED', detail: 'No DS record and no DNSKEY records found' }], domain);
    }
  });
</script>
