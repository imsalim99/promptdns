---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolArticle from '../components/ToolArticle.astro';
import ToolPanel from '../components/ToolPanel.astro';
import ResultCard from '../components/ResultCard.astro';
---
<BaseLayout title="TTL Checker - See Every Record's Cache Time" description="Free DNS TTL checker: see the time-to-live of every record on a domain to plan migrations and catch bloated caches.">
  <div class="mx-auto max-w-4xl px-4 py-12">
        <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a>
       <span aria-hidden="true">/</span>
      <a href="/tools/" class="hover:text-accent">Tools</a>
       <span aria-hidden="true">/</span>
      <span class="text-ink-dim">DNS TTL Checker</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">TTL Checker: See Every Record’s Cache Time</h1>
    <p class="mt-4 text-lg text-ink-dim">Free TTL checker: see every DNS record's cache time at once. Plan migrations, catch bloated caches.</p>
    <div class="mt-8">
<ToolPanel>
  <form id="ttl-form" class="flex flex-col gap-3 sm:flex-row">
    <input id="ttl-domain" type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder="example.com" class="flex-1 rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none" />
    <button type="submit" class="btn-cta btn-shimmer px-6 py-2.5 text-sm">Check TTLs</button>
  </form>
  <div id="ttl-status" class="mt-4 hidden rounded-md px-4 py-3 text-sm font-medium"></div>
        <p id="ttl-sample-note" data-vs="example" class="mt-6 text-xs text-ink-faint">
        Sample diagnostic for <code>example.com</code>. Enter any domain above for live results.
      </p>
<div id="ttl-results" class="mt-6 overflow-x-auto rounded-lg border border-line/60">
    <table class="pdns-table"><thead><tr><th>Type</th><th>TTL</th><th>Value</th></tr></thead><tbody id="ttl-tbody"><tr><td>A</td><td class="font-mono text-xs text-ink-dim">3600</td><td><code>93.184.216.34</code></td></tr><tr><td>NS</td><td class="font-mono text-xs text-ink-dim">86400</td><td><code>a.iana-servers.net</code></td></tr><tr><td>TXT</td><td class="font-mono text-xs text-ink-dim">3600</td><td><code>"v=spf1 -all"</code></td></tr></tbody></table>
  </div>
  <ResultCard tool="ttl-checker" />
</ToolPanel>

    <ToolArticle slug="ttl-checker" />
    </div>
</div>
</BaseLayout>
<script>
  import { lookup, RESOLVERS, normalizeDomain, type RecordType } from '../lib/doh';
  import type { PdnsResult, PdnsFinding, Severity } from '../data/findings';
  const form = document.getElementById('ttl-form') as HTMLFormElement;
  const input = document.getElementById('ttl-domain') as HTMLInputElement;
  const statusEl = document.getElementById('ttl-status')!;
  const resultsEl = document.getElementById('ttl-results')!;
  const tbody = document.getElementById('ttl-tbody')!;
  const TOOL = 'ttl-checker';
  const emit = (verdict: Severity, verdictLine: string, findings: PdnsFinding[], domain: string) => {
    const detail: PdnsResult = {
      tool: TOOL, domain, verdict, verdictLine, findings,
      ctaLabel: 'Know when records change',
      related: [
        { label: 'Propagation checker', href: '/dns-propagation-checker/' },
        { label: 'DNS monitoring', href: '/dns-monitoring/' },
      ],
    };
    window.dispatchEvent(new CustomEvent('pdns:result', { detail }));
  };
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const domain = normalizeDomain(input.value);
    if (!domain.includes('.')) { statusEl.textContent = 'Enter a valid domain.'; statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-fail/10 text-fail border border-fail/30'; statusEl.classList.remove('hidden'); return; }
    statusEl.textContent = `Checking TTLs for ${domain}…`; statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-panel-2 text-accent border border-line'; statusEl.classList.remove('hidden');
    window.dispatchEvent(new CustomEvent('pdns:clear', { detail: { tool: TOOL } }));
    const types: RecordType[] = ['A','AAAA','MX','NS','TXT','SOA','CAA'];
    const rows: { t: string; ttl: number; v: string }[] = [];
    try {
      await Promise.all(types.map(async (t) => {
        const r = await lookup(domain, t, RESOLVERS[0]);
        for (const a of r.answers.slice(0, 4)) rows.push({ t, ttl: a.TTL, v: a.data });
      }));
    } catch {
      statusEl.textContent = `Could not reach the DNS resolver for ${domain}. This is an inconclusive result - not a pass or fail.`;
      statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-warn/10 text-warn border border-warn/30';
      emit('info', 'DNS query did not complete. Nothing is known about this domain\u2019s TTLs.', [{ code: 'DNS_QUERY_FAILED' }], domain);
      return;
    }
    if (!rows.length) {
      statusEl.textContent = 'No records found.'; statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-warn/10 text-warn border border-warn/30';
      emit('warn', `No common records found for ${domain}.`, [{ code: 'TTL_NO_RECORDS' }], domain);
      return;
    }
    const min = Math.min(...rows.map(r => r.ttl));
    const slow = min > 3600;
    statusEl.textContent = `${rows.length} records. Lowest TTL: ${min}s${min > 300 ? ' (lower to 300 a day before migrations)' : ' (migration-ready)'}.`;
    statusEl.className = `mt-4 rounded-md px-4 py-3 text-sm font-medium ${slow ? 'bg-warn/10 text-warn border border-warn/30' : 'bg-pass/10 text-pass border border-pass/30'}`;
    if (slow) {
      emit('warn', `${rows.length} records found. Lowest TTL is ${min}s: changes will be slow to spread.`,
        [{ code: 'TTL_SLOW', detail: `Lowest TTL: ${min}s` }], domain);
    } else {
      emit('pass', `${rows.length} records found. Lowest TTL: ${min}s.`,
        [{ code: 'TTL_FAST', detail: `Lowest TTL: ${min}s` }], domain);
    }
    document.getElementById('ttl-sample-note')?.classList.add('hidden');
    tbody.innerHTML = '';
    for (const r of rows.sort((a, b) => a.ttl - b.ttl)) {
      tbody.insertAdjacentHTML('beforeend', `<tr><td class="font-mono text-xs text-accent">${r.t}</td><td class="font-mono text-xs ${r.ttl > 3600 ? 'text-warn' : 'text-ink'}">${r.ttl}s</td><td><code>${r.v.replace(/</g, '&lt;').slice(0, 60)}</code></td></tr>`);
    }
    resultsEl.classList.remove('hidden');
  });
</script>
