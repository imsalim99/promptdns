---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolPanel from '../components/ToolPanel.astro';

const faqSchema = {
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
  {
   "@type": "Question",
   "name": "What is the difference between MTA-STS and DANE?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "MTA-STS uses a DNS TXT record and an HTTPS-hosted policy file to enforce TLS for SMTP. DANE uses DNSSEC-signed TLSA records. They solve the same problem differently; MTA-STS is more widely adopted."
   }
  },
  {
   "@type": "Question",
   "name": "Does MTA-STS work without DNSSEC?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Yes. MTA-STS relies on HTTPS certificate validation for the policy file, not DNSSEC. This makes it easier to deploy than DANE, which requires DNSSEC."
   }
  },
  {
   "@type": "Question",
   "name": "What happens if my MTA-STS policy file is unreachable?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Receiving servers fall back to their cached copy of your policy. If no cached copy exists, they skip MTA-STS enforcement and deliver normally."
   }
  }
 ]
}
---
<BaseLayout title="MTA-STS Record Checker" description="Free MTA-STS checker: verify the _mta-sts TXT record and fetch the policy file to check mode and MX hosts."  schema={[faqSchema]}
>
  <div class="mx-auto max-w-4xl px-4 py-12">
        <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a>
       <span aria-hidden="true">/</span>
      <a href="/tools/" class="hover:text-accent">Tools</a>
       <span aria-hidden="true">/</span>
      <span class="text-ink-dim">MTA-STS Record Checker</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">MTA-STS Checker: Validate TLS Policy and MX Records</h1>
    <p class="mt-4 text-lg text-ink-dim">Free MTA-STS checker: verify MTA-STS policy records and TLS enforcement for inbound mail.</p>
    <div class="mt-8">
<ToolPanel>
  <form id="ms-form" class="flex flex-col gap-3 sm:flex-row">
    <input id="ms-domain" type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder="example.com" class="flex-1 rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none" />
    <button type="submit" class="btn-cta btn-shimmer px-6 py-2.5 text-sm">Check MTA-STS</button>
  </form>
  <div id="ms-status" class="mt-4 hidden rounded-md px-4 py-3 text-sm font-medium"></div>
  <p id="ms-sample-note" data-vs="example" class="mt-6 text-xs text-ink-faint">
        Sample diagnostic for <code>example.com</code>. Enter your own domain above for live results.
      </p>
<div id="ms-results" class="pd-results mt-6 overflow-x-auto rounded-lg border border-line/60" aria-live="polite">
    <table class="pdns-table"><thead><tr><th>Item</th><th>Value</th></tr></thead><tbody id="ms-tbody"><tr><td class="font-medium text-ink">DNS record</td><td class="text-sm text-ink-dim"><code>v=STS1</code> present at _smtp._tls.example.com</td></tr><tr><td class="font-medium text-ink">Policy mode</td><td class="text-sm text-ink-dim">enforce</td></tr><tr><td class="font-medium text-ink">MX matches policy</td><td class="text-sm text-ink-dim">All MX hosts are listed in the policy file</td></tr></tbody></table>
  </div>
</ToolPanel>
    </div>
    <article class="rich-text mt-12 max-w-none">
      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Frequently asked questions</h2>
      <div class="mt-3 grid gap-3"><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">What is the difference between MTA-STS and DANE?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">MTA-STS uses a DNS TXT record and an HTTPS-hosted policy file to enforce TLS for SMTP. DANE uses DNSSEC-signed TLSA records. They solve the same problem differently; MTA-STS is more widely adopted.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Does MTA-STS work without DNSSEC?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Yes. MTA-STS relies on HTTPS certificate validation for the policy file, not DNSSEC. This makes it easier to deploy than DANE, which requires DNSSEC.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">What happens if my MTA-STS policy file is unreachable?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Receiving servers fall back to their cached copy of your policy. If no cached copy exists, they skip MTA-STS enforcement and deliver normally.</p></details></div>
<h2>Related</h2><ul><li><a href="/mta-sts/">MTA-STS explained</a> · <a href="/tls-rpt-checker/">TLS-RPT checker</a></li></ul></article>
  </div>
</BaseLayout>
<script>
  import { lookup, RESOLVERS, normalizeDomain } from '../lib/doh';
  import { txtRecords } from '../lib/spf';
  import { fetchText } from '../lib/proxy';
  const form = document.getElementById('ms-form') as HTMLFormElement;
  const input = document.getElementById('ms-domain') as HTMLInputElement;
  const statusEl = document.getElementById('ms-status')!;
  const resultsEl = document.getElementById('ms-results')!;
  const tbody = document.getElementById('ms-tbody')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const domain = normalizeDomain(input.value);
    statusEl.textContent = `Looking up _mta-sts.${domain}…`; statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-panel-2 text-accent border border-line'; statusEl.classList.remove('hidden');
    const res = await lookup(`_mta-sts.${domain}`, 'TXT', RESOLVERS[0]);
    const rec = txtRecords(res.answers).find(t => t.toLowerCase().includes('stsv1'));
    if (!rec) { statusEl.textContent = 'No MTA-STS record found. Inbound TLS is opportunistic only.'; statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-warn/10 text-warn border border-warn/30'; return; }
    statusEl.textContent = 'TXT record found. Fetching policy file…';
    const pol = await fetchText(`https://mta-sts.${domain}/.well-known/mta-sts.txt`);
    const rows: [string, string][] = [['TXT record', rec]];
    if (pol.ok && !pol.text.startsWith('<')) {
      const mode = pol.text.match(/mode:\s*(\w+)/)?.[1] ?? '?';
      const mxs = pol.text.split(/\r?\n/).filter(l => l.startsWith('mx:'));
      rows.push(['Policy mode', mode === 'enforce' ? 'enforce (TLS required)' : mode === 'testing' ? 'testing (report only)' : mode]);
      rows.push(['MX hosts', mxs.map(l => l.replace('mx:', '').trim()).join(', ') || 'none listed']);
    } else {
      rows.push(['Policy file', 'Could not fetch over HTTPS - MTA-STS requires the policy at https://mta-sts.' + domain + '/.well-known/mta-sts.txt']);
    }
    document.getElementById('ms-sample-note')?.classList.add('hidden');
    tbody.innerHTML = '';
    for (const [k, v] of rows) tbody.insertAdjacentHTML('beforeend', `<tr><td class="text-ink-dim">${k}</td><td class="font-mono text-xs">${v.replace(/</g, '&lt;')}</td></tr>`);
    statusEl.textContent = 'MTA-STS check complete.';
    statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-pass/10 text-pass border border-pass/30';
    resultsEl.classList.remove('hidden');
  });
</script>
