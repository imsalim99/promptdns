---
import BaseLayout from '../layouts/BaseLayout.astro';
import Diagram from '../components/Diagram.astro';
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What does DNS stand for?', acceptedAnswer: { '@type': 'Answer', text: 'Domain Name System. It is the internet\u2019s directory that translates human-readable domain names into IP addresses computers use to connect.' } },
    { '@type': 'Question', name: 'Is DNS the same as a website host?', acceptedAnswer: { '@type': 'Answer', text: 'No. DNS only translates names to addresses and routes mail; the hosting server is where your site actually lives. You can change either independently.' } },
    { '@type': 'Question', name: 'Who runs DNS?', acceptedAnswer: { '@type': 'Answer', text: 'No single entity. Root servers, TLD registries, registrars, DNS hosting providers, and public resolvers like Cloudflare and Google each operate one layer.' } },
  ],
};
