---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolPanel from '../components/ToolPanel.astro';

const faqSchema = {
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
  {
   "@type": "Question",
   "name": "Is the TLS-RPT Checker really free?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Yes: every tool on PromptDNS is free forever, with no account, no limits, and no trial timers. The TLS-RPT validation runs entirely in your browser."
   }
  },
  {
   "@type": "Question",
   "name": "How accurate are the results?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "The TLS-RPT validation queries public DNS-over-HTTPS resolvers (Cloudflare, Google, Quad9) in real time. Results reflect what those resolvers actually serve, which is the same data the wider internet receives."
   }
  },
  {
   "@type": "Question",
   "name": "Do you store the domains I look up?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "No. Lookups happen client-side in your browser. Domains are not sent to our servers, stored, or logged. See the privacy policy for details."
   }
  },
  {
   "@type": "Question",
   "name": "Can I use this tool for client work?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Yes: the tools are free for commercial use. Agencies on the Business plan can also generate white-label automated reports."
   }
  },
  {
   "@type": "Question",
   "name": "How often should I run this check?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "After any DNS or infrastructure change, and periodically (weekly or monthly) as part of routine health monitoring. The paid plans automate this."
   }
  },
  {
   "@type": "Question",
   "name": "What if the results look wrong?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Compare with a second tool or dig from a terminal. If results differ between tools, one may be showing a cached answer: the propagation checker reveals which resolvers disagree."
   }
  }
 ]
}
---
<BaseLayout title="TLS-RPT Record Checker" description="Free TLS-RPT checker: verify the _smtp._tls TXT record and where your TLS failure reports are sent."  schema={[faqSchema]}
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <nav class="mb-4 text-sm text-ink-faint"><a href="/" class="hover:text-accent">Home</a> / <span class="text-ink-dim">TLS-RPT Checker</span></nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">TLS-RPT Record Checker</h1>
    <p class="mt-4 text-lg text-ink-dim">Check the <span class="font-mono text-sm">_smtp._tls</span> TXT record: where providers send reports about TLS delivery failures.</p>
    <div class="mt-8">
<ToolPanel>
  <form id="tr-form" class="flex flex-col gap-3 sm:flex-row">
    <input id="tr-domain" type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder="example.com" class="flex-1 rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none" />
    <button type="submit" class="btn-cta btn-shimmer px-6 py-2.5 text-sm">Check TLS-RPT</button>
  </form>
  <div id="tr-status" class="mt-4 hidden rounded-md px-4 py-3 text-sm font-medium"></div>
  <div id="tr-results" class="mt-6 hidden overflow-x-auto rounded-lg border border-line/60">
    <table class="pdns-table"><thead><tr><th>Item</th><th>Value</th></tr></thead><tbody id="tr-tbody"></tbody></table>
  </div>
</ToolPanel>

    <div class="mt-10 flex items-center gap-3 rounded-xl border border-line bg-panel/40 px-5 py-3">
      <span class="grid h-9 w-9 place-items-center rounded-full bg-gradient-to-br from-accent to-violet font-display text-xs font-bold text-canvas">PD</span>
      <div>
        <p class="text-sm font-medium text-ink">PromptDNS Team</p>
        <p class="text-xs text-ink-faint">Last updated: August 2026</p>
      </div>
    </div>
    </div>
    <article class="rich-text mt-12 max-w-none">
      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Frequently asked questions</h2>
      <div class="mt-3 grid gap-3"><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Is the TLS-RPT Checker really free?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Yes: every tool on PromptDNS is free forever, with no account, no limits, and no trial timers. The TLS-RPT validation runs entirely in your browser.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">How accurate are the results?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">The TLS-RPT validation queries public DNS-over-HTTPS resolvers (Cloudflare, Google, Quad9) in real time. Results reflect what those resolvers actually serve, which is the same data the wider internet receives.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Do you store the domains I look up?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">No. Lookups happen client-side in your browser. Domains are not sent to our servers, stored, or logged. See the privacy policy for details.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Can I use this tool for client work?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Yes: the tools are free for commercial use. Agencies on the Business plan can also generate white-label automated reports.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">How often should I run this check?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">After any DNS or infrastructure change, and periodically (weekly or monthly) as part of routine health monitoring. The paid plans automate this.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">What if the results look wrong?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Compare with a second tool or dig from a terminal. If results differ between tools, one may be showing a cached answer: the propagation checker reveals which resolvers disagree.</p></details></div>
<h2>Related</h2><ul><li><a href="/mta-sts/">MTA-STS explained</a> · <a href="/mta-sts-checker/">MTA-STS checker</a></li></ul></article>
  </div>
</BaseLayout>
<script>
  import { lookup, RESOLVERS, normalizeDomain } from '../lib/doh';
  import { txtRecords } from '../lib/spf';
  const form = document.getElementById('tr-form') as HTMLFormElement;
  const input = document.getElementById('tr-domain') as HTMLInputElement;
  const statusEl = document.getElementById('tr-status')!;
  const resultsEl = document.getElementById('tr-results')!;
  const tbody = document.getElementById('tr-tbody')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const domain = normalizeDomain(input.value);
    statusEl.textContent = `Looking up _smtp._tls.${domain}…`; statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-panel-2 text-accent border border-line'; statusEl.classList.remove('hidden');
    const res = await lookup(`_smtp._tls.${domain}`, 'TXT', RESOLVERS[0]);
    const rec = txtRecords(res.answers).find(t => t.toLowerCase().includes('tlsrpt'));
    if (!rec) { statusEl.textContent = 'No TLS-RPT record found. You receive no TLS failure reports.'; statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-warn/10 text-warn border border-warn/30'; return; }
    const rua = rec.match(/rua=([^;]+)/i)?.[1] ?? '';
    tbody.innerHTML = `<tr><td class="text-ink-dim">Record</td><td class="font-mono text-xs">${rec.replace(/</g, '&lt;')}</td></tr><tr><td class="text-ink-dim">Reports sent to</td><td class="font-mono text-xs text-accent">${rua.replace(/</g, '&lt;')}</td></tr>`;
    statusEl.textContent = 'TLS-RPT record found.';
    statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-pass/10 text-pass border border-pass/30';
    resultsEl.classList.remove('hidden');
  });
</script>
