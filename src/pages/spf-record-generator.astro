---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolPanel from '../components/ToolPanel.astro';

const faqSchema = {
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
  {
   "@type": "Question",
   "name": "Is the SPF Generator really free?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Yes: every tool on PromptDNS is free forever, with no account, no limits, and no trial timers. The SPF record generation runs entirely in your browser."
   }
  },
  {
   "@type": "Question",
   "name": "How accurate are the results?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "The SPF record generation queries public DNS-over-HTTPS resolvers (Cloudflare, Google, Quad9) in real time. Results reflect what those resolvers actually serve, which is the same data the wider internet receives."
   }
  },
  {
   "@type": "Question",
   "name": "Do you store the domains I look up?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "No. Lookups happen client-side in your browser. Domains are not sent to our servers, stored, or logged. See the privacy policy for details."
   }
  },
  {
   "@type": "Question",
   "name": "Can I use this tool for client work?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Yes: the tools are free for commercial use. Agencies on the Business plan can also generate white-label automated reports."
   }
  },
  {
   "@type": "Question",
   "name": "How often should I run this check?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "After any DNS or infrastructure change, and periodically (weekly or monthly) as part of routine health monitoring. The paid plans automate this."
   }
  },
  {
   "@type": "Question",
   "name": "What if the results look wrong?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Compare with a second tool or dig from a terminal. If results differ between tools, one may be showing a cached answer: the propagation checker reveals which resolvers disagree."
   }
  }
 ]
}
---
<BaseLayout title="SPF Record Generator — Build Your SPF Free" description="Free SPF record generator: add your senders (Google, Microsoft, ESPs, custom IPs) and get a valid v=spf1 record with lookup counting."  schema={[faqSchema]}
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <nav class="mb-4 text-sm text-ink-faint"><a href="/" class="hover:text-accent">Home</a> / <span class="text-ink-dim">SPF Generator</span></nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">SPF Record Generator</h1>
    <p class="mt-4 text-lg text-ink-dim">Pick your senders, choose a policy, get a valid record with a live lookup count.</p>
    <div class="mt-8">
<ToolPanel>
  <form id="sg-form" class="grid gap-4 sm:grid-cols-2">
    <div>
      <p class="mb-2 text-xs text-ink-faint">Sending services</p>
      <div id="sg-services" class="grid gap-1.5 text-sm">
        <label class="flex items-center gap-2"><input type="checkbox" value="include:_spf.google.com" class="accent-cyan-400"> Google Workspace</label>
        <label class="flex items-center gap-2"><input type="checkbox" value="include:spf.protection.outlook.com" class="accent-cyan-400"> Microsoft 365</label>
        <label class="flex items-center gap-2"><input type="checkbox" value="include:sendgrid.net" class="accent-cyan-400"> SendGrid</label>
        <label class="flex items-center gap-2"><input type="checkbox" value="include:mailgun.org" class="accent-cyan-400"> Mailgun</label>
        <label class="flex items-center gap-2"><input type="checkbox" value="include:servers.mcsv.net" class="accent-cyan-400"> Mailchimp</label>
        <label class="flex items-center gap-2"><input type="checkbox" value="include:zoho.com" class="accent-cyan-400"> Zoho</label>
        <label class="flex items-center gap-2"><input type="checkbox" value="include:amazonses.com" class="accent-cyan-400"> Amazon SES</label>
        <label class="flex items-center gap-2"><input type="checkbox" value="a" class="accent-cyan-400"> My own server (a)</label>
        <label class="flex items-center gap-2"><input type="checkbox" value="mx" class="accent-cyan-400"> My mail servers (mx)</label>
      </div>
      <div class="mt-3 grid gap-2">
        <input id="sg-ip" type="text" placeholder="Extra IP, e.g. 203.0.113.10" class="rounded-md border border-line bg-transparent px-3 py-2 font-mono text-xs text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none" />
        <input id="sg-include" type="text" placeholder="Extra include:, e.g. include:esp.example.com" class="rounded-md border border-line bg-transparent px-3 py-2 font-mono text-xs text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none" />
      </div>
    </div>
    <div>
      <p class="mb-2 text-xs text-ink-faint">Policy for everyone else</p>
      <select id="sg-all" class="w-full rounded-md border border-line bg-panel px-3 py-2.5 text-sm text-ink focus:border-accent focus:outline-none">
        <option value="~all">~all softfail (recommended start)</option>
        <option value="-all">-all hard fail (strict)</option>
        <option value="?all">?all neutral</option>
      </select>
      <div class="mt-6">
        <div class="flex items-center justify-between"><p class="text-sm font-semibold text-ink">Your SPF record</p><button type="button" id="sg-copy" class="rounded-md border border-line bg-panel-2 px-3 py-1.5 text-xs font-medium text-ink hover:border-accent/40">Copy</button></div>
        <pre id="sg-out" class="mt-2 overflow-x-auto rounded-lg border border-line bg-panel-2 p-4 font-mono text-xs leading-relaxed text-accent-soft"></pre>
        <p id="sg-count" class="mt-2 text-xs text-ink-faint"></p>
      </div>
    </div>
  </form>
</ToolPanel>
    </div>
    </div>
    <article class="rich-text mt-12 max-w-none">
      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Frequently asked questions</h2>
      <div class="mt-3 grid gap-3"><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Is the SPF Generator really free?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Yes: every tool on PromptDNS is free forever, with no account, no limits, and no trial timers. The SPF record generation runs entirely in your browser.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">How accurate are the results?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">The SPF record generation queries public DNS-over-HTTPS resolvers (Cloudflare, Google, Quad9) in real time. Results reflect what those resolvers actually serve, which is the same data the wider internet receives.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Do you store the domains I look up?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">No. Lookups happen client-side in your browser. Domains are not sent to our servers, stored, or logged. See the privacy policy for details.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Can I use this tool for client work?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Yes: the tools are free for commercial use. Agencies on the Business plan can also generate white-label automated reports.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">How often should I run this check?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">After any DNS or infrastructure change, and periodically (weekly or monthly) as part of routine health monitoring. The paid plans automate this.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">What if the results look wrong?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Compare with a second tool or dig from a terminal. If results differ between tools, one may be showing a cached answer: the propagation checker reveals which resolvers disagree.</p></details></div>
<h2>Related</h2><ul>
      <li><a href="/spf-record-checker/">SPF checker</a> (verify after publishing) · <a href="/spf-flattener/">flattener</a></li>
      <li><a href="/spf-record-syntax/">Full syntax reference</a></li>
    </ul></article>
  </div>
</BaseLayout>
<script>
  const boxes = [...document.querySelectorAll('#sg-services input')] as HTMLInputElement[];
  const ipIn = document.getElementById('sg-ip') as HTMLInputElement;
  const incIn = document.getElementById('sg-include') as HTMLInputElement;
  const allSel = document.getElementById('sg-all') as HTMLSelectElement;
  const out = document.getElementById('sg-out')!;
  const count = document.getElementById('sg-count')!;
  const copyBtn = document.getElementById('sg-copy') as HTMLButtonElement;
  function render() {
    const parts: string[] = [];
    let lookups = 0;
    for (const b of boxes) if (b.checked) { parts.push(b.value); if (/^(include|a$|mx$)/.test(b.value)) lookups++; }
    const ip = ipIn.value.trim();
    if (ip) parts.push(`ip4:${ip}`);
    const inc = incIn.value.trim().replace(/^include:/, '');
    if (inc) { parts.push(`include:${inc}`); lookups++; }
    out.textContent = `v=spf1 ${parts.join(' ')}${parts.length ? ' ' : ''}${allSel.value}`;
    count.textContent = lookups > 0 ? `${lookups} DNS lookups used (limit 10)${lookups > 8 ? ' — consider flattening' : ''}` : 'No DNS lookups: literal IPs only.';
    count.className = `mt-2 text-xs ${lookups > 8 ? 'text-warn' : 'text-ink-faint'}`;
  }
  [ipIn, incIn, allSel, ...boxes].forEach(el => el.addEventListener('input', render));
  render();
  copyBtn.addEventListener('click', async () => { await navigator.clipboard.writeText(out.textContent ?? ''); copyBtn.textContent = 'Copied!'; setTimeout(() => copyBtn.textContent = 'Copy', 1500); });
</script>
