---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolPanel from '../components/ToolPanel.astro';

const faqSchema = {
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
    {'@type': 'Question', 'name': "What happens if I have two SPF records?", "acceptedAnswer": { '@type': 'Answer', "text": "RFC 7208 requires exactly one v=spf1 record per domain. Multiple records cause a permerror, which means receivers ignore your SPF entirely. Merge all senders into a single record." } },
    {'@type': 'Question', 'name': "What is the difference between ~all and -all?", "acceptedAnswer": { '@type': 'Answer', "text": "~all (softfail) marks unlisted senders as suspicious but delivers their mail. -all (hardfail) instructs receivers to reject unlisted senders. Use ~all until you are confident every legitimate sender is listed." } },
    {'@type': 'Question', 'name': "Do I need ip4: and ip6: mechanisms?", "acceptedAnswer": { '@type': 'Answer', "text": "Only if you send email from servers not covered by an include: mechanism. Most email services provide include: directives that already cover their sending IPs." } }
  ]
}
---
<BaseLayout title="SPF Record Generator - Build Your SPF Free" description="Free SPF record generator: add your senders (Google, Microsoft, ESPs, custom IPs) and get a valid v=spf1 record with lookup counting."  schema={[faqSchema]}
>
  <div class="mx-auto max-w-4xl px-4 py-12">
        <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a>
       <span aria-hidden="true">/</span>
      <a href="/tools/" class="hover:text-accent">Tools</a>
       <span aria-hidden="true">/</span>
      <span class="text-ink-dim">SPF Record Generator</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">SPF Record Generator: Build a Valid v=spf1 Record</h1>
    <p class="mt-4 text-lg text-ink-dim">Free SPF record generator: build correct v=spf1 records with include, ip4, ip6, mx and all mechanisms.</p>
    <div class="mt-8">
<ToolPanel>
  <form id="sg-form" class="grid gap-4 sm:grid-cols-2">
    <div>
      <p class="mb-2 text-xs text-ink-faint">Sending services</p>
      <div id="sg-services" class="grid gap-1.5 text-sm">
        <label class="flex items-center gap-2"><input type="checkbox" value="include:_spf.google.com" class="accent-cyan-400"> Google Workspace</label>
        <label class="flex items-center gap-2"><input type="checkbox" value="include:spf.protection.outlook.com" class="accent-cyan-400"> Microsoft 365</label>
        <label class="flex items-center gap-2"><input type="checkbox" value="include:sendgrid.net" class="accent-cyan-400"> SendGrid</label>
        <label class="flex items-center gap-2"><input type="checkbox" value="include:mailgun.org" class="accent-cyan-400"> Mailgun</label>
        <label class="flex items-center gap-2"><input type="checkbox" value="include:servers.mcsv.net" class="accent-cyan-400"> Mailchimp</label>
        <label class="flex items-center gap-2"><input type="checkbox" value="include:zoho.com" class="accent-cyan-400"> Zoho</label>
        <label class="flex items-center gap-2"><input type="checkbox" value="include:amazonses.com" class="accent-cyan-400"> Amazon SES</label>
        <label class="flex items-center gap-2"><input type="checkbox" value="a" class="accent-cyan-400"> My own server (a)</label>
        <label class="flex items-center gap-2"><input type="checkbox" value="mx" class="accent-cyan-400"> My mail servers (mx)</label>
      </div>
      <div class="mt-3 grid gap-2">
        <input id="sg-ip" type="text" placeholder="Extra IP, e.g. 203.0.113.10" class="rounded-md border border-line bg-transparent px-3 py-2 font-mono text-xs text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none" />
        <input id="sg-include" type="text" placeholder="Extra include:, e.g. include:esp.example.com" class="rounded-md border border-line bg-transparent px-3 py-2 font-mono text-xs text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none" />
      </div>
    </div>
    <div>
      <p class="mb-2 text-xs text-ink-faint">Policy for everyone else</p>
      <select id="sg-all" class="w-full rounded-md border border-line bg-panel px-3 py-2.5 text-sm text-ink focus:border-accent focus:outline-none">
        <option value="~all">~all softfail (recommended start)</option>
        <option value="-all">-all hard fail (strict)</option>
        <option value="?all">?all neutral</option>
      </select>
      <div class="mt-6">
        <div class="flex items-center justify-between"><p class="text-sm font-semibold text-ink">Your SPF record</p><button type="button" id="sg-copy" class="rounded-md border border-line bg-panel-2 px-3 py-1.5 text-xs font-medium text-ink hover:border-accent/40">Copy</button></div>
        <pre id="sg-out" class="mt-2 overflow-x-auto rounded-lg border border-line bg-panel-2 p-4 font-mono text-xs leading-relaxed text-accent-soft"></pre>
        <p id="sg-count" class="mt-2 text-xs text-ink-faint"></p>
      </div>
    </div>
  </form>
</ToolPanel>

    <h2 class="font-display mt-10 text-xl font-semibold text-ink">Syntax the SPF generator validates</h2>
    <section class="not-prose my-4" aria-label="Reference table">
      <div class="glass rounded-2xl p-5 shadow-lg sm:p-7 overflow-x-auto">
        <table class="pdns-table" style="width:100%">
          <thead><tr><th>Check</th><th>Rule</th><th>Source</th></tr></thead>
          <tbody><tr><td class="font-medium text-ink">Single record</td><td class="text-sm text-ink-dim">One v=spf1 per name</td><td class="text-sm text-ink-dim">RFC 7208</td></tr><tr><td class="font-medium text-ink">Mechanism syntax</td><td class="text-sm text-ink-dim">Valid include/a/mx/ip4/ip6/all usage</td><td class="text-sm text-ink-dim">RFC 7208</td></tr><tr><td class="font-medium text-ink">Lookup budget</td><td class="text-sm text-ink-dim">Warning near the 10-lookup cap</td><td class="text-sm text-ink-dim">RFC 7208 section 4.6.4</td></tr></tbody>
        </table>
      </div>
    </section>
    </div>
    <article class="rich-text mt-12 max-w-none">
      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Frequently asked questions</h2>
      <div class="mt-3 grid gap-3"><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">What happens if I have two SPF records?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">RFC 7208 requires exactly one v=spf1 record per domain. Multiple records cause a permerror, which means receivers ignore your SPF entirely. Merge all senders into a single record.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">What is the difference between ~all and -all?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">~all (softfail) marks unlisted senders as suspicious but delivers their mail. -all (hardfail) instructs receivers to reject unlisted senders. Use ~all until you are confident every legitimate sender is listed.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Do I need ip4: and ip6: mechanisms?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Only if you send email from servers not covered by an include: mechanism. Most email services provide include: directives that already cover their sending IPs.</p></details></div>
<h2>Related</h2><ul>
      <li><a href="/spf-record-checker/">SPF checker</a> (verify after publishing) · <a href="/spf-flattener/">flattener</a></li>
      <li><a href="/spf-record-syntax/">Full syntax reference</a></li>
    </ul></article>
  </div>
</BaseLayout>
<script>
  const boxes = [...document.querySelectorAll('#sg-services input')] as HTMLInputElement[];
  const ipIn = document.getElementById('sg-ip') as HTMLInputElement;
  const incIn = document.getElementById('sg-include') as HTMLInputElement;
  const allSel = document.getElementById('sg-all') as HTMLSelectElement;
  const out = document.getElementById('sg-out')!;
  const count = document.getElementById('sg-count')!;
  const copyBtn = document.getElementById('sg-copy') as HTMLButtonElement;
  function render() {
    const parts: string[] = [];
    let lookups = 0;
    for (const b of boxes) if (b.checked) { parts.push(b.value); if (/^(include|a$|mx$)/.test(b.value)) lookups++; }
    const ip = ipIn.value.trim();
    if (ip) parts.push(`ip4:${ip}`);
    const inc = incIn.value.trim().replace(/^include:/, '');
    if (inc) { parts.push(`include:${inc}`); lookups++; }
    out.textContent = `v=spf1 ${parts.join(' ')}${parts.length ? ' ' : ''}${allSel.value}`;
    count.textContent = lookups > 0 ? `${lookups} DNS lookups used (limit 10)${lookups > 8 ? ' - consider flattening' : ''}` : 'No DNS lookups: literal IPs only.';
    count.className = `mt-2 text-xs ${lookups > 8 ? 'text-warn' : 'text-ink-faint'}`;
  }
  [ipIn, incIn, allSel, ...boxes].forEach(el => el.addEventListener('input', render));
  render();
  copyBtn.addEventListener('click', async () => { await navigator.clipboard.writeText(out.textContent ?? ''); copyBtn.textContent = 'Copied!'; setTimeout(() => copyBtn.textContent = 'Copy', 1500); });
</script>
