---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TOTAL_TOOLS } from '../data/tools';

const planned = [
  {
    name: 'Free', price: '$0', period: 'forever', badge: 'Available today',
    desc: 'Every web tool, free forever.',
    features: [`All ${TOTAL_TOOLS} browser-side tools`, 'No account, no limits, no tracking of lookups', 'All guides and references', 'Email support'],
    cta: 'Use the tools', href: '/tools/', featured: false, live: true,
  },
  {
    name: 'Starter', price: '$19', period: '/month (planned)', badge: 'Coming soon',
    desc: 'For freelancers and small sites that need eyes on DNS.',
    features: ['3 domains monitored', 'DNS + email-auth change alerts', 'DMARC report monitoring', '90-day history', 'Blocklist, SSL and expiry checks'],
    cta: 'Join early access', href: '/early-access/', featured: false, live: false,
  },
  {
    name: 'Pro', price: '$49', period: '/month (planned)', badge: 'Coming soon',
    desc: 'For teams sending real email volume.',
    features: ['10 domains monitored', 'Hosted SPF / DMARC / MTA-STS', 'AI access monitoring', 'Slack/Teams/webhook alerts', '1-year history'],
    cta: 'Join early access', href: '/early-access/', featured: true, live: false,
  },
  {
    name: 'Business', price: '$99', period: '/month (planned)', badge: 'Coming soon',
    desc: 'For agencies managing client domains.',
    features: ['25 domains monitored', 'White-label PDF reports', 'API access', '5 team seats', 'Subdomain-takeover monitoring'],
    cta: 'Join early access', href: '/early-access/', featured: false, live: false,
  },
];

const faqs = [
  ['Are the tools really free forever?', `Yes. All ${TOTAL_TOOLS} tools are free with no account, no limits, and no trial timers. Paid plans will only ever add automation — monitoring, alerts, history, and reports. One-off checks will never be paywalled.`],
  ['Can I pay for a plan today?', 'No — paid plans are still in development. The prices on this page are the planned launch prices and may change. Join the early-access list to be first in and help shape the plans.'],
  ['What exactly is in development?', `Continuous DNS and email-authentication monitoring with change alerts, and DMARC aggregate report monitoring — see the <a href="/dmarc-monitoring/" class="text-accent">DMARC monitoring</a> and <a href="/dns-monitoring/" class="text-accent">DNS monitoring</a> pages for what each will do.`],
  ['How will billing work?', 'Payments will be processed by Paddle as our merchant of record: they handle global taxes, invoices, and card security. We never see or store card numbers.'],
  ['What is the refund policy?', 'When billing launches: full refund within 14 days of any first payment, no questions asked, and you can cancel anytime. Full details on the refund policy page.'],
  ['Do you offer managed services?', 'Done-for-you setup and enforcement services are planned alongside the paid plans. Contact us if you need help today and we will tell you honestly whether we can.'],
];
---

<BaseLayout
  title="Pricing"
  description="All PromptDNS tools are free forever, no account. Monitoring plans (from $19/mo planned) are in development — join early access for the first accounts."
>
  <div class="mx-auto max-w-6xl px-4 py-16 lg:px-8">
    <div class="text-center">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">Pricing</p>
      <h1 class="font-display mt-3 text-4xl font-bold tracking-tight text-ink sm:text-5xl">Free tools. Monitoring in the works.</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-ink-dim">
        Every checker and lookup is free forever, no account needed. Paid monitoring is in
        development — the plans below are what is planned, clearly marked. Nothing here is
        for sale yet.
      </p>
    </div>

    <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {planned.map((t) => (
        <div class:list={[
              'flex flex-col rounded-2xl border p-6 transition-all duration-300 hover:-translate-y-1',
              t.featured ? 'border-accent/50 bg-gradient-to-b from-accent/10 to-violet/10 shadow-[0_0_60px_-20px_rgba(34,211,238,0.4)]' : 'border-line bg-panel/60',
            ]}>
          <p class:list={[
                'mb-3 w-fit rounded-full border px-3 py-0.5 font-mono text-[10px] uppercase tracking-wider',
                t.live ? 'border-pass/40 bg-pass/10 text-pass' : 'border-warn/40 bg-warn/10 text-warn',
              ]}>{t.badge}</p>
          <h2 class="font-display text-lg font-bold text-ink">{t.name}</h2>
          <p class="mt-1 text-sm text-ink-dim">{t.desc}</p>
          <p class="mt-5"><span class="font-display text-4xl font-bold text-ink">{t.price}</span><span class="text-sm text-ink-faint">{t.period}</span></p>
          <ul class="mt-5 flex-1 space-y-2.5 text-sm text-ink-dim">
            {t.features.map((f) => (
              <li class="flex gap-2"><span class:list={[t.live ? 'text-pass' : 'text-ink-faint']}>{t.live ? '✔' : '◦'}</span>{f}</li>
            ))}
          </ul>
          <a href={t.href} class:list={[
                'mt-6 block rounded-lg py-2.5 text-center text-sm font-semibold transition-transform hover:scale-[1.02]',
                t.featured ? 'btn-cta btn-shimmer' : 'border border-line bg-panel-2 text-ink hover:border-accent/40',
              ]}>{t.cta}</a>
        </div>
      ))}
    </div>

    <p class="mt-6 text-center text-sm text-ink-faint">
      Planned prices, subject to change at launch · 14-day refund on first payments · taxes handled by Paddle, our merchant of record.
    </p>

    <!-- What exists vs what's coming -->
    <div class="mt-16 grid gap-5 md:grid-cols-2">
      <div class="rounded-2xl border border-pass/30 bg-pass/5 p-6">
        <h2 class="font-display text-lg font-bold text-ink">Available today</h2>
        <ul class="mt-4 space-y-2 text-sm text-ink-dim">
          <li class="flex gap-2"><span class="text-pass">✔</span>All {TOTAL_TOOLS} tools — checkers, lookups, generators, analyzers</li>
          <li class="flex gap-2"><span class="text-pass">✔</span>240+ guides: record types, ESP setups, provider playbooks, security</li>
          <li class="flex gap-2"><span class="text-pass">✔</span>Everything client-side: no account, lookups not stored</li>
        </ul>
        <a href="/tools/" class="mt-5 inline-block font-mono text-xs text-accent hover:text-accent-soft">Browse the tools →</a>
      </div>
      <div class="rounded-2xl border border-warn/30 bg-warn/5 p-6">
        <h2 class="font-display text-lg font-bold text-ink">In development</h2>
        <ul class="mt-4 space-y-2 text-sm text-ink-dim">
          <li class="flex gap-2"><span class="text-warn">▲</span><a href="/dns-monitoring/" class="text-accent hover:text-accent-soft">DNS monitoring</a> — change alerts with diffs, drift, expiry warnings</li>
          <li class="flex gap-2"><span class="text-warn">▲</span><a href="/dmarc-monitoring/" class="text-accent hover:text-accent-soft">DMARC monitoring</a> — who sends email as your domain, path to p=reject</li>
          <li class="flex gap-2"><span class="text-warn">▲</span>AI access monitoring — alerted if AI crawlers get blocked</li>
          <li class="flex gap-2"><span class="text-warn">▲</span>Hosted SPF/DMARC and agency features, after launch</li>
        </ul>
        <a href="/early-access/" class="mt-5 inline-block font-mono text-xs text-accent hover:text-accent-soft">Join early access →</a>
      </div>
    </div>

    <!-- FAQ -->
    <div class="mx-auto mt-20 max-w-3xl">
      <h2 class="text-center font-display text-2xl font-bold tracking-tight text-ink">Pricing questions</h2>
      <div class="mt-8 grid gap-3">
        {faqs.map(([q, a]) => (
          <details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">
              {q}
              <span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-ink-dim" set:html={a} />
          </details>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
