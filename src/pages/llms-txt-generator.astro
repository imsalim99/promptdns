---
import BaseLayout from '../layouts/BaseLayout.astro';
import Diagram from '../components/Diagram.astro';
import ToolPanel from '../components/ToolPanel.astro';

const faqSchema = {
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
  {
   "@type": "Question",
   "name": "Is the llms.txt Generator really free?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Yes: every tool on PromptDNS is free forever, with no account, no limits, and no trial timers. The llms.txt generation runs entirely in your browser."
   }
  },
  {
   "@type": "Question",
   "name": "How accurate are the results?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "The llms.txt generation queries public DNS-over-HTTPS resolvers (Cloudflare, Google, Quad9) in real time. Results reflect what those resolvers actually serve, which is the same data the wider internet receives."
   }
  },
  {
   "@type": "Question",
   "name": "Do you store the domains I look up?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "No. Lookups happen client-side in your browser. Domains are not sent to our servers, stored, or logged. See the privacy policy for details."
   }
  },
  {
   "@type": "Question",
   "name": "Can I use this tool for client work?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Yes: the tools are free for commercial use. Agencies on the Business plan can also generate white-label automated reports."
   }
  },
  {
   "@type": "Question",
   "name": "How often should I run this check?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "After any DNS or infrastructure change, and periodically (weekly or monthly) as part of routine health monitoring. The paid plans automate this."
   }
  },
  {
   "@type": "Question",
   "name": "What if the results look wrong?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Compare with a second tool or dig from a terminal. If results differ between tools, one may be showing a cached answer: the propagation checker reveals which resolvers disagree."
   }
  }
 ]
}
---
<BaseLayout
  title="llms.txt Generator, Free, Instant"
  description="Generate an llms.txt file for your website: the markdown summary that helps AI assistants and agents understand and cite your content."
  schema={[faqSchema]}
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a>
       <span aria-hidden="true">/</span>
      <a href="/tools/" class="hover:text-accent">Tools</a>
       <span aria-hidden="true">/</span>
      <span class="text-ink-dim">llms.txt Generator</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">llms.txt Generator</h1>
    <p class="mt-4 text-lg text-ink-dim">Build a valid <code class="font-mono text-accent-soft">llms.txt</code> for your site, the markdown file that tells language models what your content is and where the important pages live.</p>

    <ToolPanel>
      <form id="llm-form" class="grid gap-4">
        <div class="grid gap-3 sm:grid-cols-2">
          <div>
            <label for="llm-url" class="mb-1 block text-xs text-ink-faint">Site URL</label>
            <input id="llm-url" type="text" placeholder="https://example.com" autocomplete="off" spellcheck="false"
              class="w-full rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none" />
          </div>
          <div class="flex items-end">
            <button type="button" id="llm-fetch" class="w-full rounded-md border border-line bg-panel-2 px-4 py-2.5 text-sm font-medium text-ink hover:border-accent/40">Try to fetch title &amp; description</button>
          </div>
        </div>
        <div>
          <label for="llm-name" class="mb-1 block text-xs text-ink-faint">Site name (H1)</label>
          <input id="llm-name" type="text" placeholder="Example Co."
            class="w-full rounded-md border border-line bg-transparent px-3 py-2.5 text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none" />
        </div>
        <div>
          <label for="llm-summary" class="mb-1 block text-xs text-ink-faint">One-sentence summary (blockquote)</label>
          <textarea id="llm-summary" rows="2" placeholder="What your site is and who it serves."
            class="w-full rounded-md border border-line bg-transparent px-3 py-2.5 text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none"></textarea>
        </div>
        <div>
          <label for="llm-links" class="mb-1 block text-xs text-ink-faint">Links, one per line: <span class="font-mono">URL | Title | optional description</span></label>
          <textarea id="llm-links" rows="6" placeholder="https://example.com/pricing | Pricing | Plans and free tier&#10;https://example.com/docs | Documentation | API reference and guides"
            class="w-full rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none"></textarea>
        </div>
      </form>

      <div id="llm-status" class="mt-4 hidden rounded-md px-4 py-3 text-sm font-medium"></div>

      <div class="mt-6">
        <div class="flex items-center justify-between">
          <p class="text-sm font-semibold text-ink">Your llms.txt</p>
          <div class="flex gap-2">
            <button id="llm-copy" class="rounded-md border border-line bg-panel-2 px-3 py-1.5 text-xs font-medium text-ink hover:border-accent/40">Copy</button>
            <button id="llm-download" class="rounded-md border border-line bg-panel-2 px-3 py-1.5 text-xs font-medium text-ink hover:border-accent/40">Download</button>
          </div>
        </div>
        <pre id="llm-out" class="mt-2 max-h-96 overflow-auto rounded-lg border border-line bg-panel-2 p-4 font-mono text-xs leading-relaxed text-accent-soft"></pre>
        <p class="mt-2 text-xs text-ink-faint">Publish at <span class="font-mono">https://yourdomain.com/llms.txt</span>, plain text, no headers required.</p>
      </div>
    </ToolPanel>

    <article class="rich-text mt-14 max-w-none">
      <h2>What llms.txt is</h2>
      <p>llms.txt is a proposed standard (llmstxt.org): a markdown file at your root that gives language models a curated map of your site, name, summary, and links with descriptions. Unlike robots.txt (which restricts), llms.txt <em>explains</em>. It complements your sitemap the way an abstract complements a paper.</p>
      
      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Frequently asked questions</h2>
      <div class="mt-3 grid gap-3"><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Is the llms.txt Generator really free?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Yes: every tool on PromptDNS is free forever, with no account, no limits, and no trial timers. The llms.txt generation runs entirely in your browser.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">How accurate are the results?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">The llms.txt generation queries public DNS-over-HTTPS resolvers (Cloudflare, Google, Quad9) in real time. Results reflect what those resolvers actually serve, which is the same data the wider internet receives.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Do you store the domains I look up?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">No. Lookups happen client-side in your browser. Domains are not sent to our servers, stored, or logged. See the privacy policy for details.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Can I use this tool for client work?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Yes: the tools are free for commercial use. Agencies on the Business plan can also generate white-label automated reports.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">How often should I run this check?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">After any DNS or infrastructure change, and periodically (weekly or monthly) as part of routine health monitoring. The paid plans automate this.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">What if the results look wrong?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Compare with a second tool or dig from a terminal. If results differ between tools, one may be showing a cached answer: the propagation checker reveals which resolvers disagree.</p></details></div>

      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Output format</h2>
      <div class="mt-3 overflow-x-auto rounded-xl border border-line bg-panel/60">
        <table class="pdns-table"><tbody><tr><td class="text-sm font-medium text-ink">H1</td><td class="text-sm text-ink-dim">Site name (required, first line)</td></tr><tr><td class="text-sm font-medium text-ink">Blockquote</td><td class="text-sm text-ink-dim">One-sentence summary</td></tr><tr><td class="text-sm font-medium text-ink">Sections</td><td class="text-sm text-ink-dim">H2 headings grouping related links</td></tr></tbody></table>
    </div>


    <div id="post-tool-cta" class="hidden mt-8 rounded-xl border border-accent/25 bg-gradient-to-br from-accent/10 to-violet/10 p-6 not-prose">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h3 class="font-display font-bold text-ink text-base">Found issues?</h3>
          <p class="mt-1 text-sm text-ink-dim">Get a full prioritized report, or let our experts fix everything for you.</p>
        </div>
        <div class="flex gap-3 flex-wrap">
          <a href="/pricing/" class="rounded-lg border border-line bg-panel px-4 py-2.5 text-sm font-medium text-ink hover:border-accent/40 transition">Get Full Report — $9</a>
          <a href="/pricing/" class="btn-cta btn-shimmer px-5 py-2.5 text-sm">Fix My Domain</a>
        </div>
      </div>
    </div>

    // Show CTA when tool results appear
    (function() {
      var targets = document.querySelectorAll('[id$="-status"], [id$="-results"], [id$="-output"], [id$="-tbody"], [id$="-cards"]');
      if (!targets.length) return;
      var obs = new MutationObserver(function(mutations) {
        for (var m of mutations) {
          var el = m.target;
          if (el && !el.classList.contains('hidden') && el.innerHTML.trim().length > 20) {
            var cta = document.getElementById('post-tool-cta');
            if (cta) cta.classList.remove('hidden');
            obs.disconnect();
            return;
          }
        }
      });
      targets.forEach(function(el) {
        obs.observe(el, { attributes: true, childList: true, subtree: true });
      });
    })();

    </div>

      <h2>Related</h2>
      <ul>
        <li><a href="/what-is-llms-txt/">What is llms.txt?</a> (full guide)</li>
        <li><a href="/ai-crawler-checker/">AI Crawler Checker</a>, control access</li>
        <li><a href="/llms-txt-syntax/">llms.txt syntax rules</a></li>
      </ul>
    </article>
  </div>
</BaseLayout>

<script>
  import { buildLlmsTxt } from '../lib/robots';
  import { fetchText, normalizeSite } from '../lib/proxy';

  const urlIn = document.getElementById('llm-url') as HTMLInputElement;
  const nameIn = document.getElementById('llm-name') as HTMLInputElement;
  const summaryIn = document.getElementById('llm-summary') as HTMLTextAreaElement;
  const linksIn = document.getElementById('llm-links') as HTMLTextAreaElement;
  const fetchBtn = document.getElementById('llm-fetch') as HTMLButtonElement;
  const statusEl = document.getElementById('llm-status')!;
  const out = document.getElementById('llm-out')!;
  const copyBtn = document.getElementById('llm-copy') as HTMLButtonElement;
  const dlBtn = document.getElementById('llm-download') as HTMLButtonElement;

  const setStatus = (cls: string, text: string) => {
    statusEl.className = `mt-4 rounded-md px-4 py-3 text-sm font-medium ${cls}`;
    statusEl.textContent = text;
  };

  function render() {
    const links = linksIn.value.split(/\r?\n/).map((l) => l.trim()).filter(Boolean).map((line) => {
      const [url, title, desc] = line.split('|').map((s) => s.trim());
      return { url: url ?? '', title: title ?? url ?? '', desc };
    });
    const headings: string[] = [];
    const sections = links.length ? [{ heading: 'Links', links }] : [];
    out.textContent = buildLlmsTxt({
      siteName: nameIn.value.trim() || urlIn.value.trim() || 'Your Site',
      url: normalizeSite(urlIn.value || 'https://example.com'),
      summary: summaryIn.value.trim() || 'Add a one-sentence summary of this site.',
      sections,
    });
  }
  [urlIn, nameIn, summaryIn, linksIn].forEach((el) => el.addEventListener('input', render));
  render();

  fetchBtn.addEventListener('click', async () => {
    const url = normalizeSite(urlIn.value);
    if (!url.includes('.')) { setStatus('bg-fail/10 text-fail border border-fail/30', 'Enter your site URL first.'); return; }
    setStatus('bg-panel-2 text-accent border border-line', 'Fetching page metadata…');
    const res = await fetchText(url);
    if (!res.ok) { setStatus('bg-warn/10 text-warn border border-warn/30', 'Could not fetch that page, fill the fields manually.'); return; }
    const doc = new DOMParser().parseFromString(res.text, 'text/html');
    const title = doc.querySelector('title')?.textContent?.trim();
    const desc = doc.querySelector('meta[name="description"]')?.getAttribute('content')?.trim();
    if (title && !nameIn.value) nameIn.value = title;
    if (desc && !summaryIn.value) summaryIn.value = desc;
    render();
    setStatus('bg-pass/10 text-pass border border-pass/30', title ? `Found: “${title}”` : 'Page fetched, fill the fields manually.');
  });

  copyBtn.addEventListener('click', async () => {
    await navigator.clipboard.writeText(out.textContent ?? '');
    copyBtn.textContent = 'Copied!';
    setTimeout(() => (copyBtn.textContent = 'Copy'), 1500);
  });
  dlBtn.addEventListener('click', () => {
    const blob = new Blob([out.textContent ?? ''], { type: 'text/plain' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'llms.txt';
    a.click();
    URL.revokeObjectURL(a.href);
  });
</script>
