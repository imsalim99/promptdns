---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolArticle from '../components/ToolArticle.astro';
import ToolPanel from '../components/ToolPanel.astro';
import ResultCard from '../components/ResultCard.astro';
---
<BaseLayout
  title="DNS Response Time Test, Cold vs Cached Resolution"
  description="Free DNS response time test: measure how fast resolvers resolve your domain from scratch (cold lookup) versus from cache, to diagnose slow authoritative nameservers."
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a>
       <span aria-hidden="true">/</span>
      <a href="/tools/" class="hover:text-accent">Tools</a>
       <span aria-hidden="true">/</span>
      <span class="text-ink-dim">DNS Response Time Test</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">DNS Response Time Test</h1>
    <p class="mt-4 text-lg text-ink-dim">Free DNS response time test: measure cold vs cached resolution to diagnose slow authoritative DNS.</p>

    <ToolPanel>
      <form id="st-form" class="flex flex-col gap-3 sm:flex-row">
        <label class="sr-only" for="st-domain">Test domain</label>
        <input id="st-domain" type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder="yourdomain.com"
          class="flex-1 rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30" />
        <button type="submit" class="btn-cta btn-shimmer px-6 py-2.5 text-sm">Run Cold Lookup Test</button>
      </form>

      <div id="st-status" class="mt-4 hidden rounded-md px-4 py-3 text-sm font-medium"></div>

      <div id="st-results" class="mt-6 hidden overflow-x-auto rounded-lg border border-line/60">
        <table class="pdns-table">
          <thead><tr><th>Resolver</th><th>Cached lookup</th><th>Fresh lookup (cold)</th><th>Difference</th></tr></thead>
          <tbody id="st-tbody"></tbody>
        </table>
      </div>

      <div id="st-scope" class="mt-4 hidden rounded-lg border border-line bg-panel/40 px-4 py-3">
        <p class="text-xs leading-relaxed text-ink-faint">
          <strong class="text-ink-dim">Scope:</strong> cold lookups query a never-seen hostname (a random prefix under your domain), so the resolver cannot answer from cache and must recurse. Unless your domain publishes a wildcard record, cold lookups return NXDOMAIN - that is expected and does not affect the timing, which is the measurement. Single runs are noisy; run the test a few times. To compare <em>resolvers</em> against each other for speed instead, use the <a href="/dns-speed-test/" class="text-accent">DNS Speed Test</a>.
        </p>
      </div>

      <ResultCard tool="dns-response-time-test" />
    </ToolPanel>

    <ToolArticle slug="dns-response-time-test" />
    </div>
</BaseLayout>

<script>
  import { lookup, RESOLVERS, normalizeDomain, type Resolver } from '../lib/doh';
  import type { PdnsResult, PdnsFinding, Severity } from '../data/findings';

  const WARM_RUNS = 2;
  const COLD_RUNS = 3;

  const TOOL = 'dns-response-time-test';
  const emit = (verdict: Severity, verdictLine: string, findings: PdnsFinding[], domain: string) => {
    const detail: PdnsResult = {
      tool: TOOL, domain, verdict, verdictLine, findings,
      ctaLabel: 'Know when DNS gets slow',
      related: [
        { label: 'DNS Speed Test', href: '/dns-speed-test/' },
        { label: 'Propagation checker', href: '/dns-propagation-checker/' },
        { label: 'DNS providers hub', href: '/dns-providers/' },
      ],
    };
    window.dispatchEvent(new CustomEvent('pdns:result', { detail }));
  };

  const form = document.getElementById('st-form') as HTMLFormElement;
  const input = document.getElementById('st-domain') as HTMLInputElement;
  const statusEl = document.getElementById('st-status')!;
  const resultsEl = document.getElementById('st-results')!;
  const tbody = document.getElementById('st-tbody')!;
  const scopeEl = document.getElementById('st-scope')!;

  const setStatus = (cls: string, text: string) => {
    statusEl.className = `mt-4 rounded-md px-4 py-3 text-sm font-medium ${cls}`;
    statusEl.textContent = text;
  };

  const randLabel = () => `cold-${Math.random().toString(36).slice(2, 8)}`;

  async function timedAvg(name: string, resolver: Resolver, runs: number): Promise<number> {
    const times: number[] = [];
    for (let i = 0; i < runs; i++) {
      const res = await lookup(name, 'A', resolver);
      times.push(res.ms);
    }
    return Math.round(times.reduce((s, t) => s + t, 0) / times.length);
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const domain = normalizeDomain(input.value);
    if (!domain.includes('.')) {
      setStatus('bg-fail/10 text-fail border border-fail/30', 'Enter a valid domain, e.g. yourdomain.com');
      return;
    }
    const btn = form.querySelector('button') as HTMLButtonElement;
    btn.disabled = true;
    tbody.innerHTML = '';
    [resultsEl, scopeEl].forEach((el) => el.classList.add('hidden'));
    window.dispatchEvent(new CustomEvent('pdns:clear', { detail: { tool: TOOL } }));

    const rows: { name: string; warm: number; cold: number }[] = [];
    try {
      for (const resolver of RESOLVERS) {
        setStatus('bg-panel-2 text-accent border border-line', `Testing ${resolver.name}: 2 cached + 3 fresh lookups…`);
        const warm = await timedAvg(domain, resolver, WARM_RUNS);
        const cold = await timedAvg(`${randLabel()}.${domain}`, resolver, COLD_RUNS);
        rows.push({ name: resolver.name, warm, cold });
      }
    } catch {
      setStatus('bg-warn/10 text-warn border border-warn/30',
        `Could not reach a resolver while testing ${domain}. This is an inconclusive result - check your connection and retry.`);
      emit('info', 'DNS query did not complete. Nothing is known about this domain\u2019s resolution time.', [{ code: 'DNS_QUERY_FAILED' }], domain);
      btn.disabled = false;
      return;
    }

    const coldAvg = Math.round(rows.reduce((s, r) => s + r.cold, 0) / rows.length);
    const warmAvg = Math.round(rows.reduce((s, r) => s + r.warm, 0) / rows.length);

    for (const r of rows) {
      const tr = document.createElement('tr');
      const tdName = document.createElement('td');
      tdName.className = 'font-medium text-ink';
      tdName.textContent = r.name;
      tr.appendChild(tdName);
      const tdWarm = document.createElement('td');
      tdWarm.className = 'font-mono text-xs text-ink-dim';
      tdWarm.textContent = `${r.warm} ms`;
      tr.appendChild(tdWarm);
      const tdCold = document.createElement('td');
      tdCold.className = 'font-mono text-xs font-semibold ' + (r.cold > 300 ? 'text-warn' : 'text-accent');
      tdCold.textContent = `${r.cold} ms`;
      tr.appendChild(tdCold);
      const tdDiff = document.createElement('td');
      tdDiff.className = 'font-mono text-xs text-ink-dim';
      tdDiff.textContent = `${Math.max(0, r.cold - r.warm)} ms slower cold`;
      tr.appendChild(tdDiff);
      tbody.appendChild(tr);
    }
    resultsEl.classList.remove('hidden');
    scopeEl.classList.remove('hidden');

    if (coldAvg > 300) {
      setStatus('bg-warn/10 text-warn border border-warn/30',
        `Fresh lookups average ${coldAvg} ms (cached: ${warmAvg} ms). That is slower than the 50-200 ms typical for well-placed authoritative DNS.`);
      emit('warn', `Cold resolution averages ${coldAvg} ms across resolvers; cached lookups average ${warmAvg} ms.`,
        [{ code: 'COLD_SLOW', detail: `Cold avg ${coldAvg} ms, cached avg ${warmAvg} ms across ${rows.length} resolvers` }], domain);
    } else {
      setStatus('bg-pass/10 text-pass border border-pass/30',
        `Fresh lookups average ${coldAvg} ms (cached: ${warmAvg} ms). Within the typical range for well-placed authoritative DNS.`);
      emit('pass', `Cold resolution averages ${coldAvg} ms across resolvers; cached lookups average ${warmAvg} ms.`,
        [{ code: 'COLD_FAST', detail: `Cold avg ${coldAvg} ms, cached avg ${warmAvg} ms across ${rows.length} resolvers` }], domain);
    }
    btn.disabled = false;
  });
</script>
