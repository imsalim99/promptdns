---
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {'@type': 'Question', 'name': "What is the difference between SPF and DKIM?", "acceptedAnswer": { '@type': 'Answer', "text": "SPF authorizes the sending IP via the envelope; DKIM signs the message content cryptographically. DMARC ties both to the visible From domain." } },
    {'@type': 'Question', 'name': "Does SPF cover my website?", "acceptedAnswer": { '@type': 'Answer', "text": "No. SPF covers email only. Website protection is DNS, TLS, and your hosting stack." } },
    {'@type': 'Question', 'name': "How many SPF records can I have?", "acceptedAnswer": { '@type': 'Answer', "text": "Exactly one per name. Two v=spf1 records on the same domain is a permerror and receivers stop evaluating." } }
  ],
};
import BaseLayout from '../layouts/BaseLayout.astro';
import Diagram from '../components/Diagram.astro';

