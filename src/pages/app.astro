---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Dashboard"
  description="Your PromptDNS dashboard: monitored domains, alerts, and DMARC sources."
  noindex
  chrome={false}
>
  <div id="dash-app">
    <div id="dash-loading" class="pd-loading">Checking sign-in…</div>

    <div id="dash-signed-out" class="pd-signedout" hidden>
      <h1>You are not signed in</h1>
      <p>Sign in with an email link to open your dashboard.</p>
      <a href="/login/" class="pd-btn pd-btn-primary">Go to sign in</a>
    </div>

    <div id="dash-shell" class="pd-shell" hidden>
      <aside class="pd-sidebar">
        <a href="/" class="pd-logo" title="Back to promptdns.com"><span>Prompt</span><span class="pd-logo-accent">DNS</span></a>
        <nav class="pd-nav" aria-label="Dashboard">
          <button type="button" class="pd-nav-item" data-screen="overview"><i data-lucide="layout-dashboard" aria-hidden="true"></i>Overview</button>
          <button type="button" class="pd-nav-item" data-screen="domains"><i data-lucide="globe" aria-hidden="true"></i>Domains</button>
          <button type="button" class="pd-nav-item" data-screen="dmarc"><i data-lucide="mail-check" aria-hidden="true"></i>Email (DMARC)</button>
          <button type="button" class="pd-nav-item" data-screen="alerts"><i data-lucide="bell" aria-hidden="true"></i>Alerts<span class="pd-nav-badge" id="nav-alert-count" hidden>0</span></button>
          <button type="button" class="pd-nav-item is-planned" disabled title="Ships after launch"><i data-lucide="file-bar-chart" aria-hidden="true"></i>Reports<span class="pd-planned-chip">planned</span></button>
          <button type="button" class="pd-nav-item is-planned" disabled title="Ships after launch"><i data-lucide="bot" aria-hidden="true"></i>AI Access<span class="pd-planned-chip">planned</span></button>
          <div class="pd-nav-sep" aria-hidden="true"></div>
          <a href="/tools/" class="pd-nav-item"><i data-lucide="wrench" aria-hidden="true"></i>All tools</a>
          <a href="/dns/" class="pd-nav-item"><i data-lucide="book-open" aria-hidden="true"></i>Guides</a>
          <div class="pd-nav-sep" aria-hidden="true"></div>
          <button type="button" class="pd-nav-item" data-screen="settings"><i data-lucide="settings" aria-hidden="true"></i>Settings</button>
        </nav>
        <div class="pd-sidebar-foot">
          <div class="pd-plan-card">
            <p class="pd-plan-name">Early access</p>
            <p class="pd-plan-desc">Free during development.</p>
          </div>
          <div class="pd-user-wrap">
            <button type="button" class="pd-user" id="nav-user-btn" aria-expanded="false">
              <span class="pd-avatar" aria-hidden="true">S</span>
              <div><p class="pd-user-mail" id="nav-user-mail"></p><p class="pd-user-role">Owner</p></div>
            </button>
            <div id="nav-user-menu" class="pd-user-menu" hidden>
              <button type="button" class="pd-menu-item" data-menu-goto="settings">Settings</button>
              <button type="button" class="pd-menu-item" data-menu-goto="settings" data-menu-scroll="billing-panel">Billing</button>
              <a href="/" class="pd-menu-item">Open website</a>
              <a href="/tools/" class="pd-menu-item">All tools</a>
              <button type="button" id="nav-signout" class="pd-menu-item pd-menu-signout">Sign out</button>
            </div>
          </div>
        </div>
      </aside>

      <main class="pd-main">
        <header class="pd-topbar">
          <div>
            <h1 class="pd-page-title" id="page-title">Overview</h1>
            <p class="pd-page-sub" id="page-sub"></p>
          </div>
          <button type="button" class="pd-btn pd-btn-primary" id="topbar-add"><i data-lucide="plus" aria-hidden="true"></i>Add domain</button>
        </header>

        <div id="pd-toast" class="pd-toast" role="status" aria-live="polite"></div>

        <!-- ============ OVERVIEW ============ -->
        <section class="pd-screen" id="screen-overview" hidden>
          <div class="pd-hero-head">
            <div>
              <p class="font-mono text-xs uppercase tracking-widest" style="color:var(--pd-ink-faint)">Your domains</p>
              <h2 class="pd-hero-heading">Live security scores, checked every 6 hours</h2>
            </div>
            <button type="button" class="pd-btn pd-btn-primary" id="ov-add"><i data-lucide="plus" aria-hidden="true"></i>Add domain</button>
          </div>
          <div id="ov-hero" class="pd-hero-grid"></div>

          <div id="ov-activity" class="pd-panel" hidden></div>

          <div class="pd-stat-grid">
            <div class="pd-stat"><p class="pd-stat-label">Open alerts</p><p class="pd-stat-value" id="ov-alerts">-</p><p class="pd-stat-note">unread, newest first on Alerts</p></div>
            <div class="pd-stat"><p class="pd-stat-label">DMARC pass rate</p><p class="pd-stat-value" id="ov-passrate">-</p><p class="pd-stat-note" id="ov-passrate-note">across your domains</p></div>
            <div class="pd-stat"><p class="pd-stat-label">Domains</p><p class="pd-stat-value" id="ov-domains">-</p><p class="pd-stat-note" id="ov-domains-note"></p></div>
          </div>

          <div class="pd-grid-2">
            <div class="pd-panel">
              <div class="pd-panel-head"><h2>Next step</h2></div>
              <div id="ov-action"></div>
            </div>
            <div class="pd-panel">
              <div class="pd-panel-head"><h2>Latest check results</h2><button type="button" class="pd-link" data-goto="domains">All domains →</button></div>
              <div id="ov-health" class="pd-health-list"></div>
            </div>
          </div>

          <div class="pd-panel" id="ov-chart-panel" hidden>
            <div class="pd-panel-head"><h2>DMARC volume</h2><span class="pd-legend"><span class="pd-legend-dot pd-dot-pass"></span>passing <span class="pd-legend-dot pd-dot-fail"></span>failing</span></div>
            <svg class="pd-chart" id="ov-chart" viewBox="0 0 640 150" role="img" aria-label="Daily DMARC message volume, passing versus failing"><g class="pd-chart-bars"></g></svg>
          </div>
        </section>

        <!-- ============ DOMAINS ============ -->
        <section class="pd-screen" id="screen-domains" hidden>
          <div class="pd-panel" id="add-panel" hidden>
            <div class="pd-panel-head"><h2>Add a domain</h2><button type="button" class="pd-link" id="add-close">Close</button></div>
            <form id="dom-form" class="pd-add-row">
              <label class="sr-only" for="dom-input">Domain</label>
              <input id="dom-input" type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder="yourdomain.com" class="pd-input" />
              <button type="submit" id="dom-submit" class="pd-btn pd-btn-primary">Add &amp; scan</button>
            </form>
            <p class="pd-panel-note">Adding runs an instant scan. Up to <span id="dom-max" class="pd-mono">3</span> domains while monitoring is in development.</p>
          </div>

          <div class="pd-panel">
            <div class="pd-panel-head"><h2>Your domains</h2></div>
            <div id="dom-list"></div>
            <p class="pd-panel-note">Every domain is re-checked every 6 hours. Pause a domain from its detail view.</p>
          </div>
        </section>

        <!-- ============ DOMAIN DETAIL ============ -->
        <section class="pd-screen" id="screen-domain" hidden>
          <div id="domain-head"></div>
          <div class="pd-tabs" role="tablist" aria-label="Domain sections">
            <button type="button" class="pd-tab is-active" data-tab="auth" aria-selected="true">Authentication</button>
            <button type="button" class="pd-tab" data-tab="records" aria-selected="false">Records</button>
            <button type="button" class="pd-tab" data-tab="activity" aria-selected="false">Activity</button>
          </div>
          <div class="pd-tabpanel" id="tab-auth"></div>
          <div class="pd-tabpanel" id="tab-records" hidden></div>
          <div class="pd-tabpanel" id="tab-activity" hidden></div>
        </section>

        <!-- ============ DMARC ============ -->
        <section class="pd-screen" id="screen-dmarc" hidden>
          <div class="pd-domain-picker">
            <label class="pd-picker-label" for="dmarc-domain">Domain</label>
            <select id="dmarc-domain" class="pd-select"></select>
          </div>
          <div id="dmarc-content"></div>
        </section>

        <!-- ============ ALERTS ============ -->
        <section class="pd-screen" id="screen-alerts" hidden>
          <div class="pd-panel">
            <div class="pd-panel-head"><h2>Alerts</h2><button type="button" class="pd-btn pd-btn-sm" id="alerts-read">Mark all read</button></div>
            <div id="alerts-list" class="pd-alert-list"></div>
            <p class="pd-panel-note">New alerts are also emailed to your account address. This inbox always works, even without email.</p>
          </div>
        </section>

        <!-- ============ SETTINGS ============ -->
        <section class="pd-screen" id="screen-settings" hidden>
          <div class="pd-grid-2">
            <div class="pd-panel">
              <div class="pd-panel-head"><h2>Appearance</h2></div>
              <div class="pd-form-row">
                <span class="pd-form-label">Dashboard theme</span>
                <span style="display:flex;gap:8px">
                  <button type="button" class="pd-btn pd-btn-xs" data-theme-set="dark" aria-pressed="true">Dark</button>
                  <button type="button" class="pd-btn pd-btn-xs" data-theme-set="light" aria-pressed="false">Light</button>
                </span>
              </div>
            </div>
            <div class="pd-panel">
              <div class="pd-panel-head"><h2>Account</h2></div>
              <div class="pd-form-row"><span class="pd-form-label">Email</span><span class="pd-mono" id="set-email"></span></div>
              <div class="pd-form-row"><span class="pd-form-label">Plan</span><span>Early access (free) <span class="pd-planned-chip">paid plans at launch</span></span></div>
              <div class="pd-form-row"><span class="pd-form-label">Sign-in</span><span>Email link, no password</span></div>
            </div>
            <div class="pd-panel">
              <div class="pd-panel-head"><h2>Notifications</h2></div>
              <div class="pd-toggle-row"><span>Email alerts (when delivery is configured)</span><span class="pd-planned-chip">soon</span></div>
              <div class="pd-toggle-row pd-is-planned"><span>Slack / Teams webhooks</span><span class="pd-planned-chip">planned</span></div>
              <div class="pd-toggle-row pd-is-planned"><span>Weekly summary</span><span class="pd-planned-chip">planned</span></div>
            </div>
            <div class="pd-panel" id="billing-panel">
              <div class="pd-panel-head"><h2>Billing</h2><span class="pd-planned-chip">at launch</span></div>
              <p class="pd-panel-note">Paid plans start when monitoring launches - processed by Dodo Payments, our merchant of record. Early-access members keep the launch free tier.</p>
            </div>
            <div class="pd-panel">
              <div class="pd-panel-head"><h2>Danger zone</h2></div>
              <div class="pd-form-row"><span class="pd-form-label">Remove a domain</span><span class="pd-form-label">From its detail view → Remove</span></div>
              <div class="pd-form-row"><span class="pd-form-label">Delete account</span><span class="pd-form-label">Contact support@promptdns.com</span></div>
            </div>
          </div>
        </section>
      </main>
    </div>
  </div>

  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.469.0/dist/umd/lucide.min.js"></script>
  <style is:global>

    #dash-app {
      --pd-bg: #050810;
      --pd-panel: #0b1222;
      --pd-panel-2: #0d1526;
      --pd-line: #1c2a47;
      --pd-ink: #e6edf7;
      --pd-ink-dim: #94a3b8;
      --pd-ink-faint: #64748b;
      --pd-accent: #22d3ee;
      --pd-violet: #8b5cf6;
      --pd-pass: #4ade80;
      --pd-warn: #fbbf24;
      --pd-fail: #f87171;
      --pd-font-display: 'Space Grotesk', 'Segoe UI', sans-serif;
      --pd-font-body: 'Inter', 'Segoe UI', sans-serif;
      --pd-font-mono: 'JetBrains Mono', Consolas, monospace;
      --pd-sidebar-grad: linear-gradient(180deg, #0a0f1e, #070c18);
      --pd-on-accent: #04121a;
      font-family: var(--pd-font-body);
      color: var(--pd-ink);
      background: var(--pd-bg);
      font-size: 14px;
      line-height: 1.5;
    }
    #dash-app[data-theme='light'] {
      --pd-bg: #f5f7fb;
      --pd-panel: #ffffff;
      --pd-panel-2: #eef2f9;
      --pd-line: #d9e1ee;
      --pd-ink: #101828;
      --pd-ink-dim: #4a5568;
      --pd-ink-faint: #8792a3;
      --pd-accent: #0e7490;
      --pd-violet: #6d28d9;
      --pd-pass: #15803d;
      --pd-warn: #b45309;
      --pd-fail: #b91c1c;
      --pd-sidebar-grad: linear-gradient(180deg, #ffffff, #f5f7fb);
      --pd-on-accent: #ffffff;
    }
    #dash-app *, #dash-app *::before, #dash-app *::after { box-sizing: border-box; }
    #dash-app h1, #dash-app h2, #dash-app h3 { font-family: var(--pd-font-display); font-weight: 600; }
    #dash-app button { cursor: pointer; }
    #dash-app .pd-mono { font-family: var(--pd-font-mono); font-size: 12px; }
    #dash-app .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    #dash-app a.pd-link { text-decoration: none; }

    .pd-loading, .pd-signedout { text-align: center; padding: 80px 20px; color: var(--pd-ink-dim); }
    .pd-signedout h1 { font-size: 24px; color: var(--pd-ink); margin-bottom: 8px; }
    .pd-signedout .pd-btn { margin-top: 16px; display: inline-flex; }

    .pd-shell { display: flex; min-height: 100vh; }
    .pd-sidebar { width: 212px; flex-shrink: 0; border-right: 1px solid var(--pd-line); background: var(--pd-sidebar-grad); display: flex; flex-direction: column; padding: 16px 12px; }
    .pd-logo { font-family: var(--pd-font-display); font-weight: 700; font-size: 17px; padding: 2px 8px 14px; color: var(--pd-ink); text-decoration: none; }
    .pd-hero-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px; }
    .pd-hero-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    .pd-hero-heading { font-size: 15px; margin-top: 2px; }
    .pd-roadmap { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    @media (max-width: 760px) { .pd-roadmap { grid-template-columns: 1fr; } }
    .pd-roadmap-step { border: 1px solid var(--pd-line); border-radius: 10px; padding: 12px 14px; }
    .pd-roadmap-step.is-current { border-color: rgba(34,211,238,.5); background: rgba(34,211,238,.05); }
    .pd-roadmap-step.is-done { border-color: rgba(74,222,128,.4); }
    .pd-roadmap-name { font-family: var(--pd-font-display); font-weight: 600; font-size: 13px; }
    .pd-roadmap-desc { font-size: 11.5px; color: var(--pd-ink-dim); margin-top: 4px; }
    .pd-roadmap-status { font-size: 10.5px; color: var(--pd-ink-faint); margin-top: 7px; font-family: var(--pd-font-mono); }
    .pd-act-head { font-family: var(--pd-font-display); font-weight: 600; font-size: 14px; }
    .pd-act-expl { font-size: 12px; color: var(--pd-ink-dim); margin: 6px 0 0; max-width: 60ch; }
    .pd-act-table { margin-top: 14px; }
    .pd-act-close { position: absolute; top: 10px; right: 12px; font-size: 16px; line-height: 1; color: var(--pd-ink-faint); }
    .pd-act-close:hover { color: var(--pd-ink); }
    @keyframes pd-fade-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
    .pd-act-anim { animation: pd-fade-in .25s ease-out; }
    @media (prefers-reduced-motion: reduce) { .pd-act-anim { animation: none; } }
    .pd-hero-actions { display: flex; flex-direction: column; gap: 6px; align-items: flex-end; }
    .pd-hero-actions .pd-link { font-size: 11px; }
    .pd-hero-card { background: var(--pd-panel); border: 1px solid var(--pd-line); border-radius: 14px; padding: 18px 20px; display: flex; align-items: center; gap: 16px; }
    .pd-hero-score { font-family: var(--pd-font-display); font-weight: 700; font-size: 46px; line-height: 1; }
    .pd-hero-score small { font-size: 14px; color: var(--pd-ink-faint); font-weight: 500; }
    .pd-hero-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
    .pd-hero-domain { font-family: var(--pd-font-mono); font-size: 15px; font-weight: 500; }
    .pd-hero-meta { font-size: 11px; color: var(--pd-ink-faint); font-family: var(--pd-font-mono); }
    .pd-user-wrap { position: relative; }
    .pd-user { width: 100%; text-align: left; }
    .pd-user-menu { position: absolute; bottom: calc(100% + 6px); left: 0; right: 0; background: var(--pd-panel-2); border: 1px solid var(--pd-line); border-radius: 10px; padding: 5px; box-shadow: 0 10px 30px color-mix(in srgb, var(--pd-ink) 22%, transparent); z-index: 40; }
    .pd-menu-item { display: block; width: 100%; text-align: left; padding: 8px 10px; border-radius: 7px; font-size: 12.5px; color: var(--pd-ink-dim); text-decoration: none; }
    .pd-menu-item:hover { background: color-mix(in srgb, var(--pd-accent) 8%, transparent); color: var(--pd-ink); }
    .pd-theme-active { border-color: var(--pd-accent); color: var(--pd-accent); }
    .pd-menu-signout:hover { color: var(--pd-fail); }
    .pd-dd-status { margin-top: 10px; border-radius: 9px; padding: 9px 13px; font-size: 12.5px; border: 1px solid; }
    .pd-logo-accent { background: linear-gradient(90deg, var(--pd-accent), var(--pd-violet)); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .pd-nav { display: flex; flex-direction: column; gap: 2px; flex: 1; }
    .pd-nav-item { display: flex; align-items: center; gap: 9px; padding: 7px 10px; border-radius: 8px; color: var(--pd-ink-dim); font-size: 13px; text-align: left; transition: background .15s, color .15s; }
    .pd-nav-item svg { width: 15px; height: 15px; flex-shrink: 0; }
    .pd-nav-item:hover { background: color-mix(in srgb, var(--pd-accent) 7%, transparent); color: var(--pd-ink); }
    .pd-nav-item.is-active { background: color-mix(in srgb, var(--pd-accent) 12%, transparent); color: var(--pd-accent); }
    .pd-nav-item.is-planned { opacity: .45; cursor: not-allowed; }
    .pd-nav-badge { margin-left: auto; background: color-mix(in srgb, var(--pd-fail) 15%, transparent); color: var(--pd-fail); border: 1px solid color-mix(in srgb, var(--pd-fail) 35%, transparent); border-radius: 99px; font-size: 10px; padding: 0 7px; font-family: var(--pd-font-mono); }
    .pd-planned-chip { font-family: var(--pd-font-mono); font-size: 9px; color: var(--pd-ink-faint); border: 1px solid var(--pd-line); border-radius: 99px; padding: 1px 7px; text-transform: uppercase; letter-spacing: .04em; white-space: nowrap; }
    .pd-nav-item .pd-planned-chip { margin-left: auto; }
    .pd-nav-sep { height: 1px; background: var(--pd-line); margin: 8px 6px; }
    .pd-sidebar-foot { display: flex; flex-direction: column; gap: 8px; }
    .pd-plan-card { border: 1px dashed var(--pd-line); border-radius: 10px; padding: 10px 12px; }
    .pd-plan-name { font-size: 12px; font-weight: 600; }
    .pd-plan-desc { font-size: 11px; color: var(--pd-ink-faint); margin-top: 2px; }
    .pd-user { display: flex; align-items: center; gap: 9px; padding: 4px 8px; }
    .pd-avatar { width: 28px; height: 28px; border-radius: 99px; background: linear-gradient(135deg, var(--pd-accent), var(--pd-violet)); color: var(--pd-on-accent); display: grid; place-items: center; font-weight: 600; font-size: 13px; }
    .pd-user-mail { font-size: 11px; color: var(--pd-ink-dim); max-width: 118px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .pd-user-role { font-size: 10px; color: var(--pd-ink-faint); }
    .pd-signout { padding: 2px 8px; text-align: left; }

    .pd-main { flex: 1; min-width: 0; display: flex; flex-direction: column; position: relative; }
    .pd-topbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 22px; border-bottom: 1px solid var(--pd-line); flex-wrap: wrap; }
    .pd-page-title { font-size: 19px; }
    .pd-page-sub { font-size: 12px; color: var(--pd-ink-faint); margin-top: 1px; }
    .pd-topbar .pd-btn svg { width: 13px; height: 13px; }

    .pd-toast { position: fixed; bottom: 20px; left: 0; right: 0; z-index: 50; display: flex; justify-content: center; pointer-events: none; }
    .pd-toast:empty { display: none; }
    .pd-toast > div { pointer-events: auto; }
    .pd-toast > div { max-width: 480px; margin: 0 auto; border-radius: 10px; padding: 10px 14px; font-size: 13px; box-shadow: 0 8px 30px color-mix(in srgb, var(--pd-ink) 20%, transparent); display: flex; align-items: center; gap: 10px; border: 1px solid; }
    .pd-toast > .pd-toast-pass { border-color: color-mix(in srgb, var(--pd-pass) 40%, transparent); background: color-mix(in srgb, var(--pd-pass) 10%, transparent); color: var(--pd-pass); }
    .pd-toast > .pd-toast-warn { border-color: color-mix(in srgb, var(--pd-warn) 40%, transparent); background: color-mix(in srgb, var(--pd-warn) 10%, transparent); color: var(--pd-warn); }
    .pd-toast > .pd-toast-fail { border-color: color-mix(in srgb, var(--pd-fail) 40%, transparent); background: color-mix(in srgb, var(--pd-fail) 10%, transparent); color: var(--pd-fail); }
    .pd-toast .pd-toast-x { margin-left: auto; color: var(--pd-ink-faint); font-size: 15px; }
    .pd-toast .pd-toast-x:hover { color: var(--pd-ink); }

    .pd-screen { padding: 20px 22px 30px; display: flex; flex-direction: column; gap: 16px; }
    .pd-screen[hidden] { display: none; }
    #dmarc-content { display: flex; flex-direction: column; gap: 16px; align-items: stretch; }
    .pd-stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; }
    .pd-stat { background: var(--pd-panel); border: 1px solid var(--pd-line); border-radius: 12px; padding: 13px 15px; }
    .pd-stat-label { font-size: 11px; color: var(--pd-ink-faint); text-transform: uppercase; letter-spacing: .05em; }
    .pd-stat-value { font-family: var(--pd-font-display); font-size: 26px; font-weight: 700; margin-top: 3px; }
    .pd-stat-note { font-size: 11px; color: var(--pd-ink-faint); margin-top: 2px; }
    .pd-text-pass { color: var(--pd-pass); }
    .pd-text-warn { color: var(--pd-warn); }
    .pd-text-fail { color: var(--pd-fail); }

    .pd-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; align-items: start; }
    @media (max-width: 860px) { .pd-grid-2 { grid-template-columns: 1fr; } }
    .pd-panel { background: var(--pd-panel); border: 1px solid var(--pd-line); border-radius: 12px; padding: 15px 17px; }
    .pd-panel-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-bottom: 11px; }
    .pd-panel-head h2 { font-size: 14px; }
    .pd-panel-note { font-size: 11px; color: var(--pd-ink-faint); margin-top: 10px; }
    .pd-link { color: var(--pd-accent); font-size: 12px; }

    .pd-btn { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--pd-line); background: var(--pd-panel-2); color: var(--pd-ink); border-radius: 8px; padding: 7px 13px; font-size: 12.5px; font-weight: 500; transition: border-color .15s; }
    .pd-btn:hover { border-color: color-mix(in srgb, var(--pd-accent) 45%, transparent); }
    .pd-btn svg { width: 13px; height: 13px; }
    .pd-btn-primary { background: linear-gradient(90deg, var(--pd-accent), var(--pd-violet)); color: var(--pd-on-accent); border: 0; font-weight: 600; }
    .pd-btn-danger:hover { border-color: color-mix(in srgb, var(--pd-fail) 50%, transparent); color: var(--pd-fail); }
    .pd-btn-sm { padding: 5px 11px; font-size: 12px; }
    .pd-btn-xs { padding: 3px 9px; font-size: 11px; border-radius: 6px; }
    .pd-btn.is-me { border-color: color-mix(in srgb, var(--pd-pass) 45%, transparent); color: var(--pd-pass); background: color-mix(in srgb, var(--pd-pass) 8%, transparent); }

    .pd-input { flex: 1; background: transparent; border: 1px solid var(--pd-line); border-radius: 8px; padding: 8px 12px; font-family: var(--pd-font-mono); font-size: 13px; color: var(--pd-ink); min-width: 0; }
    .pd-input:focus { outline: none; border-color: var(--pd-accent); box-shadow: 0 0 0 2px color-mix(in srgb, var(--pd-accent) 20%, transparent); }
    .pd-add-row { display: flex; gap: 10px; flex-wrap: wrap; }

    .pd-health-list { display: flex; flex-direction: column; }
    .pd-health-row { display: flex; align-items: center; gap: 12px; width: 100%; text-align: left; padding: 10px 8px; border-radius: 9px; border-top: 1px solid var(--pd-line); transition: background .15s; }
    .pd-health-row:first-child { border-top: 0; }
    .pd-health-row:hover { background: color-mix(in srgb, var(--pd-accent) 5%, transparent); }
    .pd-score { font-family: var(--pd-font-display); font-weight: 700; font-size: 15px; color: var(--pd-ink); }
    .pd-score-a, .pd-score-b { color: var(--pd-pass); }
    .pd-score-c, .pd-score-d { color: var(--pd-warn); }
    .pd-score-f { color: var(--pd-fail); }
    .pd-health-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 5px; }
    .pd-domain-name { font-family: var(--pd-font-mono); font-size: 13px; font-weight: 500; }
    .pd-health-meta { display: flex; gap: 5px; flex-wrap: wrap; }
    .pd-health-side { display: flex; flex-direction: column; align-items: flex-end; gap: 3px; }
    .pd-grade { font-family: var(--pd-font-display); font-weight: 700; font-size: 15px; }
    .pd-grade-a, .pd-grade-b { color: var(--pd-pass); }
    .pd-grade-c, .pd-grade-d { color: var(--pd-warn); }
    .pd-grade-f { color: var(--pd-fail); }
    .pd-health-checked { font-size: 10px; color: var(--pd-ink-faint); }

    .pd-chip { display: inline-flex; align-items: center; gap: 4px; font-size: 10px; padding: 2px 8px; border-radius: 99px; border: 1px solid; white-space: nowrap; }
    .pd-chip-pass { color: var(--pd-pass); border-color: color-mix(in srgb, var(--pd-pass) 35%, transparent); background: color-mix(in srgb, var(--pd-pass) 8%, transparent); }
    .pd-chip-warn { color: var(--pd-warn); border-color: color-mix(in srgb, var(--pd-warn) 35%, transparent); background: color-mix(in srgb, var(--pd-warn) 8%, transparent); }
    .pd-chip-fail { color: var(--pd-fail); border-color: color-mix(in srgb, var(--pd-fail) 35%, transparent); background: color-mix(in srgb, var(--pd-fail) 8%, transparent); }
    .pd-chip-info { color: var(--pd-accent); border-color: color-mix(in srgb, var(--pd-accent) 35%, transparent); background: color-mix(in srgb, var(--pd-accent) 8%, transparent); }

    .pd-action-card { border: 1px solid color-mix(in srgb, var(--pd-accent) 30%, transparent); background: color-mix(in srgb, var(--pd-accent) 5%, transparent); border-radius: 10px; padding: 13px 15px; }
    .pd-action-card h3 { font-size: 13.5px; margin-top: 8px; }
    .pd-action-card p { font-size: 12px; color: var(--pd-ink-dim); margin-top: 4px; }
    .pd-action-card .pd-btn { margin-top: 10px; }
    .pd-action-card.is-fix { border-color: color-mix(in srgb, var(--pd-fail) 30%, transparent); background: color-mix(in srgb, var(--pd-fail) 5%, transparent); }

    .pd-chart { width: 100%; height: auto; display: block; }
    .pd-chart-bars rect:hover { opacity: .8; }
    .pd-legend { display: flex; align-items: center; gap: 12px; font-size: 11px; color: var(--pd-ink-dim); }
    .pd-legend-dot { display: inline-block; width: 8px; height: 8px; border-radius: 2px; margin-right: 4px; }
    .pd-dot-pass { background: var(--pd-pass); }
    .pd-dot-fail { background: var(--pd-fail); }

    .pd-table-wrap { overflow-x: auto; }
    .pd-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
    .pd-table th { text-align: left; font-size: 10.5px; text-transform: uppercase; letter-spacing: .05em; color: var(--pd-ink-faint); font-weight: 500; padding: 7px 10px; border-bottom: 1px solid var(--pd-line); white-space: nowrap; }
    .pd-table td { padding: 9px 10px; border-bottom: 1px solid color-mix(in srgb, var(--pd-line) 60%, transparent); vertical-align: middle; }
    .pd-table tr:last-child td { border-bottom: 0; }
    .pd-cell-dim { color: var(--pd-ink-dim); }

    .pd-domain-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; background: var(--pd-panel); border: 1px solid var(--pd-line); border-radius: 12px; padding: 15px 17px; }
    .pd-domain-head-main { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .pd-domain-title { font-size: 18px; font-family: var(--pd-font-mono); }
    .pd-domain-head-actions { display: flex; gap: 8px; flex-wrap: wrap; }

    .pd-tabs { display: flex; gap: 4px; flex-wrap: wrap; border-bottom: 1px solid var(--pd-line); }
    .pd-tab { padding: 8px 14px; font-size: 12.5px; color: var(--pd-ink-dim); border-bottom: 2px solid transparent; margin-bottom: -1px; }
    .pd-tab:hover { color: var(--pd-ink); }
    .pd-tab.is-active { color: var(--pd-accent); border-bottom-color: var(--pd-accent); }
    .pd-tabpanel { display: flex; flex-direction: column; gap: 12px; }
    .pd-tabpanel[hidden] { display: none; }

    .pd-meter-head { display: flex; justify-content: space-between; font-size: 11px; color: var(--pd-ink-dim); margin-top: 12px; }
    .pd-meter { height: 5px; border-radius: 99px; background: var(--pd-panel-2); margin-top: 5px; overflow: hidden; }
    .pd-meter-fill { height: 100%; border-radius: 99px; background: linear-gradient(90deg, var(--pd-accent), var(--pd-violet)); }
    .pd-check-list { list-style: none; margin-top: 11px; display: flex; flex-direction: column; gap: 6px; }
    .pd-check-list li { display: flex; align-items: flex-start; gap: 7px; font-size: 12px; color: var(--pd-ink-dim); }
    .pd-check-list li svg { width: 13px; height: 13px; color: var(--pd-pass); flex-shrink: 0; margin-top: 2px; }

    .pd-timeline { display: flex; flex-direction: column; gap: 12px; }
    .pd-tl-item { display: flex; gap: 10px; }
    .pd-tl-dot { width: 9px; height: 9px; border-radius: 99px; margin-top: 4px; flex-shrink: 0; }
    .pd-dot-warn { background: var(--pd-warn); }
    .pd-tl-title { font-size: 12.5px; font-weight: 500; }
    .pd-tl-meta { font-size: 11px; color: var(--pd-ink-faint); font-family: var(--pd-font-mono); }

    .pd-domain-picker { display: flex; align-items: center; gap: 9px; }
    .pd-picker-label { font-size: 12px; color: var(--pd-ink-faint); }
    .pd-select { background: var(--pd-panel); color: var(--pd-ink); border: 1px solid var(--pd-line); border-radius: 8px; padding: 7px 11px; font: inherit; font-size: 12.5px; }

    .pd-alert-list { display: flex; flex-direction: column; gap: 9px; }
    .pd-alert { border: 1px solid var(--pd-line); border-radius: 10px; padding: 12px 15px; background: var(--pd-panel-2); }
    .pd-alert[data-sev="fail"] { border-left: 3px solid var(--pd-fail); }
    .pd-alert[data-sev="warn"] { border-left: 3px solid var(--pd-warn); }
    .pd-alert[data-sev="info"] { border-left: 3px solid var(--pd-accent); }
    .pd-alert.is-unread { background: color-mix(in srgb, var(--pd-accent) 4%, transparent); }
    .pd-alert-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; cursor: pointer; }
    .pd-alert-title { font-size: 13px; font-weight: 500; flex: 1; min-width: 200px; }
    .pd-alert-time { font-size: 10.5px; color: var(--pd-ink-faint); font-family: var(--pd-font-mono); }
    .pd-alert-body { margin-top: 9px; display: none; }
    .pd-alert.is-open .pd-alert-body { display: block; }
    .pd-alert-diff { font-family: var(--pd-font-mono); font-size: 12px; background: color-mix(in srgb, var(--pd-ink) 7%, transparent); border-radius: 7px; padding: 7px 11px; color: var(--pd-ink-dim); white-space: pre-wrap; }

    .pd-form-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 9px 0; border-bottom: 1px solid rgba(28,42,71,.5); font-size: 12.5px; flex-wrap: wrap; }
    .pd-form-row:last-child { border-bottom: 0; }
    .pd-form-label { color: var(--pd-ink-dim); }
    .pd-toggle-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 9px 0; border-bottom: 1px solid rgba(28,42,71,.5); font-size: 12.5px; }
    .pd-toggle-row:last-child { border-bottom: 0; }
    .pd-toggle-row.pd-is-planned { color: var(--pd-ink-faint); }

    .pd-empty { border: 1px dashed var(--pd-line); border-radius: 10px; padding: 22px; text-align: center; font-size: 12.5px; color: var(--pd-ink-faint); }
    .pd-empty a { color: var(--pd-accent); }

    @media (max-width: 720px) {
      .pd-shell { flex-direction: column; }
      .pd-sidebar { width: 100%; flex-direction: row; align-items: center; flex-wrap: wrap; gap: 4px; }
      .pd-nav { flex-direction: row; flex-wrap: wrap; }
      .pd-sidebar-foot { display: none; }
      .pd-logo { padding-bottom: 4px; width: 100%; }
      .pd-toast { margin: 0 12px; }
      .pd-screen { padding: 14px 12px 24px; }
    }
  </style>

  <script>
    import { lookup, RESOLVERS } from '../lib/doh';

    type ScanCheck = { id: string; label: string; status: string; value: string; earned: number; weight: number };
    type ScanRecord = { type: string; name: string; value: string };
    type DomainRow = { id: number; domain: string; paused: boolean; score: number | null; grade: string | null; checkedAt: string | null; checks: ScanCheck[] | null; records: ScanRecord[] | null };
    type AlertRow = { id: number; severity: string; title: string; detail: string; created_at: string; read_at: string | null; domain: string };
    type DmarcSource = { ip: string; volume: number; dmarcPass: number; spfPass: number; dkimPass: number; disposition: string; lastReport: string | null };
    type DailyPoint = { date: string; total: number; passing: number };

    const state = { domains: [] as DomainRow[], currentDomainId: null as number | null, dmarcDomainId: null as number | null, max: 3 };

    function applyTheme(t: 'dark' | 'light') {
      const app = document.getElementById('dash-app')!;
      if (t === 'light') app.setAttribute('data-theme', 'light');
      else app.removeAttribute('data-theme');
      try { localStorage.setItem('pd-theme', t); } catch { /* private mode */ }
      document.querySelectorAll('[data-theme-set]').forEach((b) => {
        const active = (b as HTMLElement).dataset.themeSet === t;
        b.setAttribute('aria-pressed', String(active));
        b.classList.toggle('pd-theme-active', active);
      });
    }
    try {
      const savedTheme = localStorage.getItem('pd-theme');
      if (savedTheme === 'light' || savedTheme === 'dark') applyTheme(savedTheme);
    } catch { /* ignore */ }

    const GRADE_CLASS: Record<string, string> = { A: 'pd-score-a', B: 'pd-score-b', C: 'pd-score-c', D: 'pd-score-d', F: 'pd-score-f' };
    const AUTO_DISMISS_MS = 6000;
    const dismissTimers = new WeakMap<HTMLElement, number>();

    function toast(cls: 'pass' | 'warn' | 'fail', text: string) {
      const el = document.getElementById('pd-toast')!;
      el.innerHTML = '<div class="pd-toast-' + cls + '">' + text + '<button type="button" class="pd-toast-x" aria-label="Dismiss">×</button></div>';
      el.querySelector('.pd-toast-x')!.addEventListener('click', () => { el.innerHTML = ''; });
      const prev = dismissTimers.get(el);
      if (prev) clearTimeout(prev);
      const wait = cls === 'pass' ? AUTO_DISMISS_MS : AUTO_DISMISS_MS * 2;
      dismissTimers.set(el, window.setTimeout(() => { el.innerHTML = ''; }, wait));
    }

    function showDomainTab(tab: string) {
      document.querySelectorAll('.pd-tab').forEach((t) => {
        const active = t.getAttribute('data-tab') === tab;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', String(active));
      });
      document.querySelectorAll('#screen-domain .pd-tabpanel').forEach((p) => { p.hidden = p.id !== 'tab-' + tab; });
    }

    function show(screen: string, sub?: string) {
      document.querySelectorAll('#dash-shell .pd-screen').forEach((s) => { (s as HTMLElement).hidden = s.id !== 'screen-' + screen; });
      document.querySelectorAll('#dash-shell .pd-nav-item').forEach((n) => n.classList.toggle('is-active', (n as HTMLElement).dataset.screen === screen));
      const t = document.getElementById('page-title')!;
      const titles: Record<string, string> = { overview: 'Overview', domains: 'Domains', domain: 'Domain detail', dmarc: 'Email (DMARC)', alerts: 'Alerts', settings: 'Settings' };
      t.textContent = titles[screen] ?? '';
      document.getElementById('page-sub')!.textContent = sub ?? ({
        overview: 'Everything watched, at a glance.',
        domains: 'All domains on the account.',
        domain: 'One domain, in depth.',
        dmarc: 'Who is sending email as your domains.',
        alerts: 'Changes and problems, newest first.',
        settings: 'Account, notifications, and billing.',
      } as Record<string, string>)[screen] ?? '';
      document.getElementById('topbar-add')!.style.display = screen === 'domains' ? '' : 'none';
    }

    function chip(status: string): string {
      const cls = status === 'pass' ? 'pd-chip-pass' : status === 'warn' ? 'pd-chip-warn' : 'pd-chip-fail';
      const icon = status === 'pass' ? '✔' : status === 'warn' ? '▲' : '✕';
      return '<span class="pd-chip ' + cls + '">' + icon + ' ' + status + '</span>';
    }
    function gradeClass(g: string | null): string { return GRADE_CLASS[(g ?? 'F').toUpperCase()] ?? 'pd-score-f'; }
    function esc(s: string): string { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

    // ---------- domains ----------
    async function loadDomains(): Promise<DomainRow[]> {
      const res = await fetch('/api/domains');
      if (!res.ok) return [];
      const data = await res.json() as { domains: DomainRow[]; max: number };
      state.domains = data.domains;
      state.max = data.max;
      const maxEl = document.getElementById('dom-max');
      if (maxEl) maxEl.textContent = String(data.max);
      renderDomainTable();
      renderHealthRows(document.getElementById('ov-health')!);
      return data.domains;
    }

    function domainChips(d: DomainRow, max = 3): string {
      const order = ['spf', 'dmarc', 'dkim', 'dnssec', 'mx', 'website', 'ns'];
      const chips: string[] = [];
      for (const id of order) {
        const c = d.checks?.find((x) => x.id === id);
        if (c && c.status !== 'pass') chips.push('<span class="pd-chip ' + (c.status === 'fail' ? 'pd-chip-fail' : 'pd-chip-warn') + '">' + esc(c.label) + '</span>');
        if (chips.length >= max) break;
      }
      if (!chips.length && d.checks?.length) chips.push('<span class="pd-chip pd-chip-pass">✔ all checks pass</span>');
      return chips.join(' ');
    }

    function renderDomainTable() {
      const list = document.getElementById('dom-list')!;
      list.innerHTML = '';
      if (!state.domains.length) {
        list.innerHTML = '<div class="pd-empty">No domains yet. Click "Add domain" and the first scan runs immediately.</div>';
        return;
      }
      const wrap = document.createElement('div');
      wrap.className = 'pd-table-wrap';
      wrap.innerHTML = '<table class="pd-table"><thead><tr><th>Domain</th><th>Score</th><th>Status</th><th>Last check</th><th></th></tr></thead><tbody></tbody></table>';
      const tbody = wrap.querySelector('tbody')!;
      for (const d of state.domains) {
        const tr = document.createElement('tr');
        tr.innerHTML =
          '<td class="pd-domain-name">' + esc(d.domain) + (d.paused ? ' <span class="pd-chip pd-chip-warn">paused</span>' : '') + '</td>' +
          '<td><span class="pd-score ' + gradeClass(d.grade) + '" style="font-size:14px">' + (d.score ?? '-') + '</span></td>' +
          '<td>' + domainChips(d, 2) + '</td>' +
          '<td class="pd-cell-dim pd-mono">' + (d.checkedAt ? d.checkedAt.slice(0, 16).replace('T', ' ') : '-') + '</td>' +
          '<td style="white-space:nowrap"><button type="button" class="pd-btn pd-btn-xs" data-scan-row="' + d.id + '">Scan</button> <button type="button" class="pd-link" data-open="' + d.id + '">Open →</button></td>';
        tbody.appendChild(tr);
      }
      const statusLine = document.createElement('div');
      statusLine.id = 'dom-scan-status';
      statusLine.className = 'pd-panel';
      statusLine.hidden = true;
      list.appendChild(wrap);
      list.appendChild(statusLine);
      list.querySelectorAll('[data-open]').forEach((b) => b.addEventListener('click', () => openDomain(Number((b as HTMLElement).dataset.open))));
      list.querySelectorAll('[data-scan-row]').forEach((b) => {
        const el = b as HTMLButtonElement;
        el.addEventListener('click', () => {
          el.disabled = true;
          el.textContent = 'Scanning…';
          void doRescan(Number(el.dataset.scanRow), statusLine).finally(() => { el.disabled = false; el.textContent = 'Scan'; });
        });
      });
    }

    function renderHealthRows(container: HTMLElement) {
      container.innerHTML = '';
      if (!state.domains.length) {
        container.innerHTML = '<div class="pd-empty">No domains yet. Add one from the Domains screen.</div>';
        return;
      }
      for (const d of state.domains) {
        const row = document.createElement('button');
        row.type = 'button';
        row.className = 'pd-health-row';
        row.innerHTML =
          '<span class="pd-score ' + gradeClass(d.grade) + '">' + (d.score ?? '-') + '</span>' +
          '<span class="pd-health-main"><span class="pd-domain-name">' + esc(d.domain) + '</span><span class="pd-health-meta">' + domainChips(d, 2) + '</span></span>' +
          '<span class="pd-health-side"><span class="pd-grade pd-grade-' + (d.grade ?? 'f').toLowerCase() + '">' + (d.grade ?? '-') + '</span><span class="pd-health-checked">' + (d.checkedAt ? 'checked ' + d.checkedAt.slice(11, 16) + ' UTC' : '') + '</span></span>';
        row.addEventListener('click', () => openDomain(d.id));
        container.appendChild(row);
      }
    }

    function nextAction(): { cls: string; tag: string; tagCls: string; title: string; body: string; cta?: string; go?: string } | null {
      for (const d of state.domains) {
        const spf = d.checks?.find((c) => c.id === 'spf');
        if (spf && spf.status === 'fail') {
          return { cls: 'is-fix', tag: 'Fix first', tagCls: 'pd-chip-fail', title: 'SPF on ' + d.domain + ' is failing', body: 'The record has errors or exceeds the lookup limit - receivers may be ignoring your policy entirely.', cta: 'Open the domain', go: String(d.id) };
        }
      }
      for (const d of state.domains) {
        const dm = d.checks?.find((c) => c.id === 'dmarc');
        if (dm && dm.status === 'warn') {
          return { cls: '', tag: 'Roadmap', tagCls: 'pd-chip-pass', title: 'Move ' + d.domain + ' toward p=quarantine', body: 'DMARC is in monitoring mode. Read the sources on the Email screen, mark every sender, and advance when they all pass.', cta: 'See DMARC sources', go: 'dmarc:' + d.id };
        }
      }
      for (const d of state.domains) {
        const ds = d.checks?.find((c) => c.id === 'dnssec');
        if (ds && ds.status === 'warn') {
          return { cls: '', tag: 'Harden', tagCls: 'pd-chip-warn', title: 'Enable DNSSEC on ' + d.domain, body: 'No DS record at the parent. Enable DNSSEC at your DNS provider, then publish the DS record at your registrar.', cta: 'Open the domain', go: String(d.id) };
        }
      }
      return null;
    }

    const lastScan: { id: number; cls: string; text: string } | null = null;
    function renderHeroCard(d: DomainRow): HTMLElement {
      const card = document.createElement('div');
      card.className = 'pd-hero-card';
      card.dataset.hero = String(d.id);
      card.innerHTML =
        '<div class="pd-hero-score ' + gradeClass(d.grade) + '">' + (d.score ?? '-') + '</div>' +
        '<div class="pd-hero-main">' +
        '<p class="pd-hero-domain">' + esc(d.domain) + (d.paused ? ' <span class="pd-chip pd-chip-warn">paused</span>' : '') + '</p>' +
        '<div class="pd-health-meta">' + domainChips(d, 3) + '</div>' +
        '<p class="pd-hero-meta">Grade ' + (d.grade ?? '-') + (d.checkedAt ? ' · checked ' + d.checkedAt.slice(11, 16) + ' UTC' : '') + '</p>' +
        '</div>' +
        '<div class="pd-hero-actions">' +
        '<button type="button" class="pd-btn pd-btn-sm" data-scan="' + d.id + '">Scan now</button>' +
        '<button type="button" class="pd-link" data-open="' + d.id + '">Details →</button>' +
        '</div>';
      card.querySelector('[data-scan]')!.addEventListener('click', (e) => {
        const b = e.currentTarget as HTMLButtonElement;
        b.disabled = true;
        b.textContent = 'Scanning…';
        void doRescan(d.id, document.getElementById('ov-activity') as HTMLElement).finally(() => { b.disabled = false; b.textContent = 'Scan now'; });
      });
      card.querySelector('[data-open]')!.addEventListener('click', () => openDomain(d.id));
      return card;
    }

    function renderHero() {
      const hero = document.getElementById('ov-hero')!;
      hero.innerHTML = '';
      if (!state.domains.length) {
        hero.innerHTML = '<div class="pd-empty" style="grid-column:1/-1">No domains monitored yet. Click "Add domain" above and its live health score appears here.</div>';
        return;
      }
      for (const d of state.domains) hero.appendChild(renderHeroCard(d));
    }

    function renderOverview(o: { domains: number; max: number; alertsOpen: number; avgScore: number | null; dmarc: { reports: number; messages: number; passRate: number | null; daily: DailyPoint[] } }) {
      (document.getElementById('ov-domains') as HTMLElement).textContent = String(o.domains);
      (document.getElementById('ov-domains-note') as HTMLElement).textContent = 'of ' + o.max + ' on Early access';
      (document.getElementById('ov-alerts') as HTMLElement).textContent = String(o.alertsOpen);
      const pr = document.getElementById('ov-passrate') as HTMLElement;
      pr.textContent = o.dmarc.passRate === null ? '-' : o.dmarc.passRate + '%';
      (document.getElementById('ov-passrate-note') as HTMLElement).textContent = o.dmarc.reports > 0 ? o.dmarc.reports + ' report(s), ' + o.dmarc.messages.toLocaleString() + ' messages' : 'no reports yet';

      renderHero();
      renderHealthRows(document.getElementById('ov-health')!);

      const action = nextAction();
      const box = document.getElementById('ov-action')!;
      if (!action) {
        box.innerHTML = '<div class="pd-action-card"><span class="pd-chip pd-chip-pass">All clear</span><h3>Nothing needs your attention</h3><p>Monitoring keeps watching every domain every 6 hours.</p></div>';
      } else {
        box.innerHTML = '<div class="pd-action-card ' + action.cls + '"><span class="pd-chip ' + action.tagCls + '">' + action.tag + '</span><h3>' + esc(action.title) + '</h3><p>' + esc(action.body) + '</p>' + (action.cta ? '<button type="button" class="pd-btn pd-btn-sm" id="action-go">' + action.cta + '</button>' : '') + '</div>';
        const go = document.getElementById('action-go');
        if (go) go.addEventListener('click', () => {
          if (!action.go) return;
          if (action.go.startsWith('dmarc:')) { state.dmarcDomainId = Number(action.go.split(':')[1]); show('dmarc'); void loadDmarcScreen(); }
          else openDomain(Number(action.go));
        });
      }

      const chartPanel = document.getElementById('ov-chart-panel')!;
      if (o.dmarc.daily.length > 1) {
        chartPanel.hidden = false;
        (chartPanel.querySelector('h2') as HTMLElement).textContent = 'DMARC volume';
        (chartPanel.querySelector('.pd-legend') as HTMLElement).hidden = false;
        drawBars(document.getElementById('ov-chart') as SVGSVGElement, o.dmarc.daily);
      } else if (o.activity && o.activity.length > 1) {
        chartPanel.hidden = false;
        (chartPanel.querySelector('h2') as HTMLElement).textContent = 'Your scores, last 14 days';
        (chartPanel.querySelector('.pd-legend') as HTMLElement).hidden = true;
        drawScoreBars(document.getElementById('ov-chart') as SVGSVGElement, o.activity);
      } else {
        chartPanel.hidden = true;
      }
    }

    function drawScoreBars(svg: SVGSVGElement, activity: { date: string; runs: number; avgScore: number }[]) {
      const g = svg.querySelector('.pd-chart-bars');
      if (!g) return;
      const W = 640, H = 150, padL = 6, padB = 16, padT = 6;
      const n = Math.max(activity.length, 1);
      const bw = (W - padL * 2) / n;
      let out = '<line x1="' + padL + '" y1="' + (padT + 1) + '" x2="' + (W - padL) + '" y2="' + (padT + 1) + '" stroke="var(--pd-line)" stroke-width="1"/>';
      activity.forEach((a, i) => {
        const x = padL + i * bw;
        const h = Math.max(2, (H - padB - padT) * (a.avgScore / 100));
        out += '<rect x="' + (x + 1).toFixed(1) + '" y="' + (H - padB - h).toFixed(1) + '" width="' + Math.max(1.5, bw - 2.5).toFixed(1) + '" height="' + h.toFixed(1) + '" rx="1.5" fill="var(--pd-accent)" opacity="0.8"><title>' + a.date + ': avg score ' + a.avgScore + ' across ' + a.runs + ' run(s)</title></rect>';
        if (i % Math.ceil(n / 8) === 0) out += '<text x="' + (x + bw / 2).toFixed(1) + '" y="' + (H - 4) + '" font-size="9" fill="var(--pd-ink-faint)" text-anchor="middle" font-family="JetBrains Mono, monospace">' + a.date.slice(5) + '</text>';
      });
      g.innerHTML = out;
    }

    async function loadOverview() {
      try {
        const res = await fetch('/api/overview');
        if (!res.ok) return;
        const o = await res.json() as { ok: boolean; domains: number; max: number; alertsOpen: number; avgScore: number | null; dmarc: { reports: number; messages: number; passRate: number | null; daily: DailyPoint[] } };
        if (o.ok) renderOverview(o);
      } catch { /* overview is best-effort */ }
    }

    // ---------- domain detail ----------
    function renderAuthTab(d: DomainRow) {
      const auth = document.getElementById('tab-auth')!;
      const cards = (d.checks ?? []).map((c) => {
        let extra = '';
        if (c.id === 'spf') {
          const m = c.value.match(/(\d+)\/10/);
          if (m) {
            const pct = Math.min(100, Number(m[1]) * 10);
            extra = '<div class="pd-meter-head"><span>DNS lookup terms</span><span class="pd-mono">' + m[1] + '/10</span></div><div class="pd-meter"><div class="pd-meter-fill" style="width:' + pct + '%"></div></div>';
          }
        }
        return '<div class="pd-panel"><div class="pd-panel-head"><h2>' + esc(c.label) + '</h2>' + chip(c.status) + '</div><p class="pd-mono" style="color:var(--pd-ink-dim)">' + esc(c.value) + '</p>' + extra + '</div>';
      }).join('');
      auth.innerHTML = '<div class="pd-grid-2">' + cards + '</div><p class="pd-panel-note">Checks and weights follow the methodology. Values are from the latest scan.</p>';
    }

    function renderRecordsTab(d: DomainRow) {
      const recBox = document.getElementById('tab-records')!;
      if (d.records && d.records.length) {
        recBox.innerHTML = '<div class="pd-panel"><div class="pd-panel-head"><h2>DNS records as seen in the last scan</h2><span class="pd-chip pd-chip-info">' + d.records.length + ' record(s)</span></div><div class="pd-table-wrap"><table class="pd-table"><thead><tr><th>Type</th><th>Name</th><th>Value</th></tr></thead><tbody>' +
          d.records.map((r) => '<tr><td class="pd-mono">' + esc(r.type) + '</td><td class="pd-mono">' + esc(r.name) + '</td><td class="pd-mono" style="word-break:break-all">' + esc(r.value) + '</td></tr>').join('') +
          '</tbody></table></div><p class="pd-panel-note">Captured during the most recent scan. TXT records include the SPF and DMARC policies.</p></div>';
      } else {
        recBox.innerHTML = '<div class="pd-panel"><div class="pd-panel-head"><h2>DNS records</h2></div><div class="pd-empty">No record values captured yet. Run a scan and they will appear here.</div></div>';
      }
    }

    async function renderActivityTab(d: DomainRow): Promise<void> {
      const act = document.getElementById('tab-activity')!;
      act.innerHTML = '<div class="pd-panel"><p class="pd-panel-note">Loading activity…</p></div>';
      try {
        const res = await fetch('/api/domains/history?id=' + d.id);
        const data = await res.json() as { runs: { outcome: string; score: number | null; changes: number; ran_at: string }[]; alerts: { severity: string; title: string; detail: string; created_at: string }[] };
        const runs = data.runs.length
          ? '<table class="pd-table pd-table-sm" style="width:100%"><thead><tr><th>Time (UTC)</th><th>Result</th><th>Score</th></tr></thead><tbody>' +
            data.runs.map((r) => '<tr><td class="pd-mono">' + r.ran_at.slice(0, 16).replace('T', ' ') + '</td><td>' + (r.outcome === 'changed' ? '<span class="pd-text-warn">changed (' + r.changes + ')</span>' : r.outcome === 'unresolvable' ? '<span class="pd-text-fail">unresolvable</span>' : '<span class="pd-text-pass">no changes</span>') + '</td><td class="pd-mono">' + (r.score === null ? 'n/a' : r.score) + '</td></tr>').join('') +
            '</tbody></table>'
          : '<div class="pd-empty">No runs logged yet. Automatic runs appear here every 6 hours.</div>';
        const changes = data.alerts.length
          ? data.alerts.map((a) => '<div class="pd-tl-item"><span class="pd-tl-dot ' + (a.severity === 'fail' ? 'pd-dot-fail' : 'pd-dot-warn') + '"></span><div><p class="pd-tl-title">' + esc(a.title) + '</p><p class="pd-tl-meta">' + esc(a.detail.split('\n').join(' / ')) + '</p><p class="pd-tl-meta">' + a.created_at.slice(0, 16).replace('T', ' ') + ' UTC</p></div></div>').join('')
          : '<div class="pd-empty">No changes detected since monitoring started.</div>';
        act.innerHTML =
          '<div class="pd-panel"><div class="pd-panel-head"><h2>Scan activity</h2><span class="pd-chip pd-chip-pass">every 6 hours</span></div>' + runs + '</div>' +
          '<div class="pd-panel"><div class="pd-panel-head"><h2>Changes detected</h2></div><div class="pd-timeline">' + changes + '</div></div>';
      } catch {
        act.innerHTML = '<div class="pd-panel"><p class="pd-panel-note">Could not load activity.</p></div>';
      }
    }

    async function openDomain(id: number) {
      const d = state.domains.find((x) => x.id === id);
      if (!d) return;
      state.currentDomainId = id;
      show('domain', d.domain);

      renderDomainHead(d);
      document.getElementById('dd-pause')!.addEventListener('click', () => void doPause(d, async () => { await loadDomains(); await openDomain(d.id); }));
      document.getElementById('dd-remove')!.addEventListener('click', () => void doRemove(d));

      renderAuthTab(d);
      renderRecordsTab(d);
      showDomainTab('auth');
      await renderActivityTab(d);
    }

    const SCAN_EXPLANATION = 'Every scan checks website DNS, nameservers, mail routing (MX), SPF, DMARC, DKIM, and DNSSEC - the same seven checks as the homepage scanner. "No changes" means none of those values moved since the previous snapshot; the run is still logged.';

    async function showActivityCard(domainId: number, container: HTMLElement): Promise<void> {
      container.hidden = false;
      container.className = 'pd-panel';
      container.style.position = 'relative';
      // Overview's container sits inside the screen flex-gap; the others need
      // their own breathing room from the element above.
      container.style.marginTop = container.id === 'ov-activity' ? '' : '14px';
      container.innerHTML = '<div class="pd-act-anim"><p class="pd-panel-note" style="margin:0">Loading activity…</p></div>';
      try {
        const res = await fetch('/api/domains/history?id=' + domainId);
        const data = await res.json() as { runs: { outcome: string; score: number | null; changes: number; ran_at: string }[] };
        const runs = (data.runs ?? []).slice(0, 4);
        const latest = runs[0];
        const headline = !latest ? 'Scan complete - first run logged.'
          : latest.outcome === 'changed' ? 'Something changed during this scan.'
          : latest.outcome === 'unresolvable' ? 'The domain did not resolve on this run.'
          : 'No changes since the previous snapshot.';
        const color = !latest || latest.outcome === 'ok' ? 'var(--pd-pass)' : latest.outcome === 'changed' ? 'var(--pd-warn)' : 'var(--pd-fail)';
        container.innerHTML =
          '<div class="pd-act-anim">' +
          '<button type="button" class="pd-act-close" aria-label="Dismiss activity">×</button>' +
          '<div class="pd-act-head" style="color:' + color + '">' + headline + '</div>' +
          '<p class="pd-act-expl">' + esc(SCAN_EXPLANATION) + '</p>' +
          (runs.length
            ? '<table class="pd-table pd-act-table" style="width:100%"><thead><tr><th>Time (UTC)</th><th>Result</th><th>Score</th></tr></thead><tbody>' +
              runs.map((r) => '<tr><td class="pd-mono">' + r.ran_at.slice(0, 16).replace('T', ' ') + '</td><td>' + (r.outcome === 'changed' ? '<span class="pd-text-warn">changed (' + r.changes + ')</span>' : r.outcome === 'unresolvable' ? '<span class="pd-text-fail">unresolvable</span>' : '<span class="pd-text-pass">no changes</span>') + '</td><td class="pd-mono">' + (r.score === null ? 'n/a' : r.score) + '</td></tr>').join('') +
              '</tbody></table>'
            : '') +
          '</div>';
        container.style.borderLeft = '3px solid ' + color;
        container.querySelector('.pd-act-close')!.addEventListener('click', () => {
          container.hidden = true;
          container.innerHTML = '';
        });
      } catch {
        container.innerHTML = '<p class="pd-panel-note">Could not load activity.</p>';
      }
    }

    async function doRescan(id: number, container?: HTMLElement): Promise<void> {
      if (container) { container.hidden = false; container.className = 'pd-panel'; container.style.position = 'relative'; container.style.borderLeft = '3px solid var(--pd-accent)'; container.style.marginTop = container.id === 'ov-activity' ? '' : '14px'; container.innerHTML = '<div class="pd-act-anim"><p class="pd-panel-note" style="margin:0">Scanning…</p></div>'; }
      try {
        const res = await fetch('/api/domains/rescan?id=' + id, { method: 'POST' });
        const data = await res.json() as { ok: boolean; error?: string; changed?: boolean };
        await Promise.all([loadDomains(), loadOverview()]);
        // Refresh the detail tabs with the fresh scan data.
        const fresh = state.domains.find((x) => x.id === id);
        if (fresh && state.currentDomainId === id && state.screen === 'domain') {
          renderAuthTab(fresh);
          renderRecordsTab(fresh);
          void renderActivityTab(fresh);
        }
        // loadDomains rebuilds the list; re-resolve the container by id so we
        // are not writing into a detached node.
        if (container && container.id) {
          const live = document.getElementById(container.id);
          if (live) container = live;
        }
        if (!data.ok) {
          if (container) { container.innerHTML = '<p class="pd-panel-note">' + esc(data.error ?? 'Rescan failed.') + '</p>'; container.style.borderLeft = '3px solid var(--pd-fail)'; }
          else toast('fail', data.error ?? 'Rescan failed.');
          return;
        }
        if (container) await showActivityCard(id, container);
        else toast('pass', 'Scan complete.');
        if (state.dmarcDomainId === id) void loadDmarcScreen();
      } catch {
        if (container) { container.innerHTML = '<p class="pd-panel-note">Could not reach the server.</p>'; container.style.borderLeft = '3px solid var(--pd-fail)'; }
        else toast('fail', 'Could not reach the server.');
      }
    }

    function renderDomainHead(d: DomainRow) {
      const head = document.getElementById('domain-head')!;
      head.innerHTML =
        '<div class="pd-domain-head"><div class="pd-domain-head-main">' +
        '<h2 class="pd-domain-title">' + esc(d.domain) + '</h2>' +
        '<span class="pd-chip ' + (d.paused ? 'pd-chip-warn' : 'pd-chip-pass') + '">● ' + (d.paused ? 'paused' : 'monitored') + '</span>' +
        '<span class="pd-score ' + gradeClass(d.grade) + '" style="font-size:26px">' + (d.score ?? '-') + '</span>' +
        '<span class="pd-grade pd-grade-' + (d.grade ?? 'f').toLowerCase() + '" style="font-size:24px">' + (d.grade ?? '-') + '</span>' +
        '</div><div class="pd-domain-head-actions">' +
        '<button type="button" class="pd-btn pd-btn-sm" id="dd-rescan">Scan now</button>' +
        '<button type="button" class="pd-btn pd-btn-sm" id="dd-pause">' + (d.paused ? 'Resume' : 'Pause') + '</button>' +
        '<button type="button" class="pd-btn pd-btn-sm pd-btn-danger" id="dd-remove">Remove</button>' +
        '</div></div>' +
        '<div id="dd-status" hidden></div>';
      document.getElementById('dd-rescan')!.addEventListener('click', () => void doRescan(d.id, document.getElementById('dd-status') as HTMLElement));
      document.getElementById('dd-pause')!.addEventListener('click', () => void doPause(d, async () => { await loadDomains(); await openDomain(d.id); }));
      document.getElementById('dd-remove')!.addEventListener('click', () => void doRemove(d));
    }

    async function doPause(d: DomainRow, after: () => Promise<void>) {
      try {
        const res = await fetch('/api/domains/pause', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: d.id, paused: !d.paused }) });
        const data = await res.json() as { ok: boolean };
        if (data.ok) await after();
      } catch {
        toast('fail', 'Could not reach the server.');
      }
    }

    async function doRemove(d: DomainRow) {
      try {
        const res = await fetch('/api/domains/delete?id=' + d.id, { method: 'POST' });
        const data = await res.json() as { ok: boolean; error?: string };
        if (data.ok) {
          toast('pass', esc(d.domain) + ' removed from monitoring. You can add it again anytime.');
          state.currentDomainId = null;
          await loadDomains();
          await loadOverview();
          show('domains');
          void loadAlerts();
        } else {
          toast('fail', data.error ?? 'Could not remove the domain.');
        }
      } catch {
        toast('fail', 'Could not reach the server.');
      }
    }

    // ---------- dmarc screen ----------
    async function loadDmarcScreen() {
      const picker = document.getElementById('dmarc-domain') as HTMLSelectElement;
      if (!state.domains.length) {
        picker.innerHTML = '';
        document.getElementById('dmarc-content')!.innerHTML = '<div class="pd-empty">Add and monitor a domain first - reports are matched to monitored domains.</div>';
        return;
      }
      if (state.dmarcDomainId === null || !state.domains.some((d) => d.id === state.dmarcDomainId)) {
        state.dmarcDomainId = state.domains[0].id;
      }
      picker.innerHTML = state.domains.map((d) => '<option value="' + d.id + '"' + (d.id === state.dmarcDomainId ? ' selected' : '') + '>' + esc(d.domain) + '</option>').join('');
      picker.onchange = () => { state.dmarcDomainId = Number(picker.value); void renderDmarc(); };
      await renderDmarc();
    }

    async function renderDmarc() {
      const box = document.getElementById('dmarc-content')!;
      const id = state.dmarcDomainId;
      if (id === null) return;
      box.innerHTML = '<div class="pd-panel"><p class="pd-panel-note">Loading…</p></div>';
      try {
        const res = await fetch('/api/domains/dmarc?id=' + id);
        const data = await res.json() as {
          ok: boolean; error?: string; domain?: string;
          summary?: { reports: number; messages: number; orgs: number; passRate: number | null };
          sources?: DmarcSource[];
          reports?: { org_name: string; date_begin: string | null; date_end: string | null; messages_total: number }[];
          daily?: DailyPoint[];
          marks?: { source_ip: string; mark: string }[];
        };
        if (!data.ok) { box.innerHTML = '<div class="pd-panel"><p class="pd-panel-note">' + esc(data.error ?? 'Could not load DMARC data.') + '</p></div>'; return; }
        const markMap = new Map((data.marks ?? []).map((m) => [m.source_ip, m.mark]));
        const parts: string[] = [];

        // Enforcement roadmap - always visible: it is the journey, reports or not.
        const drow = state.domains.find((x) => x.id === id);
        const policyMatch = drow?.checks?.find((c) => c.id === 'dmarc')?.value.match(/p=(none|quarantine|reject)/);
        const policy = policyMatch ? policyMatch[1] : null;
        const stepCls = (name: string) => policy === name ? 'is-current' : (name === 'none' ? 'is-done' : '');
        const stepStatus = (name: string) => {
          if (policy === name) return 'You are here';
          if (name === 'none') return 'Complete - the record is live';
          if (name === 'quarantine') return policy === 'reject' ? 'Complete' : 'Ready when every source is marked and passing';
          return 'After a clean stretch on quarantine';
        };
        const roadmapHtml = '<div class="pd-panel"><div class="pd-panel-head"><h2>Enforcement roadmap</h2><span class="pd-chip ' + (policy === 'reject' ? 'pd-chip-pass' : 'pd-chip-warn') + '">currently p=' + (policy ?? 'unknown') + '</span></div>' +
          '<div class="pd-roadmap">' +
          '<div class="pd-roadmap-step ' + stepCls('none') + '"><p class="pd-roadmap-name">1 · p=none</p><p class="pd-roadmap-desc">Monitor only. Read reports, mark every source, fix legitimate senders that fail.</p><p class="pd-roadmap-status">' + stepStatus('none') + '</p></div>' +
          '<div class="pd-roadmap-step ' + stepCls('quarantine') + '"><p class="pd-roadmap-name">2 · p=quarantine</p><p class="pd-roadmap-desc">Failing mail goes to spam. Ramp with pct=25 → 100 while watching the reports.</p><p class="pd-roadmap-status">' + stepStatus('quarantine') + '</p></div>' +
          '<div class="pd-roadmap-step ' + stepCls('reject') + '"><p class="pd-roadmap-name">3 · p=reject</p><p class="pd-roadmap-desc">Failing mail is rejected outright. The end goal.</p><p class="pd-roadmap-status">' + stepStatus('reject') + '</p></div>' +
          '</div><p class="pd-panel-note">PromptDNS never changes your policy automatically. Each step is a record edit this screen prepares for you, with a rollback plan.</p></div>';

        if (!data.summary || data.summary.reports === 0) {
          parts.push('<div class="pd-panel"><div class="pd-panel-head"><h2>No reports yet</h2></div>' +
            '<div class="pd-empty" style="text-align:left">Setup:<br><br>1. Publish your DMARC record with <span class="pd-mono">rua=mailto:reports@promptdns.com</span> - the <a href="/dmarc-record-generator/">record generator</a> builds it.<br><br>2. First aggregate reports from Gmail, Microsoft, and Yahoo typically arrive within 24-48 hours of the record going live; give it up to 72.<br><br>3. If nothing arrives after 72 hours: confirm the rua= address matches, and that the Email Routing rule for reports@ is Active.<br><br>4. Reports show up here automatically.</div></div>');
          parts.push(roadmapHtml);
          box.innerHTML = parts.join('');
          return;
        }
        const sum = data.summary;
        parts.push('<div class="pd-stat-grid">' +
          '<div class="pd-stat"><p class="pd-stat-label">Reports received</p><p class="pd-stat-value">' + sum.reports + '</p></div>' +
          '<div class="pd-stat"><p class="pd-stat-label">Messages analyzed</p><p class="pd-stat-value">' + sum.messages.toLocaleString() + '</p></div>' +
          '<div class="pd-stat"><p class="pd-stat-label">Pass rate</p><p class="pd-stat-value ' + (sum.passRate !== null && sum.passRate >= 90 ? 'pd-text-pass' : sum.passRate === null ? '' : 'pd-text-warn') + '">' + (sum.passRate === null ? '-' : sum.passRate + '%') + '</p></div>' +
          '<div class="pd-stat"><p class="pd-stat-label">Reporting providers</p><p class="pd-stat-value">' + sum.orgs + '</p></div></div>');

        if (data.daily && data.daily.length > 1) {
          parts.push('<div class="pd-panel"><div class="pd-panel-head"><h2>Message volume</h2><span class="pd-legend"><span class="pd-legend-dot pd-dot-pass"></span>passing <span class="pd-legend-dot pd-dot-fail"></span>failing</span></div><svg class="pd-chart" id="dmarc-chart" viewBox="0 0 640 150" role="img" aria-label="Daily DMARC volume, passing versus failing"><g class="pd-chart-bars"></g></svg></div>');
        }

        const srcs = data.sources ?? [];
        parts.push('<div class="pd-panel"><div class="pd-panel-head"><h2>Sources</h2><span class="pd-panel-note" style="margin-top:0">Mark each sender so reports can tell legitimate mail from spoofing.</span></div><div class="pd-table-wrap"><table class="pd-table"><thead><tr><th>Source IP</th><th>Host (PTR)</th><th>Volume</th><th>SPF</th><th>DKIM</th><th>DMARC</th><th>Marked</th></tr></thead><tbody id="dmarc-src-rows"></tbody></table></div></div>');

        parts.push(roadmapHtml);

        parts.push('<div class="pd-panel"><div class="pd-panel-head"><h2>Recent reports</h2></div><div class="pd-timeline">' +
          (data.reports ?? []).map((r) => '<div class="pd-tl-item"><span class="pd-tl-dot pd-dot-pass" style="background:var(--pd-accent)"></span><div><p class="pd-tl-title">' + esc(r.org_name) + ': ' + r.messages_total.toLocaleString() + ' messages</p><p class="pd-tl-meta">' + (r.date_begin ?? '?') + ' to ' + (r.date_end ?? '?') + '</p></div></div>').join('') +
          '</div></div>');

        box.innerHTML = parts.join('');
        if (data.daily && data.daily.length > 1) drawBars(document.getElementById('dmarc-chart') as SVGSVGElement, data.daily);

        const tbody = document.getElementById('dmarc-src-rows')!;
        for (const src of srcs) {
          const tr = document.createElement('tr');
          const mark = markMap.get(src.ip);
          tr.innerHTML =
            '<td class="pd-mono">' + esc(src.ip) + '</td>' +
            '<td class="pd-mono pd-cell-dim" data-ptr="pending">…</td>' +
            '<td class="pd-mono">' + src.volume.toLocaleString() + '</td>' +
            '<td>' + (src.spfPass > 0 ? '<span class="pd-text-pass">pass</span>' : '<span class="pd-text-fail">fail</span>') + '</td>' +
            '<td>' + (src.dkimPass > 0 ? '<span class="pd-text-pass">pass</span>' : '<span class="pd-text-fail">fail</span>') + '</td>' +
            '<td>' + (src.dmarcPass > 0 ? '<span class="pd-text-pass">pass</span>' : '<span class="pd-text-fail">fail</span>') + '</td>' +
            '<td><button type="button" class="pd-btn pd-btn-xs ' + (mark === 'me' ? 'is-me' : '') + '" data-ip="' + esc(src.ip) + '" data-mark="' + (mark ?? '') + '">' + (mark === 'me' ? 'This is me' : mark === 'notme' ? 'Not me' : 'Mark') + '</button></td>';
          tbody.appendChild(tr);
        }
        tbody.querySelectorAll('button[data-ip]').forEach((b) => {
          b.addEventListener('click', async () => {
            const el = b as HTMLElement;
            const ip = el.dataset.ip!;
            const cur = el.dataset.mark;
            const next = cur === 'me' ? 'notme' : 'me';
            try {
              const res = await fetch('/api/domains/dmarc/mark', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id, ip, mark: next }) });
              const resp = await res.json() as { ok: boolean };
              if (resp.ok) {
                el.dataset.mark = next;
                b.textContent = next === 'me' ? 'This is me' : 'Not me';
                el.classList.toggle('is-me', next === 'me');
              }
            } catch { toast('fail', 'Could not reach the server.'); }
          });
        });
        const ptrCells = Array.from(tbody.querySelectorAll<HTMLTableCellElement>('td[data-ptr="pending"]'));
        await Promise.allSettled(srcs.slice(0, 20).map(async (src, i) => {
          const cell = ptrCells[i];
          if (!cell) return;
          if (src.ip.includes(':')) { cell.textContent = '-'; return; }
          const arpa = src.ip.split('.').reverse().join('.') + '.in-addr.arpa';
          try {
            const r = await lookup(arpa, 'PTR', RESOLVERS[0]);
            const host = r.answers.find((a) => a.type === 12)?.data.replace(/^"|"$/g, '').replace(/\.$/, '');
            cell.textContent = host || '-';
          } catch { cell.textContent = '-'; }
        }));
      } catch {
        box.innerHTML = '<div class="pd-panel"><p class="pd-panel-note">Could not load DMARC data.</p></div>';
      }
    }

    // ---------- alerts ----------
    async function loadAlerts() {
      const list = document.getElementById('alerts-list')!;
      const readBtn = document.getElementById('alerts-read') as HTMLButtonElement;
      list.innerHTML = '';
      const res = await fetch('/api/alerts');
      if (!res.ok) return;
      const data = await res.json() as { alerts: AlertRow[] };
      const alerts = data.alerts;
      const unread = alerts.filter((a) => !a.read_at).length;
      const badge = document.getElementById('nav-alert-count') as HTMLElement;
      badge.hidden = unread === 0;
      badge.textContent = String(unread);
      if (!alerts.length) {
        list.innerHTML = '<div class="pd-empty">No alerts. You will see one here the moment a monitored domain changes.</div>';
        readBtn.hidden = true;
        return;
      }
      readBtn.hidden = false;
      for (const a of alerts) {
        const box = document.createElement('div');
        box.className = 'pd-alert' + (a.read_at ? '' : ' is-unread');
        box.dataset.sev = a.severity;
        const sevChip = a.severity === 'fail' ? '<span class="pd-chip pd-chip-fail">fail</span>' : a.severity === 'warn' ? '<span class="pd-chip pd-chip-warn">warn</span>' : '<span class="pd-chip pd-chip-info">info</span>';
        box.innerHTML =
          '<div class="pd-alert-head">' + sevChip + '<span class="pd-alert-title">' + (a.read_at ? '' : '● ') + esc(a.title) + '</span><time class="pd-alert-time">' + a.created_at.slice(0, 16).replace('T', ' ') + ' UTC</time></div>' +
          '<div class="pd-alert-body"><p class="pd-alert-diff">' + esc(a.detail) + '</p></div>';
        box.querySelector('.pd-alert-head')!.addEventListener('click', () => box.classList.toggle('is-open'));
        list.appendChild(box);
      }
    }

    // ---------- charts ----------
    function drawBars(svg: SVGSVGElement, daily: DailyPoint[]) {
      const g = svg.querySelector('.pd-chart-bars');
      if (!g) return;
      const W = 640, H = 150, padL = 6, padB = 16, padT = 6;
      const n = Math.max(daily.length, 1);
      const bw = (W - padL * 2) / n;
      const maxTotal = Math.max(...daily.map((d) => d.total), 1);
      let out = '';
      daily.forEach((d, i) => {
        const x = padL + i * bw;
        const scale = (H - padB - padT) / maxTotal;
        const hp = d.passing * scale;
        const hf = (d.total - d.passing) * scale;
        out += '<rect x="' + (x + 1).toFixed(1) + '" y="' + (H - padB - hp - hf).toFixed(1) + '" width="' + Math.max(1.5, bw - 2.5).toFixed(1) + '" height="' + Math.max(0.5, hp).toFixed(1) + '" rx="1.5" fill="var(--pd-pass)" opacity="0.75"><title>' + d.date + ': ' + d.passing.toLocaleString() + ' passing</title></rect>';
        if (hf > 0.5) out += '<rect x="' + (x + 1).toFixed(1) + '" y="' + (H - padB - hf).toFixed(1) + '" width="' + Math.max(1.5, bw - 2.5).toFixed(1) + '" height="' + hf.toFixed(1) + '" rx="1.5" fill="var(--pd-fail)" opacity="0.8"><title>' + d.date + ': ' + (d.total - d.passing).toLocaleString() + ' failing</title></rect>';
        if (i % Math.ceil(n / 8) === 0) out += '<text x="' + (x + bw / 2).toFixed(1) + '" y="' + (H - 4) + '" font-size="9" fill="#64748b" text-anchor="middle" font-family="JetBrains Mono, monospace">' + d.date.slice(5) + '</text>';
      });
      g.innerHTML = out;
    }

    // ---------- wiring ----------
    document.querySelectorAll('#dash-shell [data-screen]').forEach((b) => {
      b.addEventListener('click', () => {
        const screen = (b as HTMLElement).dataset.screen!;
        show(screen);
        if (screen === 'overview') void loadOverview();
        if (screen === 'domains') void loadDomains();
        if (screen === 'dmarc') void loadDmarcScreen();
        if (screen === 'alerts') void loadAlerts();
      });
    });
    document.querySelectorAll('#dash-shell [data-goto]').forEach((b) => {
      b.addEventListener('click', () => show((b as HTMLElement).dataset.goto!));
    });

    document.querySelectorAll('.pd-tab').forEach((tab) => {
      tab.addEventListener('click', () => showDomainTab(tab.getAttribute('data-tab') ?? 'auth'));
    });

    document.getElementById('topbar-add')!.addEventListener('click', () => {
      show('domains');
      document.getElementById('add-panel')!.hidden = false;
      (document.getElementById('dom-input') as HTMLInputElement).focus();
    });
    document.getElementById('add-close')!.addEventListener('click', () => { document.getElementById('add-panel')!.hidden = true; });

    const form = document.getElementById('dom-form') as HTMLFormElement;
    const input = document.getElementById('dom-input') as HTMLInputElement;
    const domSubmit = document.getElementById('dom-submit') as HTMLButtonElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      domSubmit.disabled = true;
      domSubmit.textContent = 'Scanning…';
      try {
        const res = await fetch('/api/domains', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ domain: input.value }) });
        const data = await res.json() as { ok: boolean; error?: string; domain?: DomainRow };
        if (data.ok && data.domain) {
          const row: DomainRow = { ...data.domain, paused: false };
          toast('pass', row.domain + ' added and scanned.');
          input.value = '';
          document.getElementById('add-panel')!.hidden = true;
          await loadDomains();
          await loadOverview();
          await openDomain(row.id);
        } else {
          toast('fail', data.error ?? 'Could not add the domain.');
        }
      } catch {
        toast('fail', 'Could not reach the server.');
      }
      domSubmit.disabled = false;
      domSubmit.textContent = 'Add & scan';
    });

    document.getElementById('alerts-read')!.addEventListener('click', async () => {
      await fetch('/api/alerts/read', { method: 'POST' });
      await loadAlerts();
    });

    document.querySelectorAll('[data-theme-set]').forEach((b) => {
      b.addEventListener('click', () => applyTheme((b as HTMLElement).dataset.themeSet as 'dark' | 'light'));
    });

    document.querySelectorAll('#nav-user-menu [data-menu-goto]').forEach((b) => {
      b.addEventListener('click', () => {
        userMenu.hidden = true;
        userBtn.setAttribute('aria-expanded', 'false');
        show((b as HTMLElement).dataset.menuGoto!);
        void loadDomains();
        const target = (b as HTMLElement).dataset.menuScroll;
        if (target) document.getElementById(target)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });

    document.getElementById('ov-add')!.addEventListener('click', () => {
      show('domains');
      document.getElementById('add-panel')!.hidden = false;
      (document.getElementById('dom-input') as HTMLInputElement).focus();
    });

    const userBtn = document.getElementById('nav-user-btn')!;
    const userMenu = document.getElementById('nav-user-menu')!;
    userBtn.addEventListener('click', () => {
      const open = userMenu.hidden;
      userMenu.hidden = !open;
      userBtn.setAttribute('aria-expanded', String(open));
    });
    document.addEventListener('click', (e) => {
      if (!userMenu.hidden && !userMenu.contains(e.target as Node) && !userBtn.contains(e.target as Node)) {
        userMenu.hidden = true;
        userBtn.setAttribute('aria-expanded', 'false');
      }
    });
    document.getElementById('nav-signout')!.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/login/';
    });

    fetch('/api/auth/me')
      .then((r) => r.json())
      .then(async (d: { authenticated: boolean; email: string | null }) => {
        document.getElementById('dash-loading')!.hidden = true;
        if (d.authenticated) {
          (document.getElementById('nav-user-mail') as HTMLElement).textContent = d.email ?? '';
          (document.getElementById('set-email') as HTMLElement).textContent = d.email ?? '';
          document.getElementById('dash-shell')!.hidden = false;
          const lucideGlobal = (window as unknown as { lucide?: { createIcons(o: { attrs: { width: number; height: number } }): void } }).lucide;
          if (lucideGlobal) lucideGlobal.createIcons({ attrs: { width: 15, height: 15 } });
          show('overview');
          await loadDomains();
          await loadOverview();
          void loadAlerts();
        } else {
          document.getElementById('dash-signed-out')!.hidden = false;
        }
      })
      .catch(() => {
        (document.getElementById('dash-loading') as HTMLElement).textContent = 'Could not reach the server.';
      });
  </script>
</div>
