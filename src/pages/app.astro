---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Your Account"
  description="Your PromptDNS account: domains you monitor and their latest scan."
  noindex
>
  <div class="mx-auto max-w-4xl px-4 py-16">
    <p id="app-state" class="font-mono text-xs uppercase tracking-[0.2em] text-accent">Checking sign-in…</p>

    <div id="app-signed-out" class="mt-6 hidden">
      <h1 class="font-display text-3xl font-bold tracking-tight text-ink">You are not signed in</h1>
      <p class="mt-3 text-sm text-ink-dim">Sign in with an email link to continue.</p>
      <a href="/login/" class="btn-cta btn-shimmer mt-6 inline-flex px-5 py-2.5 text-sm">Go to sign in</a>
    </div>

    <div id="app-signed-in" class="mt-6 hidden">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <div>
          <h1 class="font-display text-3xl font-bold tracking-tight text-ink">Your account</h1>
          <p class="mt-1 text-sm text-ink-dim">Signed in as <span id="app-email" class="font-mono text-accent"></span></p>
        </div>
        <button id="app-logout" class="rounded-lg border border-line bg-panel-2 px-4 py-2 text-xs font-semibold text-ink-dim transition-colors hover:border-fail/40 hover:text-fail">Sign out</button>
      </div>

      <div class="mt-8 rounded-xl border border-line bg-panel/60 p-6">
        <h2 class="font-display text-lg font-bold text-ink">Add a domain</h2>
        <p class="mt-1 text-sm text-ink-dim">
          Adding a domain runs an instant scan of its DNS and email authentication. Up to
          <span class="font-mono text-accent" id="app-max">3</span> domains while monitoring is in
          development.
        </p>
        <form id="dom-form" class="mt-4 flex flex-col gap-3 sm:flex-row">
          <label class="sr-only" for="dom-input">Domain</label>
          <input id="dom-input" type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder="yourdomain.com"
            class="flex-1 rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30" />
          <button type="submit" id="dom-submit" class="btn-cta btn-shimmer px-5 py-2.5 text-sm">Add &amp; scan</button>
        </form>
        <div id="dom-msg" class="mt-4 hidden rounded-md px-4 py-3 text-sm font-medium"></div>
      </div>

      <div class="mt-8">
        <h2 class="font-display text-lg font-bold text-ink">Your domains</h2>
        <div id="dom-list" class="mt-4 grid gap-3"></div>
        <p class="mt-3 text-xs text-ink-faint">
          Scores use the same checks as the <a href="/" class="text-accent hover:text-accent-soft">homepage scanner</a>
          (<a href="/methodology/" class="text-accent hover:text-accent-soft">methodology</a>). Every domain is
          re-checked automatically every 6 hours; a new snapshot is stored and an alert is raised only when
          something actually changes. Alert emails arrive once email delivery is configured.
        </p>
      </div>

      <div class="mt-10">
        <div class="flex items-center justify-between gap-3">
          <h2 class="font-display text-lg font-bold text-ink">Alerts</h2>
          <button id="alerts-read" class="hidden rounded-lg border border-line bg-panel-2 px-3 py-1.5 text-xs font-semibold text-ink-dim hover:border-accent/40 hover:text-ink">Mark all read</button>
        </div>
        <div id="alerts-list" class="mt-4 grid gap-2"></div>
      </div>
    </div>
  </div>

  <script>
    import { lookup, RESOLVERS } from '../lib/doh';

    type ScanCheck = { id: string; label: string; status: string; value: string; earned: number; weight: number };
    type DomainRow = { id: number; domain: string; paused: boolean; score: number | null; grade: string | null; checkedAt: string | null; checks: ScanCheck[] | null };

    const state = document.getElementById('app-state')!;
    const signedOut = document.getElementById('app-signed-out')!;
    const signedIn = document.getElementById('app-signed-in')!;

    const GRADE_CLASS: Record<string, string> = {
      A: 'text-pass border-pass/40 bg-pass/10',
      B: 'text-pass border-pass/40 bg-pass/10',
      C: 'text-warn border-warn/40 bg-warn/10',
      D: 'text-warn border-warn/40 bg-warn/10',
      F: 'text-fail border-fail/40 bg-fail/10',
    };

    const showMsg = (cls: string, text: string) => {
      showTransient(document.getElementById('dom-msg')!, `mt-4 rounded-md px-4 py-3 text-sm font-medium ${cls}`, text);
    };

    const AUTO_DISMISS_MS = 6000;
    const dismissTimers = new WeakMap<HTMLElement, number>();

    function showTransient(el: HTMLElement, cls: string, text: string) {
      el.className = cls;
      el.textContent = '';
      el.appendChild(document.createTextNode(text));
      const x = document.createElement('button');
      x.type = 'button';
      x.className = 'float-right ml-2 leading-none text-ink-faint hover:text-ink';
      x.setAttribute('aria-label', 'Dismiss message');
      x.textContent = '\u00d7';
      x.addEventListener('click', () => {
        const t = dismissTimers.get(el);
        if (t) clearTimeout(t);
        el.classList.add('hidden');
      });
      el.appendChild(x);
      el.classList.remove('hidden');
      const prev = dismissTimers.get(el);
      if (prev) clearTimeout(prev);
      const wait = cls.includes('fail') || cls.includes('warn') ? AUTO_DISMISS_MS * 2 : AUTO_DISMISS_MS;
      dismissTimers.set(el, window.setTimeout(() => el.classList.add('hidden'), wait));
    }

    function setCardStatus(domain: string, cls: string, text: string) {
      const card = document.querySelector<HTMLElement>(`[data-domain="${CSS.escape(domain)}"]`);
      const el = card?.querySelector<HTMLElement>('.card-status');
      if (!el) return;
      showTransient(el, `card-status mt-3 rounded-md px-3 py-2 text-xs font-medium ${cls}`, text);
    }

    function domainCard(d: DomainRow): HTMLElement {
      const card = document.createElement('div');
      card.className = 'rounded-xl border border-line bg-panel/60 p-5';
      card.dataset.domain = d.domain;
      const head = document.createElement('div');
      head.className = 'flex flex-wrap items-center justify-between gap-3';
      const left = document.createElement('div');
      left.className = 'flex items-center gap-2 flex-wrap';
      const monitorChip = document.createElement('span');
      monitorChip.className = d.paused
        ? 'rounded-full border border-warn/30 bg-warn/10 px-2 py-0.5 font-mono text-[10px] text-warn'
        : 'rounded-full border border-pass/30 bg-pass/10 px-2 py-0.5 font-mono text-[10px] text-pass';
      monitorChip.title = d.paused
        ? 'Automatic monitoring is paused for this domain. Resume to re-enter the 6-hour cycle.'
        : 'This domain is re-checked automatically every 6 hours';
      monitorChip.textContent = d.paused ? '● paused' : '● monitored';
      left.appendChild(monitorChip);
      const name = document.createElement('span');
      name.className = 'font-mono text-sm font-semibold text-ink';
      name.textContent = d.domain;
      left.appendChild(name);
      head.appendChild(left);
      const right = document.createElement('div');
      right.className = 'flex items-center gap-3';
      if (d.grade) {
        const badge = document.createElement('span');
        badge.className = `rounded border px-2 py-0.5 font-mono text-xs ${GRADE_CLASS[d.grade] ?? 'text-ink border-line'}`;
        badge.textContent = `${d.score}/100 - ${d.grade}`;
        right.appendChild(badge);
      }
      const scanNow = document.createElement('button');
      scanNow.className = 'text-xs font-medium text-accent hover:text-accent-soft';
      scanNow.textContent = 'Scan now';
      scanNow.addEventListener('click', async () => {
        scanNow.disabled = true;
        scanNow.textContent = 'Scanning…';
        try {
          const res = await fetch(`/api/domains/rescan?id=${d.id}`, { method: 'POST' });
          const data = (await res.json()) as { ok: boolean; error?: string; changed?: boolean; score?: number; grade?: string; checks?: ScanCheck[] };
          if (data.ok) {
            const when = card.querySelector<HTMLElement>('.last-scanned');
            if (when) when.textContent = `Last scanned: ${new Date().toISOString().replace('T', ' ').slice(0, 16)} UTC`;
            if (data.changed && data.checks) {
              const newRow: DomainRow = { ...d, score: data.score ?? d.score, grade: data.grade ?? d.grade, checks: data.checks, checkedAt: new Date().toISOString() };
              card.replaceWith(domainCard(newRow));
              void loadAlerts();
            }
            setCardStatus(
              d.domain,
              data.changed
                ? 'bg-warn/10 text-warn border border-warn/30'
                : 'bg-pass/10 text-pass border border-pass/30',
              data.changed
                ? 'Something changed on this check - new snapshot stored, alert added below.'
                : 'Re-checked just now: no changes since the last snapshot.',
            );
          } else {
            setCardStatus(d.domain, 'bg-fail/10 text-fail border border-fail/30', data.error ?? 'Rescan failed.');
          }
        } catch {
          setCardStatus(d.domain, 'bg-warn/10 text-warn border border-warn/30', 'Could not reach the server.');
        }
        scanNow.disabled = false;
        scanNow.textContent = 'Scan now';
      });
      right.appendChild(scanNow);
      const del = document.createElement('button');
      del.className = 'text-xs text-ink-faint hover:text-fail';
      del.textContent = 'Remove';
      del.addEventListener('click', async () => {
        del.disabled = true;
        try {
          const res = await fetch(`/api/domains/delete?id=${d.id}`, { method: 'POST' });
          const data = (await res.json()) as { ok: boolean; error?: string };
          if (data.ok) {
            card.remove();
            ensureEmptyState();
            void loadAlerts();
            showMsg('bg-pass/10 text-pass border border-pass/30', `${d.domain} removed from monitoring. You can add it again anytime.`);
            return;
          }
          showMsg('bg-fail/10 text-fail border border-fail/30', data.error ?? 'Could not remove the domain.');
        } catch {
          showMsg('bg-warn/10 text-warn border border-warn/30', 'Could not reach the server.');
        }
        del.disabled = false;
      });
      right.appendChild(del);
      head.appendChild(right);
      card.appendChild(head);

      if (d.checks?.length) {
        const grid = document.createElement('div');
        grid.className = 'mt-3 grid gap-1.5 sm:grid-cols-2';
        for (const c of d.checks) {
          const row = document.createElement('div');
          row.className = 'flex items-center justify-between gap-2 text-xs';
          const icon = c.status === 'pass' ? '✔' : c.status === 'warn' ? '▲' : '✕';
          const cls = c.status === 'pass' ? 'text-pass' : c.status === 'warn' ? 'text-warn' : 'text-fail';
          row.innerHTML = `<span class="${cls}">${icon}</span><span class="text-ink-dim">${c.label}</span><span class="ml-auto font-mono text-ink-faint">${c.value}</span>`;
          grid.appendChild(row);
        }
        card.appendChild(grid);
      }
      if (d.checkedAt) {
        const when = document.createElement('p');
        when.className = 'last-scanned mt-3 font-mono text-[10px] text-ink-faint';
        when.textContent = `Last scanned: ${d.checkedAt.replace('T', ' ').slice(0, 16)} UTC`;
        card.appendChild(when);
      }

      const cardStatus = document.createElement('div');
      cardStatus.className = 'card-status mt-3 hidden rounded-md px-3 py-2 text-xs font-medium';
      card.appendChild(cardStatus);

      const report = document.createElement('div');
      report.className = 'domain-report mt-3 hidden rounded-lg border border-line bg-panel/40 p-4';
      card.appendChild(report);

      const dmarcPanel = document.createElement('div');
      dmarcPanel.className = 'dmarc-panel mt-3 hidden rounded-lg border border-line bg-panel/40 p-4';
      card.appendChild(dmarcPanel);

      const actions = document.createElement('div');
      actions.className = 'mt-3 flex flex-wrap items-center gap-3 border-t border-line pt-3';
      const reportBtn = document.createElement('button');
      reportBtn.className = 'text-xs font-medium text-accent hover:text-accent-soft';
      reportBtn.textContent = 'Monitoring report';
      reportBtn.addEventListener('click', () => toggleReport(reportBtn, report, d));
      actions.appendChild(reportBtn);
      const dmarcBtn = document.createElement('button');
      dmarcBtn.className = 'text-xs font-medium text-accent hover:text-accent-soft';
      dmarcBtn.textContent = 'DMARC sources';
      dmarcBtn.addEventListener('click', () => toggleDmarc(dmarcBtn, dmarcPanel, d));
      actions.appendChild(dmarcBtn);
      const pauseBtn = document.createElement('button');
      pauseBtn.className = 'text-xs text-ink-faint hover:text-warn';
      pauseBtn.textContent = d.paused ? 'Resume monitoring' : 'Pause monitoring';
      pauseBtn.addEventListener('click', async () => {
        pauseBtn.disabled = true;
        try {
          const res = await fetch('/api/domains/pause', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: d.id, paused: !d.paused }),
          });
          const data = (await res.json()) as { ok: boolean; paused: boolean };
          if (data.ok) {
            d.paused = data.paused;
            monitorChip.className = d.paused
              ? 'rounded-full border border-warn/30 bg-warn/10 px-2 py-0.5 font-mono text-[10px] text-warn'
              : 'rounded-full border border-pass/30 bg-pass/10 px-2 py-0.5 font-mono text-[10px] text-pass';
            monitorChip.title = d.paused
              ? 'Automatic monitoring is paused for this domain. Resume to re-enter the 6-hour cycle.'
              : 'This domain is re-checked automatically every 6 hours';
            monitorChip.textContent = d.paused ? '\u25cf paused' : '\u25cf monitored';
            pauseBtn.textContent = d.paused ? 'Resume monitoring' : 'Pause monitoring';
          }
        } finally {
          pauseBtn.disabled = false;
        }
      });
      actions.appendChild(pauseBtn);
      card.appendChild(actions);
      return card;
    }

    const ptrName = (ip: string) => ip.includes(':') ? null : `${ip.split('.').reverse().join('.')}.in-addr.arpa`;

    async function toggleDmarc(btn: HTMLButtonElement, box: HTMLElement, d: DomainRow) {
      if (!box.classList.contains('hidden')) {
        box.classList.add('hidden');
        btn.textContent = 'DMARC sources';
        return;
      }
      btn.textContent = 'Hide DMARC';
      box.textContent = '';
      box.classList.remove('hidden');
      const loading = document.createElement('p');
      loading.className = 'text-xs text-ink-faint';
      loading.textContent = 'Loading…';
      box.appendChild(loading);
      try {
        const res = await fetch(`/api/domains/dmarc?id=${d.id}`);
        const data = (await res.json()) as {
          ok: boolean;
          error?: string;
          summary?: { reports: number; messages: number; orgs: number; passRate: number | null };
          sources?: { ip: string; volume: number; dmarcPass: number; spfPass: number; dkimPass: number; disposition: string; lastReport: string | null }[];
          reports?: { org_name: string; report_id: string; date_begin: string | null; date_end: string | null; messages_total: number }[];
        };
        box.textContent = '';
        if (!data.ok) {
          const err = document.createElement('p');
          err.className = 'text-xs text-fail';
          err.textContent = data.error ?? 'Could not load DMARC data.';
          box.appendChild(err);
          return;
        }

        const title = document.createElement('p');
        title.className = 'text-xs font-semibold text-ink';
        title.textContent = 'Who is sending email as your domain (from aggregate reports)';
        box.appendChild(title);

        if (!data.summary || data.summary.reports === 0) {
          const empty = document.createElement('div');
          empty.className = 'mt-2 text-xs leading-relaxed text-ink-dim';
          empty.innerHTML =
            'No reports received yet. Setup:' +
            '<ol class="mt-1 list-decimal space-y-1 pl-5">' +
            '<li>Publish your DMARC record with <code class="font-mono">rua=mailto:reports@promptdns.com</code> - the <a href="/dmarc-record-generator/" class="text-accent">record generator</a> builds it.</li>' +
            '<li>First aggregate reports from Gmail, Microsoft, and Yahoo typically arrive within 24-48 hours of the record going live.</li>' +
            '<li>Reports show up here automatically; nothing else to configure.</li>' +
            '</ol>';
          box.appendChild(empty);
          return;
        }

        const sum = data.summary;
        const cards = document.createElement('div');
        cards.className = 'mt-2 grid grid-cols-2 gap-2 sm:grid-cols-4';
        for (const [label, value] of [
          ['Reports received', String(sum.reports)],
          ['Messages analyzed', sum.messages.toLocaleString()],
          ['DMARC pass rate', sum.passRate === null ? 'n/a' : `${sum.passRate}%`],
          ['Reporting providers', String(sum.orgs)],
        ] as [string, string][]) {
          const cell = document.createElement('div');
          cell.className = 'rounded-lg border border-line bg-panel/60 p-2.5 text-center';
          cell.innerHTML = `<div class="font-display text-lg font-bold text-accent">${value}</div><div class="text-[10px] text-ink-faint">${label}</div>`;
          cards.appendChild(cell);
        }
        box.appendChild(cards);

        const srcTitle = document.createElement('p');
        srcTitle.className = 'mt-3 text-xs font-semibold text-ink';
        srcTitle.textContent = 'Sources (aggregated across reports)';
        box.appendChild(srcTitle);

        const table = document.createElement('table');
        table.className = 'mt-2 w-full text-left text-xs';
        table.innerHTML = '<thead><tr class="text-ink-faint"><th class="py-1 font-medium">Source IP</th><th class="font-medium">Host (PTR)</th><th class="font-medium">Volume</th><th class="font-medium">SPF</th><th class="font-medium">DKIM</th><th class="font-medium">DMARC</th></tr></thead>';
        const tbody = document.createElement('tbody');
        box.appendChild(table);
        table.appendChild(tbody);
        const sources = data.sources ?? [];
        for (const src of sources) {
          const tr = document.createElement('tr');
          tr.className = 'border-t border-line/60';
          const pass = (n: number) => (n > 0 ? '<span class="text-pass">pass</span>' : '<span class="text-fail">fail</span>');
          const known = src.dmarcPass > 0;
          tr.innerHTML =
            `<td class="py-1 font-mono text-[11px] text-ink">${src.ip}</td>` +
            '<td class="font-mono text-[11px] text-ink-faint" data-ptr="pending">…</td>' +
            `<td class="font-mono text-[11px] text-ink-dim">${src.volume.toLocaleString()}</td>` +
            `<td>${pass(src.spfPass)}</td><td>${pass(src.dkimPass)}</td>` +
            `<td>${known ? pass(src.dmarcPass) : '<span class="text-warn">unknown</span>'}</td>`;
          tbody.appendChild(tr);
        }
        // PTR resolution (first 20, sequential-light via Promise.allSettled)
        const ptrCells = Array.from(tbody.querySelectorAll<HTMLTableCellElement>('td[data-ptr="pending"]'));
        await Promise.allSettled(sources.slice(0, 20).map(async (src, i) => {
          const arpa = ptrName(src.ip);
          const cell = ptrCells[i];
          if (!arpa || !cell) return;
          try {
            const r = await lookup(arpa, 'PTR', RESOLVERS[0]);
            const host = r.answers.find((a) => a.type === 12)?.data.replace(/^"|"$/g, '').replace(/\.$/, '');
            if (host) cell.textContent = host;
            else cell.textContent = '-';
          } catch {
            cell.textContent = '-';
          }
        }));

        const repTitle = document.createElement('p');
        repTitle.className = 'mt-3 text-xs font-semibold text-ink';
        repTitle.textContent = 'Recent reports';
        box.appendChild(repTitle);
        const repList = document.createElement('ul');
        repList.className = 'mt-1 space-y-0.5';
        for (const r of data.reports ?? []) {
          const li = document.createElement('li');
          li.className = 'text-xs text-ink-dim';
          li.textContent = `${r.org_name}: ${r.messages_total.toLocaleString()} messages (${r.date_begin ?? '?'} to ${r.date_end ?? '?'})`;
          repList.appendChild(li);
        }
        box.appendChild(repList);
      } catch {
        box.textContent = '';
        const err = document.createElement('p');
        err.className = 'text-xs text-fail';
        err.textContent = 'Could not load DMARC data.';
        box.appendChild(err);
      }
    }

    async function toggleReport(btn: HTMLButtonElement, box: HTMLElement, d: DomainRow) {
      if (!box.classList.contains('hidden')) {
        box.classList.add('hidden');
        btn.textContent = 'Monitoring report';
        return;
      }
      btn.textContent = 'Hide report';
      box.textContent = '';
      box.classList.remove('hidden');
      const loading = document.createElement('p');
      loading.className = 'text-xs text-ink-faint';
      loading.textContent = 'Loading…';
      box.appendChild(loading);
      try {
        const res = await fetch(`/api/domains/history?id=${d.id}`);
        const data = (await res.json()) as {
          runs: { outcome: string; score: number | null; changes: number; ran_at: string }[];
          alerts: { severity: string; title: string; detail: string; created_at: string; read_at: string | null }[];
        };
        box.textContent = '';

        const what = document.createElement('p');
        what.className = 'text-xs leading-relaxed text-ink-dim';
        what.innerHTML = '<strong class="text-ink">What is monitored:</strong> website DNS (A/AAAA), nameservers, mail routing (MX), SPF (validity + lookup count), DMARC (policy), DKIM (common selectors), DNSSEC (DS record). Checks and weights follow the <a href="/methodology/" class="text-accent">methodology</a>. Cadence: every 6 hours.';
        box.appendChild(what);

        const logTitle = document.createElement('p');
        logTitle.className = 'mt-3 text-xs font-semibold text-ink';
        logTitle.textContent = 'Scan activity (last 30 runs)';
        box.appendChild(logTitle);

        if (!data.runs.length) {
          const none = document.createElement('p');
          none.className = 'mt-1 text-xs text-ink-faint';
          none.textContent = 'No runs logged yet. Automatic runs appear here every 6 hours; "Scan now" also logs a run.';
          box.appendChild(none);
        } else {
          const table = document.createElement('table');
          table.className = 'mt-2 w-full text-left text-xs';
          table.innerHTML = '<thead><tr class="text-ink-faint"><th class="py-1 font-medium">Time (UTC)</th><th class="font-medium">Result</th><th class="font-medium">Score</th></tr></thead>';
          const tbody = document.createElement('tbody');
          for (const r of data.runs) {
            const tr = document.createElement('tr');
            tr.className = 'border-t border-line/60';
            const outcome = r.outcome === 'changed'
              ? `<span class="text-warn">changed (${r.changes})</span>`
              : r.outcome === 'unresolvable'
                ? '<span class="text-fail">unresolvable</span>'
                : '<span class="text-pass">no changes</span>';
            tr.innerHTML = `<td class="py-1 font-mono text-[11px] text-ink-dim">${r.ran_at.replace('T', ' ').slice(0, 16)}</td><td>${outcome}</td><td class="font-mono text-ink-dim">${r.score === null ? 'n/a' : `${r.score}/100`}</td>`;
            tbody.appendChild(tr);
          }
          table.appendChild(tbody);
          box.appendChild(table);
        }

        const alertTitle = document.createElement('p');
        alertTitle.className = 'mt-3 text-xs font-semibold text-ink';
        alertTitle.textContent = `Alerts for this domain (${data.alerts.length})`;
        box.appendChild(alertTitle);
        if (!data.alerts.length) {
          const none = document.createElement('p');
          none.className = 'mt-1 text-xs text-ink-faint';
          none.textContent = 'None - nothing has changed since monitoring started.';
          box.appendChild(none);
        } else {
          for (const a of data.alerts) {
            const p = document.createElement('p');
            p.className = 'mt-1 text-xs text-ink-dim';
            p.textContent = `${a.created_at.replace('T', ' ').slice(0, 16)} - ${a.title}: ${a.detail.split('\n').join(' / ')}`;
            box.appendChild(p);
          }
        }
      } catch {
        box.textContent = '';
        const err = document.createElement('p');
        err.className = 'text-xs text-fail';
        err.textContent = 'Could not load the report.';
        box.appendChild(err);
      }
    }

    async function loadDomains() {
      const list = document.getElementById('dom-list')!;
      list.textContent = '';
      const res = await fetch('/api/domains');
      if (!res.ok) return;
      const data = (await res.json()) as { domains: DomainRow[]; max: number };
      (document.getElementById('app-max') as HTMLElement).textContent = String(data.max);
      if (!data.domains.length) {
        const empty = document.createElement('p');
        empty.className = 'empty-state rounded-xl border border-dashed border-line bg-panel/40 p-6 text-center text-sm text-ink-faint';
        empty.textContent = 'No domains yet. Add one above and the first scan runs immediately.';
        list.appendChild(empty);
        return;
      }
      for (const d of data.domains) list.appendChild(domainCard(d));
    }

    function ensureEmptyState() {
      const list = document.getElementById('dom-list')!;
      if (list.querySelector('[data-domain]')) return;
      list.textContent = '';
      const empty = document.createElement('p');
      empty.className = 'empty-state rounded-xl border border-dashed border-line bg-panel/40 p-6 text-center text-sm text-ink-faint';
      empty.textContent = 'No domains yet. Add one above and the first scan runs immediately.';
      list.appendChild(empty);
    }

    async function loadAlerts() {
      const list = document.getElementById('alerts-list')!;
      const readBtn = document.getElementById('alerts-read')!;
      list.textContent = '';
      const res = await fetch('/api/alerts');
      if (!res.ok) return;
      const data = (await res.json()) as { alerts: { id: number; severity: string; title: string; detail: string; created_at: string; read_at: string | null; domain: string }[] };
      const alerts = data.alerts;
      if (!alerts.length) {
        const empty = document.createElement('p');
        empty.className = 'rounded-xl border border-dashed border-line bg-panel/40 p-6 text-center text-sm text-ink-faint';
        empty.textContent = 'No alerts. You will see one here the moment a monitored domain changes.';
        list.appendChild(empty);
        readBtn.classList.add('hidden');
        return;
      }
      const hasUnread = alerts.some((a) => !a.read_at);
      readBtn.classList.toggle('hidden', !hasUnread);
      const SEV_CLASS: Record<string, string> = {
        fail: 'border-fail/30 bg-fail/5',
        warn: 'border-warn/30 bg-warn/5',
        info: 'border-line bg-panel/40',
      };
      for (const a of alerts) {
        const box = document.createElement('div');
        box.className = `rounded-xl border p-4 ${SEV_CLASS[a.severity] ?? SEV_CLASS.info}`;
        const head = document.createElement('div');
        head.className = 'flex flex-wrap items-center justify-between gap-2';
        const title = document.createElement('p');
        title.className = a.read_at ? 'text-sm text-ink-dim' : 'text-sm font-semibold text-ink';
        title.textContent = (a.read_at ? '' : '● ') + a.title;
        head.appendChild(title);
        const when = document.createElement('time');
        when.className = 'font-mono text-[10px] text-ink-faint';
        when.textContent = a.created_at.replace('T', ' ').slice(0, 16) + ' UTC';
        head.appendChild(when);
        box.appendChild(head);
        for (const line of a.detail.split('\n')) {
          const p = document.createElement('p');
          p.className = 'mt-1 font-mono text-xs text-ink-dim';
          p.textContent = line;
          box.appendChild(p);
        }
        list.appendChild(box);
      }
    }

    document.getElementById('alerts-read')?.addEventListener('click', async () => {
      await fetch('/api/alerts/read', { method: 'POST' });
      await loadAlerts();
    });

    const form = document.getElementById('dom-form') as HTMLFormElement;
    const input = document.getElementById('dom-input') as HTMLInputElement;
    const btn = document.getElementById('dom-submit') as HTMLButtonElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = 'Scanning…';
      try {
        const res = await fetch('/api/domains', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ domain: input.value }),
        });
        const data = (await res.json()) as { ok: boolean; error?: string; domain?: DomainRow };
        if (data.ok && data.domain) {
          const row: DomainRow = { ...data.domain, paused: false };
          document.querySelector('#dom-list .empty-state')?.remove();
          document.getElementById('dom-list')!.appendChild(domainCard(row));
          showMsg('bg-pass/10 text-pass border border-pass/30', `${row.domain} added and scanned.`);
          input.value = '';
        } else {
          showMsg('bg-fail/10 text-fail border border-fail/30', data.error ?? 'Could not add the domain.');
        }
      } catch {
        showMsg('bg-warn/10 text-warn border border-warn/30', 'Could not reach the server. Try again.');
      }
      btn.disabled = false;
      btn.textContent = 'Add & scan';
    });

    document.getElementById('app-logout')?.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/login/';
    });

    fetch('/api/auth/me')
      .then((r) => r.json())
      .then((d: { authenticated: boolean; email: string | null }) => {
        state.classList.add('hidden');
        if (d.authenticated) {
          (document.getElementById('app-email') as HTMLElement).textContent = d.email ?? '';
          signedIn.classList.remove('hidden');
          void loadDomains();
          void loadAlerts();
        } else {
          signedOut.classList.remove('hidden');
        }
      })
      .catch(() => {
        state.textContent = 'Could not reach the server.';
        signedOut.classList.remove('hidden');
      });
  </script>
</BaseLayout>
