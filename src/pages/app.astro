      const roleSel = E('select', { class: 'sel', style: 'width:100%', onchange: (e: any) => { x.r = e.target.value; } }, ['Admin', 'Analyst', 'Viewer'].map((o) => E('option', {}, o)));
      $('#ly').replaceChildren(
        E('div', { class: 'ov', onclick: cdr }),
        E('aside', { class: 'dr', role: 'dialog', 'aria-label': 'Invite teammate' },
          E('div', { class: 'fx sp' }, E('h1', {}, 'Invite teammate'), E('button', { class: 'btn', onclick: cdr }, 'Close')),
          row('Email', emailIn),
          row('Role', roleSel),
          row('Access', E('select', { class: 'sel', style: 'width:100%' }, ['All clients'].concat(WS.map((w) => w.n)).map((o) => E('option', {}, o)))),
          E('div', { class: 'fx' },
            E('button', { class: 'btn p', onclick: () => { if (!/.+@.+/.test(x.e)) return toast('Enter a valid email'); MEMS.push({ n: x.e.split('@')[0], e: x.e, r: x.r, a: x.a, la: 'Pending invite' }); cdr(); toast('Preview: invite stored locally'); go(); } }, 'Send invite'),
            E('button', { class: 'btn', onclick: cdr }, 'Cancel'))));
    }

    // ================= billing (plans are sample until Dodo is live) =================
    const PLANS: [string, number, number, string, string[]][] = [
      ['Starter', 19, 3, '90 days', ['Report explorer', 'Sources manager', 'DNS change alerts']],
      ['Pro', 49, 10, '1 year', ['Managed DMARC and SPF', 'Cloudflare connect', 'AI access monitor', 'Slack and webhooks']],
      ['Business', 99, 25, '1 year', ['White-label reports', 'Agency workspaces', 'API access', 'TLS-RPT and MTA-STS']],
    ];
    function cfp(n: string) {
      const t = PLANS.find((x) => x[0] === n)!;
      $('#ly').replaceChildren(
        E('div', { class: 'ov', onclick: cdr }),
        E('aside', { class: 'dr', role: 'dialog', 'aria-label': 'Switch to ' + n },
          E('div', { class: 'fx sp' }, E('h1', {}, 'Switch to ' + n), E('button', { class: 'btn', onclick: cdr }, 'Close')),
          E('div', { class: 'li' }, 'New plan', E('b', {}, n + ' - $' + t[1] + '/mo, ' + t[2] + ' domains')),
          E('div', { class: 'li' }, 'Domains after switch', E('b', {}, t[2] + ' (your ' + DOMS.length + ' carry over)')),
          E('div', { class: 'li', style: 'background:var(--ws);padding:10px;border-radius:10px' }, 'Billing activates when Dodo Payments is approved. Nothing is charged today.'),
          E('div', { class: 'fx', style: 'margin-top:16px' },
            E('button', { class: 'btn p', onclick: () => { cdr(); toast('Preview: plan changes unlock with Dodo Payments.'); } }, 'Confirm change'),
            E('button', { class: 'btn', onclick: cdr }, 'Keep current plan'))));
    }
    const BIL: any = { xd: 0, lh: 0, inv: [{ d: 'Oct 1, 2026', n: 'Business plan, monthly', a: 99, s: 'Paid' }, { d: 'Sep 1, 2026', n: 'Business plan, monthly', a: 99, s: 'Paid' }, { d: 'Aug 1, 2026', n: 'Upgrade to Pro, prorated', a: 34.3, s: 'Paid' }] };
    function bil() {
      const msgs = OV && OV.dmarc ? OV.dmarc.messages || 0 : 0;
      const meter = (l: string, v: number, mx: number, t: string) => E('div', { style: 'margin:10px 0' }, E('div', { class: 'fx sp sub' }, l, E('b', { style: 'color:var(--ink)' }, t)), bar(Math.min(100, v / mx * 100)));
      const cur = E('div', { class: 'cd' }, E('div', { class: 'fx sp' }, E('h3', {}, 'Current plan'), pill('Active', 'ok')),
        E('div', { style: 'margin:10px 0' }, E('span', { class: 'k' }, 'Early access'), E('span', { class: 'sub' }, '  free during development')),
        E('div', { class: 'sub', style: 'margin:10px 0' }, 'Paid plans switch on when Dodo Payments approves the merchant account. Your domains and history carry over.'),
        E('div', { class: 'fx' }, E('button', { class: 'btn', onclick: () => { const el = document.getElementById('plans-card'); if (el) el.scrollIntoView({ behavior: 'smooth' }); } }, 'See paid plans')));
      const pay = E('div', { class: 'cd' }, E('h3', {}, 'Payment method'),
        E('div', { class: 'li' }, E('div', {}, 'No card on file', E('small', {}, 'Nothing is billed during early access')), pill('Awaiting Dodo', 'wn')),
        E('div', { class: 'sub', style: 'margin:8px 0 10px' }, 'Payments, tax and invoices will be handled by Dodo Payments, our merchant of record.'),
        E('button', { class: 'btn', onclick: () => toast('Preview: payment setup unlocks with Dodo Payments.') }, 'Update payment method'));
      const use = E('div', { class: 'cd' }, E('h3', {}, 'Usage this period'),
        meter('Domains', DOMS.length, MAXD, DOMS.length + ' of ' + MAXD),
        meter('Team seats', 1, 10, '1 of 10'),
        meter('DMARC messages processed', msgs, 2500000, f(msgs) + ' of 2.5M fair use / mo'));
      const plans = E('div', { class: 'cd' }, E('div', { class: 'fx sp', style: 'margin-bottom:10px' }, E('h3', {}, 'Plans'), prev()),
        E('div', { class: 'g', style: 'grid-template-columns:repeat(auto-fit,minmax(200px,1fr));margin:0' }, PLANS.map((x) => E('div', { class: 'cd', style: 'margin:0' },
          E('div', { class: 'fx sp' }, E('b', {}, x[0])),
          E('div', { style: 'margin:8px 0' }, E('span', { class: 'k' }, '$' + x[1]), E('span', { class: 'sub' }, ' /mo')),
          E('div', { class: 'sub' }, x[2] + ' domains, ' + x[3] + ' history'),
          E('ul', { style: 'padding-left:18px;margin:8px 0 12px' }, x[4].map((fl) => E('li', {}, fl))),
          E('button', { class: 'btn p', onclick: () => cfp(x[0]) }, 'Switch to ' + x[0])))));
      const addons = E('div', { class: 'cd' }, E('div', { class: 'fx sp' }, E('h3', {}, 'Add-ons'), prev()),
        E('div', { class: 'li' }, E('div', {}, 'Extra domains', E('small', {}, '$4 per domain per month')), E('div', { class: 'fx' },
          E('button', { class: 'btn', 'aria-label': 'Remove an extra domain', disabled: !BIL.xd, onclick: () => { BIL.xd--; go(); } }, '-'),
          E('b', { class: 'm' }, String(BIL.xd)),
          E('button', { class: 'btn', 'aria-label': 'Add an extra domain', onclick: () => { BIL.xd++; go(); } }, '+'))),
        E('div', { class: 'li' }, E('div', {}, 'Longer report history (3 extra years)', E('small', {}, '$9 per month')),
          E('button', { class: 'sw' + (BIL.lh ? ' on' : ''), role: 'switch', 'aria-checked': !!BIL.lh, 'aria-label': 'Longer history', onclick: () => { BIL.lh = BIL.lh ? 0 : 1; go(); } })),
        E('div', { class: 'sub', style: 'margin-top:8px' }, 'Add-ons activate with the first paid cycle.'));
      const invs = E('div', { class: 'cd' }, E('div', { class: 'fx sp', style: 'margin-bottom:10px' }, E('h3', {}, 'Invoices'), prev()),
        E('div', { class: 'sc' }, E('table', {},
          E('thead', {}, E('tr', {}, ['Date', 'Description', 'Amount', 'Status', ''].map((x) => E('th', {}, x)))),
          E('tbody', {}, BIL.inv.map((iv: any) => E('tr', {},
            E('td', {}, iv.d),
            E('td', {}, iv.n),
            E('td', { class: 'm' }, '$' + (Math.round(iv.a * 100) / 100)),
            E('td', {}, pill(iv.s, iv.s === 'Paid' ? 'ok' : 'in2')),
            E('td', {}, E('button', { class: 'btn', onclick: () => toast('Preview: invoice PDFs arrive with Dodo Payments.') }, 'Download'))))))));
      return E('div', {}, E('div', { class: 'g g21' }, cur, pay), E('div', { class: 'g g2' }, use, addons), plans, invs);
    }
    // ================= router =================
    const V: Record<string, [string, () => HTMLElement | Promise<HTMLElement>]> = {
      overview: ['Overview', ov],
      reports: ['DMARC reports', rep],
      policy: ['Enforcement and managed records', pol],
      deliver: ['Deliverability', dlv],
      dns: ['DNS monitor and AI access', ai],
      alerts: ['Alerts', alr],
      rpt: ['Reports', rpt],
      domain: ['Domain overview', dom],
      ws: ['Workspaces', wsv],
      bill: ['Billing', bil],
      settings: ['Settings', settings],
    };
    function go() {
      const y = scrollY;
      const userMail = (document.getElementById('dv-mail') as HTMLElement)?.dataset.mail || '';
      $('#side').replaceChildren(
        E('a', { class: 'logo', href: '/', title: 'Back to promptdns.com' }, E('span', { class: 'logo-badge', 'aria-hidden': 'true' }, 'DNS'), E('span', {}, 'Prompt', E('span', { class: 'logo-accent' }, 'DNS'))),
        E('div', { class: 'lab' }, 'MONITOR'),
        ...Object.entries(V).filter(([k]) => k !== 'settings' && k !== 'domain' && k !== 'ws' && k !== 'bill').map(([k, [t]]) => E('button', { class: 'nv' + (S.v === k ? ' on' : ''), 'aria-current': S.v === k ? 'page' : null, onclick: () => { S.v = k; go(); scrollTo(0, 0); } }, t, k === 'alerts' && ALERTS.some((a) => !a.read_at) ? E('span', { class: 'navbadge' }, String(ALERTS.filter((a) => !a.read_at).length)) : null)),
        E('div', { class: 'lab' }, 'TOOLS'),
E('a', { class: 'nv', href: '/tools/' }, 'All tools'),
E('a', { class: 'nv', href: '/dns/' }, 'Guides'),
E('div', { class: 'lab' }, 'ACCOUNT'),
        
        ...[['Workspaces', 'ws'], ['Billing', 'bill']].map(([t, k]) => E('button', { class: 'nv' + (S.v === k ? ' on' : ''), onclick: () => { S.v = k; go(); scrollTo(0, 0); } }, t)),
        E('button', { class: 'nv' + (S.v === 'settings' ? ' on' : ''), onclick: () => { S.v = 'settings'; go(); scrollTo(0, 0); } }, 'Settings'),
        E('button', { class: 'nv', onclick: () => { setTheme(document.documentElement.dataset.theme === 'light' ? 'dark' : 'light'); go(); } }, E('span', {}, themeLabel()), E('span', { class: 'sub' }, 'theme')),
        E('div', { class: 'plan' }, E('b', {}, 'Early access'), 'Free during development.'),
        E('div', { class: 'foot-user' }, E('span', { class: 'av', 'aria-hidden': 'true' }, (userMail || '?').charAt(0).toUpperCase()), E('span', { class: 'em' }, userMail),
          E('button', { class: 'btn', style: 'padding:4px 8px;font-size:11.5px;white-space:nowrap', onclick: async () => { await postJSON('/api/auth/logout'); location.reload(); } }, 'Sign out')));
      const sel = DOMS.length ? E('select', { id: 'dm', class: 'sel', 'aria-label': 'Domain', onchange: (e: any) => { S.d = +e.target.value; go(); } }, DOMS.map((d, i) => E('option', { value: i, selected: S.d === i }, d.n))) : null;
      $('#main').replaceChildren(
        E('div', { class: 'top' }, E('h1', {}, V[S.v][0]),
          E('div', { class: 'fx' }, sel || '')),
        E('div', { id: 'dv-screen' }, ''));
      const out = V[S.v][1]();
      Promise.resolve(out).then((el) => { const holder = $('#dv-screen'); if (holder) holder.replaceChildren(el); });
      scrollTo(0, y);
    }

    // ================= theme =================
    function setTheme(t: 'dark' | 'light') {
      const r = document.documentElement;
      if (t === 'light') r.dataset.theme = 'light'; else delete r.dataset.theme;
      try { localStorage.setItem('pd-theme', t); } catch { /* private mode */ }
    }
    function themeLabel() {
      return document.documentElement.dataset.theme === 'light' ? 'Dark mode' : 'Light mode';
    }

    // ================= boot =================
    (async function boot() {
      let t: string | null = null;
      try { t = localStorage.getItem('pd-theme'); } catch { /* private mode */ }
      setTheme(t === 'light' ? 'light' : 'dark');
      const me = await getJSON('/api/auth/me');
      if (!me || !me.ok || !me.authenticated || !me.email) {
        $('#dash-loading').hidden = true;
        $('#dash-signed-out').hidden = false;
        return;
      }
      await refreshAll();
      $('#dash-loading').hidden = true;
      $('#dash-shell').hidden = false;
      const mailEl = E('span', { id: 'dv-mail', 'data-mail': me.email || '', style: 'display:none' });
      document.getElementById('dash-shell')!.append(mailEl);
      go();
      addEventListener('keydown', (e) => { if (e.key === 'Escape') cdr(); });
    })();
  </script>
</BaseLayout>
