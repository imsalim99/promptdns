          E('div', {}, E('b', {}, RP.brand || 'Your brand'), E('div', { style: 'opacity:.85' }, RP.type + ' · ' + RP.sc + ' · ' + RP.per))),
        E('div', { style: 'padding:6px 16px 16px' },
          s.size ? SECS.filter((x) => s.has(x)).map((x) =>
            x === 'Health score' ? blk(x, E('div', { style: 'font:700 30px JetBrains Mono,monospace' }, OV && OV.avgScore != null ? String(OV.avgScore) : '-', E('span', { style: 'font-size:13px;color:#5A6378' }, ' / 100')))
              : x === 'DMARC results' ? blk(x, E('div', { style: 'margin-top:6px' }, 'Pass rate ' + (rate != null ? rate + '%' : 'N/A') + ' of ' + f(msgs) + ' messages'), E('div', { style: 'height:7px;border-radius:4px;background:#E3E6EE;margin-top:6px' }, E('div', { style: 'height:100%;width:' + (rate ?? 0) + '%;border-radius:4px;background:' + c })))
                : x === 'Sources' ? blk(x, E('div', { style: 'margin-top:6px' }, OV ? f(OV.dmarc?.messages || 0) + ' messages across ' + DOMS.length + ' domain' + (DOMS.length === 1 ? '' : 's') : 'No data yet'))
                  : x === 'SPF and DKIM changes' ? blk(x, E('div', { style: 'margin-top:6px' }, ALERTS.slice(0, 2).map((a) => a.title).join('. ') || 'No changes recorded.'))
                    : x === 'AI access' ? blk(x, E('div', { style: 'margin-top:6px' }, 'AI readiness ' + Math.min(100, 50 + Object.values(S.ai).filter((v) => v !== 'unset').length * 6) + ' / 100.'))
                      : blk(x, E('div', { style: 'margin-top:6px' }, '1. Classify every sending source. 2. Move DMARC to quarantine when all pass. 3. Enable DNSSEC.'))) : E('div', { style: 'margin-top:14px;color:#5A6378' }, 'Select at least one section.'),
          RP.pw ? E('div', { style: 'margin-top:16px;color:#5A6378;font-size:11px' }, 'Powered by PromptDNS') : ''));
    }
    const pv = () => { const o = $('#pv'); if (o) o.replaceWith(pvw()); };
    function rpt() {
      const u = (k, v) => { RP[k] = v; pv(); };
      const sel = (id, opts, cur, k) => E('select', { id, class: 'sel', style: 'width:100%', onchange: (e: any) => u(k, e.target.value) }, opts.map((o) => E('option', { selected: o === cur }, o)));
      const row = (l, id, el) => E('div', { style: 'margin:10px 0' }, E('label', { class: 'sub', for: id, style: 'display:block' }, l), el);
      const bld = E('div', { class: 'cd' }, E('div', { class: 'fx sp' }, E('h3', {}, 'Report builder'), prev()),
        E('div', { class: 'g g2', style: 'margin:0' }, row('Report type', 'rt', sel('rt', ['Security summary', 'DMARC progress', 'Executive summary'], RP.type, 'type')), row('Period', 'rp', sel('rp', ['Last 7 days', 'Last 30 days', 'Last quarter'], RP.per, 'per'))),
        row('Domains', 'rd', sel('rd', ['All domains'].concat(DOMS.map((d) => d.n)), RP.sc, 'sc')),
        E('div', { class: 'sub' }, 'Sections'),
        E('div', { class: 'fx', style: 'margin:6px 0 12px' }, SECS.map((x) => E('label', { class: 'btn' }, E('input', { type: 'checkbox', checked: RP.sec.has(x), onchange: (e: any) => { e.target.checked ? RP.sec.add(x) : RP.sec.delete(x); pv(); } }), ' ' + x))),
        E('div', { class: 'fx sp' }, E('h3', {}, 'White-label'), pill('Business', 'in2')),
        E('div', { class: 'g g2', style: 'margin:0' }, row('Brand name', 'bn', E('input', { id: 'bn', class: 'in', style: 'width:100%', value: RP.brand, oninput: (e: any) => u('brand', e.target.value) })), row('Brand colour', 'bc', E('input', { id: 'bc', type: 'color', value: RP.color, style: 'width:100%;height:38px', oninput: (e: any) => u('color', e.target.value) }))),
        E('label', { class: 'btn' }, E('input', { type: 'checkbox', checked: !!RP.pw, onchange: (e: any) => u('pw', e.target.checked ? 1 : 0) }), ' Show "Powered by PromptDNS"'),
        E('div', { class: 'fx', style: 'margin-top:14px' },
          E('button', { class: 'btn p', onclick: () => { if (!RP.sec.size) return toast('Pick at least one section'); RP.hist.unshift({ n: RP.type + ' · ' + RP.sc, per: RP.per, ts: 'Just now', sz: (160 + RP.sec.size * 55) + ' KB' }); toast('Preview: PDF delivery ships with the managed release.'); go(); } }, 'Generate PDF'),
          E('button', { class: 'btn', onclick: () => toast('Preview: share links ship with the managed release.') }, 'Copy share link')));
      const sch = E('div', { class: 'cd' }, E('div', { class: 'fx sp' }, E('h3', {}, 'Scheduled reports'), prev()),
        E('div', { class: 'fx', style: 'margin:10px 0' },
          E('select', { class: 'sel', 'aria-label': 'Frequency', onchange: (e: any) => { RP.fr = e.target.value; } }, ['Weekly', 'Monthly', 'Quarterly'].map((o) => E('option', { selected: o === RP.fr }, o))),
          E('input', { class: 'in', 'aria-label': 'Recipients', value: RP.to, oninput: (e: any) => { RP.to = e.target.value; } }),
          E('button', { class: 'btn p', onclick: () => { RP.sch.push({ n: RP.type, fr: RP.fr, to: RP.to, nx: 'next ' + RP.fr.toLowerCase(), on: 1 }); toast('Preview: scheduling ships with the managed release.'); go(); } }, 'Add schedule')),
        RP.sch.length ? E('div', { class: 'sc' }, E('table', {}, E('thead', {}, E('tr', {}, ['Report', 'Repeats', 'Sent to', 'Active', ''].map((x) => E('th', {}, x)))),
          E('tbody', {}, RP.sch.map((s2, i) => E('tr', {}, E('td', {}, E('b', {}, s2.n)), E('td', {}, s2.fr), E('td', { class: 'm' }, s2.to), E('td', {}, E('button', { class: 'sw' + (s2.on ? ' on' : ''), role: 'switch', 'aria-checked': !!s2.on, 'aria-label': 'Toggle ' + s2.n, onclick: () => { s2.on = s2.on ? 0 : 1; go(); } })), E('td', {}, E('button', { class: 'lk', 'aria-label': 'Delete schedule', onclick: () => { RP.sch.splice(i, 1); go(); } }, '✕'))))))) : E('p', { class: 'sub' }, 'No schedules yet.'));
      const his = E('div', { class: 'cd' }, E('h3', {}, 'Report history'), RP.hist.length ? E('div', { class: 'sc', style: 'margin-top:10px' }, E('table', {}, E('thead', {}, E('tr', {}, ['Report', 'Period', 'Created', 'Size', ''].map((x) => E('th', {}, x)))),
        E('tbody', {}, RP.hist.map((h) => E('tr', {}, E('td', {}, E('b', {}, h.n)), E('td', {}, h.per), E('td', {}, h.ts), E('td', { class: 'm' }, h.sz), E('td', {}, E('button', { class: 'btn', onclick: () => toast('Preview: PDF delivery ships with the managed release.') }, 'Download'))))))) : E('p', { class: 'sub' }, 'Generated reports land here.'));
      return E('div', {}, E('div', { class: 'g g21' }, bld, E('div', { class: 'cd' }, E('h3', { style: 'margin-bottom:10px' }, 'Live preview'), pvw())), E('div', { class: 'g g2' }, sch, his));
    }

    // ================= router =================
    const V: Record<string, [string, () => HTMLElement | Promise<HTMLElement>]> = {
      overview: ['Overview', ov],
      reports: ['DMARC reports', rep],
      policy: ['Enforcement and managed records', pol],
      deliver: ['Deliverability', dlv],
      dns: ['DNS monitor and AI access', ai],
      alerts: ['Alerts', alr],
      rpt: ['Reports', rpt],
    };
    function go() {
      const y = scrollY;
      const userMail = (document.getElementById('dv-mail') as HTMLElement)?.dataset.mail || '';
      $('#side').replaceChildren(
        E('a', { class: 'logo', href: '/' }, E('i'), 'PromptDNS'),
        E('div', { class: 'lab' }, 'MONITOR'),
        ...Object.entries(V).map(([k, [t]]) => E('button', { class: 'nv' + (S.v === k ? ' on' : ''), 'aria-current': S.v === k ? 'page' : null, onclick: () => { S.v = k; go(); scrollTo(0, 0); } }, t)),
        E('div', { class: 'lab' }, 'COMING NEXT'),
        ...['Workspaces', 'Billing'].map((t) => E('button', { class: 'nv', disabled: true, title: 'Ships after launch', onclick: () => toast(t + ' ships after launch.') }, t)),
        E('div', { class: 'plan' }, E('b', {}, 'Early access'), 'Free during development.'),
        E('div', { class: 'foot-user' }, E('span', { class: 'av', 'aria-hidden': 'true' }, (userMail || '?').charAt(0).toUpperCase()), E('span', { class: 'em' }, userMail),
          E('button', { class: 'btn', style: 'padding:4px 8px;font-size:11.5px;white-space:nowrap', onclick: async () => { await postJSON('/api/auth/logout'); location.reload(); } }, 'Sign out')));
      const sel = DOMS.length ? E('select', { id: 'dm', class: 'sel', 'aria-label': 'Domain', onchange: (e: any) => { S.d = +e.target.value; go(); } }, DOMS.map((d, i) => E('option', { value: i, selected: S.d === i }, d.n))) : null;
      $('#main').replaceChildren(
        E('div', { class: 'top' }, E('h1', {}, V[S.v][0]),
          E('div', { class: 'fx' }, sel || '', E('button', { class: 'btn', 'aria-label': 'Toggle theme', onclick: () => { const r = document.documentElement; setTheme(r.dataset.theme === 'dark' ? 'light' : 'dark'); } }, 'Theme'))),
        E('div', { id: 'dv-screen' }, ''));
      const out = V[S.v][1]();
      Promise.resolve(out).then((el) => { const holder = $('#dv-screen'); if (holder) holder.replaceChildren(el); });
      scrollTo(0, y);
    }

    // ================= theme =================
    function setTheme(t: 'dark' | 'light') {
      const r = document.documentElement;
      if (t === 'dark') r.dataset.theme = 'dark'; else delete r.dataset.theme;
      try { localStorage.setItem('pd-theme', t); } catch { /* private mode */ }
    }

    // ================= boot =================
    (async function boot() {
      let t: string | null = null;
      try { t = localStorage.getItem('pd-theme'); } catch { /* private mode */ }
      setTheme((t === 'light' || t === 'dark') ? t : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'));
      const me = await getJSON('/api/auth/me');
      if (!me || !me.ok || !me.authenticated || !me.email) {
        $('#dash-loading').hidden = true;
        $('#dash-signed-out').hidden = false;
        return;
      }
      await refreshAll();
      $('#dash-loading').hidden = true;
      $('#dash-shell').hidden = false;
      const mailEl = E('span', { id: 'dv-mail', 'data-mail': me.email || '', style: 'display:none' });
