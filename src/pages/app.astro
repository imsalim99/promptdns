          E('div', { class: 'fx sp' }, E('h3', {}, c), pill(c === 'Email' ? 'Active' : 'Coming soon', c === 'Email' ? 'ok' : 'in2')),
          E('div', { class: 'sub', style: 'margin:6px 0 10px' }, c === 'Email' ? 'Alerts go to your account email.' : 'Connect ' + c + ' after the managed release.'),
          E('div', { class: 'fx' }, c === 'Email' ? '' : E('button', { class: 'btn', onclick: () => toast('Preview: channel connections ship with the managed release.') }, 'Connect')))));
      }
      return E('div', {}, E('div', { class: 'cd', style: 'padding-bottom:0;margin-bottom:14px' }, tabs), body);
    }

    // ================= reports =================
    const SECS = ['Health score', 'DMARC results', 'Sources', 'SPF and DKIM changes', 'AI access', 'Recommendations'];
    const RP = { type: 'Security summary', per: 'Last 30 days', sc: 'All domains', sec: new Set(['Health score', 'DMARC results', 'Sources', 'Recommendations']), brand: 'Your brand', color: '#5B4FE8', pw: 1, fr: 'Monthly', to: 'clients@example.com', hist: [] as any[], sch: [] as any[] };
    const fg = (c) => { const n = parseInt(c.slice(1), 16), l = .299 * (n >> 16) + .587 * ((n >> 8) & 255) + .114 * (n & 255); return l > 150 ? '#12161F' : '#fff'; };
    function pvw() {
      const c = RP.color, s = RP.sec;
      const blk = (t, ...k) => E('div', { style: 'margin-top:14px' }, E('div', { style: 'font-weight:700;font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:' + (fg(c) === '#fff' ? c : '#12161F') }, t), ...k);
      const rate = OV && OV.dmarc && OV.dmarc.passRate != null ? OV.dmarc.passRate : null;
      const msgs = OV ? OV.dmarc?.messages || 0 : 0;
      return E('div', { id: 'pv', style: 'background:#fff;color:#12161F;border:1px solid #D9DCE6;border-radius:10px;overflow:hidden;font-size:12.5px' },
        E('div', { style: 'background:' + c + ';color:' + fg(c) + ';padding:14px 16px;display:flex;gap:10px;align-items:center' },
