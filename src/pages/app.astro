---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Dashboard"
  description="Your PromptDNS dashboard: monitored domains, DMARC reports, enforcement, alerts, and deliverability."
  noindex
  chrome={false}
>
  <div id="dash-app">
    <div id="dash-loading" class="dv-center">Checking sign-in…</div>

    <div id="dash-signed-out" class="dv-center" hidden>
      <div class="dv-card">
        <h1 style="font-size:21px;margin:0 0 6px">You are not signed in</h1>
        <p class="sub" style="margin:0 0 14px">Sign in with an email link to open your dashboard.</p>
        <a class="btn p" href="/login/">Go to sign in</a>
      </div>
    </div>

    <div id="dash-shell" hidden>
      <div class="app"><aside id="side"></aside><main id="main"></main></div>
      <p class="sub" style="padding:0 26px 28px;margin:0">Provider logos: Simple Icons (CC0) and Font Awesome Free (CC BY 4.0). All trademarks belong to their owners and are shown only to identify providers.</p>
      <div id="ly"></div>
    </div>
  </div>

  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

  <style is:global>
    :root{--bg:#F4F5F9;--cd:#fff;--ink:#12161F;--so:#5A6378;--ln:#E3E6EE;--ac:#5B4FE8;--as:#EEECFD;--ad:#2E2599;--ok:#0F766E;--os:#E1F3F1;--wn:#B45309;--ws:#FDF0DC;--bd:#B42318;--bs:#FCE9E7;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
    :root[data-theme=dark]{--bg:#0F1219;--cd:#171B26;--ink:#E8EBF3;--so:#98A1B8;--ln:#2A3042;--ac:#8F85FF;--as:#242048;--ad:#CFCBFF;--ok:#4FD1C5;--os:#10302D;--wn:#F6AD55;--ws:#3A2A10;--bd:#FC8181;--bs:#3D1A1A}
    #dash-app *{box-sizing:border-box}
    html,body{height:100%}
    html:has(#dash-app){background:var(--bg)}
    html:has(#dash-app) body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.5 'Plus Jakarta Sans',system-ui,sans-serif}
    #dash-app button,#dash-app select,#dash-app input{font:inherit;color:inherit}
    #dash-app button{cursor:pointer}
    .app{display:grid;grid-template-columns:208px minmax(0,1fr);min-height:100%}
    #side{background:var(--cd);border-right:1px solid var(--ln);padding:16px 10px;display:flex;flex-direction:column;gap:2px;position:sticky;top:0;height:100vh}
    .logo{font-weight:800;font-size:16px;padding:4px 10px 14px;display:flex;gap:8px;align-items:center;color:var(--ink);text-decoration:none}
    .logo i{width:22px;height:22px;border-radius:7px;background:var(--ac)}
    .nv{display:flex;justify-content:space-between;align-items:center;padding:9px 10px;border:0;border-radius:9px;background:none;color:var(--so);font-weight:600;text-align:left;width:100%}
    .nv:hover{background:var(--bg)}.nv.on{background:var(--as);color:var(--ad)}
    .nv[disabled]{cursor:not-allowed;opacity:.6}
    .lab{font-size:10.5px;font-weight:700;letter-spacing:.08em;color:var(--so);padding:12px 10px 4px}
    #main{padding:20px 26px 40px;min-width:0}
    .top{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:16px}
    #dash-app h1{font-size:21px;margin:0}#dash-app h3{margin:0;font-size:14.5px}
    .sub{color:var(--so);font-size:12.5px}
    .fx{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.sp{justify-content:space-between}
    .btn,.sel,.in{border:1px solid var(--ln);background:var(--cd);border-radius:9px;padding:7px 12px;font-weight:600;text-decoration:none;display:inline-block}
    .btn.p{background:var(--ac);border-color:var(--ac);color:#fff}
    .in{font-weight:500;min-width:200px}
    .btn:focus-visible,.nv:focus-visible,.sel:focus-visible,.in:focus-visible,.seg button:focus-visible,.lk:focus-visible{outline:2px solid var(--ac);outline-offset:2px}
    .g{display:grid;gap:14px;margin-bottom:14px}
    .g4{grid-template-columns:repeat(4,minmax(0,1fr))}.g2{grid-template-columns:repeat(2,minmax(0,1fr))}.g21{grid-template-columns:minmax(0,2fr) minmax(0,1fr)}
    .cd{background:var(--cd);border:1px solid var(--ln);border-radius:14px;padding:16px 18px;min-width:0}
    .k{font:700 26px 'JetBrains Mono',monospace}.m{font-family:'JetBrains Mono',monospace;font-size:12px}
    .seg{display:inline-flex;border:1px solid var(--ln);border-radius:9px;overflow:hidden}
    .seg button{border:0;background:none;padding:6px 12px;font-weight:700;color:var(--so)}
    .seg .on{background:var(--as);color:var(--ad)}
    #dash-app table{width:100%;border-collapse:collapse;font-size:13px}
    #dash-app th{text-align:left;font-size:11.5px;color:var(--so);padding:8px 10px;background:var(--bg);font-weight:600;white-space:nowrap}
    #dash-app th button{border:0;background:none;font-weight:600;color:var(--so);padding:0}
    #dash-app td{padding:9px 10px;border-bottom:1px solid var(--ln)}
    tr.cl{cursor:pointer}tr.cl:hover td{background:var(--bg)}
    .pl{display:inline-block;font-size:11.5px;font-weight:700;padding:2px 9px;border-radius:9px;white-space:nowrap}
    .ok{background:var(--os);color:var(--ok)}.wn{background:var(--ws);color:var(--wn)}.bd{background:var(--bs);color:var(--bd)}.in2{background:var(--as);color:var(--ad)}
    .lk{border:0;background:none;color:var(--ac);font-weight:700;padding:0}
    .tabs{display:flex;gap:18px;border-bottom:1px solid var(--ln);margin-bottom:10px}
    .tabs button{border:0;background:none;padding:8px 0;font-weight:700;color:var(--so);border-bottom:2px solid transparent}
    .tabs .on{color:var(--ac);border-color:var(--ac)}
    .bar{height:7px;border-radius:4px;background:var(--ln);overflow:hidden;min-width:70px}.bar b{display:block;height:100%}
    .rad{border:2px solid var(--ln);border-radius:12px;padding:12px 14px;background:var(--cd);text-align:left;flex:1;min-width:150px}
    .rad.on{border-color:var(--ac);background:var(--as)}.rad b{display:block}
    .sw{width:38px;height:22px;border-radius:12px;border:0;background:var(--ln);position:relative;flex:none}
    .sw::after{content:"";position:absolute;top:3px;left:3px;width:16px;height:16px;border-radius:50%;background:#fff;transition:.15s}
    .sw.on{background:var(--ok)}.sw.on::after{left:19px}
    .li{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid var(--ln)}
    .li small{display:block;color:var(--so)}
    .wrap{position:relative}
    .tip{position:absolute;pointer-events:none;background:var(--ink);color:var(--bg);padding:6px 9px;border-radius:8px;font-size:12px;white-space:nowrap;display:none;z-index:3}
    .ov{position:fixed;inset:0;background:#0007;z-index:5}
    .dr{position:fixed;top:0;right:0;bottom:0;width:min(560px,100%);background:var(--cd);z-index:6;padding:20px;overflow:auto;box-shadow:-8px 0 30px #0004}
    .toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:10px;z-index:9;font-weight:600;max-width:min(480px,90vw)}
    .sc{overflow-x:auto}
    #dash-app pre{background:var(--bg);padding:12px;border-radius:10px;font:12px/1.5 'JetBrains Mono',monospace;margin:0;overflow:auto}
    .dv-center{display:grid;place-items:center;min-height:60vh;padding:20px}
    .dv-card{background:var(--cd);border:1px solid var(--ln);border-radius:14px;padding:26px;max-width:380px;text-align:center}
    .foot-user{display:flex;align-items:center;gap:8px;padding:8px 10px;border-top:1px solid var(--ln);margin-top:auto}
    .foot-user .av{width:26px;height:26px;border-radius:50%;background:var(--as);color:var(--ad);display:inline-flex;align-items:center;justify-content:center;font-weight:800;font-size:12px;flex:none}
    .foot-user .em{font-size:11.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .plan{margin:8px 10px 6px;padding:9px 10px;border:1px dashed var(--ln);border-radius:10px;font-size:11.5px;color:var(--so)}
    .plan b{display:block;color:var(--ink)}
    @media(max-width:900px){.app{grid-template-columns:1fr}#side{position:static;height:auto;flex-direction:row;overflow-x:auto;align-items:center}.lab,.logo,.plan,.foot-user{display:none}.nv{white-space:nowrap;width:auto}.g4,.g2,.g21{grid-template-columns:1fr 1fr}}
    @media(max-width:560px){.g4,.g2,.g21{grid-template-columns:1fr}#main{padding:14px}}
  </style>

  <script>
    // ================= helpers =================
    const $ = (s, e) => (e || document).querySelector(s);
    const H = (s) => { const t = document.createElement('template'); t.innerHTML = s.trim(); return t.content.firstChild; };
    const E = (t, a, ...k) => {
      const e = document.createElement(t);
      for (const [n, v] of Object.entries(a || {})) {
        if (n === 'class') e.className = v;
        else if (n.startsWith('on')) e.addEventListener(n.slice(2), v);
        else if (v !== false && v != null) e.setAttribute(n, v);
      }
      k.flat(9).filter((c) => c !== false && c != null).forEach((c) => e.append(c.nodeType ? c : document.createTextNode(c)));
      return e;
    };
    const f = (n) => Math.round(n).toLocaleString('en');
    const MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    const toast = (m) => { const t = E('div', { class: 'toast', role: 'status' }, m); document.body.append(t); setTimeout(() => t.remove(), 2600); };
    const pill = (t, c) => E('span', { class: 'pl ' + c }, t);
    const prev = () => pill('Preview', 'in2');
    const col = (v) => (v >= 90 ? 'ok' : v >= 60 ? 'wn' : 'bd');
    const cv = (v) => `var(--${col(v)})`;
    const seg = (opts, cur, fn) => E('div', { class: 'seg' }, opts.map(([v, l]) => E('button', { class: cur === v ? 'on' : '', 'aria-pressed': cur === v, onclick: () => fn(v) }, l)));
    const bar = (v, w) => E('div', { class: 'bar' }, E('b', { style: `width:${v}%;background:${cv(v)}` }));
    const ring = (v) => v == null ? E('span', { class: 'sub' }, 'N/A') : H(`<svg width="34" height="34" viewBox="0 0 36 36" role="img" aria-label="Health ${v} of 100"><circle cx="18" cy="18" r="14" fill="none" stroke="var(--ln)" stroke-width="4"/><circle cx="18" cy="18" r="14" fill="none" stroke="${cv(v)}" stroke-width="4" stroke-dasharray="${v * .88} 88" transform="rotate(-90 18 18)" stroke-linecap="round"/><text x="18" y="22" text-anchor="middle" font-size="10" font-weight="700" fill="currentColor">${v}</text></svg>`);
    const sp = (p) => p.map((q, i) => i ? `C${(p[i - 1][0] + q[0]) / 2},${p[i - 1][1]} ${(p[i - 1][0] + q[0]) / 2},${q[1]} ${q[0]},${q[1]}` : `M${q[0]},${q[1]}`).join('');
    const fmtWhen = (iso) => { if (!iso) return ''; const d = new Date(iso); if (isNaN(d)) return iso; return MON[d.getMonth()] + ' ' + d.getDate() + ', ' + String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0'); };

    // provider logos (Simple Icons CC0 / Font Awesome Free CC BY 4.0)
    const LG = {"cloudflare":["0 0 24 24","M16.5088 16.8447c.1475-.5068.0908-.9707-.1553-1.3154-.2246-.3164-.6045-.499-1.0615-.5205l-8.6592-.1123a.1559.1559 0 0 1-.1333-.0713c-.0283-.042-.0351-.0986-.021-.1553.0278-.084.1123-.1484.2036-.1562l8.7359-.1123c1.0351-.0489 2.1601-.8868 2.5537-1.9136l.499-1.3013c.0215-.0561.0293-.1128.0147-.168-.5625-2.5463-2.835-4.4453-5.5499-4.4453-2.5039 0-4.6284 1.6177-5.3876 3.8614-.4927-.3658-1.1187-.5625-1.794-.499-1.2026.119-2.1665 1.083-2.2861 2.2856-.0283.31-.0069.6128.0635.894C1.5683 13.171 0 14.7754 0 16.752c0 .1748.0142.3515.0352.5273.0141.083.0844.1475.1689.1475h15.9814c.0909 0 .1758-.0645.2032-.1553l.12-.4268zm2.7568-5.5634c-.0771 0-.1611 0-.2383.0112-.0566 0-.1054.0415-.127.0976l-.3378 1.1744c-.1475.5068-.0918.9707.1543 1.3164.2256.3164.6055.498 1.0625.5195l1.8437.1133c.0557 0 .1055.0263.1329.0703.0283.043.0351.1074.0214.1562-.0283.084-.1132.1485-.204.1553l-1.921.1123c-1.041.0488-2.1582.8867-2.5527 1.914l-.1406.3585c-.0283.0713.0215.1416.0986.1416h6.5977c.0771 0 .1474-.0489.169-.126.1122-.4082.1757-.837.1757-1.2803 0-2.6025-2.125-4.727-4.7344-4.727","#F38020"],"openai":["0 0 24 24","M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7475-7.0729zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944zm-9.6607-4.1254a4.4708 4.4708 0 0 1-.5346-3.0137l.142.0852 4.783 2.7582a.7712.7712 0 0 0 .7806 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 19.9502a4.4992 4.4992 0 0 1-6.1408-1.6464zM2.3408 7.8956a4.485 4.485 0 0 1 2.3655-1.9728V11.6a.7664.7664 0 0 0 .3879.6765l5.8144 3.3543-2.0201 1.1685a.0757.0757 0 0 1-.071 0l-4.8303-2.7865A4.504 4.504 0 0 1 2.3408 7.872zm16.5963 3.8558L13.1038 8.364 15.1192 7.2a.0757.0757 0 0 1 .071 0l4.8303 2.7913a4.4944 4.4944 0 0 1-.6765 8.1042v-5.6772a.79.79 0 0 0-.407-.667zm2.0107-3.0231l-.142-.0852-4.7735-2.7818a.7759.7759 0 0 0-.7854 0L9.409 9.2297V6.8974a.0662.0662 0 0 1 .0284-.0615l4.8303-2.7866a4.4992 4.4992 0 0 1 6.6802 4.66zM8.3065 12.863l-2.02-1.1638a.0804.0804 0 0 1-.038-.0567V6.0742a4.4992 4.4992 0 0 1 7.3757-3.4537l-.142.0805L8.704 5.459a.7948.7948 0 0 0-.3927.6813zm1.0976-2.3654l2.602-1.4998 2.6069 1.4998v2.9994l-2.5974 1.4997-2.6067-1.4997Z",null],"anthropic":["0 0 24 24","M17.3041 3.541h-3.6718l6.696 16.918H24Zm-10.6082 0L0 20.459h3.7442l1.3693-3.5527h7.0052l1.3693 3.5528h3.7442L10.5363 3.5409Zm-.3712 10.2232 2.2914-5.9456 2.2914 5.9456Z",null],"perplexity":["0 0 24 24","M22.3977 7.0896h-2.3106V.0676l-7.5094 6.3542V.1577h-1.1554v6.1966L4.4904 0v7.0896H1.6023v10.3976h2.8882V24l6.932-6.3591v6.2005h1.1554v-6.0469l6.9318 6.1807v-6.4879h2.8882V7.0896zm-3.4657-4.531v4.531h-5.355l5.355-4.531zm-13.2862.0676 4.8691 4.4634H5.6458V2.6262zM2.7576 16.332V8.245h7.8476l-6.1149 6.1147v1.9723H2.7576zm2.8882 5.0404v-3.8852h.0001v-2.6488l5.7763-5.7764v7.0111l-5.7764 5.2993zm12.7086.0248-5.7766-5.1509V9.0618l5.7766 5.7766v6.5588zm2.8882-5.0652h-1.733v-1.9723L13.3948 8.245h7.8478v8.087z","#1FB8CD"],"amazon":["0 0 448 512","M257.2 162.7c-48.7 1.8-169.5 15.5-169.5 117.5 0 109.5 138.3 114 183.5 43.2 6.5 10.2 35.4 37.5 45.3 46.8l56.8-56S341 288.9 341 261.4V114.3C341 89 316.5 32 228.7 32 140.7 32 94 87 94 136.3l73.5 6.8c16.3-49.5 54.2-49.5 54.2-49.5 40.7-.1 35.5 29.8 35.5 69.1zm0 86.8c0 80-84.2 68-84.2 17.2 0-47.2 50.5-56.7 84.2-57.8v40.6zm136 163.5c-7.7 10-70 67-174.5 67S34.2 408.5 9.7 379c-6.8-7.7 1-11.3 5.5-8.3C88.5 415.2 203 488.5 387.7 401c7.5-3.7 13.3 2 5.5 12zm39.8 2.2c-6.5 15.8-16 26.8-21.2 31-5.5 4.5-9.5 2.7-6.5-3.8s19.3-46.5 12.7-55c-6.5-8.3-37-4.3-48-3.2-10.8 1-13 2-14-.3-2.3-5.7 21.7-15.5 37.5-17.5 15.7-1.8 41-.8 46 5.7 3.7 5.1 0 27.1-6.5 43.1z",null],"google":["0 0 24 24","M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z","#4285F4"]};
    const LK = [['openai','openai'],['gptbot','openai'],['chatgpt','openai'],['claude','anthropic'],['anthropic','anthropic'],['perplexity','perplexity'],['google-extended','google'],['google','google'],['amazonbot','amazon'],['amazon','amazon'],['gpt','openai']];
    const lg = (n, s) => {
      s = s || 20;
      const l = String(n).toLowerCase(), k = (LK.find(([a]) => l.includes(a)) || [])[1];
      if (!k) return null;
      if (k === 'anthropic') return H('<svg width="' + s + '" height="' + s + '" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="' + LG.anthropic[1] + '"/></svg>');
      const [vb, d, c] = LG[k];
      return H('<svg width="' + s + '" height="' + s + '" viewBox="' + vb + '" aria-hidden="true" style="flex:none"><path fill="' + (c || 'currentColor') + '" d="' + d + '"/></svg>');
    };
    const nm = (n, b) => E('span', { class: 'fx', style: 'gap:8px;flex-wrap:nowrap' }, lg(n) || '', b ? E('b', {}, n) : n);

    // ================= data =================
    type DRow = { id: number; n: string; paused: boolean; score: number | null; grade: string | null; checkedAt: string | null; checks: { id: string; label: string; status: string; value: string }[] | null; records: { type: string; name: string; value: string }[] | null };
    let DOMS: DRow[] = [];
    let OV: any = null;
    let ALERTS: { id: number; severity: string; title: string; detail: string; created_at: string; read_at: string | null; domain: string }[] = [];
    let MAXD = 3;
    const dmarcCache = new Map<number, any>();
    let histCache = new Map<number, any>();

    const S = { v: 'overview', d: 0, rng: 'MO', kind: 'area', tab: 'all', q: '', sort: ['n', 1] as [string, number], dt: 'rec', sel: null as number | null, hide: new Set<string>(), pol: 'quarantine', pct: 50, ruf: false, flat: false, mta: 'enforce', pf: [] as any[], atab: 'feed', asev: 'all', ai: { GPTBot: 'block', ClaudeBot: 'allow', PerplexityBot: 'allow', 'Google-Extended': 'block', Amazonbot: 'unset' } as Record<string, string> };

    const getJSON = async (u: string) => { try { const r = await fetch(u); const j = await r.json(); return j; } catch { return null; } };
    const postJSON = async (u: string, body?: any) => {
      try {
        const r = await fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: body ? JSON.stringify(body) : undefined });
        return await r.json();
      } catch { return { ok: false, error: 'Could not reach the server.' }; }
    };

    async function refreshAll() {
      const [d, o, a] = await Promise.all([getJSON('/api/domains'), getJSON('/api/overview'), getJSON('/api/alerts')]);
      if (d && d.ok) {
        DOMS = (d.domains || []).map((x: any) => ({ id: x.id, n: x.domain, paused: !!x.paused, score: x.score, grade: x.grade, checkedAt: x.checkedAt, checks: x.checks || [], records: x.records || [] }));
        MAXD = d.max || 3;
      }
      OV = o && o.ok ? o : null;
      if (a && a.ok) ALERTS = a.alerts || [];
      dmarcCache.clear(); histCache.clear();
      if (S.d >= DOMS.length) S.d = 0;
      go();
    }

    const curDom = () => DOMS[S.d] || null;
    const chk = (d: DRow, id: string) => (d.checks || []).find((c) => c.id === id);
