          sources.length ? '' : E('p', { class: 'sub' }, 'Sources appear here as aggregate reports arrive.')),
        E('div', { class: 'cd' }, E('h3', {}, 'Top problems'), E('div', { class: 'sub', style: 'margin-bottom:6px' }, 'Sources failing DMARC on real volume'),
