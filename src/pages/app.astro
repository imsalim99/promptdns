    // ================= deliverability =================
    async function dlv() {
      const d = curDom();
      if (!d) return E('div', { class: 'cd' }, E('h3', {}, 'No domain selected'), E('p', { class: 'sub' }, 'Add a domain to see its outbound deliverability waterfall.'));
