          E('div', { class: 'sc' }, E('table', {}, E('thead', {}, E('tr', {}, ['Rule', 'Applies to', 'Channels'].map((x) => E('th', {}, x)))),
            E('tbody', {}, RL.map((r) => E('tr', {}, E('td', {}, E('b', {}, r[0] as string)), E('td', {}, r[1] as string), E('td', {}, E('div', { class: 'fx' }, (r[2] as string[]).map((c) => pill(c, 'in2'))))))))),
          E('p', { class: 'sub', style: 'margin-top:10px' }, 'Custom rules with per-rule channels arrive with the managed enforcement release.'));
