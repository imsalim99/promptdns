---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolPanel from '../components/ToolPanel.astro';
import { RECORD_TYPES } from '../lib/doh';

const faqSchema = {
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
    {'@type': 'Question', 'name': "What record types can I look up?", "acceptedAnswer": { '@type': 'Answer', "text": "All major types: A, AAAA, CNAME, MX, NS, TXT, SOA, SRV, PTR, CAA, DNSKEY, and DS. Each returns full values and TTLs from live DNS-over-HTTPS queries." } },
    {'@type': 'Question', 'name': "Why do different tools show different results for the same domain?", "acceptedAnswer": { '@type': 'Answer', "text": "DNS results vary by resolver due to caching and TTL. Our tool queries Cloudflare, Google, and AliDNS directly. The propagation checker shows differences across all three side by side." } },
    {'@type': 'Question', 'name': "What does TTL mean in the results?", "acceptedAnswer": { '@type': 'Answer', "text": "TTL (Time To Live) is how long a resolver caches the record before re-querying the authoritative server. Lower TTLs mean faster propagation but more resolver load." } }
  ]
}
---
<BaseLayout
  title="DNS Record Lookup, A, AAAA, MX, TXT, NS & More"
  description="Free DNS record lookup: query any domain's A, AAAA, CNAME, MX, TXT, NS, SOA, PTR, SRV, CAA, DS or DNSKEY records with TTLs."
  schema={[faqSchema]}
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a>
       <span aria-hidden="true">/</span>
      <a href="/tools/" class="hover:text-accent">Tools</a>
       <span aria-hidden="true">/</span>
      <span class="text-ink-dim">DNS Record Lookup</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">DNS Record Lookup: Fetch A, AAAA, MX, TXT, NS and More</h1>
    <p class="mt-4 text-lg text-ink-dim">Free DNS record lookup: query any record type (A through DNSKEY) with full values and TTLs over DNS-over-HTTPS.</p>

    <ToolPanel>
      <form id="rl-form" class="flex flex-col gap-3 sm:flex-row">
        <label class="sr-only" for="rl-domain">Domain</label>
        <input id="rl-domain" type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder="example.com"
          class="flex-1 rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30" />
        <label class="sr-only" for="rl-type">Record type</label>
        <select id="rl-type" class="rounded-md border border-line bg-panel px-3 py-2.5 text-sm text-ink focus:border-accent focus:outline-none">
          {RECORD_TYPES.map((t) => <option value={t.value}>{t.label}</option>)}
        </select>
        <button type="submit" class="btn-cta btn-shimmer px-6 py-2.5 text-sm">Lookup</button>
      </form>

      <div id="rl-status" class="mt-4 hidden rounded-md px-4 py-3 text-sm font-medium"></div>

            <p id="rl-sample-note" data-vs="example" class="mt-6 text-xs text-ink-faint">
        Sample diagnostic for <code>example.com</code>. Enter any domain above for live results.
      </p>
<div id="rl-results" class="pd-results mt-6 overflow-x-auto rounded-lg border border-line/60" aria-live="polite">
        <table class="pdns-table">
          <thead><tr><th>Name</th><th>TTL</th><th>Type</th><th>Value</th></tr></thead>
          <tbody id="rl-tbody">
            <tr><td class="font-medium text-ink">example.com</td><td class="font-mono text-xs text-ink-dim">86400</td><td>NS</td><td><code>a.iana-servers.net</code></td></tr>
            <tr><td class="font-medium text-ink">example.com</td><td class="font-mono text-xs text-ink-dim">3600</td><td>A</td><td><code>93.184.216.34</code></td></tr>
            <tr><td class="font-medium text-ink">example.com</td><td class="font-mono text-xs text-ink-dim">3600</td><td>TXT</td><td><code>"v=spf1 -all"</code></td></tr></tbody>
        </table>
      </div>

      <div class="mt-4 flex flex-wrap gap-3 text-sm">
        <a id="rl-propagate" href="/dns-propagation-checker/" class="text-accent hover:text-accent-soft">Check this record's propagation →</a>
        <a href="/dns-records/" class="text-accent hover:text-accent-soft">Record types explained →</a>
    </div>
    </ToolPanel>

    <article class="rich-text mt-14 max-w-none">
      <h2>Reading the results</h2>
      <p><strong>TTL</strong> is how long resolvers may cache the answer (seconds), it's why changes take time to spread. The <strong>Type</strong> column tells you what the record does; every type has a full guide in the <a href="/dns-records/">record types reference</a>. Empty answers with NOERROR mean the record type exists for the name but has no values; NXDOMAIN means the name itself doesn't exist.</p>
      
      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Frequently asked questions</h2>
      <div class="mt-3 grid gap-3"><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">What record types can I look up?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">All major types: A, AAAA, CNAME, MX, NS, TXT, SOA, SRV, PTR, CAA, DNSKEY, and DS. Each returns full values and TTLs from live DNS-over-HTTPS queries.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Why do different tools show different results for the same domain?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">DNS results vary by resolver due to caching and TTL. Our tool queries Cloudflare, Google, and AliDNS directly. The propagation checker shows differences across all three side by side.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">What does TTL mean in the results?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">TTL (Time To Live) is how long a resolver caches the record before re-querying the authoritative server. Lower TTLs mean faster propagation but more resolver load.</p></details></div>
<h2>Related tools</h2>
      <ul>
        <li><a href="/dns-propagation-checker/">DNS Propagation Checker</a>, compare across resolvers</li>
        <li><a href="/dns-speed-test/">DNS Speed Test</a>, which resolver is fastest for you</li>
      </ul>
    </article>
  </div>
</BaseLayout>

<script>
  import { lookup, RESOLVERS, normalizeDomain, type RecordType } from '../lib/doh';

  const form = document.getElementById('rl-form') as HTMLFormElement;
  const input = document.getElementById('rl-domain') as HTMLInputElement;
  const typeSel = document.getElementById('rl-type') as HTMLSelectElement;
  const statusEl = document.getElementById('rl-status')!;
  const resultsEl = document.getElementById('rl-results')!;
  const tbody = document.getElementById('rl-tbody')!;
  const propLink = document.getElementById('rl-propagate') as HTMLAnchorElement;

  const TYPE_NAMES: Record<number, string> = { 1: 'A', 28: 'AAAA', 5: 'CNAME', 15: 'MX', 16: 'TXT', 2: 'NS', 6: 'SOA', 12: 'PTR', 33: 'SRV', 257: 'CAA', 43: 'DS', 48: 'DNSKEY' };

  const setStatus = (cls: string, text: string) => {
    statusEl.className = `mt-4 rounded-md px-4 py-3 text-sm font-medium ${cls}`;
    statusEl.textContent = text;
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const domain = normalizeDomain(input.value);
    if (!domain.includes('.')) { setStatus('bg-fail/10 text-fail border border-fail/30', 'Enter a valid domain, e.g. example.com'); return; }
    setStatus('bg-panel-2 text-accent border border-line', `Querying ${typeSel.value} records for ${domain}…`);
    resultsEl.classList.add('hidden');

    const res = await lookup(domain, typeSel.value as RecordType, RESOLVERS[0]);
    propLink.href = `/dns-propagation-checker/?domain=${encodeURIComponent(domain)}`;

    if (!res.ok && res.status === 3) {
      setStatus('bg-fail/10 text-fail border border-fail/30', `NXDOMAIN, ${domain} does not exist.`);
      return;
    }
    if (!res.answers.length) {
      setStatus('bg-warn/10 text-warn border border-warn/30', `NOERROR but no ${typeSel.value} records returned for ${domain}.`);
      return;
    }

    setStatus('bg-pass/10 text-pass border border-pass/30', `${res.answers.length} ${typeSel.value} record${res.answers.length > 1 ? 's' : ''} found (via ${res.resolver}, ${res.ms} ms).`);
    document.getElementById('rl-sample-note')?.classList.add('hidden');
    tbody.innerHTML = '';
    for (const a of res.answers) {
      tbody.insertAdjacentHTML('beforeend', `<tr>
        <td class="font-mono text-xs text-ink-dim">${a.name}</td>
        <td class="font-mono text-xs text-accent">${a.TTL}s</td>
        <td class="font-mono text-xs text-ink">${TYPE_NAMES[a.type] ?? a.type}</td>
        <td><code>${a.data.replace(/</g, '&lt;')}</code></td>
      </tr>`);
    }
    resultsEl.classList.remove('hidden');
  });
</script>
