---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolPanel from '../components/ToolPanel.astro';

const faqSchema = {
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
  {
   "@type": "Question",
   "name": "Is the AI Crawler Checker really free?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Yes: every tool on PromptDNS is free forever, with no account, no limits, and no trial timers. The AI crawler audit runs entirely in your browser."
   }
  },
  {
   "@type": "Question",
   "name": "How accurate are the results?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "The AI crawler audit queries public DNS-over-HTTPS resolvers (Cloudflare, Google, Quad9) in real time. Results reflect what those resolvers actually serve, which is the same data the wider internet receives."
   }
  },
  {
   "@type": "Question",
   "name": "Do you store the domains I look up?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "No. Lookups happen client-side in your browser. Domains are not sent to our servers, stored, or logged. See the privacy policy for details."
   }
  },
  {
   "@type": "Question",
   "name": "Can I use this tool for client work?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Yes: the tools are free for commercial use. Agencies on the Business plan can also generate white-label automated reports."
   }
  },
  {
   "@type": "Question",
   "name": "How often should I run this check?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "After any DNS or infrastructure change, and periodically (weekly or monthly) as part of routine health monitoring. The paid plans automate this."
   }
  },
  {
   "@type": "Question",
   "name": "What if the results look wrong?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Compare with a second tool or dig from a terminal. If results differ between tools, one may be showing a cached answer: the propagation checker reveals which resolvers disagree."
   }
  }
 ]
}
---
<BaseLayout
  title="AI Crawler Checker, Is Your Site Blocking AI Bots?"
  description="Free AI crawler checker: see whether GPTBot, ClaudeBot, PerplexityBot, Google-Extended, CCBot and other AI bots are allowed or blocked by your robots.txt."
  schema={[faqSchema]}
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a>
       <span aria-hidden="true">/</span>
      <a href="/tools/" class="hover:text-accent">Tools</a>
       <span aria-hidden="true">/</span>
      <span class="text-ink-dim">AI Crawler Checker</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">AI Crawler Checker</h1>
    <p class="mt-4 text-lg text-ink-dim">Audit any domain's robots.txt against 12 AI crawlers, find out who can train on and cite your content, and who's blocked.</p>

    <ToolPanel>
      <form id="aic-form" class="flex flex-col gap-3 sm:flex-row">
        <label class="sr-only" for="aic-domain">Domain</label>
        <input id="aic-domain" type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder="example.com"
          class="flex-1 rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30" />
        <button type="submit" class="btn-cta btn-shimmer px-6 py-2.5 text-sm">Check AI Access</button>
      </form>

      <div id="aic-status" class="mt-4 hidden rounded-md px-4 py-3 text-sm font-medium"></div>

      <div id="aic-summary" class="mt-4 hidden grid gap-3 sm:grid-cols-4"></div>

      <div id="aic-results" class="mt-6 hidden grid gap-2"></div>

      <div id="aic-raw" class="mt-6 hidden">
        <p class="mb-2 text-sm font-semibold text-ink">robots.txt (parsed rules per bot)</p>
        <div id="aic-raw-content" class="grid gap-1"></div>
    </div>


    <div id="post-tool-cta" class="hidden mt-8 rounded-xl border border-accent/25 bg-gradient-to-br from-accent/10 to-violet/10 p-6 not-prose">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h3 class="font-display font-bold text-ink text-base">Found issues?</h3>
          <p class="mt-1 text-sm text-ink-dim">Get a full prioritized report, or let our experts fix everything for you.</p>
        </div>
        <div class="flex gap-3 flex-wrap">
          <a href="/pricing/" class="rounded-lg border border-line bg-panel px-4 py-2.5 text-sm font-medium text-ink hover:border-accent/40 transition">Get Full Report — $9</a>
          <a href="/pricing/" class="btn-cta btn-shimmer px-5 py-2.5 text-sm">Fix My Domain</a>
        </div>
      </div>
    </div>

    // Show CTA when tool results appear
    (function() {
      var targets = document.querySelectorAll('[id$="-status"], [id$="-results"], [id$="-output"], [id$="-tbody"], [id$="-cards"]');
      if (!targets.length) return;
      var obs = new MutationObserver(function(mutations) {
        for (var m of mutations) {
          var el = m.target;
          if (el && !el.classList.contains('hidden') && el.innerHTML.trim().length > 20) {
            var cta = document.getElementById('post-tool-cta');
            if (cta) cta.classList.remove('hidden');
            obs.disconnect();
            return;
          }
        }
      });
      targets.forEach(function(el) {
        obs.observe(el, { attributes: true, childList: true, subtree: true });
      });
    })();

    </div>
    </ToolPanel>

    <article class="rich-text mt-14 max-w-none">
      <h2>Why this matters</h2>
      <p>AI assistants (ChatGPT, Claude, Perplexity, Gemini) decide what they can read from your site using robots.txt user-agent rules like <code>GPTBot</code> and <code>Google-Extended</code>. Blocking them stops training and retrieval; allowing them puts your content into answers and citations. There is no single right answer, but you should decide deliberately, not by accident.</p>
      
      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Frequently asked questions</h2>
      <div class="mt-3 grid gap-3"><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Is the AI Crawler Checker really free?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Yes: every tool on PromptDNS is free forever, with no account, no limits, and no trial timers. The AI crawler audit runs entirely in your browser.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">How accurate are the results?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">The AI crawler audit queries public DNS-over-HTTPS resolvers (Cloudflare, Google, Quad9) in real time. Results reflect what those resolvers actually serve, which is the same data the wider internet receives.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Do you store the domains I look up?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">No. Lookups happen client-side in your browser. Domains are not sent to our servers, stored, or logged. See the privacy policy for details.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Can I use this tool for client work?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Yes: the tools are free for commercial use. Agencies on the Business plan can also generate white-label automated reports.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">How often should I run this check?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">After any DNS or infrastructure change, and periodically (weekly or monthly) as part of routine health monitoring. The paid plans automate this.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">What if the results look wrong?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Compare with a second tool or dig from a terminal. If results differ between tools, one may be showing a cached answer: the propagation checker reveals which resolvers disagree.</p></details></div>
<h2>Related</h2>
      <ul>
        <li><a href="/ai-crawlers-list/">The complete list of AI crawlers</a> (guide)</li>
        <li><a href="/how-to-block-ai-crawlers/">How to block AI crawlers</a> / <a href="/how-to-allow-ai-crawlers/">allow them</a></li>
        <li><a href="/llms-txt-generator/">llms.txt Generator</a>, the complement to robots.txt</li>
      </ul>
    </article>
  </div>
</BaseLayout>

<script>
  import { fetchText, hostOf } from '../lib/proxy';
  import { parseRobots, verdictsFor, looksLikeHtml } from '../lib/robots';

  const form = document.getElementById('aic-form') as HTMLFormElement;
  const input = document.getElementById('aic-domain') as HTMLInputElement;
  const statusEl = document.getElementById('aic-status')!;
  const summaryEl = document.getElementById('aic-summary')!;
  const resultsEl = document.getElementById('aic-results')!;
  const rawEl = document.getElementById('aic-raw')!;
  const rawContent = document.getElementById('aic-raw-content')!;

  const setStatus = (cls: string, text: string) => {
    statusEl.className = `mt-4 rounded-md px-4 py-3 text-sm font-medium ${cls}`;
    statusEl.textContent = text;
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const host = hostOf(input.value);
    if (!host.includes('.')) { setStatus('bg-fail/10 text-fail border border-fail/30', 'Enter a valid domain, e.g. example.com'); return; }
    [summaryEl, resultsEl, rawEl].forEach((el) => el.classList.add('hidden'));
    setStatus('bg-panel-2 text-accent border border-line', `Fetching https://${host}/robots.txt…`);

    const res = await fetchText(`https://${host}/robots.txt`);
    if (!res.ok || looksLikeHtml(res.text)) {
      setStatus('bg-warn/10 text-warn border border-warn/30', res.status === 0 ? `Could not reach ${host} — the site blocks automated fetches or public proxies are rate-limited; try again shortly.` : `No readable robots.txt at ${host}, with no rules, every AI crawler is allowed by default.`);
      return;
    }

    const { groups } = parseRobots(res.text);
    const verdicts = verdictsFor(groups);
    const allowed = verdicts.filter((v) => v.status === 'allowed' || v.status === 'no-rules').length;
    const blocked = verdicts.filter((v) => v.status === 'blocked').length;
    const partial = verdicts.filter((v) => v.status === 'partial').length;

    setStatus('bg-pass/10 text-pass border border-pass/30', `robots.txt found (fetched via ${res.via}), ${allowed} AI bots allowed, ${blocked} blocked.`);

    summaryEl.innerHTML = '';
    for (const [l, v, cls] of [['Allowed', String(allowed), 'text-pass'], ['Blocked', String(blocked), 'text-fail'], ['Partial', String(partial), 'text-warn'], ['Bots tracked', '12', 'text-accent']] as [string, string, string][]) {
      summaryEl.insertAdjacentHTML('beforeend', `<div class="rounded-lg border border-line bg-panel/60 p-4"><div class="font-display text-2xl font-bold ${cls}">${v}</div><div class="text-xs text-ink-faint">${l}</div></div>`);
    }
    summaryEl.classList.remove('hidden');

    resultsEl.innerHTML = '';
    for (const v of verdicts) {
      const badge = v.status === 'blocked'
        ? '<span class="rounded bg-fail/15 px-2 py-0.5 text-xs font-semibold text-fail">BLOCKED</span>'
        : v.status === 'partial'
        ? '<span class="rounded bg-warn/15 px-2 py-0.5 text-xs font-semibold text-warn">PARTIAL</span>'
        : '<span class="rounded bg-pass/15 px-2 py-0.5 text-xs font-semibold text-pass">ALLOWED</span>';
      const note = v.status === 'no-rules' ? '<span class="text-xs text-ink-faint">no specific or wildcard rules, allowed by default</span>' : '';
      resultsEl.insertAdjacentHTML('beforeend', `<div class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-line bg-panel/60 px-4 py-3">
        <div>
          <span class="font-mono text-sm text-ink">${v.bot.name}</span>
          <span class="ml-2 text-xs text-ink-faint">${v.bot.vendor}, ${v.bot.purpose}</span>
          ${note}
        </div>
        ${badge}
      </div>`);
    }
    resultsEl.classList.remove('hidden');

    rawContent.innerHTML = '';
    for (const v of verdicts) {
      if (v.rules.length) {
        rawContent.insertAdjacentHTML('beforeend', `<div class="rounded border border-line bg-panel-2 p-3"><p class="font-mono text-xs text-accent">${v.bot.name}</p>${v.rules.map((r) => `<p class="font-mono text-xs text-ink-dim">${r}</p>`).join('')}</div>`);
      }
    }
    rawEl.classList.remove('hidden');
  });
</script>
