---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolPanel from '../components/ToolPanel.astro';
import ResultCard from '../components/ResultCard.astro';

const faqSchema = {
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
  {
   "@type": "Question",
   "name": "What is a good DMARC grade?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Grade A (p=reject with rua reporting) is the goal, but C (p=none with rua) is the correct starting point. Advance none to quarantine to reject as aggregate reports confirm every legitimate sender passes."
   }
  },
  {
   "@type": "Question",
   "name": "What does p=none actually do?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "It monitors only: receivers send aggregate reports but still deliver failing mail. Spoofed mail keeps reaching inboxes until the policy moves to quarantine or reject."
   }
  },
  {
   "@type": "Question",
   "name": "Why does the record need a rua address?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Without rua= no aggregate reports are sent, so you cannot see who sends as your domain or confirm legitimate mail passes. A policy without reports cannot be tuned safely."
   }
  },
  {
   "@type": "Question",
   "name": "Can subdomains have a different DMARC policy?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Yes, with the sp= tag. Without it, subdomains inherit the root domain's p= policy."
   }
  },
  {
   "@type": "Question",
   "name": "What is DMARC alignment?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "SPF or DKIM must pass AND the authenticated domain must match the visible From: domain. The alignment guide explains relaxed versus strict matching with examples."
   }
  },
  {
   "@type": "Question",
   "name": "Is my domain sent to a server when I use this checker?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "No. The lookup runs in your browser against public DNS-over-HTTPS resolvers. PromptDNS has no server in the lookup path and stores nothing."
   }
  }
 ]
}
---
<BaseLayout
  title="DMARC Record Checker, Check Your DMARC Policy"
  description="Free DMARC record checker: validate your DMARC policy tags, alignment, and reporting configuration with a clear grade."
  schema={[faqSchema]}
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a>
       <span aria-hidden="true">/</span>
      <a href="/tools/" class="hover:text-accent">Tools</a>
       <span aria-hidden="true">/</span>
      <span class="text-ink-dim">DMARC Record Checker</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">DMARC Record Checker: Validate Policy, Reporting and Alignment</h1>
    <p class="mt-4 text-lg text-ink-dim">Free DMARC checker: validate p= policy, rua reporting, alignment, subdomain sp=. No sign up.</p>

    <ToolPanel>
      <form id="dmarc-form" class="flex flex-col gap-3 sm:flex-row">
        <label class="sr-only" for="dmarc-domain">Domain</label>
        <input id="dmarc-domain" type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder="example.com"
          class="flex-1 rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30" />
        <button type="submit" class="btn-cta btn-shimmer px-6 py-2.5 text-sm">Check DMARC</button>
      </form>

      <div id="dmarc-status" class="mt-4 hidden rounded-md px-4 py-3 text-sm font-medium"></div>

      <div id="dmarc-grade" class="mt-4 hidden flex items-center gap-4 rounded-lg border border-line bg-panel/60 p-4">
        <span id="dmarc-grade-letter" class="font-display text-5xl font-bold text-accent"></span>
        <div>
          <p class="text-sm font-semibold text-ink" id="dmarc-grade-title"></p>
          <p class="text-xs text-ink-dim" id="dmarc-grade-desc"></p>
        </div>
      </div>

      <p id="dmarc-sample-note" data-vs="example" class="mt-6 text-xs text-ink-faint">
        Sample diagnostic for <code>example.com</code>. Enter any domain above to read its real DMARC policy.
      </p>
      <div id="dmarc-results" class="mt-2 overflow-x-auto rounded-lg border border-line/60">
        <table class="pdns-table">
          <thead><tr><th>Tag</th><th>Value</th><th>Meaning</th></tr></thead>
          <tbody id="dmarc-tbody">
            <tr><td class="font-mono text-xs text-accent-soft">v</td><td class="font-mono text-xs">DMARC1</td><td class="text-sm text-ink-dim">Protocol version, must be DMARC1</td></tr>
            <tr><td class="font-mono text-xs text-accent-soft">p</td><td class="font-mono text-xs">none</td><td class="text-sm text-ink-dim">Monitor only: failing mail is delivered, nothing is rejected</td></tr>
            <tr><td class="font-mono text-xs text-accent-soft">rua</td><td class="font-mono text-xs">mailto:dmarc@example.com</td><td class="text-sm text-ink-dim">Daily aggregate reports are sent to this address</td></tr>
          </tbody>
        </table>
    </div>

      <ResultCard tool="dmarc-record-checker" />
    </ToolPanel>

    <article class="rich-text mt-14 max-w-none">
      <h2>How DMARC is graded here</h2>
      <p><strong>A</strong>, enforcement (p=reject) with reporting. <strong>B</strong>, quarantine with reporting. <strong>C</strong>, monitoring (p=none) with reports. <strong>D/F</strong>, missing pieces. Enforcement without rua, or no record at all, leaves you blind or spoofable.</p>
      
      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Frequently asked questions</h2>
<div class="mt-3 grid gap-3"><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">What is a good DMARC grade?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Grade A (p=reject with rua reporting) is the goal, but C (p=none with rua) is the correct starting point. Advance none to quarantine to reject as aggregate reports confirm every legitimate sender passes.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">What does p=none actually do?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">It monitors only: receivers send aggregate reports but still deliver failing mail. Spoofed mail keeps reaching inboxes until the policy moves to quarantine or reject.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Why does the record need a rua address?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Without rua= no aggregate reports are sent, so you cannot see who sends as your domain or confirm legitimate mail passes. A policy without reports cannot be tuned safely.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Can subdomains have a different DMARC policy?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Yes, with the sp= tag. Without it, subdomains inherit the root domain's p= policy.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">What is DMARC alignment?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">SPF or DKIM must pass AND the authenticated domain must match the visible From: domain. <a href="/dmarc-alignment/" class="text-accent">The alignment guide</a> explains relaxed versus strict matching with examples.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Is my domain sent to a server when I use this checker?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">No. The lookup runs in your browser against public DNS-over-HTTPS resolvers. PromptDNS has no server in the lookup path and stores nothing.</p></details></div>
<h2>Related tools</h2>
      <ul>
        <li><a href="/dmarc-record-generator/">DMARC Record Generator</a>, build a correct record</li>
        <li><a href="/spf-record-checker/">SPF Record Checker</a> and <a href="/dkim-record-checker/">DKIM Record Checker</a></li>
        <li><a href="/dmarc/">DMARC explained</a> (guide)</li>
        <li><a href="/dmarc-record-syntax/">DMARC record syntax: every tag explained</a> (guide)</li>
        <li><a href="/dmarc-enforcement-roadmap/">DMARC enforcement roadmap: p=none to p=reject</a> (guide)</li>
      </ul>
    </article>
  </div>
</BaseLayout>

<script>
  import { lookup, RESOLVERS, normalizeDomain } from '../lib/doh';
  import { parseDmarc } from '../lib/dmarc';
  import { txtRecords } from '../lib/spf';
  import type { PdnsResult, PdnsFinding, Severity } from '../data/findings';

  const form = document.getElementById('dmarc-form') as HTMLFormElement;
  const input = document.getElementById('dmarc-domain') as HTMLInputElement;
  const statusEl = document.getElementById('dmarc-status')!;
  const gradeBox = document.getElementById('dmarc-grade')!;
  const gradeLetter = document.getElementById('dmarc-grade-letter')!;
  const gradeTitle = document.getElementById('dmarc-grade-title')!;
  const gradeDesc = document.getElementById('dmarc-grade-desc')!;
  const resultsEl = document.getElementById('dmarc-results')!;
  const tbody = document.getElementById('dmarc-tbody')!;

  const gradeMeta: Record<string, [string, string]> = {
    A: ['Full enforcement with reporting', 'Spoofed mail is rejected and you can monitor everything.'],
    B: ['Enforcement (quarantine) with reporting', 'Spoofed mail lands in spam. Consider moving to p=reject.'],
    C: ['Monitoring only', 'p=none with reports, good start, but spoofed mail is still delivered.'],
    D: ['Configured but incomplete', 'Policy exists but reporting is missing.'],
    F: ['Not protectable', 'No usable DMARC configuration found.'],
  };

  const TOOL = 'dmarc-record-checker';
  const RELATED_OK = [
    { label: 'Check SPF', href: '/spf-record-checker/' },
    { label: 'Check DKIM', href: '/dkim-record-checker/' },
    { label: 'DMARC explained', href: '/dmarc/' },
  ];
  const RELATED_FAIL = [
    { label: 'Build a DMARC record', href: '/dmarc-record-generator/' },
    { label: 'Check SPF', href: '/spf-record-checker/' },
    { label: 'Check DKIM', href: '/dkim-record-checker/' },
  ];

  const setStatus = (cls: string, text: string) => {
    statusEl.className = `mt-4 rounded-md px-4 py-3 text-sm font-medium ${cls}`;
    statusEl.textContent = text;
  };

  const emit = (verdict: Severity, verdictLine: string, findings: PdnsFinding[], domain: string, related = RELATED_OK) => {
    const detail: PdnsResult = { tool: TOOL, domain, verdict, verdictLine, findings, related, ctaLabel: 'See who sends email as your domain' };
    window.dispatchEvent(new CustomEvent('pdns:result', { detail }));
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const domain = normalizeDomain(input.value);
    if (!domain.includes('.')) { setStatus('bg-fail/10 text-fail border border-fail/30', 'Enter a valid domain, e.g. example.com'); return; }
    [gradeBox, resultsEl].forEach((el) => el.classList.add('hidden'));
    document.getElementById('dmarc-sample-note')?.classList.add('hidden');
    setStatus('bg-panel-2 text-accent border border-line', `Looking up _dmarc.${domain}…`);
    window.dispatchEvent(new CustomEvent('pdns:clear', { detail: { tool: TOOL } }));

    let res;
    try {
      res = await lookup(`_dmarc.${domain}`, 'TXT', RESOLVERS[0]);
    } catch {
      setStatus('bg-warn/10 text-warn border border-warn/30',
        `Could not reach the DNS resolver for ${domain}. This is an inconclusive result - not a pass or fail. Check your connection and retry.`);
      emit('info', 'DNS query did not complete. Nothing is known about this domain\u2019s DMARC.', [{ code: 'DMARC_DNS_UNREACHABLE' }], domain);
      return;
    }

    const record = txtRecords(res.answers).find((t) => t.toLowerCase().startsWith('v=dmarc1'));
    if (!record) {
      setStatus('bg-fail/10 text-fail border border-fail/30', `No DMARC record on ${domain}. Anyone can spoof this domain.`);
      emit('fail', `No DMARC record on ${domain}. Receivers have no policy from you.`, [{ code: 'DMARC_NOT_PUBLISHED' }], domain, RELATED_FAIL);
      return;
    }
    const parse = parseDmarc(record);
    setStatus(parse.errors.length ? 'bg-fail/10 text-fail border border-fail/30'
      : parse.warnings.length ? 'bg-warn/10 text-warn border border-warn/30'
      : 'bg-pass/10 text-pass border border-pass/30',
      parse.errors.length ? 'DMARC record found, with errors.' : parse.warnings.length ? 'DMARC record found, with warnings.' : 'DMARC record found and healthy.');

    const [t, d] = gradeMeta[parse.grade];
    gradeLetter.textContent = parse.grade;
    gradeTitle.textContent = t;
    gradeDesc.textContent = d;
    gradeBox.classList.remove('hidden');

    tbody.innerHTML = `<tr><td colspan="3"><code>${record.replace(/</g, '&lt;')}</code></td></tr>`;
    for (const tag of parse.tags) {
      tbody.insertAdjacentHTML('beforeend', `<tr>
        <td class="font-mono text-xs text-accent">${tag.tag}=</td>
        <td class="font-mono text-xs text-ink">${tag.value.replace(/</g, '&lt;')}</td>
        <td class="text-ink-dim">${tag.meaning}</td>
      </tr>`);
    }
    resultsEl.classList.remove('hidden');

    // Findings for the ResultCard
    const findings: PdnsFinding[] = [];
    if (parse.errors.length) findings.push({ code: 'DMARC_SYNTAX_ERROR', detail: parse.errors.join('; ') });
    for (const w of parse.warnings) {
      if (w.startsWith('p=none')) findings.push({ code: 'DMARC_P_NONE' });
      else if (w.startsWith('No rua=')) findings.push({ code: 'DMARC_NO_RUA', detail: 'No rua= tag: aggregate reports are not being sent anywhere' });
      else if (w.startsWith('Enforcement without reporting')) findings.push({ code: 'DMARC_NO_RUA', detail: 'Enforcement (p=' + parse.policy + ') without rua= cannot be tuned' });
      else if (w.startsWith('pct=100')) findings.push({ code: 'DMARC_FULL_ENFORCEMENT' });
      else if (w.startsWith('Unknown tag')) findings.push({ code: 'DMARC_UNKNOWN_TAG', detail: w });
    }
    const verdict: Severity = findings.some((f) => f.code === 'DMARC_SYNTAX_ERROR')
      ? 'fail'
      : findings.some((f) => f.code === 'DMARC_NO_RUA' || f.code === 'DMARC_P_NONE' || f.code === 'DMARC_UNKNOWN_TAG')
        ? 'warn'
        : 'pass';
    if (!findings.some((f) => f.code === 'DMARC_FULL_ENFORCEMENT')) {
      if (verdict === 'pass') findings.push({ code: 'DMARC_HEALTHY', detail: `Grade ${parse.grade}: ${t}` });
    }

    const verdictLine = verdict === 'fail'
      ? 'DMARC record found, but it has errors that can break the policy.'
      : verdict === 'warn'
        ? `Grade ${parse.grade} (${t}).`
        : `Grade ${parse.grade}: ${t}.`;

    emit(verdict, verdictLine, findings, domain, verdict === 'fail' ? RELATED_FAIL : RELATED_OK);
  });
</script>
