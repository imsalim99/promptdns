---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolPanel from '../components/ToolPanel.astro';

const faqSchema = {
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
  {
   "@type": "Question",
   "name": "Is the DMARC Record Checker really free?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Yes: every tool on PromptDNS is free forever, with no account, no limits, and no trial timers. The DMARC validation runs entirely in your browser."
   }
  },
  {
   "@type": "Question",
   "name": "How accurate are the results?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "The DMARC validation queries public DNS-over-HTTPS resolvers (Cloudflare, Google, Quad9) in real time. Results reflect what those resolvers actually serve, which is the same data the wider internet receives."
   }
  },
  {
   "@type": "Question",
   "name": "Do you store the domains I look up?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "No. Lookups happen client-side in your browser. Domains are not sent to our servers, stored, or logged. See the privacy policy for details."
   }
  },
  {
   "@type": "Question",
   "name": "Can I use this tool for client work?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Yes: the tools are free for commercial use. Agencies on the Business plan can also generate white-label automated reports."
   }
  },
  {
   "@type": "Question",
   "name": "How often should I run this check?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "After any DNS or infrastructure change, and periodically (weekly or monthly) as part of routine health monitoring. The paid plans automate this."
   }
  },
  {
   "@type": "Question",
   "name": "What if the results look wrong?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Compare with a second tool or dig from a terminal. If results differ between tools, one may be showing a cached answer: the propagation checker reveals which resolvers disagree."
   }
  }
 ]
}
---
<BaseLayout
  title="DMARC Record Checker, Check Your DMARC Policy"
  description="Free DMARC record checker: validate your DMARC policy tags, alignment, and reporting configuration with a clear grade."
  schema={[faqSchema]}
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a>
       <span aria-hidden="true">/</span>
      <a href="/tools/" class="hover:text-accent">Tools</a>
       <span aria-hidden="true">/</span>
      <span class="text-ink-dim">DMARC Record Checker</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">DMARC Record Checker</h1>
    <p class="mt-4 text-lg text-ink-dim">Check any domain's DMARC record: policy strength, reporting configuration, alignment settings, graded A to F.</p>

    <ToolPanel>
      <form id="dmarc-form" class="flex flex-col gap-3 sm:flex-row">
        <label class="sr-only" for="dmarc-domain">Domain</label>
        <input id="dmarc-domain" type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder="example.com"
          class="flex-1 rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30" />
        <button type="submit" class="btn-cta btn-shimmer px-6 py-2.5 text-sm">Check DMARC</button>
      </form>

      <div id="dmarc-status" class="mt-4 hidden rounded-md px-4 py-3 text-sm font-medium"></div>

      <div id="dmarc-grade" class="mt-4 hidden flex items-center gap-4 rounded-lg border border-line bg-panel/60 p-4">
        <span id="dmarc-grade-letter" class="font-display text-5xl font-bold text-accent"></span>
        <div>
          <p class="text-sm font-semibold text-ink" id="dmarc-grade-title"></p>
          <p class="text-xs text-ink-dim" id="dmarc-grade-desc"></p>
        </div>
      </div>

      <div id="dmarc-results" class="mt-6 hidden overflow-x-auto rounded-lg border border-line/60">
        <table class="pdns-table">
          <thead><tr><th>Tag</th><th>Value</th><th>Meaning</th></tr></thead>
          <tbody id="dmarc-tbody"></tbody>
        </table>
    </div>


    <div id="post-tool-cta" class="hidden mt-8 rounded-xl border border-accent/25 bg-gradient-to-br from-accent/10 to-violet/10 p-6 not-prose">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h3 class="font-display font-bold text-ink text-base">Found issues?</h3>
          <p class="mt-1 text-sm text-ink-dim">Get a full prioritized report, or let our experts fix everything for you.</p>
        </div>
        <div class="flex gap-3 flex-wrap">
          <a href="/pricing/" class="rounded-lg border border-line bg-panel px-4 py-2.5 text-sm font-medium text-ink hover:border-accent/40 transition">Get Full Report — $9</a>
          <a href="/pricing/" class="btn-cta btn-shimmer px-5 py-2.5 text-sm">Fix My Domain</a>
        </div>
      </div>
    </div>

    // Show CTA when tool results appear
    (function() {
      var targets = document.querySelectorAll('[id$="-status"], [id$="-results"], [id$="-output"], [id$="-tbody"], [id$="-cards"]');
      if (!targets.length) return;
      var obs = new MutationObserver(function(mutations) {
        for (var m of mutations) {
          var el = m.target;
          if (el && !el.classList.contains('hidden') && el.innerHTML.trim().length > 20) {
            var cta = document.getElementById('post-tool-cta');
            if (cta) cta.classList.remove('hidden');
            obs.disconnect();
            return;
          }
        }
      });
      targets.forEach(function(el) {
        obs.observe(el, { attributes: true, childList: true, subtree: true });
      });
    })();

    </div>

      <div id="dmarc-issues" class="mt-4 hidden grid gap-2"></div>
    </ToolPanel>

    <article class="rich-text mt-14 max-w-none">
      <h2>How DMARC is graded here</h2>
      <p><strong>A</strong>, enforcement (p=reject) with reporting. <strong>B</strong>, quarantine with reporting. <strong>C</strong>, monitoring (p=none) with reports. <strong>D/F</strong>, missing pieces. Enforcement without rua, or no record at all, leaves you blind or spoofable.</p>
      
      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Frequently asked questions</h2>
      <div class="mt-3 grid gap-3"><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Is the DMARC Record Checker really free?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Yes: every tool on PromptDNS is free forever, with no account, no limits, and no trial timers. The DMARC validation runs entirely in your browser.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">How accurate are the results?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">The DMARC validation queries public DNS-over-HTTPS resolvers (Cloudflare, Google, Quad9) in real time. Results reflect what those resolvers actually serve, which is the same data the wider internet receives.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Do you store the domains I look up?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">No. Lookups happen client-side in your browser. Domains are not sent to our servers, stored, or logged. See the privacy policy for details.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Can I use this tool for client work?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Yes: the tools are free for commercial use. Agencies on the Business plan can also generate white-label automated reports.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">How often should I run this check?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">After any DNS or infrastructure change, and periodically (weekly or monthly) as part of routine health monitoring. The paid plans automate this.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">What if the results look wrong?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Compare with a second tool or dig from a terminal. If results differ between tools, one may be showing a cached answer: the propagation checker reveals which resolvers disagree.</p></details></div>
<h2>Related tools</h2>
      <ul>
        <li><a href="/dmarc-record-generator/">DMARC Record Generator</a>, build a correct record</li>
        <li><a href="/spf-record-checker/">SPF Record Checker</a> and <a href="/dkim-record-checker/">DKIM Record Checker</a></li>
        <li><a href="/dmarc/">DMARC explained</a> (guide)</li>
      </ul>
    </article>
  </div>
</BaseLayout>

<script>
  import { lookup, RESOLVERS, normalizeDomain } from '../lib/doh';
  import { parseDmarc } from '../lib/dmarc';
  import { txtRecords } from '../lib/spf';

  const form = document.getElementById('dmarc-form') as HTMLFormElement;
  const input = document.getElementById('dmarc-domain') as HTMLInputElement;
  const statusEl = document.getElementById('dmarc-status')!;
  const gradeBox = document.getElementById('dmarc-grade')!;
  const gradeLetter = document.getElementById('dmarc-grade-letter')!;
  const gradeTitle = document.getElementById('dmarc-grade-title')!;
  const gradeDesc = document.getElementById('dmarc-grade-desc')!;
  const resultsEl = document.getElementById('dmarc-results')!;
  const tbody = document.getElementById('dmarc-tbody')!;
  const issuesEl = document.getElementById('dmarc-issues')!;

  const gradeMeta: Record<string, [string, string]> = {
    A: ['Full enforcement with reporting', 'Spoofed mail is rejected and you can monitor everything.'],
    B: ['Enforcement (quarantine) with reporting', 'Spoofed mail lands in spam. Consider moving to p=reject.'],
    C: ['Monitoring only', 'p=none with reports, good start, but spoofed mail is still delivered.'],
    D: ['Configured but incomplete', 'Policy exists but reporting is missing.'],
    F: ['Not protectable', 'No usable DMARC configuration found.'],
  };

  const setStatus = (cls: string, text: string) => {
    statusEl.className = `mt-4 rounded-md px-4 py-3 text-sm font-medium ${cls}`;
    statusEl.textContent = text;
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const domain = normalizeDomain(input.value);
    if (!domain.includes('.')) { setStatus('bg-fail/10 text-fail border border-fail/30', 'Enter a valid domain, e.g. example.com'); return; }
    [gradeBox, resultsEl, issuesEl].forEach((el) => el.classList.add('hidden'));
    setStatus('bg-panel-2 text-accent border border-line', `Looking up _dmarc.${domain}…`);

    const res = await lookup(`_dmarc.${domain}`, 'TXT', RESOLVERS[0]);
    const record = txtRecords(res.answers).find((t) => t.toLowerCase().startsWith('v=dmarc1'));
    if (!record) {
      setStatus('bg-fail/10 text-fail border border-fail/30', `No DMARC record on ${domain}. Anyone can spoof this domain.`);
      return;
    }
    const parse = parseDmarc(record);
    setStatus(parse.errors.length ? 'bg-fail/10 text-fail border border-fail/30'
      : parse.warnings.length ? 'bg-warn/10 text-warn border border-warn/30'
      : 'bg-pass/10 text-pass border border-pass/30',
      parse.errors.length ? 'DMARC record found, with errors.' : parse.warnings.length ? 'DMARC record found, with warnings.' : 'DMARC record found and healthy.');

    const [t, d] = gradeMeta[parse.grade];
    gradeLetter.textContent = parse.grade;
    gradeTitle.textContent = t;
    gradeDesc.textContent = d;
    gradeBox.classList.remove('hidden');

    tbody.innerHTML = `<tr><td colspan="3"><code>${record.replace(/</g, '&lt;')}</code></td></tr>`;
    for (const tag of parse.tags) {
      tbody.insertAdjacentHTML('beforeend', `<tr>
        <td class="font-mono text-xs text-accent">${tag.tag}=</td>
        <td class="font-mono text-xs text-ink">${tag.value.replace(/</g, '&lt;')}</td>
        <td class="text-ink-dim">${tag.meaning}</td>
      </tr>`);
    }
    resultsEl.classList.remove('hidden');

    issuesEl.innerHTML = '';
    for (const err of parse.errors) issuesEl.insertAdjacentHTML('beforeend', `<div class="rounded-md border border-fail/30 bg-fail/10 px-4 py-2 text-sm text-fail">✕ ${err}</div>`);
    for (const w of parse.warnings) issuesEl.insertAdjacentHTML('beforeend', `<div class="rounded-md border border-warn/30 bg-warn/10 px-4 py-2 text-sm text-warn">▲ ${w}</div>`);
    if (parse.errors.length || parse.warnings.length) issuesEl.classList.remove('hidden');
  });
</script>
