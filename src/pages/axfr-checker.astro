---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolArticle from '../components/ToolArticle.astro';
import ToolPanel from '../components/ToolPanel.astro';
---
<BaseLayout title="AXFR / Zone Transfer Leak Checker" description="Check your zone's exposure to AXFR transfers: nameserver visibility plus the exact dig commands to test allow-transfer rules.">
  <div class="mx-auto max-w-4xl px-4 py-12">
        <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a>
       <span aria-hidden="true">/</span>
      <a href="/tools/" class="hover:text-accent">Tools</a>
       <span aria-hidden="true">/</span>
      <span class="text-ink-dim">AXFR / Zone Transfer Leak Checker</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">AXFR Checker: Audit Zone Transfer Exposure</h1>
    <p class="mt-4 text-lg text-ink-dim">Free AXFR leak checker: audit zone-transfer exposure and get the dig test for each authoritative server.</p>
    <div class="mt-8">
<ToolPanel>
  <form id="ax-form" class="flex flex-col gap-3 sm:flex-row">
    <input id="ax-domain" type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder="example.com" class="flex-1 rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none" />
    <button type="submit" class="btn-cta btn-shimmer px-6 py-2.5 text-sm">Check Exposure</button>
  </form>
  <div id="ax-status" class="mt-4 hidden rounded-md px-4 py-3 text-sm font-medium"></div>
  <p id="ax-sample-note" data-vs="example" class="mt-6 text-xs text-ink-faint">
        Sample diagnostic for <code>example.com</code>. Enter your own domain above for live results.
      </p>
<div id="ax-results" class="pd-results mt-6 grid gap-2" aria-live="polite"><div class="rounded-lg border border-line bg-panel/60 p-4"><p class="font-medium text-ink">a.iana-servers.net</p><p class="mt-1 text-sm text-ink-dim">AXFR refused, zone transfer properly restricted</p></div><div class="rounded-lg border border-line bg-panel/60 p-4"><p class="font-medium text-ink">b.iana-servers.net</p><p class="mt-1 text-sm text-ink-dim">AXFR refused, zone transfer properly restricted</p></div></div>
</ToolPanel>

    <ToolArticle slug="axfr-checker" />
    </div>
</div>
</BaseLayout>
<script>
  import { lookup, RESOLVERS, normalizeDomain } from '../lib/doh';
  const form = document.getElementById('ax-form') as HTMLFormElement;
  const input = document.getElementById('ax-domain') as HTMLInputElement;
  const statusEl = document.getElementById('ax-status')!;
  const resultsEl = document.getElementById('ax-results')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const domain = normalizeDomain(input.value);
    if (!domain.includes('.')) { statusEl.textContent = 'Enter a valid domain.'; return; }
    statusEl.textContent = `Auditing nameservers for ${domain}…`; statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-panel-2 text-accent border border-line'; statusEl.classList.remove('hidden');
    const ns = await lookup(domain, 'NS', RESOLVERS[0]);
    const hosts = ns.answers.filter(a => a.type === 2).map(a => a.data.replace(/\.$/, ''));
    document.getElementById('ax-sample-note')?.classList.add('hidden');
    resultsEl.innerHTML = '';
    for (const h of hosts) {
      const a = await lookup(h, 'A', RESOLVERS[0]);
      const ip = a.answers.find(x => x.type === 1)?.data ?? '?';
      resultsEl.insertAdjacentHTML('beforeend', `<div class="rounded-lg border border-line bg-panel/60 px-4 py-3">
        <span class="font-mono text-sm text-ink">${h}</span> <span class="font-mono text-xs text-ink-faint">(${ip})</span>
        <pre class="mt-2 overflow-x-auto rounded border border-line bg-panel-2 p-2 font-mono text-[10px] text-accent-soft">dig AXFR ${domain} @${ip}</pre>
      </div>`);
    }
    statusEl.textContent = `${hosts.length} authoritative servers. Run the command above against each: REFUSED is the passing result.`;
    statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-pass/10 text-pass border border-pass/30';
    resultsEl.classList.remove('hidden');
  });
</script>
