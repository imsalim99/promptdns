---
import BaseLayout from '../../layouts/BaseLayout.astro';

/** slug -> display name, built from the ESP matrix filenames via the tools data is not
 *  available here, so maintain the mapping used by the generator in one place. */
const espNames: Record<string, string> = Object.fromEntries([
  ['sendgrid','SendGrid'],['mailchimp','Mailchimp'],['hubspot','HubSpot'],['zoho-mail','Zoho Mail'],
  ['brevo','Brevo (Sendinblue)'],['klaviyo','Klaviyo'],['postmark','Postmark'],['mailgun','Mailgun'],
  ['mandrill','Mandrill'],['salesforce','Salesforce'],['pipedrive','Pipedrive'],['zendesk','Zendesk'],
  ['freshdesk','Freshdesk'],['atlassian','Atlassian (Jira/Confluence)'],['intercom','Intercom'],
  ['activecampaign','ActiveCampaign'],['constant-contact','Constant Contact'],['mailerlite','MailerLite'],
  ['getresponse','GetResponse'],['aweber','AWeber'],['mailjet','Mailjet'],['moosend','Moosend'],
  ['campaign-monitor','Campaign Monitor'],['customer-io','Customer.io'],['sparkpost','SparkPost'],
  ['amazon-ses','Amazon SES'],['smtp2go','SMTP2GO'],['socketlabs','SocketLabs'],['shopify-email','Shopify Email'],
  ['woocommerce','WooCommerce'],['bigcommerce','BigCommerce'],['woodpecker','Woodpecker'],
  ['instantly','Instantly'],['lemlist','Lemlist'],['reply-io','Reply.io'],['gmass','GMass'],
  ['sendy','Sendy'],['drip','Drip'],['dotdigital','Dotdigital'],['ongage','Ongage'],
  ['pepipost','Pepipost (Netcore)'],['mailer-send','MailerSend'],
]);
const slugToName = (slug: string) => espNames[slug] ?? slug;

const sections = [
  { href: '/spf-record/', title: 'SPF, Sender Policy Framework', desc: 'Which servers may send mail as your domain. Syntax, examples, and the 10-lookup limit.' },
  { href: '/dkim/', title: 'DKIM, DomainKeys Identified Mail', desc: 'Cryptographic signing that proves mail wasn\u2019t tampered with in transit.' },
  { href: '/dmarc/', title: 'DMARC, Policy + Reporting', desc: 'The policy layer that tells receivers what to do when SPF/DKIM fail, and reports back.' },
  { href: '/spf-permerror/', title: 'SPF PermError', desc: 'What it means when SPF cannot be evaluated, and how to fix it safely.' },
  { href: '/dmarc-alignment/', title: 'DMARC Alignment', desc: 'Why mail can pass SPF and still fail DMARC: relaxed vs strict alignment.' },
  { href: '/spf-softfail-vs-hardfail/', title: 'Softfail vs Hardfail', desc: '~all vs -all: what each means and how to choose based on your senders.' },
  { href: '/bimi/', title: 'BIMI', desc: 'Display your verified logo in inboxes.' },
  { href: '/mta-sts/', title: 'MTA-STS & TLS-RPT', desc: 'Enforce TLS for inbound mail and get failure reports.' },
  { href: '/email-ports-587-465-25/', title: 'Email Ports Explained', desc: '25 vs 465 vs 587: which port for which purpose.' },
  { href: '/how-to-read-email-headers/', title: 'How to Read Email Headers', desc: 'The delivery story: authentication verdicts, hops, red flags.' },
  { href: '/spf-dkim-dmarc-google-workspace/', title: 'Google Workspace Setup', desc: 'SPF, DKIM, and DMARC step by step for Google Workspace.' },
  { href: '/spf-dkim-dmarc-microsoft-365/', title: 'Microsoft 365 Setup', desc: 'SPF, DKIM, and DMARC step by step for Microsoft 365.' },
  { href: '/email-deliverability/', title: 'Email Deliverability', desc: 'Sender reputation, bounce handling, warm-up schedules, and staying out of spam.' },
  { href: '/ssl-tls/', title: 'SSL/TLS Guides', desc: 'Certificates, HSTS, TLS versions, and HTTPS best practices.' },
];
---
<BaseLayout
  title="Email Authentication: SPF, DKIM & DMARC"
  description="Set up SPF, DKIM, and DMARC to stop spoofing and land in the inbox. Complete guides with syntax, examples, and provider-specific steps."
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a> <span aria-hidden="true">/</span>
      <span class="text-ink-dim">Email Authentication</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">Email Authentication: SPF, DKIM & DMARC</h1>
    <p class="mt-5 text-lg leading-relaxed text-ink-dim">
      Email authentication proves your mail is really from you. Since Gmail, Yahoo, and Microsoft
      began requiring SPF, DKIM, and DMARC for bulk senders, it is no longer optional. These
      guides take you from first record to full enforcement.
    </p>

    <div class="mt-10 grid gap-4">
      {sections.map((s) => (
        <a href={s.href} class="group rounded-xl border border-line bg-panel/60 p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/40">
          <h2 class="font-display font-semibold text-ink group-hover:text-accent">{s.title}</h2>
          <p class="mt-1 text-sm text-ink-dim">{s.desc}</p>
        </a>
      ))}
    </div>

    <!-- Deep guides: mechanism syntax, policies, reports, and the newer protocols -->
    <div class="mt-16">
      <div class="flex flex-wrap items-center gap-4 border-b border-line pb-4">
        <span class="h-9 w-1.5 rounded-full bg-gradient-to-b from-accent to-violet" aria-hidden="true"></span>
        <div class="flex-1">
          <h2 class="font-display text-2xl font-bold tracking-tight text-ink">Deep guides</h2>
          <p class="mt-0.5 text-sm text-ink-faint">Mechanism syntax, policies, reports, and the protocols beyond DMARC</p>
        </div>
      </div>

      {(
        [
          ['SPF', [
            ['/spf-mechanisms-explained/', 'SPF mechanisms explained'],
            ['/spf-record-examples/', 'SPF record examples'],
            ['/how-to-create-spf-record/', 'How to create an SPF record'],
            ['/spf-flattening/', 'SPF flattening'],
            ['/spf-temperror/', 'SPF TempError'],
            ['/spf-record-too-long/', 'SPF record too long'],
            ['/spf-vs-dkim/', 'SPF vs DKIM'],
            ['/spf-vs-dmarc/', 'SPF vs DMARC'],
          ]],
          ['DKIM', [
            ['/how-dkim-works/', 'How DKIM works'],
            ['/dkim-key-length/', 'DKIM key length'],
            ['/dkim-not-signing/', 'DKIM not signing'],
            ['/dkim-vs-dmarc/', 'DKIM vs DMARC'],
            ['/multiple-dkim-selectors/', 'Multiple DKIM selectors'],
            ['/dkim-canonicalization/', 'DKIM canonicalization'],
          ]],
          ['DMARC', [
            ['/dmarc-record-syntax/', 'DMARC record syntax'],
            ['/dmarc-policies/', 'DMARC policies'],
            ['/dmarc-aggregate-reports/', 'DMARC aggregate reports'],
            ['/dmarc-forensic-reports/', 'DMARC forensic reports'],
            ['/how-to-create-dmarc-record/', 'How to create a DMARC record'],
            ['/dmarc-enforcement-roadmap/', 'DMARC enforcement roadmap'],
            ['/dmarc-pct-tag/', 'DMARC pct tag'],
            ['/dmarc-subdomain-policy/', 'DMARC subdomain policy'],
            ['/dmarc-vs-spf-vs-dkim/', 'DMARC vs SPF vs DKIM'],
          ]],
          ['Beyond DMARC', [
            ['/bimi-record/', 'BIMI record'],
            ['/bimi-vmc/', 'BIMI VMC certificate'],
            ['/mta-sts-record/', 'MTA-STS record'],
            ['/tls-rpt/', 'TLS-RPT'],
            ['/tls-rpt-record/', 'TLS-RPT record'],
            ['/arc-seal-explained/', 'ARC seal explained'],
          ]],
        ] as [string, [string, string][]][]
      ).map(([label, links]) => (
        <div class="mt-6">
          <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent">{label}</p>
          <div class="mt-2 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
            {links.map(([href, name]) => (
              <a href={href} class="rounded-lg border border-line bg-panel/60 px-4 py-2.5 text-sm text-ink-dim transition-all hover:border-accent/40 hover:text-accent">
                {name}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Per-service setup matrix -->
    <div class="mt-16">
      <div class="flex flex-wrap items-center gap-4 border-b border-line pb-4">
        <span class="h-9 w-1.5 rounded-full bg-gradient-to-b from-accent to-violet" aria-hidden="true"></span>
        <div class="flex-1">
          <h2 class="font-display text-2xl font-bold tracking-tight text-ink">Setup guides for every service</h2>
          <p class="mt-0.5 text-sm text-ink-faint">SPF, DKIM, and DMARC setup, step by step, for 42 sending platforms</p>
        </div>
      </div>

      {(
        [
          ['Email & marketing platforms', ['sendgrid','mailchimp','brevo','klaviyo','mailgun','mandrill','postmark','mailjet','moosend','campaign-monitor','customer-io','sparkpost','smtp2go','socketlabs','drip','dotdigital','ongage','pepipost','mailer-send','amazon-ses','activecampaign','constant-contact','mailerlite','getresponse','aweber','zoho-mail']],
          ['CRM & business tools', ['hubspot','salesforce','pipedrive','zendesk','freshdesk','atlassian','intercom']],
          ['Ecommerce', ['shopify-email','woocommerce','bigcommerce']],
          ['Cold outreach', ['woodpecker','instantly','lemlist','reply-io','gmass']],
          ['Self-hosted', ['sendy']],
        ] as [string, string[]][]
      ).map(([label, slugs]) => (
        <div class="mt-6">
          <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent">{label}</p>
          <div class="mt-2 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
            {slugs.map((slug) => (
              <a href={`/spf-dkim-dmarc-${slug}/`} class="rounded-lg border border-line bg-panel/60 px-4 py-2.5 text-sm text-ink-dim transition-all hover:border-accent/40 hover:text-accent">
                {slugToName[slug] ?? slug}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="mt-12 rounded-xl border border-violet/25 bg-gradient-to-br from-violet/10 to-accent/10 p-6">
      <h2 class="font-display font-semibold text-ink">Scan your domain</h2>
      <p class="mt-1 text-sm text-ink-dim">
        Check your SPF, DKIM, and DMARC in one pass with the
        <a href="/" class="font-medium text-accent hover:text-accent-soft">homepage security scanner</a>,
        live results, no signup.
      </p>
    </div>
  </div>
</BaseLayout>
