---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

interface HubCard {
  href: string;
  badge: string;
  title: string;
  desc: string;
}

const ipAddressingCards: HubCard[] = [
  {
    href: '/asn-explained/',
    badge: 'Guide',
    title: 'What Is an ASN (Autonomous System Number)?',
    desc: 'How BGP uses 16-bit and 32-bit ASNs to route IP prefixes, Stub vs Multihomed vs Transit ASes, the 5 RIRs, and ASN lookup.',
  },
  {
    href: '/static-vs-dynamic-ip/',
    badge: 'Guide',
    title: 'Static vs Dynamic IP Address',
    desc: 'How DHCP leases work, how to check if your IP is static or dynamic on Windows/Mac/Linux, and why servers need static IPs.',
  },
  {
    href: '/ipv4-vs-ipv6/',
    badge: 'Guide',
    title: 'IPv4 vs IPv6: Key Differences Explained',
    desc: 'Compare 32-bit dotted-decimal IPv4 (4.3B addresses) against 128-bit hexadecimal IPv6 (340 undecillion), headers, and dual-stack speed.',
  },
  {
    href: '/public-vs-private-ip/',
    badge: 'Guide',
    title: 'Public vs Private IP Addresses',
    desc: 'Understand external WAN IPs vs internal LAN IPs (10.x.x.x, 172.16.x.x, 192.168.x.x) and why private IPs fail in public DNS.',
  },
  {
    href: '/reserved-ip-ranges/',
    badge: 'Guide',
    title: 'Reserved and Private IP Ranges (RFC 1918 & More)',
    desc: 'Complete reference table for RFC 1918 private LANs, 127.0.0.0/8 loopback, 100.64.0.0/10 CGNAT, link-local, and TEST-NET blocks.',
  },
  {
    href: '/nat-explained/',
    badge: 'Guide',
    title: 'NAT Explained (Network Address Translation)',
    desc: 'How home and enterprise routers use SNAT, DNAT, Port Address Translation (PAT), and Carrier-Grade NAT to share one public IP.',
  },
  {
    href: '/bgp-explained/',
    badge: 'Guide',
    title: 'What Is BGP (Border Gateway Protocol)?',
    desc: 'How autonomous systems announce IP prefixes over TCP port 179, best-path selection, eBGP vs iBGP, and anycast DNS routing.',
  },
  {
    href: '/rpki-roa-explained/',
    badge: 'Guide',
    title: 'RPKI and ROAs: Securing BGP Route Origins',
    desc: 'How Route Origin Authorizations cryptographically bind IP prefixes to originating ASNs and prevent BGP hijacks.',
  },
];

const routingProxiesCards: HubCard[] = [
  {
    href: '/common-network-ports/',
    badge: 'Guide',
    title: 'Common Network Ports: The Reference List',
    desc: 'Complete cheat sheet for DNS (53, 853), Web (80, 443), Email (25, 465, 587, 993), SSH (22), and database TCP/UDP ports.',
  },
  {
    href: '/dns-load-balancing/',
    badge: 'Guide',
    title: 'DNS Load Balancing (Round-Robin, GeoDNS & GSLB)',
    desc: 'Compare Round-Robin, Weighted, Latency-Based, GeoDNS, and Active Failover against L4/L7 application load balancers.',
  },
  {
    href: '/reverse-proxy-explained/',
    badge: 'Guide',
    title: 'Reverse Proxy Explained (NGINX & Cloudflare)',
    desc: 'How reverse proxies sit in front of backend servers to terminate SSL/TLS, hide origin IPs, cache assets, and route ports.',
  },
  {
    href: '/what-is-a-cdn/',
    badge: 'Guide',
    title: 'What Is a CDN (Content Delivery Network)?',
    desc: 'How Anycast edge networks cache static and dynamic assets across global PoPs to cut latency and absorb DDoS attacks.',
  },
  {
    href: '/doh-vs-dot/',
    badge: 'Guide',
    title: 'DNS-over-HTTPS (443) vs DNS-over-TLS (853)',
    desc: 'How encrypted DNS encapsulates port 53 queries inside HTTPS port 443 and TLS/QUIC port 853 connections.',
  },
  {
    href: '/email-ports-587-465-25/',
    badge: 'Guide',
    title: 'Email Ports Explained: 25 vs 465 vs 587',
    desc: 'Why ISPs block outbound TCP port 25 and when to configure port 587 (STARTTLS) or port 465 (Implicit TLS).',
  },
];

const ipDnsRecordsCards: HubCard[] = [
  {
    href: '/a-record/',
    badge: 'Guide',
    title: 'A Record (IPv4 Address Mapping)',
    desc: 'Point domains and subdomains to 32-bit IPv4 server addresses and avoid RFC 1918 private IP and port syntax mistakes.',
  },
  {
    href: '/aaaa-record/',
    badge: 'Guide',
    title: 'AAAA Record (IPv6 Quad-A Mapping)',
    desc: 'Configure 128-bit IPv6 addresses, :: zero-compression shorthand, and dual-stack Happy Eyeballs connection racing.',
  },
  {
    href: '/ptr-record/',
    badge: 'Guide',
    title: 'PTR Record (Reverse DNS / rDNS)',
    desc: 'How .in-addr.arpa and .ip6.arpa map IP addresses back to hostnames at your cloud host/ISP for FCrDNS mail verification.',
  },
  {
    href: '/srv-record/',
    badge: 'Guide',
    title: 'SRV Record (TCP/UDP Port Locator)',
    desc: 'Publish _service._proto priority, weight, and custom port numbers in DNS for SIP, Teams, Active Directory, and Minecraft.',
  },
  {
    href: '/dns/',
    badge: 'Guide',
    title: 'DNS: The Complete Guide to the Domain Name System',
    desc: 'Return to the main Domain Name System guide covering resolution architecture, propagation, migrations, and troubleshooting.',
  },
];

const networkToolsCards: HubCard[] = [
  {
    href: '/my-ip/',
    badge: 'Free Tool',
    title: 'What Is My IP Address',
    desc: 'View your current public IPv4/IPv6 address, ISP organization, ASN number, and geographic location instantly.',
  },
  {
    href: '/ip-lookup/',
    badge: 'Free Tool',
    title: 'IP Lookup (Location, ASN & PTR)',
    desc: 'Enter any IPv4 or IPv6 address to inspect its originating ASN, network owner, country, and reverse DNS hostname.',
  },
  {
    href: '/reverse-ip-lookup/',
    badge: 'Free Tool',
    title: 'Reverse IP Lookup (PTR)',
    desc: 'Query .in-addr.arpa and .ip6.arpa PTR records across 3 global DoH resolvers to verify FCrDNS server identity.',
  },
  {
    href: '/cidr-calculator/',
    badge: 'Free Tool',
    title: 'CIDR / Subnet Calculator',
    desc: 'Calculate network address, broadcast IP, netmask, wildcard mask, and usable host count for any IPv4 or IPv6 CIDR block.',
  },
  {
    href: '/ipv4-to-ipv6-converter/',
    badge: 'Free Tool',
    title: 'IPv4 to IPv6 Converter',
    desc: 'Convert 32-bit IPv4 addresses into IPv4-mapped IPv6 (::ffff:x.x.x.x) and 6to4 (2002::) hexadecimal formats.',
  },
  {
    href: '/whois-lookup/',
    badge: 'Free Tool',
    title: 'WHOIS / RDAP Lookup',
    desc: 'Query official ICANN and RIR RDAP registries for domain and IP registration data, EPP lock status, and abuse contacts.',
  },
  {
    href: '/domain-age-checker/',
    badge: 'Free Tool',
    title: 'Domain Age Checker',
    desc: 'Check exact domain creation date, age in years/days, last-updated timestamp, and registration expiry date via RDAP.',
  },
  {
    href: '/nameserver-lookup/',
    badge: 'Free Tool',
    title: 'Nameserver Lookup (Find NS + IPs)',
    desc: "Discover a domain's authoritative nameservers along with their underlying IPv4 (A) and IPv6 (AAAA) glue addresses.",
  },
  {
    href: '/punycode-converter/',
    badge: 'Free Tool',
    title: 'Punycode / IDN Converter',
    desc: 'Translate Unicode internationalized domain names (IDNs with accents, scripts, or emojis) to and from ASCII xn-- Punycode.',
  },
  {
    href: '/dns-leak-test/',
    badge: 'Free Tool',
    title: 'DNS Leak Test',
    desc: 'Test which recursive DNS server IPs and ISP ASNs are resolving your browser queries when using a VPN or DoH.',
  },
  {
    href: '/asn-lookup/',
    badge: 'Free Tool',
    title: 'ASN Lookup (BGP Prefixes & RPKI)',
    desc: 'Look up any ASN, IP, or domain to inspect the network holder, RIR, announced BGP prefixes, and RPKI ROA validation status.',
  },
];

const faqs = [
  {
    q: 'How do IP addresses and DNS work together when loading a website?',
    a: 'IP addresses (93.184.216.34 or 2606:2800:220:1::) are the numerical network addresses that internet routers use to deliver packets from your device to a web server. DNS (the Domain Name System) is the lookup layer that translates a human-readable domain name (example.com) into that numerical IP address before your browser opens the TCP and HTTPS connection.',
  },
  {
    q: 'Is the 192.168.1.x address shown in ipconfig my public internet IP address?',
    a: 'No, the 192.168.1.x address shown in ipconfig is your Private LAN IP (from the RFC 1918 private block), assigned to your computer by your home or office Wi-Fi router via DHCP for local communication. Your router uses Network Address Translation (NAT) to replace that private address with a single ISP-assigned Public IP when packets leave your network for the internet. Use our browser-based What Is My IP Address tool above to inspect your external public IP.',
  },
  {
    q: 'What does the "/24" or "/32" at the end of an IP address mean in firewall and SPF rules?',
    a: 'In practice, that slash number is CIDR (Classless Inter-Domain Routing) notation, which tells the server how many leading bits of the 32-bit IPv4 address are fixed as the network prefix. A /32 means one exact single IP address (32 - 32 = 0 host bits, giving 2^0 = 1 IP), whereas a /24 (netmask 255.255.255.0) covers a block of 256 contiguous IP addresses (giving 2^8 = 256 IPs, such as 198.51.100.0 through 198.51.100.255). Use our CIDR Calculator above to inspect any prefix instantly.',
  },
  {
    q: 'How can I find out which cloud provider or ISP hosts a specific IP address or website?',
    a: 'First, run an A Record Lookup on the domain name to retrieve its IPv4 address. Second, paste that IP address into our IP Lookup tool to query Regional Internet Registry (RDAP) and BGP routing data, which reveals the Autonomous System Number (ASN, such as AS13335 for Cloudflare, AS16509 for AWS, or AS15169 for Google Cloud), the organization name, and the reverse DNS (PTR) hostname.',
  },
];

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'IP and Networking: IPv4 vs IPv6, CIDR Subnetting, ASNs, NAT, Ports, and Tools',
  url: 'https://promptdns.com/ip-and-networking/',
  description: 'Complete technical reference for IP and networking: IPv4 vs IPv6 addressing, RFC 1918 private ranges, CIDR subnetting, BGP ASNs, NAT routing, network ports, and 11 free network utilities.',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://promptdns.com/' },
    { '@type': 'ListItem', position: 2, name: 'IP & Networking', item: 'https://promptdns.com/ip-and-networking/' },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---

<BaseLayout
  title="IP and Networking: IPv4 vs IPv6, CIDR Subnetting, ASNs, NAT, Ports, and Tools"
  description="Complete technical reference for IP and networking: IPv4 vs IPv6 addressing, RFC 1918 private ranges, CIDR subnetting, BGP ASNs, NAT routing, network ports, and 11 free network utilities."
  schema={[collectionSchema, breadcrumbSchema, faqSchema]}
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent transition-colors">Home</a>
      <span aria-hidden="true" class="mx-2">/</span>
      <span class="text-ink-dim" aria-current="page">IP &amp; Networking</span>
    </nav>

    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
      IP and Networking: IPv4 vs IPv6, CIDR Subnetting, ASNs, NAT, Ports, and Tools
    </h1>

    <div class="pd-answer mt-6" data-vs="answer">
      <p class="text-lg leading-relaxed text-ink-dim">
        IP and networking infrastructure is <strong class="text-ink">the system of numerical host addresses (<code>IPv4</code> and <code>IPv6</code>), CIDR subnet masks, Autonomous System Numbers (<code>ASNs</code>), and TCP/UDP transport ports that route packets after DNS resolution</strong>. Routers forward traffic across BGP and NAT boundaries. The 6 layers connect domain names to servers.
      </p>
    </div>

    <nav class="pd-toc" aria-label="On this page">
      <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent">On this page</p>
      <ul>
        <li><a href="#layers">How the 6 Layers of IP Addressing and Network Routing Fit Together</a></li>
        <li><a href="#ip-addressing">1. IPv4, IPv6, Private Ranges, Static vs Dynamic IPs, NAT, and ASNs</a></li>
        <li><a href="#routing-proxies">2. Network Ports, Reverse Proxies, CDNs, and DNS Load Balancing</a></li>
        <li><a href="#ip-dns-records">3. IP-to-Domain DNS Record Guides</a></li>
        <li><a href="#network-tools">4. Free Browser-Based IP, CIDR Subnet, RDAP, and Network Utility Tools</a></li>
        <li><a href="#faq">Frequently Asked Questions</a></li>
      </ul>
    </nav>

    <div class="mt-12 space-y-16">
      <!-- Section 1: Overview Table -->
      <section id="layers" class="scroll-mt-24">
        <h2 class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
          How the 6 Layers of IP Addressing and Network Routing Fit Together
        </h2>
        <p class="mt-4 text-base leading-relaxed text-ink-dim">
          Resolving a domain name in DNS is only step one of a network connection: once the browser or mail server receives an IPv4 or IPv6 address, operating systems and internet routers rely on 6 networking layers to address, subnet, translate, route, and transport packets to the destination service. The table below compares the 6 core networking layers covered in this guide by technical scope, governing standards, and primary operational role.
        </p>

        <div class="mt-6 overflow-x-auto">
          <table class="pdns-table border-collapse rounded-xl border border-line bg-panel/40 text-left text-sm text-ink-dim">
            <thead>
              <tr class="border-b border-line bg-panel/80 text-xs font-semibold uppercase tracking-wider text-ink">
                <th class="px-4 py-3">Networking Layer</th>
                <th class="px-4 py-3">Technical Scope &amp; Format</th>
                <th class="px-4 py-3">Governing Standards</th>
                <th class="px-4 py-3">Operational Role in Web &amp; Email Infrastructure</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              <tr>
                <td class="px-4 py-3 font-medium text-ink">1. IP Protocol Versions</td>
                <td class="px-4 py-3"><strong>IPv4</strong> (<code>32-bit</code> dotted decimal) and <strong>IPv6</strong> (<code>128-bit</code> colon hexadecimal).</td>
                <td class="px-4 py-3"><code>RFC 791</code> (IPv4) &amp; <code>RFC 8200</code> (IPv6)</td>
                <td class="px-4 py-3">Provides unique numerical interface addresses for every server, router, and client device.</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium text-ink">2. Address Scope &amp; NAT</td>
                <td class="px-4 py-3"><strong>Public WAN IPs</strong> vs <strong>Private LAN IPs</strong> (<code>10.0.0.0/8</code>, <code>172.16.0.0/12</code>, <code>192.168.0.0/16</code>) &amp; <strong>CGNAT</strong> (<code>100.64.0.0/10</code>).</td>
                <td class="px-4 py-3"><code>RFC 1918</code>, <code>RFC 6598</code>, &amp; <code>RFC 3022</code> (<code>NAT</code>)</td>
                <td class="px-4 py-3">Separates globally routable internet server IPs from internal local networks behind routers.</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium text-ink">3. Assignment Stability</td>
                <td class="px-4 py-3"><strong>Static IP</strong> (fixed server address) vs <strong>Dynamic IP</strong> (temporary <code>DHCP</code> lease).</td>
                <td class="px-4 py-3"><code>RFC 2131</code> (<code>DHCP</code>)</td>
                <td class="px-4 py-3">Ensures production DNS <code>A</code>/<code>AAAA</code> and <code>PTR</code> mail records point to permanent, non-rotating server IPs.</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium text-ink">4. CIDR &amp; Subnetting</td>
                <td class="px-4 py-3">Prefix-length bitmasks (<code>/8</code> to <code>/32</code> in IPv4; <code>/48</code> to <code>/128</code> in IPv6).</td>
                <td class="px-4 py-3"><code>RFC 4632</code> (<code>CIDR</code>)</td>
                <td class="px-4 py-3">Divides IP blocks into subnets, defines firewall allowlists, and formats <code>SPF</code> <code>ip4:</code>/<code>ip6:</code> ranges.</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium text-ink">5. BGP &amp; ASN Ownership</td>
                <td class="px-4 py-3"><strong>16-bit and 32-bit ASNs</strong> (<code>AS13335</code>, <code>AS15169</code>) allocated by the 5 RIRs (<code>ARIN</code>, <code>RIPE</code>, <code>APNIC</code>, <code>LACNIC</code>, <code>AFRINIC</code>).</td>
                <td class="px-4 py-3"><code>RFC 4271</code> (<code>BGP-4</code>) &amp; <code>RFC 6793</code></td>
                <td class="px-4 py-3">Routes IP prefixes across internet backbones, powers Anycast DNS, and scores sender reputation.</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium text-ink">6. Ports, Proxies &amp; CDNs</td>
                <td class="px-4 py-3"><strong>16-bit TCP/UDP ports</strong> (<code>53</code>, <code>80</code>, <code>443</code>, <code>25</code>, <code>587</code>), Reverse Proxies (<code>NGINX</code>), CDNs, and <code>GSLB</code>.</td>
                <td class="px-4 py-3"><code>RFC 6335</code> (IANA Ports)</td>
                <td class="px-4 py-3">Directs packets arriving at a server IP to the exact application daemon and balances global load.</td>
              </tr>
            </tbody>
          </table>
        </div>

        <p class="mt-6 text-base leading-relaxed text-ink-dim">
          Explore the guides in four sections: <strong class="text-ink">Section 1</strong> covers IP addressing, private ranges, DHCP vs static IPs, NAT, and BGP ASNs, <strong class="text-ink">Section 2</strong> covers network ports, reverse proxies, CDNs, and load balancing, <strong class="text-ink">Section 3</strong> links to the DNS records that map IPs (<code>A</code>, <code>AAAA</code>, <code>PTR</code>, <code>SRV</code>), and <strong class="text-ink">Section 4</strong> provides 11 free browser-based IP, CIDR, and RDAP tools.
        </p>
      </section>

      <!-- Section 2: IP Addressing Grid -->
      <section id="ip-addressing" class="scroll-mt-24">
        <h2 class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
          1. IPv4, IPv6, Private Ranges, Static vs Dynamic IPs, NAT, and ASNs (8 Guides)
        </h2>
        <p class="mt-4 text-base leading-relaxed text-ink-dim">
          Eight guides explain how IPv4 and IPv6 addresses are structured, which IP blocks are reserved for private local networks (<code>RFC 1918</code> and <code>CGNAT</code>), how to check if your IP is static or dynamic, how routers translate addresses with NAT, and how BGP uses Autonomous System Numbers (<code>ASNs</code>). Select a guide below:
        </p>

        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {ipAddressingCards.map((card) => (
            <a
              href={card.href}
              class="group block rounded-2xl border border-line bg-panel/60 p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/40 hover:bg-panel/80"
            >
              <span class="inline-block rounded-md border border-accent/30 bg-accent/10 px-2 py-0.5 text-xs font-medium text-accent">
                {card.badge}
              </span>
              <h3 class="mt-2.5 text-base font-semibold text-ink transition-colors group-hover:text-accent">
                {card.title}
              </h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-dim">
                {card.desc}
              </p>
            </a>
          ))}
        </div>
      </section>

      <!-- Section 3: Routing, Proxies & CDNs Grid -->
      <section id="routing-proxies" class="scroll-mt-24">
        <h2 class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
          2. Network Ports, Reverse Proxies, CDNs, and DNS Load Balancing (6 Guides)
        </h2>
        <p class="mt-4 text-base leading-relaxed text-ink-dim">
          Six guides cover what happens after a packet reaches a target IP address: how TCP and UDP port numbers route traffic to the right service (<code>53</code>, <code>80</code>, <code>443</code>, <code>25</code>, <code>587</code>), and how reverse proxies, CDNs, and DNS load balancers distribute global traffic. Open a guide below:
        </p>

        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {routingProxiesCards.map((card) => (
            <a
              href={card.href}
              class="group block rounded-2xl border border-line bg-panel/60 p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/40 hover:bg-panel/80"
            >
              <span class="inline-block rounded-md border border-accent/30 bg-accent/10 px-2 py-0.5 text-xs font-medium text-accent">
                {card.badge}
              </span>
              <h3 class="mt-2.5 text-base font-semibold text-ink transition-colors group-hover:text-accent">
                {card.title}
              </h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-dim">
                {card.desc}
              </p>
            </a>
          ))}
        </div>
      </section>

      <!-- Section 4: IP-to-Domain DNS Records Grid -->
      <section id="ip-dns-records" class="scroll-mt-24">
        <h2 class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
          3. IP-to-Domain DNS Record Guides (A, AAAA, PTR, SRV, and Core DNS) (5 Guides)
        </h2>
        <p class="mt-4 text-base leading-relaxed text-ink-dim">
          Four specialized DNS record types bridge the gap between human domain names and numerical IP addresses and ports: <code>A</code> and <code>AAAA</code> for forward resolution, <code>PTR</code> for reverse IP-to-hostname lookups, and <code>SRV</code> for port discovery. Explore the record guides below:
        </p>

        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {ipDnsRecordsCards.map((card) => (
            <a
              href={card.href}
              class="group block rounded-2xl border border-line bg-panel/60 p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/40 hover:bg-panel/80"
            >
              <span class="inline-block rounded-md border border-accent/30 bg-accent/10 px-2 py-0.5 text-xs font-medium text-accent">
                {card.badge}
              </span>
              <h3 class="mt-2.5 text-base font-semibold text-ink transition-colors group-hover:text-accent">
                {card.title}
              </h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-dim">
                {card.desc}
              </p>
            </a>
          ))}
        </div>
      </section>

      <!-- Section 5: Network Tools Grid -->
      <section id="network-tools" class="scroll-mt-24">
        <h2 class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
          4. Free Browser-Based IP, CIDR Subnet, RDAP, and Network Utility Tools (11 Tools)
        </h2>
        <p class="mt-4 text-base leading-relaxed text-ink-dim">
          Inspect your own public IP and ASN, look up geolocation and reverse DNS (<code>PTR</code>) for any server IP, calculate IPv4/IPv6 CIDR subnet ranges, query RDAP registration dates, and convert Punycode or IPv6 formats using our 11 free tools below:
        </p>

        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {networkToolsCards.map((card) => (
            <a
              href={card.href}
              class="group block rounded-2xl border border-line bg-panel/60 p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/40 hover:bg-panel/80"
            >
              <span class="inline-block rounded-md border border-accent/30 bg-accent/10 px-2 py-0.5 text-xs font-medium text-accent">
                {card.badge}
              </span>
              <h3 class="mt-2.5 text-base font-semibold text-ink transition-colors group-hover:text-accent">
                {card.title}
              </h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-dim">
                {card.desc}
              </p>
            </a>
          ))}
        </div>
      </section>

      <!-- Closing Callout Box -->
      <div class="mt-12 rounded-2xl border border-accent/25 bg-gradient-to-br from-accent/10 to-violet/10 p-6">
        <p class="text-sm leading-relaxed text-ink-dim">
          Every guide, comparison guide, and diagnostic utility in this <strong class="text-ink">IP and Networking reference guide</strong> helps you manage <strong class="text-ink">IPv4 and IPv6 addressing</strong>, calculate <strong class="text-ink">CIDR subnets</strong>, understand <strong class="text-ink">BGP ASN routing and NAT</strong>, and audit <strong class="text-ink">reverse DNS (<code>PTR</code>) and network ports</strong>.
        </p>
      </div>

      <!-- FAQ Section -->
      <section id="faq" class="scroll-mt-24">
        <FaqAccordion
          faqs={faqs.map((f) => [f.q, f.a])}
          heading="Frequently asked questions"
        />
      </section>
    </div>
  </div>
</BaseLayout>
