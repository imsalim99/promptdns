---
import BaseLayout from '../layouts/BaseLayout.astro';
const faqSchema = {
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
  {
   "@type": "Question",
   "name": "Is DNS part of networking?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "DNS is the internet's addressing layer: pure networking, but with its own deep specialization, which is why this site treats it as a first-class topic."
   }
  },
  {
   "@type": "Question",
   "name": "Where should a beginner start?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "What is an IP address, then IPv4 vs IPv6, then NAT. Those three unlock most of the rest."
   }
  },
  {
   "@type": "Question",
   "name": "Do I need this for basic website management?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Only the DNS layer. The deeper networking pages matter when troubleshooting mail, running servers, or reading logs."
   }
  }
 ]
}
---
<BaseLayout
  title="IP & Networking Guides | PromptDNS | PromptDNS"
  description="IP and networking guides: IP addresses, NAT, ASNs, ports, CDNs, and the concepts every webmaster eventually needs."
  schema={[faqSchema]}
>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a> <span aria-hidden="true">/</span>
      <span class="text-ink-dim">IP & Networking Guides</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">IP & Networking Guides</h1>
    <p class="mt-5 text-lg leading-relaxed text-ink-dim">The concepts under every DNS decision: what addresses mean, who operates networks, how traffic flows, and where the web ends and the network begins.</p>
    <div class="rich-text mt-8">
      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Start here</h2>
      <ul class="list-disc space-y-1.5 pl-5"><li class="leading-relaxed"><a href="/my-ip/">What is an IP address</a> — addresses from first principles</li><li class="leading-relaxed"><a href="/ipv4-vs-ipv6/">IPv4 vs IPv6</a> — the two protocol generations</li><li class="leading-relaxed"><a href="/public-vs-private-ip/">Public vs private IPs</a> — and the RFC 1918 ranges</li></ul>
      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Digging deeper</h2>
      <ul class="list-disc space-y-1.5 pl-5"><li class="leading-relaxed"><a href="/asn-explained/">What is an ASN</a> — the networks behind addresses</li><li class="leading-relaxed"><a href="/nat-explained/">NAT explained</a> — how one public IP serves a whole network</li><li class="leading-relaxed"><a href="/static-vs-dynamic-ip/">Static vs dynamic IPs</a> — and when stability matters</li></ul>
      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Tools</h2>
      <ul class="list-disc space-y-1.5 pl-5"><li class="leading-relaxed"><a href="/ip-lookup/">IP Lookup</a>, <a href="/reverse-ip-lookup/">Reverse IP</a>, <a href="/my-ip/">What Is My IP</a></li><li class="leading-relaxed"><a href="/cidr-calculator/">CIDR calculator</a> for subnet math</li></ul>
      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Frequently asked questions</h2>
      <div class="mt-3 grid gap-3"><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Is DNS part of networking?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">DNS is the internet's addressing layer: pure networking, but with its own deep specialization, which is why this site treats it as a first-class topic.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Where should a beginner start?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">What is an IP address, then IPv4 vs IPv6, then NAT. Those three unlock most of the rest.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Do I need this for basic website management?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Only the DNS layer. The deeper networking pages matter when troubleshooting mail, running servers, or reading logs.</p></details></div>
      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Related</h2>
      <ul class="mt-3 grid gap-2"><li><a href="/ip-lookup/" class="text-accent hover:text-accent-soft">IP lookup tool →</a></li><li><a href="/cidr-calculator/" class="text-accent hover:text-accent-soft">CIDR calculator →</a></li></ul>
    </div>
  </div>
</BaseLayout>
