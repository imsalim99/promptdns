---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TOTAL_TOOLS } from '../data/tools';

const building = [
  {
    title: 'Continuous domain monitoring',
    desc: 'Your DNS records, SPF, DKIM, DMARC, and DNSSEC checked on a schedule. Get an alert the moment something changes or breaks - no need to re-run tools.',
  },
  {
    title: 'DMARC report monitoring',
    desc: 'See every service sending email as your domain, from the aggregate reports Gmail, Microsoft, and Yahoo already send. Spot spoofing and misconfigurations early.',
  },
  {
    title: 'AI access monitoring',
    desc: 'Know if AI crawlers like GPTBot and ClaudeBot can still reach your site, and get alerted when robots.txt or your CDN starts blocking them.',
  },
];
---

<BaseLayout
  title="Early Access"
  description="PromptDNS domain and email security monitoring is in development. Join the early access list and be first to get a free account."
>
  <div class="mx-auto max-w-3xl px-4 py-16">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">Early access</p>
    <h1 class="font-display mt-3 text-4xl font-bold tracking-tight text-ink">
      Monitoring is coming to PromptDNS.
    </h1>
    <p class="mt-4 text-lg text-ink-dim">
      All {TOTAL_TOOLS} tools are free today, no account needed. What's next is the part tools
      can't do: watching your domain continuously and telling you when something breaks.
    </p>

    <div class="mt-10 grid gap-4">
      {building.map((b) => (
        <div class="rounded-xl border border-line bg-panel/60 p-5">
          <h2 class="font-display font-semibold text-ink">{b.title}</h2>
          <p class="mt-1 text-sm leading-relaxed text-ink-dim">{b.desc}</p>
        </div>
      ))}
    </div>

    <div class="mt-10 rounded-xl border border-accent/30 bg-accent/5 p-6 sm:p-7">
      <h2 class="font-display text-lg font-bold text-ink">Join the early access list</h2>
      <p id="ea-domain-note" class="mt-2 hidden font-mono text-xs text-accent"></p>
      <p class="mt-2 text-sm leading-relaxed text-ink-dim">
        Early-access members get the first accounts, the launch free tier, and a direct line to
        request features. One email when it's ready - no spam.
      </p>

      <form id="ea-form" class="mt-5 flex flex-col gap-3 sm:flex-row">
        <label class="sr-only" for="ea-email">Email address</label>
        <input id="ea-email" type="email" required autocomplete="email" placeholder="you@yourdomain.com"
          class="flex-1 rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30" />
        <button type="submit" id="ea-submit" class="btn-cta btn-shimmer px-5 py-2.5 text-sm">Join early access</button>
      </form>

      <div id="ea-result" class="mt-4 hidden rounded-md px-4 py-3 text-sm font-medium"></div>
      <p id="ea-fallback" class="mt-3 hidden text-xs text-ink-faint">
        Prefer email? Write to
        <a id="ea-mailto" href="mailto:earlyaccess@promptdns.com" class="font-mono text-accent hover:text-accent-soft">earlyaccess@promptdns.com</a>.
      </p>
    </div>

    <p class="mt-8 text-sm text-ink-faint">
      Meanwhile, every tool keeps working without an account:
      <a href="/tools/" class="text-accent hover:text-accent-soft">browse all {TOTAL_TOOLS} tools</a>.
    </p>
  </div>

  <script>
    // Prefill from tool CTAs: /early-access/?domain=example.com&src=tool:spf-record-checker
    const params = new URLSearchParams(window.location.search);
    const domain = params.get('domain');
    const src = params.get('src');
    if (domain) {
      const note = document.getElementById('ea-domain-note');
      if (note) {
        note.textContent = `Requested for: ${domain}${src ? ` (from ${src.replace('tool:', '')})` : ''}`;
        note.classList.remove('hidden');
      }
    }

    const form = document.getElementById('ea-form') as HTMLFormElement;
    const email = document.getElementById('ea-email') as HTMLInputElement;
    const btn = document.getElementById('ea-submit') as HTMLButtonElement;
    const result = document.getElementById('ea-result')!;
    const fallback = document.getElementById('ea-fallback')!;
    const mailto = document.getElementById('ea-mailto') as HTMLAnchorElement;

    const show = (cls: string, text: string, showFallback: boolean) => {
      result.className = `mt-4 rounded-md px-4 py-3 text-sm font-medium ${cls}`;
      result.textContent = text;
      result.classList.remove('hidden');
      fallback.classList.toggle('hidden', !showFallback);
    };

    if (domain && mailto) {
      const subject = `Early access - PromptDNS monitoring for ${domain}`;
      const body = `Email: (your email)\nDomain: ${domain}${src ? `\nSource: ${src}` : ''}`;
      mailto.href = `mailto:earlyaccess@promptdns.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = 'Joining…';
      try {
        const res = await fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email.value, domain, source: src }),
        });
        const data = (await res.json()) as { ok: boolean; already?: boolean; error?: string };
        if (res.ok && data.ok) {
          show('bg-pass/10 text-pass border border-pass/30',
            data.already ? 'This email is already on the list. You will hear from us at launch.' : 'You are on the list. You will hear from us when monitoring is ready.',
            false);
        } else {
          show('bg-warn/10 text-warn border border-warn/30', data.error ?? 'Something went wrong. Please try again.', true);
        }
      } catch {
        show('bg-warn/10 text-warn border border-warn/30', 'Could not reach the server. Use the email option below.', true);
      }
      btn.disabled = false;
      btn.textContent = 'Join early access';
    });
  </script>
</BaseLayout>
