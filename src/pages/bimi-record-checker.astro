---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolPanel from '../components/ToolPanel.astro';

const faqSchema = {
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
  {
   "@type": "Question",
   "name": "Do I need a VMC certificate for BIMI?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Yes, for Gmail and Apple Mail you need a Verified Mark Certificate (VMC) issued by a certificate authority like DigiCert or Entrust. Some providers accept Common Mark Certificates (CMC) which are cheaper."
   }
  },
  {
   "@type": "Question",
   "name": "Does BIMI work without DMARC?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "No. BIMI requires your domain to have DMARC enforced at p=quarantine or p=reject. p=none is not sufficient. This is why DMARC enforcement is a prerequisite for BIMI deployment."
   }
  },
  {
   "@type": "Question",
   "name": "Which email providers support BIMI?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Gmail, Apple Mail (iOS 16+), and Yahoo Mail support BIMI. Microsoft Outlook does not currently support the BIMI standard."
   }
  }
 ]
}
---
<BaseLayout title="BIMI Record Checker" description="Free BIMI record checker: verify your BIMI TXT record, logo URL, and VMC reference at default._bimi."  schema={[faqSchema]}
>
  <div class="mx-auto max-w-4xl px-4 py-12">
        <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a>
       <span aria-hidden="true">/</span>
      <a href="/tools/" class="hover:text-accent">Tools</a>
       <span aria-hidden="true">/</span>
      <span class="text-ink-dim">BIMI Record Checker</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">BIMI Record Checker: Validate Logo SVG and VMC Setup</h1>
    <p class="mt-4 text-lg text-ink-dim">Check your BIMI record at <span class="font-mono text-sm">default._bimi.yourdomain.com</span>: version, logo URL, and certificate.</p>
    <div class="mt-8">
<ToolPanel>
  <form id="bimi-form" class="flex flex-col gap-3 sm:flex-row">
    <input id="bimi-domain" type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder="example.com" class="flex-1 rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none" />
    <button type="submit" class="btn-cta btn-shimmer px-6 py-2.5 text-sm">Check BIMI</button>
  </form>
  <div id="bimi-status" class="mt-4 hidden rounded-md px-4 py-3 text-sm font-medium"></div>
  <p id="bimi-sample-note" data-vs="example" class="mt-6 text-xs text-ink-faint">
        Sample diagnostic for <code>example.com</code>. Enter your own domain above for live results.
      </p>
<div id="bimi-results" class="pd-results mt-6 overflow-x-auto rounded-lg border border-line/60" aria-live="polite">
    <table class="pdns-table"><thead><tr><th>Tag</th><th>Value</th><th>Meaning</th></tr></thead><tbody id="bimi-tbody"><tr><td class="font-mono text-xs text-accent-soft">v</td><td class="font-mono text-xs">BIMI1</td><td class="text-sm text-ink-dim">Protocol version</td></tr><tr><td class="font-mono text-xs text-accent-soft">l</td><td class="font-mono text-xs">https://example.com/bimi/logo.svg</td><td class="text-sm text-ink-dim">Logo location, SVG Tiny 1.2 format</td></tr><tr><td class="font-mono text-xs text-accent-soft">a</td><td class="font-mono text-xs">https://example.com/bimi/vmc.pem</td><td class="text-sm text-ink-dim">VMC certificate location (optional)</td></tr></tbody></table>
  </div>
</ToolPanel>
    </div>
    <article class="rich-text mt-12 max-w-none">
      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Frequently asked questions</h2>
      <div class="mt-3 grid gap-3"><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Do I need a VMC certificate for BIMI?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Yes, for Gmail and Apple Mail you need a Verified Mark Certificate (VMC) issued by a certificate authority like DigiCert or Entrust. Some providers accept Common Mark Certificates (CMC) which are cheaper.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Does BIMI work without DMARC?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">No. BIMI requires your domain to have DMARC enforced at p=quarantine or p=reject. p=none is not sufficient. This is why DMARC enforcement is a prerequisite for BIMI deployment.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Which email providers support BIMI?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Gmail, Apple Mail (iOS 16+), and Yahoo Mail support BIMI. Microsoft Outlook does not currently support the BIMI standard.</p></details></div>
<h2>Related</h2><ul><li><a href="/bimi/">BIMI explained</a> · <a href="/dmarc-record-checker/">DMARC checker (prerequisite)</a></li></ul></article>
  </div>
</BaseLayout>
<script>
  import { lookup, RESOLVERS, normalizeDomain } from '../lib/doh';
  import { txtRecords } from '../lib/spf';
  const form = document.getElementById('bimi-form') as HTMLFormElement;
  const input = document.getElementById('bimi-domain') as HTMLInputElement;
  const statusEl = document.getElementById('bimi-status')!;
  const resultsEl = document.getElementById('bimi-results')!;
  const tbody = document.getElementById('bimi-tbody')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const domain = normalizeDomain(input.value);
    statusEl.textContent = `Looking up default._bimi.${domain}…`; statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-panel-2 text-accent border border-line'; statusEl.classList.remove('hidden');
    const res = await lookup(`default._bimi.${domain}`, 'TXT', RESOLVERS[0]);
    const rec = txtRecords(res.answers).find(t => t.toLowerCase().includes('bimi'));
    if (!rec) { statusEl.textContent = 'No BIMI record found. BIMI requires DMARC at enforcement first.'; statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-warn/10 text-warn border border-warn/30'; return; }
    const v = rec.match(/v=([^;]+)/i)?.[1] ?? '';
    const l = rec.match(/l=([^;]+)/i)?.[1] ?? '';
    const a = rec.match(/a=([^;]+)/i)?.[1] ?? '';
    document.getElementById('bimi-sample-note')?.classList.add('hidden');
    tbody.innerHTML = '';
    for (const [tag, val, meaning] of [['v=', v, 'Version (BIMI1)'], ['l=', l, 'Logo SVG URL'], ['a=', a, 'VMC certificate (empty = no VMC, Gmail requires one)']] as [string, string, string][]) {
      tbody.insertAdjacentHTML('beforeend', `<tr><td class="font-mono text-xs text-accent">${tag}</td><td class="font-mono text-xs">${val.replace(/</g, '&lt;') || '(missing)'}</td><td class="text-xs text-ink-dim">${meaning}</td></tr>`);
    }
    statusEl.textContent = 'BIMI record found and parsed.';
    statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-pass/10 text-pass border border-pass/30';
    resultsEl.classList.remove('hidden');
  });
</script>
