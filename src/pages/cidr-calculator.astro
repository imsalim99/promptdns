---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolPanel from '../components/ToolPanel.astro';

const faqSchema = {
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
  {
   "@type": "Question",
   "name": "Is the CIDR Calculator really free?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Yes: every tool on PromptDNS is free forever, with no account, no limits, and no trial timers. The subnet calculation runs entirely in your browser."
   }
  },
  {
   "@type": "Question",
   "name": "How accurate are the results?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "The subnet calculation queries public DNS-over-HTTPS resolvers (Cloudflare, Google, Quad9) in real time. Results reflect what those resolvers actually serve, which is the same data the wider internet receives."
   }
  },
  {
   "@type": "Question",
   "name": "Do you store the domains I look up?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "No. Lookups happen client-side in your browser. Domains are not sent to our servers, stored, or logged. See the privacy policy for details."
   }
  },
  {
   "@type": "Question",
   "name": "Can I use this tool for client work?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Yes: the tools are free for commercial use. Agencies on the Business plan can also generate white-label automated reports."
   }
  },
  {
   "@type": "Question",
   "name": "How often should I run this check?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "After any DNS or infrastructure change, and periodically (weekly or monthly) as part of routine health monitoring. The paid plans automate this."
   }
  },
  {
   "@type": "Question",
   "name": "What if the results look wrong?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Compare with a second tool or dig from a terminal. If results differ between tools, one may be showing a cached answer: the propagation checker reveals which resolvers disagree."
   }
  }
 ]
}
---
<BaseLayout title="CIDR / Subnet Calculator" description="Free subnet calculator: CIDR notation to IP range, mask, wildcard, broadcast, and host count — with a full reference table."  schema={[faqSchema]}
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <nav class="mb-4 text-sm text-ink-faint"><a href="/" class="hover:text-accent">Home</a> / <span class="text-ink-dim">Subnet Calculator</span></nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">CIDR / Subnet Calculator</h1>
    <p class="mt-4 text-lg text-ink-dim">Enter an IP and prefix length (e.g. 192.168.1.10/24) to get the network, range, mask, and usable hosts.</p>
    <div class="mt-8">
<ToolPanel>
  <form id="cidr-form" class="flex flex-col gap-3 sm:flex-row">
    <input id="cidr-in" type="text" value="192.168.1.10/24" autocomplete="off" spellcheck="false" class="flex-1 rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink focus:border-accent focus:outline-none" />
    <button type="submit" class="btn-cta btn-shimmer px-6 py-2.5 text-sm">Calculate</button>
  </form>
  <div id="cidr-status" class="mt-4 hidden rounded-md px-4 py-3 text-sm font-medium"></div>
  <div id="cidr-results" class="mt-6 hidden overflow-x-auto rounded-lg border border-line/60">
    <table class="pdns-table"><thead><tr><th>Field</th><th>Value</th></tr></thead><tbody id="cidr-tbody"></tbody></table>
  </div>
</ToolPanel>
    </div>
    <article class="rich-text mt-12 max-w-none"><h2>Common masks</h2>
      <div class="overflow-x-auto rounded-xl border border-line bg-panel/60"><table class="pdns-table"><thead><tr><th>CIDR</th><th>Mask</th><th>Usable hosts</th></tr></thead><tbody>
        <tr><td class="font-mono text-xs text-accent">/24</td><td class="font-mono text-xs">255.255.255.0</td><td class="text-sm">254</td></tr>
        <tr><td class="font-mono text-xs text-accent">/25</td><td class="font-mono text-xs">255.255.255.128</td><td class="text-sm">126</td></tr>
        <tr><td class="font-mono text-xs text-accent">/26</td><td class="font-mono text-xs">255.255.255.192</td><td class="text-sm">62</td></tr>
        <tr><td class="font-mono text-xs text-accent">/27</td><td class="font-mono text-xs">255.255.255.224</td><td class="text-sm">30</td></tr>
        <tr><td class="font-mono text-xs text-accent">/28</td><td class="font-mono text-xs">255.255.255.240</td><td class="text-sm">14</td></tr>
        <tr><td class="font-mono text-xs text-accent">/30</td><td class="font-mono text-xs">255.255.255.252</td><td class="text-sm">2</td></tr>
        <tr><td class="font-mono text-xs text-accent">/16</td><td class="font-mono text-xs">255.255.0.0</td><td class="text-sm">65,534</td></tr>
      </tbody></table></div>
      
      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Frequently asked questions</h2>
      <div class="mt-3 grid gap-3"><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Is the CIDR Calculator really free?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Yes: every tool on PromptDNS is free forever, with no account, no limits, and no trial timers. The subnet calculation runs entirely in your browser.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">How accurate are the results?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">The subnet calculation queries public DNS-over-HTTPS resolvers (Cloudflare, Google, Quad9) in real time. Results reflect what those resolvers actually serve, which is the same data the wider internet receives.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Do you store the domains I look up?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">No. Lookups happen client-side in your browser. Domains are not sent to our servers, stored, or logged. See the privacy policy for details.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Can I use this tool for client work?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Yes: the tools are free for commercial use. Agencies on the Business plan can also generate white-label automated reports.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">How often should I run this check?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">After any DNS or infrastructure change, and periodically (weekly or monthly) as part of routine health monitoring. The paid plans automate this.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">What if the results look wrong?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Compare with a second tool or dig from a terminal. If results differ between tools, one may be showing a cached answer: the propagation checker reveals which resolvers disagree.</p></details></div>
<h2 class="mt-8">Related</h2><ul><li><a href="/ipv4-to-ipv6-converter/">CIDR notation explained</a> · <a href="/cidr-calculator/">Subnetting guide</a></li></ul>
    </article>
  </div>
</BaseLayout>
<script>
  const form = document.getElementById('cidr-form') as HTMLFormElement;
  const input = document.getElementById('cidr-in') as HTMLInputElement;
  const statusEl = document.getElementById('cidr-status')!;
  const resultsEl = document.getElementById('cidr-results')!;
  const tbody = document.getElementById('cidr-tbody')!;
  const toInt = (ip: string) => ip.split('.').reduce((s, o) => (s << 8) + Number(o), 0) >>> 0;
  const toIp = (n: number) => [24, 16, 8, 0].map(sh => (n >>> sh) & 255).join('.');
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const m = input.value.trim().match(/^(\d{1,3}(?:\.\d{1,3}){3})\/(\d{1,2})$/);
    if (!m) { statusEl.textContent = 'Enter IP/prefix, e.g. 192.168.1.10/24.'; statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-fail/10 text-fail border border-fail/30'; statusEl.classList.remove('hidden'); return; }
    const prefix = Number(m[2]);
    if (prefix > 32) { statusEl.textContent = 'Prefix must be 0-32.'; return; }
    const ipInt = toInt(m[1]);
    const mask = prefix === 0 ? 0 : (0xFFFFFFFF << (32 - prefix)) >>> 0;
    const network = (ipInt & mask) >>> 0;
    const broadcast = (network | (~mask >>> 0)) >>> 0;
    const hosts = prefix >= 31 ? 2 ** (32 - prefix) : 2 ** (32 - prefix) - 2;
    const rows: [string, string][] = [
      ['Network', `${toIp(network)}/${prefix}`],
      ['Netmask', toIp(mask)],
      ['Wildcard', toIp(~mask >>> 0)],
      ['Broadcast', toIp(broadcast)],
      ['Host range', prefix >= 31 ? toIp(network) : `${toIp(network + 1)} – ${toIp(broadcast - 1)}`],
      ['Usable hosts', hosts.toLocaleString()],
      ['Total addresses', (2 ** (32 - prefix)).toLocaleString()],
    ];
    tbody.innerHTML = '';
    for (const [k, v] of rows) tbody.insertAdjacentHTML('beforeend', `<tr><td class="text-ink-dim">${k}</td><td class="font-mono text-xs text-accent">${v}</td></tr>`);
    statusEl.textContent = `Calculated ${m[1]}/${prefix}.`;
    statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-pass/10 text-pass border border-pass/30';
    statusEl.classList.remove('hidden');
    resultsEl.classList.remove('hidden');
  });
</script>
