---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolPanel from '../components/ToolPanel.astro';

const faqSchema = {
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
    {'@type': 'Question', 'name': "What is the difference between /24 and /16?", "acceptedAnswer": { '@type': 'Answer', "text": "/24 gives you 256 addresses (a typical small network). /16 gives you 65,536 addresses (a larger network or ISP allocation). The number after the slash is the count of leading 1-bits in the subnet mask." } },
    {'@type': 'Question', 'name': "How many usable hosts are in a /29?", "acceptedAnswer": { '@type': 'Answer', "text": "A /29 has 8 total addresses but only 6 usable hosts: 2 are reserved for the network identifier and the broadcast address. Our calculator shows usable hosts automatically." } },
    {'@type': 'Question', 'name': "Can I convert IPv4 CIDR to IPv6?", "acceptedAnswer": { '@type': 'Answer', "text": "Yes, an IPv4 /32 maps to an IPv6 /128 in the ::ffff: prefix range. Our IPv4-to-IPv6 converter handles this mapping." } }
  ]
}
---
<BaseLayout title="CIDR / Subnet Calculator" description="Free subnet calculator: CIDR notation to IP range, mask, wildcard, broadcast, and host count - with a full reference table."  schema={[faqSchema]}
>
  <div class="mx-auto max-w-4xl px-4 py-12">
        <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a>
       <span aria-hidden="true">/</span>
      <a href="/tools/" class="hover:text-accent">Tools</a>
       <span aria-hidden="true">/</span>
      <span class="text-ink-dim">CIDR / Subnet Calculator</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">CIDR Calculator: IPv4 and IPv6 Subnet Math</h1>
    <p class="mt-4 text-lg text-ink-dim">Free CIDR calculator: convert IP ranges, calculate subnets, usable hosts and broadcast addresses.</p>
    <div class="mt-8">
<ToolPanel>
  <form id="cidr-form" class="flex flex-col gap-3 sm:flex-row">
    <input id="cidr-in" type="text" value="192.168.1.10/24" autocomplete="off" spellcheck="false" class="flex-1 rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink focus:border-accent focus:outline-none" />
    <button type="submit" class="btn-cta btn-shimmer px-6 py-2.5 text-sm">Calculate</button>
  </form>
  <div id="cidr-status" class="mt-4 hidden rounded-md px-4 py-3 text-sm font-medium"></div>
  <p id="cidr-sample-note" data-vs="example" class="mt-6 text-xs text-ink-faint">
        Sample diagnostic for <code>example.com</code>. Enter your own domain above for live results.
      </p>
<div id="cidr-results" class="pd-results mt-6 overflow-x-auto rounded-lg border border-line/60" aria-live="polite">
    <table class="pdns-table"><thead><tr><th>Field</th><th>Value</th></tr></thead><tbody id="cidr-tbody"><tr><td class="font-medium text-ink">Network</td><td><code>192.168.1.0/24</code></td></tr><tr><td class="font-medium text-ink">Usable hosts</td><td class="text-sm text-ink-dim">254</td></tr><tr><td class="font-medium text-ink">First, last usable</td><td class="text-sm text-ink-dim"><code>192.168.1.1</code>, <code>192.168.1.254</code></td></tr></tbody></table>
  </div>
</ToolPanel>
    </div>
    <article class="rich-text mt-12 max-w-none"><h2>Common masks</h2>
      <div class="overflow-x-auto rounded-xl border border-line bg-panel/60"><table class="pdns-table"><thead><tr><th>CIDR</th><th>Mask</th><th>Usable hosts</th></tr></thead><tbody>
        <tr><td class="font-mono text-xs text-accent">/24</td><td class="font-mono text-xs">255.255.255.0</td><td class="text-sm">254</td></tr>
        <tr><td class="font-mono text-xs text-accent">/25</td><td class="font-mono text-xs">255.255.255.128</td><td class="text-sm">126</td></tr>
        <tr><td class="font-mono text-xs text-accent">/26</td><td class="font-mono text-xs">255.255.255.192</td><td class="text-sm">62</td></tr>
        <tr><td class="font-mono text-xs text-accent">/27</td><td class="font-mono text-xs">255.255.255.224</td><td class="text-sm">30</td></tr>
        <tr><td class="font-mono text-xs text-accent">/28</td><td class="font-mono text-xs">255.255.255.240</td><td class="text-sm">14</td></tr>
        <tr><td class="font-mono text-xs text-accent">/30</td><td class="font-mono text-xs">255.255.255.252</td><td class="text-sm">2</td></tr>
        <tr><td class="font-mono text-xs text-accent">/16</td><td class="font-mono text-xs">255.255.0.0</td><td class="text-sm">65,534</td></tr>
      </tbody></table></div>
      
      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Frequently asked questions</h2>
      <div class="mt-3 grid gap-3"><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">What is the difference between /24 and /16?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">/24 gives you 256 addresses (a typical small network). /16 gives you 65,536 addresses (a larger network or ISP allocation). The number after the slash is the count of leading 1-bits in the subnet mask.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">How many usable hosts are in a /29?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">A /29 has 8 total addresses but only 6 usable hosts: 2 are reserved for the network identifier and the broadcast address. Our calculator shows usable hosts automatically.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Can I convert IPv4 CIDR to IPv6?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Yes, an IPv4 /32 maps to an IPv6 /128 in the ::ffff: prefix range. Our IPv4-to-IPv6 converter handles this mapping.</p></details></div>
<h2 class="mt-8">Related</h2><ul><li><a href="/ipv4-to-ipv6-converter/">CIDR notation explained</a> · <a href="/cidr-calculator/">Subnetting guide</a></li></ul>
    </article>
  </div>
</BaseLayout>
<script>
  const form = document.getElementById('cidr-form') as HTMLFormElement;
  const input = document.getElementById('cidr-in') as HTMLInputElement;
  const statusEl = document.getElementById('cidr-status')!;
  const resultsEl = document.getElementById('cidr-results')!;
  const tbody = document.getElementById('cidr-tbody')!;
  const toInt = (ip: string) => ip.split('.').reduce((s, o) => (s << 8) + Number(o), 0) >>> 0;
  const toIp = (n: number) => [24, 16, 8, 0].map(sh => (n >>> sh) & 255).join('.');
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const m = input.value.trim().match(/^(\d{1,3}(?:\.\d{1,3}){3})\/(\d{1,2})$/);
    if (!m) { statusEl.textContent = 'Enter IP/prefix, e.g. 192.168.1.10/24.'; statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-fail/10 text-fail border border-fail/30'; statusEl.classList.remove('hidden'); return; }
    const prefix = Number(m[2]);
    if (prefix > 32) { statusEl.textContent = 'Prefix must be 0-32.'; return; }
    const ipInt = toInt(m[1]);
    const mask = prefix === 0 ? 0 : (0xFFFFFFFF << (32 - prefix)) >>> 0;
    const network = (ipInt & mask) >>> 0;
    const broadcast = (network | (~mask >>> 0)) >>> 0;
    const hosts = prefix >= 31 ? 2 ** (32 - prefix) : 2 ** (32 - prefix) - 2;
    const rows: [string, string][] = [
      ['Network', `${toIp(network)}/${prefix}`],
      ['Netmask', toIp(mask)],
      ['Wildcard', toIp(~mask >>> 0)],
      ['Broadcast', toIp(broadcast)],
      ['Host range', prefix >= 31 ? toIp(network) : `${toIp(network + 1)} - ${toIp(broadcast - 1)}`],
      ['Usable hosts', hosts.toLocaleString()],
      ['Total addresses', (2 ** (32 - prefix)).toLocaleString()],
    ];
    document.getElementById('cidr-sample-note')?.classList.add('hidden');
    tbody.innerHTML = '';
    for (const [k, v] of rows) tbody.insertAdjacentHTML('beforeend', `<tr><td class="text-ink-dim">${k}</td><td class="font-mono text-xs text-accent">${v}</td></tr>`);
    statusEl.textContent = `Calculated ${m[1]}/${prefix}.`;
    statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-pass/10 text-pass border border-pass/30';
    statusEl.classList.remove('hidden');
    resultsEl.classList.remove('hidden');
  });
</script>
