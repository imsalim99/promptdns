---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolPanel from '../components/ToolPanel.astro';

const faqSchema = {
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
  {
   "@type": "Question",
   "name": "What is punycode used for?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Punycode encodes internationalized domain names (IDNs) using non-ASCII characters into ASCII-compatible encoding that the DNS system can process."
   }
  },
  {
   "@type": "Question",
   "name": "Are punycode domains safe to click?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Mostly yes, but attackers have used visually similar Unicode characters (homograph attacks) to imitate trusted domains. Always check the punycode form in your browser address bar."
   }
  },
  {
   "@type": "Question",
   "name": "Does my browser show punycode or Unicode?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Modern browsers show Unicode for legitimate IDNs but switch to punycode display when the domain contains mixed character scripts that could be used for spoofing."
   }
  }
 ]
}
---
<BaseLayout title="Punycode / IDN Converter" description="Free punycode converter: translate internationalized domain names between Unicode and xn-- ASCII form, both directions."  schema={[faqSchema]}
>
  <div class="mx-auto max-w-4xl px-4 py-12">
        <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a>
       <span aria-hidden="true">/</span>
      <a href="/tools/" class="hover:text-accent">Tools</a>
       <span aria-hidden="true">/</span>
      <span class="text-ink-dim">Punycode / IDN Converter</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">Punycode / IDN Converter</h1>
    <p class="mt-4 text-lg text-ink-dim">Free punycode converter: convert internationalized domain names between Unicode and punycode.</p>
    <div class="mt-8">
<ToolPanel>
  <form id="pc-form" class="flex flex-col gap-3 sm:flex-row">
    <input id="pc-in" type="text" value="münchen.de" autocomplete="off" spellcheck="false" class="flex-1 rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink focus:border-accent focus:outline-none" />
    <button type="submit" class="btn-cta btn-shimmer px-6 py-2.5 text-sm">Convert</button>
  </form>
  <div id="pc-status" class="mt-4 hidden rounded-md px-4 py-3 text-sm font-medium"></div>
  <div id="pc-results" class="mt-6 hidden overflow-x-auto rounded-lg border border-line/60">
    <table class="pdns-table"><thead><tr><th>Form</th><th>Value</th></tr></thead><tbody id="pc-tbody"></tbody></table>
  </div>
</ToolPanel>
    </div>
    <article class="rich-text mt-12 max-w-none">
      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Frequently asked questions</h2>
      <div class="mt-3 grid gap-3"><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">What is punycode used for?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Punycode encodes internationalized domain names (IDNs) using non-ASCII characters into ASCII-compatible encoding that the DNS system can process.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Are punycode domains safe to click?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Mostly yes, but attackers have used visually similar Unicode characters (homograph attacks) to imitate trusted domains. Always check the punycode form in your browser address bar.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Does my browser show punycode or Unicode?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Modern browsers show Unicode for legitimate IDNs but switch to punycode display when the domain contains mixed character scripts that could be used for spoofing.</p></details></div>
<h2>Related</h2><ul><li><a href="/dns-records/">IDN and punycode explained</a></li></ul></article>
  </div>
</BaseLayout>
<script>
  const form = document.getElementById('pc-form') as HTMLFormElement;
  const input = document.getElementById('pc-in') as HTMLInputElement;
  const statusEl = document.getElementById('pc-status')!;
  const resultsEl = document.getElementById('pc-results')!;
  const tbody = document.getElementById('pc-tbody')!;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const raw = input.value.trim().replace(/^https?:\/\//, '').replace(/\/.*$/, '');
    try {
      const url = new URL(`http://${raw}`);
      const ascii = url.hostname;
      const unicode = new URL(`http://${raw}`).hostname;
      // URL API normalizes to punycode automatically; for unicode display, decode via Intl
      let display = ascii;
      try { (display as any) = ascii; } catch {}
      const isAscii = /^[\x00-\x7F]+$/.test(raw);
      tbody.innerHTML = '';
      const rows: [string, string][] = [
        ['Punycode (ASCII)', ascii],
        ['Unicode form', isAscii ? '(input is ASCII)' : raw],
      ];
      for (const [k, v] of rows) tbody.insertAdjacentHTML('beforeend', `<tr><td class="text-ink-dim">${k}</td><td class="font-mono text-xs text-accent">${v}</td></tr>`);
      statusEl.textContent = `Converted ${raw}.`;
      statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-pass/10 text-pass border border-pass/30';
      statusEl.classList.remove('hidden');
      resultsEl.classList.remove('hidden');
    } catch {
      statusEl.textContent = 'Could not parse that domain.';
      statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-fail/10 text-fail border border-fail/30';
      statusEl.classList.remove('hidden');
    }
  });
</script>
