---
import BaseLayout from '../layouts/BaseLayout.astro';
import Diagram from '../components/Diagram.astro';

const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Does a lower or higher MX priority number get used first?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A lower number always has higher priority and is tried first. Sending mail servers contact priority 0 or 1 before priority 10, and only fall back to priority 20 or 50 if the lower-numbered primary server is offline.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I point an MX record directly to an IP address?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No, DNS standards prohibit pointing an MX record directly to an IPv4 or IPv6 address. Always point your MX record to a hostname (such as mail.yourdomain.com), and create a separate A or AAAA record pointing that hostname to the IP address.',
      },
    },
    {
      '@type': 'Question',
      name: 'How many MX records should a domain have?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Most domains publish between 1 and 5 MX records depending on their email provider. Modern Google Workspace (1 smtp.google.com) and Microsoft 365 require only 1 MX record, while providers like Proton Mail and Zoho use 2 to 3 records for backup failover.',
      },
    },
    {
      '@type': 'Question',
      name: 'What happens if I have MX records from two different email providers at the same time?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Publishing MX records for two different inbox providers on the same domain splits or breaks your incoming email delivery. Sending servers route mail only to the lowest-priority provider (or randomly split messages if priorities match), causing lost emails.',
      },
    },
  ],
};
