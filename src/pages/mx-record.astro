<BaseLayout
  title="MX Record: What Mail Exchange Records Are, Priority Rules, and Examples"
  description="MX record explained: what Mail Exchange records are, how priority numbers work, standard examples for Google and Microsoft 365, and 3 strict target rules."
  schema={[faq]}
  breadcrumb={[["Home", "/"], ["DNS Guide", "/dns/"], ["Record Types", "/dns-records/"], ["MX Record"]]}
>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/dns/" class="hover:text-accent">DNS Guide</a>
      <span aria-hidden="true">/</span>
      <a href="/dns-records/" class="hover:text-accent">Record Types</a>
      <span aria-hidden="true">/</span>
      <span class="text-ink-dim">MX Record</span>
