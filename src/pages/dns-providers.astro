const faqs = [
  {
    q: "How do I find out where my domain's DNS is currently hosted?",
    a: 'Run your domain through our Nameserver Lookup tool and inspect the authoritative NS records returned by the registry. Your DNS is always managed at the company that owns those nameservers, for example, if your NS records say *.ns.cloudflare.com, your DNS is hosted at Cloudflare (even if you registered the domain name at GoDaddy or Namecheap).',
  },
  {
    q: 'Why are the DNS records I added in GoDaddy, Namecheap, or cPanel not working?',
    a: "The most common reason DNS edits have zero effect is editing records in the wrong control panel. Your domain registrar's built-in DNS table becomes inactive if you previously pointed your domain's nameservers (NS records) to Cloudflare, Wix, or an external web host. Always edit DNS records inside the dashboard of your active authoritative nameserver provider.",
  },
  {
    q: "Should I switch my domain's nameservers to Wix, Squarespace, or Netlify if I already use company email?",
    a: 'No, in practice we recommend connecting via Pointing (A and CNAME records) while keeping your authoritative DNS on a full-featured provider like Cloudflare or AWS Route 53 if your domain already has active company email (Google Workspace, Microsoft 365, or custom MX/SPF/DKIM records) or uses DNSSEC. Delegating your entire domain\'s nameservers to a website builder hands over control of your entire zone and often strips DNSSEC support.',
  },
  {
    q: 'Why did my subdomain become sub.example.com.example.com after I saved it?',
    a: 'In real-world setups across Cloudflare, GoDaddy, Namecheap, and Squarespace, the DNS control panel automatically appends your root domain name to whatever you type in the Host/Name box. Type only sub in the Host field (or @ for the root domain) when creating a record for sub.example.com so the panel does not double your domain suffix.',
  },
];

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'DNS Provider Playbooks: Setup, Nameservers, and Troubleshooting for 12 Platforms',
  url: 'https://promptdns.com/dns-providers/',
  description: 'Complete setup and troubleshooting guides for DNS providers: setup records, change nameservers, and troubleshoot Cloudflare, AWS Route 53, Google Cloud DNS, Azure DNS, GoDaddy, Namecheap, cPanel, and more.',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://promptdns.com/' },
    { '@type': 'ListItem', position: 2, name: 'DNS Providers', item: 'https://promptdns.com/dns-providers/' },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---

<BaseLayout
  title="DNS Provider Playbooks: Setup, Nameservers, and Troubleshooting for 12 Platforms"
  description="Complete setup and troubleshooting guides for DNS providers: setup records, change nameservers, and troubleshoot Cloudflare, AWS Route 53, Google Cloud DNS, Azure DNS, GoDaddy, Namecheap, cPanel, and more."
  schema={[collectionSchema, breadcrumbSchema, faqSchema]}
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent transition-colors">Home</a>
      <span aria-hidden="true" class="mx-2">/</span>
      <span class="text-ink-dim" aria-current="page">DNS Providers</span>
    </nav>

    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
      DNS Provider Playbooks: Setup, Nameservers, and Troubleshooting for 12 Platforms
    </h1>

    <div class="pd-answer mt-6" data-vs="answer">
      <p class="text-lg leading-relaxed text-ink-dim">
        A DNS hosting provider <strong class="text-ink">operates the authoritative nameservers that store your domain's zone file and answer global queries for your <code>A</code>, <code>MX</code>, <code>CNAME</code>, and <code>TXT</code> records</strong>. Control panels differ in apex notation (<code>@</code> vs blank), minimum TTLs, and <code>CNAME</code> flattening. These 34 playbooks cover 12 major platforms.
      </p>
    </div>

    <nav class="pd-toc" aria-label="On this page">
      <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent">On this page</p>
      <ul>
        <li><a href="#provider-matrix">12 Major DNS Providers Compared</a></li>
        <li><a href="#cloud-anycast">1. Cloud and Anycast DNS Provider Playbooks</a></li>
        <li><a href="#registrars-panels">2. Domain Registrar and Server Control Panel DNS Guides</a></li>
        <li><a href="#website-platforms">3. Website Builder, E-Commerce, and Frontend Hosting DNS Guides</a></li>
        <li><a href="#provider-tools">4. Live DNS Provider Verification and Migration Tools</a></li>
        <li><a href="#faq">Frequently Asked Questions</a></li>
      </ul>
    </nav>

    <div class="mt-12 space-y-16">
      <!-- Section 1: Provider Comparison Table -->
      <section id="provider-matrix" class="scroll-mt-24">
        <h2 class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
          12 Major DNS Providers Compared: Apex Aliasing, DNSSEC, Minimum TTL, and Pricing
        </h2>
        <p class="mt-4 text-base leading-relaxed text-ink-dim">
          Every authoritative DNS platform exposes the same underlying IETF record types (<code>A</code>, <code>AAAA</code>, <code>CNAME</code>, <code>MX</code>, <code>TXT</code>, <code>NS</code>, <code>SRV</code>, <code>CAA</code>), yet each control panel enforces different field formatting rules, root-domain aliasing mechanisms, minimum Time to Live (TTL) floors, and DNSSEC signing workflows. The table below compares all 12 DNS platforms covered in our playbooks across 5 technical dimensions: platform category, root (<code>@</code>) hostname aliasing support, one-click DNSSEC availability, minimum custom TTL, and pricing model.
        </p>

        <div class="mt-6 overflow-x-auto">
          <table class="pdns-table border-collapse rounded-xl border border-line bg-panel/40 text-left text-sm text-ink-dim">
            <thead>
              <tr class="border-b border-line bg-panel/80 text-xs font-semibold uppercase tracking-wider text-ink">
                <th class="px-4 py-3">DNS Platform</th>
                <th class="px-4 py-3">Platform Category</th>
                <th class="px-4 py-3">Root (<code>@</code>) Aliasing Mechanism</th>
                <th class="px-4 py-3">One-Click DNSSEC</th>
                <th class="px-4 py-3">Minimum Custom TTL</th>
                <th class="px-4 py-3">Pricing Model</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              <tr>
                <td class="px-4 py-3 font-medium text-ink">1. Cloudflare DNS</td>
                <td class="px-4 py-3">Enterprise Anycast Cloud</td>
                <td class="px-4 py-3"><strong>Yes</strong> (Automatic <code>CNAME Flattening</code>)</td>
                <td class="px-4 py-3"><strong>Yes</strong> (<code>Algorithm 13</code> ECDSA)</td>
                <td class="px-4 py-3"><code>60 s</code> (<code>30 s</code> Enterprise; <code>Auto = 300 s</code>)</td>
                <td class="px-4 py-3"><strong>Free tier</strong> (Unlimited queries) + Pro/Business</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium text-ink">2. AWS Route 53</td>
                <td class="px-4 py-3">Hyperscale Cloud DNS</td>
                <td class="px-4 py-3"><strong>Yes</strong> (<code>Route 53 Alias</code> record)</td>
                <td class="px-4 py-3"><strong>Yes</strong> (<code>KMS</code>-backed signing)</td>
                <td class="px-4 py-3"><code>1 s</code> (<code>60 s</code> standard)</td>
                <td class="px-4 py-3">$0.50/zone/mo + per-million query fee (<code>Alias</code> queries to AWS free)</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium text-ink">3. Google Cloud DNS</td>
                <td class="px-4 py-3">Hyperscale Cloud DNS</td>
                <td class="px-4 py-3"><strong>Yes</strong> (<code>ALIAS</code> / Routing Policies)</td>
                <td class="px-4 py-3"><strong>Yes</strong> (Automated <code>ZSK</code>/<code>KSK</code>)</td>
                <td class="px-4 py-3"><code>1 s</code> (<code>300 s</code> default)</td>
                <td class="px-4 py-3">$0.20/zone/mo + per-million query fee</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium text-ink">4. Microsoft Azure DNS</td>
                <td class="px-4 py-3">Hyperscale Cloud DNS</td>
                <td class="px-4 py-3"><strong>Yes</strong> (<code>Azure Alias Record Set</code>)</td>
                <td class="px-4 py-3"><strong>Yes</strong> (Public Zone DNSSEC)</td>
                <td class="px-4 py-3"><code>1 s</code> (<code>3600 s</code> default)</td>
                <td class="px-4 py-3">$0.50/zone/mo + per-million query fee</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium text-ink">5. GoDaddy DNS</td>
                <td class="px-4 py-3">Domain Registrar DNS</td>
                <td class="px-4 py-3"><strong>No</strong> (Requires <code>A</code> record or HTTP forward)</td>
                <td class="px-4 py-3"><strong>Yes</strong> (Basic &amp; Premium DNS)</td>
                <td class="px-4 py-3"><code>600 s</code> (<code>10 minutes</code>)</td>
                <td class="px-4 py-3">Free with domain registration (+ Paid Premium DNS)</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium text-ink">6. Namecheap DNS</td>
                <td class="px-4 py-3">Domain Registrar DNS</td>
                <td class="px-4 py-3"><strong>Yes</strong> (<code>ALIAS</code> record polling every 1 to 5m)</td>
                <td class="px-4 py-3"><strong>Yes</strong> (<code>BasicDNS</code> &amp; <code>PremiumDNS</code>)</td>
                <td class="px-4 py-3"><code>60 s</code> (<code>1 minute</code>)</td>
                <td class="px-4 py-3">Free <code>BasicDNS</code> with domain (+ $4.88/yr <code>PremiumDNS</code>)</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium text-ink">7. cPanel (BIND / PowerDNS)</td>
                <td class="px-4 py-3">Self-Hosted Server Panel</td>
                <td class="px-4 py-3"><strong>No</strong> (<code>Zone Editor</code> requires <code>A</code> at <code>@</code>)</td>
                <td class="px-4 py-3"><strong>Yes</strong> (In PowerDNS Zone Editor)</td>
                <td class="px-4 py-3"><code>60 s</code> (<code>14400 s</code> default)</td>
                <td class="px-4 py-3">Included with cPanel web hosting license</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium text-ink">8. Plesk</td>
                <td class="px-4 py-3">Self-Hosted Server Panel</td>
                <td class="px-4 py-3"><strong>No</strong> (Requires <code>A</code> record at <code>@</code>)</td>
                <td class="px-4 py-3"><strong>Yes</strong> (Via Plesk DNSSEC extension)</td>
                <td class="px-4 py-3"><code>60 s</code> (<code>86400 s</code> default)</td>
                <td class="px-4 py-3">Included with Plesk server license</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium text-ink">9. Shopify</td>
                <td class="px-4 py-3">E-Commerce Platform</td>
                <td class="px-4 py-3"><strong>Yes</strong> (Managed root <code>A</code> + <code>shops.myshopify.com</code>)</td>
                <td class="px-4 py-3">Managed on external DNS</td>
                <td class="px-4 py-3"><code>300 s</code> to <code>3600 s</code></td>
                <td class="px-4 py-3">Included with Shopify store subscription</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium text-ink">10. Wix</td>
                <td class="px-4 py-3">Website Builder Platform</td>
                <td class="px-4 py-3"><strong>Yes</strong> (Managed root <code>A</code> records on Wix NS)</td>
                <td class="px-4 py-3"><strong>No</strong> (When using Wix NS; use Pointing method for external DNSSEC)</td>
                <td class="px-4 py-3"><code>300 s</code> to <code>3600 s</code></td>
                <td class="px-4 py-3">Included with Wix Premium plan</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium text-ink">11. Squarespace</td>
                <td class="px-4 py-3">Website Builder &amp; Registrar</td>
                <td class="px-4 py-3"><strong>Yes</strong> (<code>ALIAS</code> record + Squarespace preset)</td>
                <td class="px-4 py-3"><strong>Yes</strong> (In Squarespace Domains DNSSEC panel)</td>
                <td class="px-4 py-3"><code>300 s</code> to <code>3600 s</code></td>
                <td class="px-4 py-3">Included with Squarespace domain / site plan</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium text-ink">12. Netlify</td>
                <td class="px-4 py-3">Frontend Cloud / Jamstack</td>
                <td class="px-4 py-3"><strong>Yes</strong> (<code>NETLIFY</code> / <code>ALIAS</code> apex record)</td>
                <td class="px-4 py-3"><strong>No</strong> (On Netlify DNS; use external Cloudflare/Route 53 for DNSSEC)</td>
                <td class="px-4 py-3"><code>60 s</code> (<code>3600 s</code> default)</td>
