---
import BaseLayout from '../layouts/BaseLayout.astro';

const majors = [
  ['Cloudflare', 'cloudflare'], ['GoDaddy', 'godaddy'], ['Namecheap', 'namecheap'],
  ['AWS Route 53', 'route53'], ['Azure DNS', 'azure-dns'], ['Google Cloud DNS', 'google-cloud-dns'],
  ['cPanel (hosting)', 'cpanel'], ['Plesk (hosting)', 'plesk'],
];
const minors = [
  ['Wix', 'wix'], ['Squarespace', 'squarespace'], ['Shopify', 'shopify'], ['Netlify', 'netlify'],
];
const comparisons = [
  ['Cloudflare DNS vs Google Cloud DNS', '/cloudflare-dns-vs-google-dns/'],
  ['Cloudflare vs AWS Route 53', '/cloudflare-vs-route53/'],
];

const faqSchema = {
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
  {
   "@type": "Question",
   "name": "What is the DNS providers section?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "It's a curated collection of guides and tools focused on dns providers, organized from fundamentals to advanced configurations."
   }
  },
  {
   "@type": "Question",
   "name": "Are all these pages free?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Yes: every guide and tool on PromptDNS is free forever, with no account and no limits."
   }
  },
  {
   "@type": "Question",
   "name": "How do I navigate this section?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Start with the first card and follow the internal links. Each page connects to related topics so you naturally build understanding."
   }
  },
  {
   "@type": "Question",
   "name": "How often is this content updated?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Money pages are reviewed and refreshed every 90 days. New guides are added weekly as the topical map expands."
   }
  },
  {
   "@type": "Question",
   "name": "Can I suggest a topic that's missing?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Yes: email hello@promptdns.com with your suggestion. We prioritize based on search demand and user feedback."
   }
  },
  {
   "@type": "Question",
   "name": "Is this content written by experts?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Every page follows a documented editorial standard: verified processes, tool-verified instructions, and regular reviews. See the About page for details."
   }
  }
 ]
}
---
<BaseLayout
  title="DNS Provider Guides — Playbooks for Every Platform"
  description="DNS playbooks for every provider: manage records and change nameservers in Cloudflare, GoDaddy, Namecheap, Route 53, Azure, cPanel, Wix, Shopify and more, plus troubleshooting guides."
  schema={[faqSchema]}
>
  <div class="mx-auto max-w-5xl px-4 py-12">
    <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a> <span aria-hidden="true">/</span>
      <a href="/dns/" class="hover:text-accent">DNS Guide</a> <span aria-hidden="true">/</span>
      <span class="text-ink-dim">Provider Guides</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">DNS Provider Playbooks</h1>
    <p class="mt-5 text-lg leading-relaxed text-ink-dim">
      Every DNS host works differently: different panels, different defaults, different ways to
      break things. These playbooks cover each platform's exact flow, its quirks, and its most
      common failures.
    </p>

    <div class="mt-12">
      <h2 class="font-display text-2xl font-bold tracking-tight text-ink">Major providers</h2>
      <div class="mt-6 grid gap-4">
        {majors.map(([name, slug]) => (
          <div class="rounded-xl border border-line bg-panel/60 p-5">
            <h3 class="font-display font-bold text-ink">{name}</h3>
            <div class="mt-3 grid gap-2 sm:grid-cols-3">
              <a href={`/manage-dns-in-${slug}/`} class="rounded-lg border border-line bg-panel-2 px-3 py-2 text-center text-xs font-medium text-ink-dim transition hover:border-accent/40 hover:text-accent">Manage DNS records</a>
              <a href={`/${slug}-change-nameservers/`} class="rounded-lg border border-line bg-panel-2 px-3 py-2 text-center text-xs font-medium text-ink-dim transition hover:border-accent/40 hover:text-accent">Change nameservers</a>
              <a href={`/${slug}-dns-troubleshooting/`} class="rounded-lg border border-line bg-panel-2 px-3 py-2 text-center text-xs font-medium text-ink-dim transition hover:border-accent/40 hover:text-accent">Troubleshooting</a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-12">
      <h2 class="font-display text-2xl font-bold tracking-tight text-ink">Website builders & platforms</h2>
      <div class="mt-6 grid gap-4">
        {minors.map(([name, slug]) => (
          <div class="rounded-xl border border-line bg-panel/60 p-5">
            <h3 class="font-display font-bold text-ink">{name}</h3>
            <div class="mt-3 grid gap-2 sm:grid-cols-2">
              <a href={`/manage-dns-in-${slug}/`} class="rounded-lg border border-line bg-panel-2 px-3 py-2 text-center text-xs font-medium text-ink-dim transition hover:border-accent/40 hover:text-accent">Manage DNS records</a>
              <a href={`/${slug}-connect-domain/`} class="rounded-lg border border-line bg-panel-2 px-3 py-2 text-center text-xs font-medium text-ink-dim transition hover:border-accent/40 hover:text-accent">Connect a domain</a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-12">
      <h2 class="font-display text-2xl font-bold tracking-tight text-ink">Choosing a provider</h2>
      <div class="mt-6 grid gap-3">
        {comparisons.map(([label, href]) => (
          <a href={href} class="rounded-xl border border-line bg-panel/60 p-5 font-medium text-ink transition-all hover:-translate-y-0.5 hover:border-accent/40 hover:text-accent">{label} →</a>
        ))}
      </div>
    </div>

    <div class="mt-12 rounded-xl border border-accent/25 bg-gradient-to-br from-accent/10 to-violet/10 p-6">
      <p class="text-sm leading-relaxed text-ink-dim">
        After any provider change: verify records with the
        <a href="/dns-record-lookup/" class="font-medium text-accent hover:text-accent-soft">DNS record lookup</a>
        and confirm worldwide agreement with the
        <a href="/dns-propagation-checker/" class="font-medium text-accent hover:text-accent-soft">propagation checker</a>.
      </p>

      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Frequently asked questions</h2>
      <div class="mt-3 grid gap-3"><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">What is the DNS providers section?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">It's a curated collection of guides and tools focused on dns providers, organized from fundamentals to advanced configurations.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Are all these pages free?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Yes: every guide and tool on PromptDNS is free forever, with no account and no limits.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">How do I navigate this section?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Start with the first card and follow the internal links. Each page connects to related topics so you naturally build understanding.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">How often is this content updated?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Money pages are reviewed and refreshed every 90 days. New guides are added weekly as the topical map expands.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Can I suggest a topic that's missing?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Yes: email hello@promptdns.com with your suggestion. We prioritize based on search demand and user feedback.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Is this content written by experts?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Every page follows a documented editorial standard: verified processes, tool-verified instructions, and regular reviews. See the About page for details.</p></details></div>

    <div class="mt-10 flex items-center gap-3 rounded-xl border border-line bg-panel/40 px-5 py-3">
      <span class="grid h-9 w-9 place-items-center rounded-full bg-gradient-to-br from-accent to-violet font-display text-xs font-bold text-canvas">PD</span>
      <div>
        <p class="text-sm font-medium text-ink">PromptDNS Team</p>
        <p class="text-xs text-ink-faint">Last updated: August 2026</p>
      </div>
    </div>
    </div>
  </div>
</BaseLayout>
