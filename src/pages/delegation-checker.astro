---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolArticle from '../components/ToolArticle.astro';
import ToolPanel from '../components/ToolPanel.astro';
---
<BaseLayout title="Delegation Checker - NS Consistency Test" description="Free DNS delegation checker: verify nameservers resolve, answer authoritatively, and catch lame delegation before users do.">
  <div class="mx-auto max-w-4xl px-4 py-12">
        <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a>
       <span aria-hidden="true">/</span>
      <a href="/tools/" class="hover:text-accent">Tools</a>
       <span aria-hidden="true">/</span>
      <span class="text-ink-dim">DNS Delegation Checker</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">Delegation Checker: Test NS Consistency Across Nameservers</h1>
    <p class="mt-4 text-lg text-ink-dim">Free delegation checker: verify every nameserver resolves, answers, and stays consistent across the set.</p>
    <div class="mt-8">
<ToolPanel>
  <form id="dl-form" class="flex flex-col gap-3 sm:flex-row">
    <input id="dl-domain" type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder="example.com" class="flex-1 rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none" />
    <button type="submit" class="btn-cta btn-shimmer px-6 py-2.5 text-sm">Check Delegation</button>
  </form>
  <div id="dl-status" class="mt-4 hidden rounded-md px-4 py-3 text-sm font-medium"></div>
  <p id="dl-sample-note" data-vs="example" class="mt-6 text-xs text-ink-faint">
        Sample diagnostic for <code>example.com</code>. Enter your own domain above for live results.
      </p>
<div id="dl-results" class="pd-results mt-6 grid gap-2" aria-live="polite"><div class="rounded-lg border border-line bg-panel/60 p-4"><p class="font-medium text-ink">a.iana-servers.net</p><p class="mt-1 text-sm text-ink-dim">Answering, authoritative for the zone</p></div><div class="rounded-lg border border-line bg-panel/60 p-4"><p class="font-medium text-ink">b.iana-servers.net</p><p class="mt-1 text-sm text-ink-dim">Answering, answers match the first NS</p></div></div>
</ToolPanel>

    <h2 class="font-display mt-10 text-xl font-semibold text-ink">What the delegation checker tests</h2>
    <section class="not-prose my-4" aria-label="Reference table">
      <div class="glass rounded-2xl p-5 shadow-lg sm:p-7 overflow-x-auto">
        <table class="pdns-table" style="width:100%">
          <thead><tr><th>Check</th><th>Good state</th><th>Source</th></tr></thead>
          <tbody><tr><td class="font-medium text-ink">NS answers</td><td class="text-sm text-ink-dim">Every delegated nameserver responds</td><td class="text-sm text-ink-dim">RFC 1035</td></tr><tr><td class="font-medium text-ink">Consistency</td><td class="text-sm text-ink-dim">All NS return the same answers</td><td class="text-sm text-ink-dim">RFC 2181 trustworthiness rules</td></tr><tr><td class="font-medium text-ink">Glue validity</td><td class="text-sm text-ink-dim">Parent glue matches child NS</td><td class="text-sm text-ink-dim">Parent zone hygiene</td></tr></tbody>
        </table>
      </div>
    </section>

    <ToolArticle slug="delegation-checker" />
    </div>
</div>
</BaseLayout>
<script>
  import { lookup, RESOLVERS, normalizeDomain } from '../lib/doh';
  const form = document.getElementById('dl-form') as HTMLFormElement;
  const input = document.getElementById('dl-domain') as HTMLInputElement;
  const statusEl = document.getElementById('dl-status')!;
  const resultsEl = document.getElementById('dl-results')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const domain = normalizeDomain(input.value);
    if (!domain.includes('.')) { statusEl.textContent = 'Enter a valid domain.'; return; }
    statusEl.textContent = `Checking delegation for ${domain}…`; statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-panel-2 text-accent border border-line'; statusEl.classList.remove('hidden');
    const ns = await lookup(domain, 'NS', RESOLVERS[0]);
    const hosts = ns.answers.filter(a => a.type === 2).map(a => a.data.replace(/\.$/, ''));
    if (!hosts.length) { statusEl.textContent = 'No NS records found.'; statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-fail/10 text-fail border border-fail/30'; return; }
    document.getElementById('dl-sample-note')?.classList.add('hidden');
    resultsEl.innerHTML = '';
    let healthy = 0;
    for (const host of hosts) {
      const a = await lookup(host, 'A', RESOLVERS[0]);
      const ip = a.answers.find(x => x.type === 1)?.data;
      const inBailiwick = host.endsWith('.' + domain);
      if (ip) healthy++;
      resultsEl.insertAdjacentHTML('beforeend', `<div class="rounded-lg border border-line bg-panel/60 px-4 py-3">
        <div class="flex justify-between"><span class="font-mono text-sm text-ink">${host}</span>
        <span class="text-xs ${ip ? 'text-pass' : 'text-fail'}">${ip ? 'resolves' : 'NO A RECORD'}</span></div>
        <div class="mt-1 font-mono text-xs text-ink-faint">${ip ?? 'glue/IP missing'}${inBailiwick ? ' · in-bailiwick (needs glue at parent)' : ''}</div>
      </div>`);
    }
    statusEl.textContent = `${healthy}/${hosts.length} nameservers healthy.${healthy < hosts.length ? ' Broken nameservers cause intermittent SERVFAIL.' : ''}`;
    statusEl.className = `mt-4 rounded-md px-4 py-3 text-sm font-medium ${healthy === hosts.length ? 'bg-pass/10 text-pass border border-pass/30' : 'bg-fail/10 text-fail border border-fail/30'}`;
    resultsEl.classList.remove('hidden');
  });
</script>
