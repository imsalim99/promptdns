---
/** Standalone dashboard — own layout, no BaseLayout (no public navbar/footer). */
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="robots" content="noindex,nofollow"/>
    <title>Dashboard — PromptDNS</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin/>
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600&f[]=satoshi@400,500,700&display=swap" rel="stylesheet"/>
    <style>
      @import "tailwindcss";
      @theme {
        --color-canvas: #050810; --color-panel: #0b1222; --color-panel-2: #101a30;
        --color-line: #1c2a47; --color-ink: #f1f5f9; --color-ink-dim: #9dabc4; --color-ink-faint: #74829c;
        --color-accent: #22d3ee; --color-violet: #8b5cf6;
        --color-pass: #4ade80; --color-fail: #f87171; --color-warn: #fbbf24;
        --font-display: "Clash Display", ui-sans-serif, sans-serif;
        --font-sans: "Satoshi", ui-sans-serif, sans-serif;
      }
      body { font-family: var(--font-sans); background: var(--color-canvas); color: var(--color-ink); font-size: 15px; -webkit-font-smoothing: antialiased; }
    </style>
  </head>
  <body>
    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <aside class="w-56 shrink-0 border-r border-line bg-panel/60 flex flex-col fixed inset-y-0 left-0 z-40">
        <div class="px-3.5 py-4 border-b border-line">
          <a href="/" class="flex items-center gap-2 font-display text-sm font-bold text-ink">
            <span class="grid h-7 w-7 place-items-center rounded-lg bg-gradient-to-br from-accent to-violet font-mono text-[9px] font-bold text-canvas">DNS</span>
            PromptDNS
          </a>
        </div>
        <nav class="flex-1 px-2 py-3 space-y-0.5">
          <div class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm font-medium text-accent bg-accent/10">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
            Overview
          </div>
          <div class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm text-ink-dim">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/></svg>
            Domains
          </div>
          <div class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm text-ink-dim">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/></svg>
            Alerts
          </div>
        </nav>
        <div class="mt-auto px-2 py-3 border-t border-line">
          <button id="signout" class="w-full flex items-center gap-2 rounded-lg px-3 py-2 text-xs text-ink-dim hover:text-fail transition">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Sign out
          </button>
        </div>
      </aside>

      <!-- Main -->
      <main class="flex-1 ml-56 p-6 lg:p-8">
        <div class="flex items-center justify-between mb-6">
          <h1 class="font-display text-xl font-bold text-ink">Dashboard</h1>
          <span class="rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-medium text-accent">Free plan</span>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
          <div class="rounded-xl border border-line bg-panel/60 p-5">
            <p class="text-xs text-ink-faint">Domains monitored</p>
            <p id="stat-domains" class="mt-1 font-display text-3xl font-bold text-accent">–</p>
          </div>
          <div class="rounded-xl border border-line bg-panel/60 p-5">
            <p class="text-xs text-ink-faint">Active alerts</p>
            <p class="mt-1 font-display text-3xl font-bold text-warn">0</p>
          </div>
          <div class="rounded-xl border border-line bg-panel/60 p-5">
            <p class="text-xs text-ink-faint">DMARC reports</p>
            <p class="mt-1 font-display text-3xl font-bold text-accent">0</p>
          </div>
          <div class="rounded-xl border border-line bg-panel/60 p-5">
            <p class="text-xs text-ink-faint">Plan</p>
            <p class="mt-1 font-display text-3xl font-bold text-ink">Free</p>
          </div>
        </div>

        <!-- Add domain -->
        <div class="rounded-xl border border-dashed border-line p-5 mb-8">
          <div class="flex gap-3 items-center">
            <input id="add-input" type="text" placeholder="Add a domain to monitor…" autocomplete="off" spellcheck="false"
              class="flex-1 max-w-xs rounded-lg border border-line bg-transparent px-4 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none"/>
            <button id="add-btn" class="rounded-lg bg-gradient-to-r from-accent to-violet px-5 py-2.5 text-sm font-semibold text-canvas">Add domain</button>
          </div>
          <p id="add-msg" class="mt-2 text-xs hidden"></p>
        </div>

        <!-- Domain list -->
        <h2 class="font-display text-lg font-bold text-ink mb-4">Your domains</h2>
        <div class="rounded-xl border border-line bg-panel/60 overflow-hidden">
          <table class="w-full text-sm">
            <thead><tr class="border-b border-line">
              <th class="px-4 py-3 text-left font-semibold text-ink-dim text-xs uppercase tracking-wide">Domain</th>
              <th class="px-4 py-3 text-left font-semibold text-ink-dim text-xs uppercase tracking-wide">Added</th>
              <th class="px-4 py-3 text-left font-semibold text-ink-dim text-xs uppercase tracking-wide">Status</th>
              <th class="px-4 py-3"></th>
            </tr></thead>
            <tbody id="domain-list"></tbody>
          </table>
        </div>
      </main>
    </div>

    <script>
      async function init() {
        const res = await fetch('/api/domains');
        if (res.status === 401) { window.location.href = '/login'; return; }
        const j = await res.json();
        const domains = j.domains || [];
        document.getElementById('stat-domains').textContent = domains.length;
        const tbody = document.getElementById('domain-list');
        if (!domains.length) {
          tbody.innerHTML = '<tr><td colspan="4" class="text-center text-ink-faint py-6">No domains added yet. Add one above.</td></tr>';
          return;
        }
        tbody.innerHTML = domains.map(function(d) {
          return '<tr>'
            + '<td class="px-4 py-3 font-mono text-sm text-ink">' + d.name + '</td>'
            + '<td class="px-4 py-3 text-xs text-ink-faint">' + d.added_at + '</td>'
            + '<td class="px-4 py-3"><span style="background:#4ade8022;padding:2px 8px;border-radius:999px;font-size:11px;color:#4ade80;">active</span></td>'
            + '<td class="px-4 py-3 text-right"><button data-remove="' + d.name + '" style="font-size:11px;color:#74829c;background:none;border:none;cursor:pointer;">remove</button></td>'
            + '</tr>';
        }).join('');
        tbody.querySelectorAll('[data-remove]').forEach(function(btn) {
          btn.addEventListener('click', async function() {
            await fetch('/api/domains', {
              method: 'DELETE',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ name: btn.dataset.remove }),
            });
            init();
          });
        });
      }

      document.getElementById('add-btn').addEventListener('click', async function() {
        const input = document.getElementById('add-input');
        const name = input.value.trim().toLowerCase();
        if (!name.includes('.')) { return; }
        await fetch('/api/domains', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name }),
        });
        input.value = '';
        init();
      });

      document.getElementById('signout').addEventListener('click', async function() {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/';
      });

      init();
    </script>
  </body>
</html>
