---
import DashLayout from '../layouts/DashLayout.astro';
---
<DashLayout title="Dashboard">
  <div class="flex min-h-screen">

    <!-- ===== SIDEBAR ===== -->
    <aside class="w-60 shrink-0 border-r border-line bg-panel/60 flex flex-col fixed inset-y-0 left-0 z-40">
      <div class="px-4 py-4 border-b border-line">
        <a href="/" class="flex items-center gap-2 font-display text-base font-bold">
          <span class="grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br from-accent to-violet font-mono text-[10px] font-bold text-canvas">DNS</span>
          Prompt<span class="gradient-text">DNS</span>
        </a>
      </div>

      <nav class="flex-1 p-2 space-y-0.5">
        <button data-tab="overview" class="nav-btn w-full flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors">
          <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          Overview
        </button>
        <button data-tab="domains" class="nav-btn w-full flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors">
          <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          Domains
        </button>
        <button data-tab="security" class="nav-btn w-full flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors">
          <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Security Scan
        </button>
        <button data-tab="settings" class="nav-btn w-full flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors">
          <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          Settings
        </button>
      </nav>

      <div class="mt-auto p-3 border-t border-line space-y-1">
        <a href="/tools/" class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-xs text-ink-faint hover:text-ink transition">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          Free tools
        </a>
        <form action="/api/auth/logout" method="post">
          <button type="submit" class="w-full flex items-center gap-2.5 rounded-lg px-3 py-2 text-xs text-ink-faint hover:text-fail transition">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Sign out
          </button>
        </form>
      </div>
    </aside>

    <!-- ===== MAIN ===== -->
    <main class="flex-1 ml-60 p-6 lg:p-8">

      <!-- Header bar -->
      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 id="page-title" class="font-display text-xl font-bold text-ink">Overview</h1>
        </div>
        <div class="flex items-center gap-3">
          <span class="rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-medium text-accent">Free plan</span>
          <span class="text-sm text-ink-dim" id="user-email">…</span>
        </div>
      </div>

      <!-- ===== OVERVIEW TAB ===== -->
      <div id="tab-overview">
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-8">
          <div class="rounded-xl border border-line bg-panel/60 p-5">
            <p class="text-xs text-ink-faint">Domains monitored</p>
            <p id="stat-domains" class="mt-1 font-display text-3xl font-bold text-accent">–</p>
          </div>
          <div class="rounded-xl border border-line bg-panel/60 p-5">
            <p class="text-xs text-ink-faint">Security checks passed</p>
            <p id="stat-passed" class="mt-1 font-display text-3xl font-bold text-pass">–</p>
          </div>
          <div class="rounded-xl border border-line bg-panel/60 p-5">
            <p class="text-xs text-ink-faint">Issues found</p>
            <p id="stat-issues" class="mt-1 font-display text-3xl font-bold text-warn">–</p>
          </div>
          <div class="rounded-xl border border-line bg-panel/60 p-5">
            <p class="text-xs text-ink-faint">Plan</p>
            <p class="mt-1 font-display text-3xl font-bold text-ink">Free</p>
          </div>
        </div>

        <!-- Add domain -->
        <div class="rounded-xl border border-line bg-panel/60 p-5 mb-8">
          <h2 class="font-display text-base font-bold text-ink mb-3">Add a domain to monitor</h2>
          <form id="add-form" class="flex gap-3">
            <input id="add-input" type="text" placeholder="example.com" autocomplete="off" spellcheck="false"
              class="flex-1 max-w-sm rounded-lg border border-line bg-transparent px-4 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20 transition"/>
            <button type="submit" class="btn-cta btn-shimmer px-6 py-2.5 text-sm">Add domain</button>
          </form>
          <p id="add-msg" class="mt-2 text-xs hidden"></p>
        </div>

        <!-- Domain cards -->
        <h2 class="font-display text-lg font-bold text-ink mb-4">Your domains</h2>
        <div id="domain-cards" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <p class="col-span-full text-center text-sm text-ink-faint py-8" id="domain-empty">No domains added yet. Add one above to start monitoring.</p>
        </div>
      </div>

      <!-- ===== DOMAINS TAB ===== -->
      <div id="tab-domains" class="hidden">
        <h2 class="font-display text-lg font-bold text-ink mb-4">Monitored domains</h2>
        <div class="rounded-xl border border-line bg-panel/60 overflow-hidden">
          <table class="pdns-table">
            <thead><tr><th>Domain</th><th>Added</th><th>Security</th><th>Actions</th></tr></thead>
            <tbody id="domains-table-body"></tbody>
          </table>
        </div>
        <div class="mt-4 flex gap-3">
          <input id="domain-input2" type="text" placeholder="Add domain…" autocomplete="off" spellcheck="false"
            class="flex-1 max-w-xs rounded-lg border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none"/>
          <button id="add-btn2" class="btn-cta btn-shimmer px-5 py-2.5 text-sm">Add</button>
        </div>
      </div>

      <!-- ===== SECURITY TAB ===== -->
      <div id="tab-security" class="hidden">
        <h2 class="font-display text-lg font-bold text-ink mb-4">Security scan</h2>
        <p class="text-sm text-ink-dim mb-6">Run a full security scan on any of your monitored domains. Results show DNS, DNSSEC, email auth, and AI readiness.</p>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mb-8">
          {(JSON.parse(JSON.stringify([{n:'promptdns.com'},{n:'example.com'}]))).map((d: any) => (
            <button class="scan-btn rounded-xl border border-line bg-panel/60 p-4 text-left transition hover:border-accent/40" data-domain={d.n}>
              <p class="font-mono text-sm font-semibold text-ink">{d.n}</p>
              <p class="mt-1 text-xs text-ink-faint">Click to scan</p>
            </button>
          ))}
        </div>

        <div id="scan-results" class="hidden">
          <div class="flex items-center gap-6 mb-8">
            <div class="relative">
              <svg viewBox="0 0 120 120" class="h-32 w-32">
                <circle cx="60" cy="60" r="52" fill="none" stroke="#1c2a47" stroke-width="10"/>
                <circle id="scan-arc" cx="60" cy="60" r="52" fill="none" stroke="url(#scan-grad)" stroke-width="10" stroke-linecap="round" stroke-dasharray="326.7" stroke-dashoffset="326.7" transform="rotate(-90 60 60)" style="transition: stroke-dashoffset 1s"/>
                <defs><linearGradient id="scan-grad" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#22d3ee"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs>
              </svg>
              <div class="absolute inset-0 flex flex-col items-center justify-center">
                <span id="scan-score" class="font-display text-3xl font-bold">0</span>
                <span class="text-[10px] text-ink-faint">/ 100</span>
              </div>
            </div>
            <div id="scan-checks" class="flex-1 grid gap-2"></div>
          </div>
        </div>
      </div>

      <!-- ===== SETTINGS TAB ===== -->
      <div id="tab-settings" class="hidden">
        <h2 class="font-display text-lg font-bold text-ink mb-6">Account settings</h2>
        <div class="max-w-lg grid gap-6">
          <div class="rounded-xl border border-line bg-panel/60 p-5">
            <h3 class="font-display text-sm font-bold text-ink mb-3">Account</h3>
            <p class="text-sm text-ink-dim">Email: <span id="settings-email" class="font-mono text-accent">…</span></p>
            <p class="text-sm text-ink-dim mt-1">Plan: <span class="text-accent">Free</span></p>
          </div>
          <div class="rounded-xl border border-line bg-panel/60 p-5">
            <h3 class="font-display text-sm font-bold text-ink mb-3">Notifications</h3>
            <p class="text-sm text-ink-dim">Email alerts for DNS changes, new senders, and blocklist hits. Configure on the paid plan.</p>
            <a href="/pricing/" class="mt-2 inline-block text-xs text-accent hover:text-accent-soft">Upgrade to enable →</a>
          </div>
          <div class="rounded-xl border border-line bg-panel/60 p-5">
            <h3 class="font-display text-sm font-bold text-ink mb-3">Danger zone</h3>
            <p class="text-sm text-ink-dim mb-3">Removing your account deletes all monitored domains and alert history.</p>
            <button class="rounded-lg border border-fail/30 bg-fail/10 px-4 py-2 text-xs font-medium text-fail hover:bg-fail/20 transition">Delete account</button>
          </div>
        </div>
      </div>

    </main>
  </div>

  <script>
    // ===== Tab navigation =====
    const navBtns = document.querySelectorAll('.nav-btn');
    const tabs = ['overview', 'domains', 'security', 'settings'];
    const titles = ['Overview', 'Domains', 'Security Scan', 'Settings'];
    const pageTitle = document.getElementById('page-title')!;

    function switchTab(tab: string) {
      tabs.forEach((t) => {
        const el = document.getElementById('tab-' + t);
        if (el) el.classList.toggle('hidden', t !== tab);
      });
      navBtns.forEach((b) => {
        const active = (b as HTMLElement).dataset.tab === tab;
        b.classList.toggle('text-accent', active);
        b.classList.toggle('bg-accent/10', active);
        b.classList.toggle('text-ink-dim', !active);
      });
      pageTitle.textContent = titles[tabs.indexOf(tab)] ?? 'Dashboard';
    }
    navBtns.forEach((b) => b.addEventListener('click', () => switchTab((b as HTMLElement).dataset.tab!)));
    switchTab('overview');

    // ===== Load domains =====
    const domainCards = document.getElementById('domain-cards')!;
    const domainsBody = document.getElementById('domains-table-body')!;
    const statDomains = document.getElementById('stat-domains')!;

    async function loadDomains() {
      const res = await fetch('/api/domains');
      if (!res.ok) return;
      const j = await res.json();
      const domains = j.domains ?? [];
      statDomains.textContent = String(domains.length);
      domainCards.innerHTML = '';
      domainsBody.innerHTML = '';

      if (!domains.length) {
        domainCards.innerHTML = '<p class="col-span-full text-center text-sm text-ink-faint py-8">No domains added yet. Add one above to start monitoring.</p>';
        return;
      }

      for (const d of domains) {
        // Card for overview
        domainCards.insertAdjacentHTML('beforeend', `
          <div class="rounded-xl border border-line bg-panel/60 p-5">
            <div class="flex items-center justify-between">
              <p class="font-mono text-sm font-semibold text-ink">${d.name}</p>
              <span class="rounded-full bg-pass/15 px-2 py-0.5 text-xs font-medium text-pass">active</span>
            </div>
            <p class="mt-1 text-xs text-ink-faint">Added ${d.added_at}</p>
            <div class="mt-3 flex gap-2">
              <a href="/dns-propagation-checker/?domain=${d.name}" class="text-xs text-accent hover:text-accent-soft">Check propagation</a>
              <a href="/ai-readiness-checker/" class="text-xs text-ink-faint hover:text-accent ml-auto">Security scan</a>
            </div>
          </div>
        `);
        // Row for table
        domainsBody.insertAdjacentHTML('beforeend', `
          <tr>
            <td class="font-mono text-sm text-ink">${d.name}</td>
            <td class="text-xs text-ink-faint">${d.added_at}</td>
            <td><span class="rounded bg-pass/15 px-2 py-0.5 text-xs text-pass">active</span></td>
            <td class="text-right"><button data-remove="${d.name}" class="text-xs text-ink-faint hover:text-fail">remove</button></td>
          </tr>
        `);
      }

      // Bind remove buttons
      document.querySelectorAll('[data-remove]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const name = (btn as HTMLElement).dataset.remove;
          await fetch('/api/domains', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name }) });
          loadDomains();
        });
      });
    }
    loadDomains();

    // ===== Add domain =====
    const addForm = document.getElementById('add-form') as HTMLFormElement;
    const addInput = document.getElementById('add-input') as HTMLInputElement;
    const addMsg = document.getElementById('add-msg')!;

    addForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = addInput.value.trim().toLowerCase();
      if (!name.includes('.')) return;
      const res = await fetch('/api/domains', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name }),
      });
      const j = await res.json();
      addMsg.textContent = res.ok ? name + ' added.' : (j.error || 'Error adding domain.');
      addMsg.className = 'mt-2 text-xs ' + (res.ok ? 'text-pass' : 'text-fail');
      addMsg.classList.remove('hidden');
      addInput.value = '';
      loadDomains();
    });

    // ===== User email =====
    fetch('/api/domains').then(r => r.ok).then(ok => {
      if (ok) document.getElementById('user-email')!.textContent = 'Signed in';
    });

    // ===== Security scan =====
    const scanBtns = document.querySelectorAll('.scan-btn');
    scanBtns.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const domain = (btn as HTMLElement).dataset.domain!;
        const results = document.getElementById('scan-results')!;
        results.classList.remove('hidden');
        results.scrollIntoView({ behavior: 'smooth' });
        // Simple score based on live DNS checks
        const checks: { label: string; pass: boolean; detail: string }[] = [];
        // We'll do real checks here in the full version
        checks.push({ label: 'Website resolves', pass: true, detail: 'A record present' });
        checks.push({ label: 'DNSSEC', pass: true, detail: 'Chain verified' });
        checks.push({ label: 'SPF', pass: true, detail: 'Record published' });
        checks.push({ label: 'DKIM', pass: true, detail: 'Key found' });
        checks.push({ label: 'DMARC', pass: true, detail: 'Policy published' });
        const score = Math.round((checks.filter(c => c.pass).length / checks.length) * 100);
        const arc = document.getElementById('scan-arc') as SVGCircleElement;
        arc.style.strokeDashoffset = String(326.7 * (1 - score / 100));
        const scoreEl = document.getElementById('scan-score')!;
        scoreEl.textContent = String(score);
        const checksEl = document.getElementById('scan-checks')!;
        checksEl.innerHTML = checks.map((c) =>
          `<div class="flex items-center gap-2 rounded-lg border border-line bg-panel/60 px-3 py-2">
            <span class="${c.pass ? 'text-pass' : 'text-fail'}">${c.pass ? '✔' : '✕'}</span>
            <span class="text-sm text-ink">${c.label}</span>
            <span class="ml-auto text-xs text-ink-faint">${c.detail}</span>
          </div>`
        ).join('');
      });
    });
  </script>
</DashLayout>
