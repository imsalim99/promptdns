---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Sign In"
  description="Sign in to PromptDNS with an email link. No passwords."
  noindex
>
  <div class="mx-auto max-w-md px-4 py-20">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">Account</p>
    <h1 class="font-display mt-3 text-3xl font-bold tracking-tight text-ink">Sign in with an email link</h1>
    <p class="mt-3 text-sm leading-relaxed text-ink-dim">
      Enter your email and we sign you in with a one-time link. No passwords, nothing to remember.
    </p>

    <form id="login-form" class="mt-8 flex flex-col gap-3">
      <label class="sr-only" for="login-email">Email address</label>
      <input id="login-email" type="email" required autocomplete="email" placeholder="you@yourdomain.com"
        class="w-full rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30" />
      <button type="submit" id="login-submit" class="btn-cta btn-shimmer px-5 py-2.5 text-sm">Send sign-in link</button>
    </form>

    <div id="login-result" class="mt-4 hidden rounded-md px-4 py-3 text-sm font-medium"></div>
    <div id="login-link" class="mt-4 hidden">
      <p class="text-xs text-ink-faint">Email delivery is not configured yet, so here is your link directly:</p>
      <a id="login-link-a" href="#" class="mt-2 block break-all rounded-md border border-accent/30 bg-accent/10 px-3 py-2 font-mono text-xs text-accent hover:bg-accent/20"></a>
      <p class="mt-2 text-xs text-ink-faint">Valid for 15 minutes. This on-screen link is available only for the PromptDNS team email until email delivery goes live.</p>
    </div>
  </div>

  <script>
    const form = document.getElementById('login-form') as HTMLFormElement;
    const email = document.getElementById('login-email') as HTMLInputElement;
    const btn = document.getElementById('login-submit') as HTMLButtonElement;
    const result = document.getElementById('login-result')!;
    const linkBox = document.getElementById('login-link')!;
    const linkA = document.getElementById('login-link-a') as HTMLAnchorElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = 'Working…';
      try {
        const res = await fetch('/api/auth/magic-link', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email.value }),
        });
        const data = (await res.json()) as { ok: boolean; owner?: boolean; verify_url?: string; message?: string; error?: string };
        if (data.ok && data.owner && data.verify_url) {
          result.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-pass/10 text-pass border border-pass/30';
          result.textContent = 'Link ready below.';
          linkA.href = data.verify_url;
          linkA.textContent = data.verify_url;
          linkBox.classList.remove('hidden');
        } else if (data.ok) {
          result.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-warn/10 text-warn border border-warn/30';
          result.textContent = data.message ?? 'Check your email for the sign-in link.';
        } else {
          result.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-fail/10 text-fail border border-fail/30';
          result.textContent = data.error ?? 'Something went wrong. Try again.';
        }
      } catch {
        result.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-fail/10 text-fail border border-fail/30';
        result.textContent = 'Could not reach the server. Try again.';
      }
      btn.disabled = false;
      btn.textContent = 'Send sign-in link';
    });
  </script>
</BaseLayout>
