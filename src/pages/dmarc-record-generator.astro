---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolPanel from '../components/ToolPanel.astro';

const faqSchema = {
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
  {
   "@type": "Question",
   "name": "Is the DMARC Record Generator really free?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Yes: every tool on PromptDNS is free forever, with no account, no limits, and no trial timers. The DMARC record generation runs entirely in your browser."
   }
  },
  {
   "@type": "Question",
   "name": "How accurate are the results?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "The DMARC record generation queries public DNS-over-HTTPS resolvers (Cloudflare, Google, Quad9) in real time. Results reflect what those resolvers actually serve, which is the same data the wider internet receives."
   }
  },
  {
   "@type": "Question",
   "name": "Do you store the domains I look up?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "No. Lookups happen client-side in your browser. Domains are not sent to our servers, stored, or logged. See the privacy policy for details."
   }
  },
  {
   "@type": "Question",
   "name": "Can I use this tool for client work?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Yes: the tools are free for commercial use. Agencies on the Business plan can also generate white-label automated reports."
   }
  },
  {
   "@type": "Question",
   "name": "How often should I run this check?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "After any DNS or infrastructure change, and periodically (weekly or monthly) as part of routine health monitoring. The paid plans automate this."
   }
  },
  {
   "@type": "Question",
   "name": "What if the results look wrong?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Compare with a second tool or dig from a terminal. If results differ between tools, one may be showing a cached answer: the propagation checker reveals which resolvers disagree."
   }
  }
 ]
}
---
<BaseLayout
  title="DMARC Record Generator, Build Your DMARC Record"
  description="Free DMARC record generator: pick your policy, alignment, and reporting addresses and get a copy-paste-ready DMARC TXT record."
  schema={[faqSchema]}
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a>
       <span aria-hidden="true">/</span>
      <a href="/email-authentication/" class="hover:text-accent">Email Authentication</a>
       <span aria-hidden="true">/</span>
      <span class="text-ink-dim">DMARC Generator</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">DMARC Record Generator</h1>
    <p class="mt-4 text-lg text-ink-dim">Configure your policy once and get a valid, copy-paste-ready DMARC record for your DNS.</p>

    <ToolPanel>
      <form id="gen-form" class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="gen-policy" class="mb-1 block text-xs text-ink-faint">Domain policy (p=)</label>
          <select id="gen-policy" class="w-full rounded-md border border-line bg-panel px-3 py-2.5 text-sm text-ink focus:border-accent focus:outline-none">
            <option value="none">none, monitor only (start here)</option>
            <option value="quarantine">quarantine, fail to spam</option>
            <option value="reject">reject, full enforcement</option>
          </select>
        </div>
        <div>
          <label for="gen-sp" class="mb-1 block text-xs text-ink-faint">Subdomain policy (sp=), optional</label>
          <select id="gen-sp" class="w-full rounded-md border border-line bg-panel px-3 py-2.5 text-sm text-ink focus:border-accent focus:outline-none">
            <option value="">inherit from p=</option>
            <option value="none">none</option>
            <option value="quarantine">quarantine</option>
            <option value="reject">reject</option>
          </select>
        </div>
        <div>
          <label for="gen-pct" class="mb-1 block text-xs text-ink-faint">Apply to % of mail (pct=)</label>
          <input id="gen-pct" type="number" min="1" max="100" value="100" class="w-full rounded-md border border-line bg-transparent px-3 py-2.5 text-sm text-ink focus:border-accent focus:outline-none" />
        </div>
        <div>
          <label for="gen-rua" class="mb-1 block text-xs text-ink-faint">Report address (rua=)</label>
          <input id="gen-rua" type="email" placeholder="dmarc@yourdomain.com" class="w-full rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none" />
        </div>
        <div>
          <label for="gen-ruf" class="mb-1 block text-xs text-ink-faint">Forensic reports (ruf=), optional</label>
          <input id="gen-ruf" type="email" placeholder="(optional)" class="w-full rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="gen-adkim" class="mb-1 block text-xs text-ink-faint">DKIM align (adkim=)</label>
            <select id="gen-adkim" class="w-full rounded-md border border-line bg-panel px-3 py-2.5 text-sm text-ink focus:border-accent focus:outline-none">
              <option value="">relaxed (r)</option><option value="r">relaxed (r)</option><option value="s">strict (s)</option>
            </select>
          </div>
          <div>
            <label for="gen-aspf" class="mb-1 block text-xs text-ink-faint">SPF align (aspf=)</label>
            <select id="gen-aspf" class="w-full rounded-md border border-line bg-panel px-3 py-2.5 text-sm text-ink focus:border-accent focus:outline-none">
              <option value="">relaxed (r)</option><option value="r">relaxed (r)</option><option value="s">strict (s)</option>
            </select>
          </div>
        </div>
      </form>

      <div class="mt-6">
        <div class="flex items-center justify-between">
          <p class="text-sm font-semibold text-ink">Your DMARC record</p>
          <button id="gen-copy" class="rounded-md border border-line bg-panel-2 px-3 py-1.5 text-xs font-medium text-ink hover:border-accent/40">Copy</button>
        </div>
        <pre id="gen-out" class="mt-2 overflow-x-auto rounded-lg border border-line bg-panel-2 p-4 font-mono text-xs leading-relaxed text-accent-soft"></pre>
        <p class="mt-2 text-xs text-ink-faint">Publish as a TXT record at <code class="font-mono">_dmarc.yourdomain.com</code>.</p>
    </div>


    <div id="post-tool-cta" class="hidden mt-8 rounded-xl border border-accent/25 bg-gradient-to-br from-accent/10 to-violet/10 p-6 not-prose">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h3 class="font-display font-bold text-ink text-base">Found issues?</h3>
          <p class="mt-1 text-sm text-ink-dim">Get a full prioritized report, or let our experts fix everything for you.</p>
        </div>
        <div class="flex gap-3 flex-wrap">
          <a href="/pricing/" class="rounded-lg border border-line bg-panel px-4 py-2.5 text-sm font-medium text-ink hover:border-accent/40 transition">Get Full Report — $9</a>
          <a href="/pricing/" class="btn-cta btn-shimmer px-5 py-2.5 text-sm">Fix My Domain</a>
        </div>
      </div>
    </div>

    // Show CTA when tool results appear
    (function() {
      var targets = document.querySelectorAll('[id$="-status"], [id$="-results"], [id$="-output"], [id$="-tbody"], [id$="-cards"]');
      if (!targets.length) return;
      var obs = new MutationObserver(function(mutations) {
        for (var m of mutations) {
          var el = m.target;
          if (el && !el.classList.contains('hidden') && el.innerHTML.trim().length > 20) {
            var cta = document.getElementById('post-tool-cta');
            if (cta) cta.classList.remove('hidden');
            obs.disconnect();
            return;
          }
        }
      });
      targets.forEach(function(el) {
        obs.observe(el, { attributes: true, childList: true, subtree: true });
      });
    })();

    </div>
    </ToolPanel>

    <article class="rich-text mt-14 max-w-none">
      <h2>The safe path to enforcement</h2>
      <p>Start with <code>p=none</code> and a working <code>rua</code> address for 2–4 weeks: read the aggregate reports, fix every legitimate sender that fails SPF/DKIM, then step to <code>p=quarantine</code> (optionally with <code>pct</code> ramping 25 → 50 → 100), and finally <code>p=reject</code>.</p>
      
      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Frequently asked questions</h2>
      <div class="mt-3 grid gap-3"><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Is the DMARC Record Generator really free?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Yes: every tool on PromptDNS is free forever, with no account, no limits, and no trial timers. The DMARC record generation runs entirely in your browser.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">How accurate are the results?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">The DMARC record generation queries public DNS-over-HTTPS resolvers (Cloudflare, Google, Quad9) in real time. Results reflect what those resolvers actually serve, which is the same data the wider internet receives.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Do you store the domains I look up?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">No. Lookups happen client-side in your browser. Domains are not sent to our servers, stored, or logged. See the privacy policy for details.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Can I use this tool for client work?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Yes: the tools are free for commercial use. Agencies on the Business plan can also generate white-label automated reports.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">How often should I run this check?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">After any DNS or infrastructure change, and periodically (weekly or monthly) as part of routine health monitoring. The paid plans automate this.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">What if the results look wrong?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Compare with a second tool or dig from a terminal. If results differ between tools, one may be showing a cached answer: the propagation checker reveals which resolvers disagree.</p></details></div>
<h2>Related tools</h2>
      <ul>
        <li><a href="/dmarc-record-checker/">DMARC Record Checker</a>, verify after publishing</li>
        <li><a href="/how-to-read-dmarc-reports/">How to read DMARC reports</a> (guide)</li>
        <li><a href="/dmarc-record-generator/">SPF Record Checker</a> companion</li>
      </ul>
    </article>
  </div>
</BaseLayout>

<script>
  import { generateDmarc, type DmarcGenOptions } from '../lib/dmarc';

  const ids = ['gen-policy', 'gen-sp', 'gen-pct', 'gen-rua', 'gen-ruf', 'gen-adkim', 'gen-aspf'] as const;
  const els = Object.fromEntries(ids.map((id) => [id, document.getElementById(id) as HTMLSelectElement | HTMLInputElement]));
  const out = document.getElementById('gen-out')!;
  const copyBtn = document.getElementById('gen-copy') as HTMLButtonElement;

  function render() {
    const o: DmarcGenOptions = {
      policy: (els['gen-policy'] as HTMLSelectElement).value as DmarcGenOptions['policy'],
      subdomainPolicy: (els['gen-sp'] as HTMLSelectElement).value as DmarcGenOptions['subdomainPolicy'],
      pct: Math.min(100, Math.max(1, parseInt((els['gen-pct'] as HTMLInputElement).value || '100', 10))),
      rua: (els['gen-rua'] as HTMLInputElement).value,
      ruf: (els['gen-ruf'] as HTMLInputElement).value,
      adkim: (els['gen-adkim'] as HTMLSelectElement).value as DmarcGenOptions['adkim'],
      aspf: (els['gen-aspf'] as HTMLSelectElement).value as DmarcGenOptions['aspf'],
    };
    out.textContent = generateDmarc(o);
  }
  ids.forEach((id) => els[id].addEventListener('input', render));
  render();

  copyBtn.addEventListener('click', async () => {
    await navigator.clipboard.writeText(out.textContent ?? '');
    copyBtn.textContent = 'Copied!';
    setTimeout(() => (copyBtn.textContent = 'Copy'), 1500);
  });
</script>
