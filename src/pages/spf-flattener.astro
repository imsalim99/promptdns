---
import BaseLayout from '../layouts/BaseLayout.astro';
import Diagram from '../components/Diagram.astro';
import ToolPanel from '../components/ToolPanel.astro';

const faqSchema = {
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
  {
   "@type": "Question",
   "name": "Is the SPF Flattener really free?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Yes: every tool on PromptDNS is free forever, with no account, no limits, and no trial timers. The SPF flattening runs entirely in your browser."
   }
  },
  {
   "@type": "Question",
   "name": "How accurate are the results?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "The SPF flattening queries public DNS-over-HTTPS resolvers (Cloudflare, Google, AliDNS) in real time. Results reflect what those resolvers actually serve, which is the same data the wider internet receives."
   }
  },
  {
   "@type": "Question",
   "name": "Do you store the domains I look up?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "No. Lookups happen client-side in your browser. Domains are not sent to our servers, stored, or logged. See the privacy policy for details."
   }
  },
  {
   "@type": "Question",
   "name": "Can I use this tool for client work?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Yes: the tools are free for commercial use. Agencies on the Business plan can also generate white-label automated reports."
   }
  },
  {
   "@type": "Question",
   "name": "How often should I run this check?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "After any DNS or infrastructure change, and periodically (weekly or monthly) as part of routine health monitoring. The paid plans automate this."
   }
  },
  {
   "@type": "Question",
   "name": "What if the results look wrong?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Compare with a second tool or dig from a terminal. If results differ between tools, one may be showing a cached answer: the propagation checker reveals which resolvers disagree."
   }
  }
 ]
}
---
<BaseLayout
  title="SPF Flattener, Fix the 10-Lookup Limit (Free)"
  description="Free SPF flattener: resolve every include: to its IP addresses and generate a flattened SPF record that stays under the 10-DNS-lookup limit."
  schema={[faqSchema]}
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a>
       <span aria-hidden="true">/</span>
      <a href="/tools/" class="hover:text-accent">Tools</a>
       <span aria-hidden="true">/</span>
      <span class="text-ink-dim">SPF Flattener</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">SPF Flattener</h1>
    <p class="mt-4 text-lg text-ink-dim">Resolve every <code class="font-mono text-accent-soft">include:</code> down to raw IP addresses and generate a flattened SPF record that stays under the 10-DNS-lookup limit, free, in your browser.</p>

    <ToolPanel>
      <form id="flat-form" class="flex flex-col gap-3 sm:flex-row">
        <label class="sr-only" for="flat-domain">Domain</label>
        <input id="flat-domain" type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder="example.com"
          class="flex-1 rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30" />
        <button type="submit" class="btn-cta btn-shimmer px-6 py-2.5 text-sm">Flatten SPF</button>
      </form>

      <div id="flat-status" class="mt-4 hidden rounded-md px-4 py-3 text-sm font-medium"></div>

      <div id="flat-stats" class="mt-4 hidden grid gap-3 sm:grid-cols-3"></div>

      <div id="flat-out" class="mt-6 hidden">
        <div class="flex items-center justify-between">
          <p class="text-sm font-semibold text-ink">Flattened record</p>
          <button id="flat-copy" class="rounded-md border border-line bg-panel-2 px-3 py-1.5 text-xs font-medium text-ink hover:border-accent/40">Copy</button>
        </div>
        <pre id="flat-record" class="mt-2 overflow-x-auto rounded-lg border border-line bg-panel-2 p-4 font-mono text-xs leading-relaxed text-accent-soft"></pre>
        <p id="flat-chunks" class="mt-2 text-xs text-ink-faint"></p>
      </div>

      <div id="flat-warnings" class="mt-4 hidden grid gap-2"></div>
    </ToolPanel>

    <article class="rich-text mt-14 max-w-none">
      <h2>Why flatten SPF?</h2>
      <p>Each <code>include:</code>, <code>a</code>, <code>mx</code>, and <code>redirect=</code> in your SPF record costs one DNS lookup, and the limit is 10. Add one too many email services and your SPF becomes a <strong>permerror</strong>, receivers ignore it entirely. Flattening replaces includes with their IP addresses: zero lookups.</p>
      <h2>The trade-off (honest version)</h2>
      <p>Static flattening freezes IPs, if a service you included rotates its sending ranges, your flattened record silently goes stale. Re-run this tool after adding senders, or use <a href="/pricing/">PromptDNS monitoring</a> to get alerted when upstream records change.</p>
      
      

      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Flattening trade-offs</h2>
      <div class="mt-3 overflow-x-auto rounded-xl border border-line bg-panel/60">
        <table class="pdns-table"><tbody><tr><td class="text-sm font-medium text-ink">Lookups</td><td class="text-sm text-ink-dim">Reduced to 0</td></tr><tr><td class="text-sm font-medium text-ink">Maintenance</td><td class="text-sm text-ink-dim">Re-run after adding senders</td></tr><tr><td class="text-sm font-medium text-ink">Risk</td><td class="text-sm text-ink-dim">Stale IPs if upstream changes</td></tr></tbody></table>
    </div>

      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Frequently asked questions</h2>
      <div class="mt-3 grid gap-3"><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Is the SPF Flattener really free?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Yes: every tool on PromptDNS is free forever, with no account, no limits, and no trial timers. The SPF flattening runs entirely in your browser.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">How accurate are the results?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">The SPF flattening queries public DNS-over-HTTPS resolvers (Cloudflare, Google, AliDNS) in real time. Results reflect what those resolvers actually serve, which is the same data the wider internet receives.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Do you store the domains I look up?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">No. Lookups happen client-side in your browser. Domains are not sent to our servers, stored, or logged. See the privacy policy for details.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Can I use this tool for client work?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Yes: the tools are free for commercial use. Agencies on the Business plan can also generate white-label automated reports.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">How often should I run this check?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">After any DNS or infrastructure change, and periodically (weekly or monthly) as part of routine health monitoring. The paid plans automate this.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">What if the results look wrong?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Compare with a second tool or dig from a terminal. If results differ between tools, one may be showing a cached answer: the propagation checker reveals which resolvers disagree.</p></details></div>
      <h2>Related tools</h2>
      <ul>
        <li><a href="/spf-record-checker/">SPF Record Checker</a>, count your lookups first</li>
        <li><a href="/spf-lookup-limit/">The SPF 10-lookup limit explained</a> (guide)</li>
        <li><a href="/dmarc-record-checker/">DMARC Record Checker</a></li>
      </ul>
    </article>
  </div>
</BaseLayout>

<script>
  import { flattenSpf } from '../lib/spf';
  import { normalizeDomain } from '../lib/doh';

  const form = document.getElementById('flat-form') as HTMLFormElement;
  const input = document.getElementById('flat-domain') as HTMLInputElement;
  const statusEl = document.getElementById('flat-status')!;
  const statsEl = document.getElementById('flat-stats')!;
  const outEl = document.getElementById('flat-out')!;
  const recordEl = document.getElementById('flat-record')!;
  const chunksEl = document.getElementById('flat-chunks')!;
  const warnEl = document.getElementById('flat-warnings')!;
  const copyBtn = document.getElementById('flat-copy') as HTMLButtonElement;

  const setStatus = (cls: string, text: string) => {
    statusEl.className = `mt-4 rounded-md px-4 py-3 text-sm font-medium ${cls}`;
    statusEl.textContent = text;
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const domain = normalizeDomain(input.value);
    if (!domain.includes('.')) { setStatus('bg-fail/10 text-fail border border-fail/30', 'Enter a valid domain, e.g. example.com'); return; }
    [statsEl, outEl, warnEl].forEach((el) => el.classList.add('hidden'));
    const btn = form.querySelector('button') as HTMLButtonElement;
    btn.disabled = true;

    const result = await flattenSpf(domain, (m) => setStatus('bg-panel-2 text-accent border border-line', m));

    statsEl.innerHTML = '';
    const cards: [string, string][] = [
      ['IPs collected', String(result.ips.length)],
      ['Domains resolved', String(result.domainsIncluded.length)],
      ['Lookups eliminated', String(result.lookupsBefore)],
    ];
    for (const [l, v] of cards) {
      statsEl.insertAdjacentHTML('beforeend', `<div class="rounded-lg border border-line bg-panel/60 p-4"><div class="font-display text-2xl font-bold text-accent">${v}</div><div class="text-xs text-ink-faint">${l}</div></div>`);
    }
    statsEl.classList.remove('hidden');

    if (result.ips.length) {
      recordEl.textContent = result.flattened;
      const chunks = Math.ceil(result.flattened.length / 255);
      chunksEl.textContent = chunks > 1 ? `${result.flattened.length} characters, split into ${chunks} quoted strings of ≤255 chars when publishing in DNS.` : `${result.flattened.length} characters, fits in a single TXT string.`;
      outEl.classList.remove('hidden');
      setStatus('bg-pass/10 text-pass border border-pass/30', `Flattened ${result.lookupsBefore} DNS lookups down to 0 for ${domain}.`);
    } else {
      setStatus('bg-warn/10 text-warn border border-warn/30', `Could not build a flattened record, see notes below.`);
    }

    warnEl.innerHTML = '';
    for (const w of result.warnings) warnEl.insertAdjacentHTML('beforeend', `<div class="rounded-md border border-warn/30 bg-warn/10 px-4 py-2 text-sm text-warn">▲ ${w}</div>`);
    for (const d of result.domainsIncluded) warnEl.insertAdjacentHTML('beforeend', `<div class="rounded-md border border-line bg-panel/60 px-4 py-2 text-xs text-ink-faint font-mono">resolved: ${d}</div>`);
    warnEl.classList.remove('hidden');

    btn.disabled = false;
  });

  copyBtn.addEventListener('click', async () => {
    await navigator.clipboard.writeText(recordEl.textContent ?? '');
    copyBtn.textContent = 'Copied!';
    setTimeout(() => (copyBtn.textContent = 'Copy'), 1500);
  });
</script>
