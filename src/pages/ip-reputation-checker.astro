---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolPanel from '../components/ToolPanel.astro';
---
<BaseLayout title="IP Reputation Checker — Multi-Blocklist Scan" description="Free IP reputation checker: scan any IPv4 address against Spamhaus ZEN, Barracuda, SpamCop, SORBS and more in one pass.">
  <div class="mx-auto max-w-4xl px-4 py-12">
    <nav class="mb-4 text-sm text-ink-faint"><a href="/" class="hover:text-accent">Home</a> / <span class="text-ink-dim">IP Reputation Checker</span></nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">IP Reputation Checker</h1>
    <p class="mt-4 text-lg text-ink-dim">Scan any IPv4 address across the major IP blocklists, with reverse DNS and honest per-list results.</p>
    <div class="mt-8">
<ToolPanel>
  <form id="ipr-form" class="flex flex-col gap-3 sm:flex-row">
    <input id="ipr-ip" type="text" autocomplete="off" spellcheck="false" placeholder="203.0.113.10" class="flex-1 rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none" />
    <button type="submit" class="btn-cta btn-shimmer px-6 py-2.5 text-sm">Check Reputation</button>
  </form>
  <div id="ipr-status" class="mt-4 hidden rounded-md px-4 py-3 text-sm font-medium"></div>
  <div id="ipr-ptr" class="mt-4 hidden rounded-lg border border-line bg-panel/60 p-4 font-mono text-sm text-accent"></div>
  <div id="ipr-results" class="mt-4 hidden overflow-x-auto rounded-lg border border-line/60">
    <table class="pdns-table"><thead><tr><th>Blocklist</th><th>Result</th><th>Detail</th></tr></thead><tbody id="ipr-tbody"></tbody></table>
  </div>
</ToolPanel>
    </div>
    <article class="rich-text mt-12 max-w-none"><h2>Related</h2><ul><li><a href="/blacklist-checker/">Domain + IP blacklist checker</a> · <a href="/ptr-record-lookup/">PTR lookup</a></li></ul></article>
  </div>
</BaseLayout>
<script>
  import { checkIpBlacklists } from '../lib/dnsbl';
  import { ptrOf } from '../lib/ipinfo';
  const form = document.getElementById('ipr-form') as HTMLFormElement;
  const input = document.getElementById('ipr-ip') as HTMLInputElement;
  const statusEl = document.getElementById('ipr-status')!;
  const ptrEl = document.getElementById('ipr-ptr')!;
  const resultsEl = document.getElementById('ipr-results')!;
  const tbody = document.getElementById('ipr-tbody')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const ip = input.value.trim();
    if (!/^(\d{1,3}\.){3}\d{1,3}$/.test(ip)) { statusEl.textContent = 'Enter a valid IPv4 address.'; statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-fail/10 text-fail border border-fail/30'; statusEl.classList.remove('hidden'); return; }
    statusEl.textContent = `Scanning ${ip}…`; statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-panel-2 text-accent border border-line'; statusEl.classList.remove('hidden');
    const ptr = await ptrOf(ip);
    if (ptr) { ptrEl.textContent = `PTR: ${ptr}`; ptrEl.classList.remove('hidden'); }
    const results = await checkIpBlacklists(ip, (m) => (statusEl.textContent = m));
    tbody.innerHTML = '';
    let listed = 0;
    for (const r of results) {
      if (r.status === 'listed') listed++;
      const badge = r.status === 'listed' ? '<span class="rounded bg-fail/15 px-2 py-0.5 text-xs font-semibold text-fail">LISTED</span>'
        : r.status === 'clear' ? '<span class="rounded bg-pass/15 px-2 py-0.5 text-xs font-semibold text-pass">clean</span>'
        : '<span class="rounded bg-warn/15 px-2 py-0.5 text-xs font-semibold text-warn">n/a</span>';
      tbody.insertAdjacentHTML('beforeend', `<tr><td class="font-medium text-ink">${r.list}</td><td>${badge}</td><td class="text-xs text-ink-dim">${r.detail}</td></tr>`);
    }
    statusEl.textContent = listed ? `${listed} listing(s) found for ${ip}.` : `${ip} looks clean across checkable lists.`;
    statusEl.className = `mt-4 rounded-md px-4 py-3 text-sm font-medium ${listed ? 'bg-fail/10 text-fail border border-fail/30' : 'bg-pass/10 text-pass border border-pass/30'}`;
    resultsEl.classList.remove('hidden');
  });
</script>
