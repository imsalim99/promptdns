---
import EspSetupTemplate from '../components/EspSetupTemplate.astro';
const data = {
 "name": "SendGrid",
 "cat": "ESP",
 "include": "include:sendgrid.net",
 "selector": "smtpapi",
 "quirk": "SendGrid uses domain authentication with CNAME records that auto-generate DKIM; if you skip the brand-link CNAMEs, links in your mail show sendgrid.net domains.",
 "steps": [
  [
   "Authenticate the domain",
   "In Settings, Sender Authentication, enter your domain. SendGrid shows several CNAME records; add them all in DNS, then click Verify."
  ],
  [
   "SPF",
   "SendGrid's include (include:sendgrid.net) is embedded in the CNAME flow; if SendGrid instructs a TXT SPF edit, add the include shown to your existing v=spf1 record."
  ],
  [
   "DKIM",
   "Generated by the CNAMEs above. Verify with the DKIM checker using selector smtpapi (legacy setups) or the one SendGrid displays."
  ]
 ],
 "faqs": [
  [
   "Does SendGrid need its own DMARC record?",
   "No. DMARC is published once for your domain and covers every legitimate sender, including this service. The service just needs SPF and DKIM set up so DMARC sees aligned passes."
  ],
  [
   "Where do I find the exact DNS values for SendGrid?",
   "In the service's own domain-authentication settings page. Providers rotate infrastructure, so the in-app values always beat tutorials. This guide gives the process and the known values."
  ],
  [
   "Can I use this domain with multiple sending services?",
   "Yes: each service adds its own include (or CNAMEs) and DKIM selector. Watch the SPF 10-lookup limit as senders stack, and flatten if you approach it."
  ]
 ]
};
---
<EspSetupTemplate data={data} />
