---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqs: [string, string][] = [
  ['What is the difference between NXDOMAIN and NODATA?', 'NXDOMAIN (RCODE 3) means the queried domain name itself does not exist in the DNS namespace, while NODATA (NOERROR with zero answers, RFC 2308 section 2.2) means the name exists but carries no record of the requested type. A browser NXDOMAIN error follows the first, and a missing AAAA on an IPv4-only host is the classic second.'],
  ['What causes DNS RCODE 2 (SERVFAIL)?', 'SERVFAIL means the resolver failed to complete the lookup, and the two dominant production causes are a broken DNSSEC chain (an orphaned or mismatched DS record at the parent, or expired RRSIG signatures) and every authoritative nameserver for the zone timing out or refusing.'],
  ['What does EAI_AGAIN mean in Node.js and Docker?', 'EAI_AGAIN is the libc getaddrinfo retry-exhausted code: the resolver could not reach any upstream DNS server within the timeout, so the failure is network or resolver reachability rather than a negative answer. In Docker it usually points at a container with a broken or missing resolv.conf upstream.'],
  ['Does RCODE 5 (REFUSED) mean my domain is blocked?', 'No, REFUSED is a server policy answer, not a block of your domain: the queried server refuses to answer for that zone, which most often means a lame delegation (the nameserver holds no zone for the domain), an ACL restriction, or rate limiting. Query a different resolver to separate policy refusals from real DNS failures.'],
  ['What are RFC 8914 Extended DNS Errors (EDE)?', 'Extended DNS Errors attach a 16-bit information code to otherwise generic responses, so a bare SERVFAIL can carry a specific reason such as EDE 6 (DNSSEC Bogus), EDE 15 (Blocked), EDE 18 (Prohibited), or EDE 22 (No Reachable Authority). Major public resolvers now surface these codes in their JSON DoH responses and dashboards.'],
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'DNS Error Messages and Response Codes (RCODEs): Complete Troubleshooting Reference',
  url: 'https://promptdns.com/dns-error-messages/',
  description: 'Every IANA DNS RCODE, browser DNS error string, and email DNS failure mapped to its root cause and diagnostic tool.',
};

interface HubCard {
  href: string;
  badge: string;
  title: string;
  desc: string;
  cta: string;
}

const guideCards: HubCard[] = [
  { href: '/website-not-resolving/', badge: 'Error Fix', title: 'Website Not Resolving? DNS Causes and Fixes', desc: 'Follow a step-by-step diagnostic tree to isolate why a domain name fails to resolve across local networks and global resolvers.', cta: 'Read guide' },
  { href: '/dns-probe-finished-nxdomain/', badge: 'Error Fix', title: 'DNS_PROBE_FINISHED_NXDOMAIN: Causes and Fixes', desc: 'Fix Chrome RCODE 3 (NXDOMAIN) errors by testing public DoH resolvers, flushing stub caches, and verifying zone delegation.', cta: 'Read guide' },
  { href: '/err-name-not-resolved/', badge: 'Error Fix', title: 'ERR_NAME_NOT_RESOLVED: 6 Fixes for Chrome & Edge', desc: 'Resolve Chromium net_error -105 failures by clearing the HostResolver cache, checking Secure DNS templates, and resetting Winsock.', cta: 'Read guide' },
  { href: '/dns-server-not-responding/', badge: 'Error Fix', title: '"DNS Server Not Responding": 9 Fixes for Windows & macOS', desc: 'Repair Windows and macOS recursive resolver timeouts by testing UDP port 53 reachability and switching to Anycast DNS servers.', cta: 'Read guide' },
  { href: '/site-down-after-dns-change/', badge: 'Error Fix', title: 'Site Down After a DNS Change? Recovery Guide', desc: 'Triage post-migration website outages caused by stale TTL caches, unprovisioned zones, orphaned DS records, or SSL mode loops.', cta: 'Read guide' },
  { href: '/email-not-working-after-dns-change/', badge: 'Error Fix', title: 'Email Stopped Working After DNS Change', desc: 'Restore broken inbound and outbound email after a nameserver switch by repairing MX, SPF, DKIM, and autodiscover records.', cta: 'Read guide' },
  { href: '/mx-record-not-working/', badge: 'Error Fix', title: 'MX Record Not Working? How to Fix Broken Mail Routing', desc: 'Diagnose and fix MX records that fail to resolve, point to CNAME aliases, or route mail to shadowed legacy servers.', cta: 'Read guide' },
];

const authCards: HubCard[] = [
  { href: '/spf-permerror/', badge: 'Error Fix', title: 'SPF PermError: Causes and Fixes', desc: 'Fix permanent SPF evaluation failures caused by exceeding the 10-DNS-lookup limit, duplicate v=spf1 records, or syntax errors.', cta: 'Read guide' },
  { href: '/spf-temperror/', badge: 'Error Fix', title: 'SPF TempError: Causes and Fixes', desc: 'Resolve transient SPF 4xx deferrals triggered by upstream DNS timeouts or SERVFAIL responses on included sender domains.', cta: 'Read guide' },
  { href: '/dkim-not-signing/', badge: 'Error Fix', title: 'DKIM Failing? Diagnosis and Fixes', desc: 'Repair DKIM signature verification failures caused by missing selector records, corrupted 2048-bit TXT strings, or body-hash changes.', cta: 'Read guide' },
  { href: '/ssl-certificate-errors/', badge: 'Error Fix', title: 'SSL Certificate Errors: Causes and Fixes', desc: 'Fix browser HTTPS certificate warnings caused by wrong A record IPs, CAA issuance blocks, expired chains, or Cloudflare SSL loops.', cta: 'Read guide' },
  { href: '/smtp-550-5-7-26/', badge: 'Error Fix', title: 'SMTP 550 5.7.26: Unauthenticated Mail Rejected', desc: 'Resolve Gmail and Google Workspace 550 5.7.26 rejections by aligning SPF, DKIM, and DMARC records for bulk and transactional mail.', cta: 'Read guide' },
  { href: '/smtp-554-5-4-14/', badge: 'Error Fix', title: 'SMTP 554 5.4.14: Hop Count Exceeded Mail Loop', desc: 'Stop Microsoft 365 and Exchange 554 5.4.14 mail routing loops caused by misconfigured MX targets and split-delivery connectors.', cta: 'Read guide' },
];

const toolCards: HubCard[] = [
  { href: '/dns-propagation-checker/', badge: 'Free Tool', title: 'DNS Propagation Checker', desc: 'Compare live DNS answers and RCODEs across Cloudflare (1.1.1.1), Google (8.8.8.8), and AliDNS (223.5.5.5) simultaneously.', cta: 'Open tool' },
  { href: '/delegation-checker/', badge: 'Free Tool', title: 'DNS Delegation Checker', desc: 'Verify parent-to-child NS consistency, SOA serial synchronization, and in-bailiwick glue records to detect lame delegations.', cta: 'Open tool' },
  { href: '/dnssec-checker/', badge: 'Free Tool', title: 'DNSSEC Checker and Validator', desc: 'Inspect DS, DNSKEY, and RRSIG chains to pinpoint the exact cryptographic mismatch causing validating resolvers to return SERVFAIL.', cta: 'Open tool' },
  { href: '/dns-resolver-tester/', badge: 'Free Tool', title: 'DNS Resolver Tester', desc: 'Compare side-by-side responses and DNSSEC validation flags across major public recursive resolvers in one pass.', cta: 'Open tool' },
  { href: '/ttl-checker/', badge: 'Free Tool', title: 'DNS TTL Checker', desc: 'Inspect remaining cache timers and SOA negative-cache ceilings (RFC 2308) to see how long stale NXDOMAIN answers persist.', cta: 'Open tool' },
  { href: '/flush-dns-cache/', badge: 'Guide', title: 'How to Flush DNS Cache (All OS & Browsers)', desc: 'Clear stale local DNS cache entries on Windows, macOS, Linux, and Chromium browsers using exact command-line instructions.', cta: 'Open tool' },
];

const browserRows: [string, string, string, string][] = [
  ['DNS_PROBE_FINISHED_NXDOMAIN', 'Chromium / Chrome / Edge', 'RCODE 3 (NXDOMAIN) from every resolver, or a captive-portal DNS hijack returning it', 'The name genuinely does not resolve: check spelling, zone records, and domain expiry'],
  ['net::ERR_NAME_NOT_RESOLVED (-105)', 'Chromium network stack', 'Resolution failed at the stub-resolver layer before any RCODE: no upstream reachable or local config broken', 'Resolver reachability and local DNS settings, not the zone itself'],
  ['"DNS server isn\'t responding" (Windows diagnostics)', 'Windows network troubleshooter', 'The configured resolver (router or ISP DNS) times out on every query', 'Switch to a working public resolver, then retest the zone'],
  ['DNS_PROBE_FINISHED_NO_INTERNET', 'Chromium / Chrome / Edge', 'No network path to any resolver: the DNS failure is a symptom of total connectivity loss', 'Physical/network layer first; DNS diagnostics only after connectivity returns'],
  ['DNS_PROBE_FINISHED_BAD_CONFIG', 'Chromium / Chrome / Edge', 'The OS resolver configuration is invalid (bad nameserver entry, broken VPN adapter)', 'Reset the adapter DNS settings to DHCP or a valid resolver'],
  ['getaddrinfo EAI_AGAIN / ENOTFOUND', 'Node.js and libc (containers, Docker)', 'EAI_AGAIN: resolver unreachable, retries exhausted; ENOTFOUND: resolver returned NXDOMAIN for the name', 'EAI_AGAIN is upstream reachability; ENOTFOUND maps to the zone-level NXDOMAIN'],
];
---
<BaseLayout
  title="DNS Error Messages & RCODEs: Complete Reference (NXDOMAIN, SERVFAIL, REFUSED) | PromptDNS"
  description="Every DNS error decoded: the full IANA RCODE table (NOERROR, FORMERR, SERVFAIL, NXDOMAIN, NOTIMP, REFUSED), RFC 8914 Extended DNS Errors, Chromium and Windows error strings, and the email DNS failures, each mapped to its fix."
  schema={[collectionSchema, faqSchema]}
  breadcrumb={[["Home", "/"], ["DNS", "/dns/"], ["DNS Error Messages"]]}
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a>
       <span aria-hidden="true">/</span>
      <a href="/dns/" class="hover:text-accent">DNS</a>
       <span aria-hidden="true">/</span>
      <span class="text-ink-dim">DNS Error Messages</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">DNS Error Messages and Response Codes (RCODEs): Complete Troubleshooting Reference</h1>
    <div class="pd-answer mt-6" data-vs="answer">
      <p class="text-lg leading-relaxed text-ink-dim">
        A DNS error message is <strong class="text-ink">a protocol response code (RCODE) or client network error string returned when a stub or recursive resolver cannot translate a hostname into a valid IP address</strong>. Authoritative nameservers and recursive resolvers set 4-bit header RCODEs (and 16-bit Extended DNS Error codes under RFC 8914) to report non-existent domains, cryptographic validation failures, or policy refusals. This reference maps every IANA DNS RCODE, Chromium browser error, and SMTP DNS failure to its root cause and diagnostic tool.
      </p>
    </div>

    <nav class="pd-toc mt-6" aria-label="On this page">
      <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent">On this page</p>
      <ul>
        <li><a href="#rcode-table">All IANA DNS Response Codes (RCODEs 0 to 10) and NODATA</a></li>
        <li><a href="#browser-os-errors">1. Browser, OS, and Runtime DNS Error Strings (Chromium, Windows, macOS, Node.js)</a></li>
        <li><a href="#email-ssl-dns-errors">2. Email Authentication (SPF/DMARC) and SSL/TLS DNS Error Guides</a></li>
        <li><a href="#diagnostic-tools">3. Live Browser-Based DNS Error Diagnostic Tools</a></li>
        <li><a href="#faq">Frequently Asked Questions</a></li>
      </ul>
    </nav>

    <div class="rich-text mt-8">
      <h2 id="rcode-table">All IANA DNS Response Codes (RCODEs 0 to 10) and NODATA</h2>
      <p>The table below defines every IANA-registered response code a resolver or nameserver can return, the wire semantics, and the production failure each one usually carries:</p>
      <div class="mt-4 overflow-x-auto rounded-xl border border-line bg-panel/60">
        <table class="pdns-table">
          <thead><tr><th>RCODE &amp; Name</th><th>Decimal / Hex</th><th>Governing RFC</th><th>Wire Meaning</th><th>Most Common Production Cause</th></tr></thead>
          <tbody>
            <tr><td class="font-medium text-ink">RCODE 0: NOERROR</td><td class="font-mono text-xs text-ink-dim">0 / 0x0</td><td class="text-sm text-ink-dim">RFC 1035 section 4.1.1</td><td class="text-sm text-ink-dim">Query succeeded</td><td class="text-sm text-ink-dim">Valid answer returned in the ANSWER section</td></tr>
            <tr><td class="font-medium text-ink">Pseudo-Code: NODATA (NOERROR + 0 Answers)</td><td class="font-mono text-xs text-ink-dim">0 with ANCOUNT=0</td><td class="text-sm text-ink-dim">RFC 2308 section 2.2</td><td class="text-sm text-ink-dim">Name exists, requested RR type does not</td><td class="text-sm text-ink-dim">Querying AAAA or TXT on a host that only has an A record, or an Empty Non-Terminal</td></tr>
            <tr><td class="font-medium text-ink">RCODE 1: FORMERR (Format Error)</td><td class="font-mono text-xs text-ink-dim">1 / 0x1</td><td class="text-sm text-ink-dim">RFC 1035 section 4.1.1</td><td class="text-sm text-ink-dim">Server unable to interpret the query packet</td><td class="text-sm text-ink-dim">Malformed DNS header, unsupported EDNS option, or firewall packet mangling</td></tr>
            <tr><td class="font-medium text-ink">RCODE 2: SERVFAIL (Server Failure)</td><td class="font-mono text-xs text-ink-dim">2 / 0x2</td><td class="text-sm text-ink-dim">RFC 1035 &amp; RFC 4035</td><td class="text-sm text-ink-dim">Resolver failed to complete the lookup</td><td class="text-sm text-ink-dim">Broken DNSSEC chain (mismatched DS, expired RRSIG) or all authoritative NS timed out</td></tr>
            <tr><td class="font-medium text-ink">RCODE 3: NXDOMAIN (Non-Existent Domain)</td><td class="font-mono text-xs text-ink-dim">3 / 0x3</td><td class="text-sm text-ink-dim">RFC 1035 &amp; RFC 2308</td><td class="text-sm text-ink-dim">Queried domain name does not exist</td><td class="text-sm text-ink-dim">Typo, deleted subdomain, expired domain (clientHold), or a negative cache hit</td></tr>
            <tr><td class="font-medium text-ink">RCODE 4: NOTIMP (Not Implemented)</td><td class="font-mono text-xs text-ink-dim">4 / 0x4</td><td class="text-sm text-ink-dim">RFC 1035 section 4.1.1</td><td class="text-sm text-ink-dim">Server does not support the requested query kind</td><td class="text-sm text-ink-dim">Sending IQUERY (obsoleted by RFC 3425) or AXFR to a recursive resolver</td></tr>
            <tr><td class="font-medium text-ink">RCODE 5: REFUSED (Query Refused)</td><td class="font-mono text-xs text-ink-dim">5 / 0x5</td><td class="text-sm text-ink-dim">RFC 1035 section 4.1.1</td><td class="text-sm text-ink-dim">Server refuses to answer by policy</td><td class="text-sm text-ink-dim">Lame delegation (NS holds no zone for the domain), ACL block, or rate limiting</td></tr>
            <tr><td class="font-medium text-ink">RCODE 6-8: YXDOMAIN / YXRRSET / NXRRSET</td><td class="font-mono text-xs text-ink-dim">6, 7, 8</td><td class="text-sm text-ink-dim">RFC 2136</td><td class="text-sm text-ink-dim">Dynamic DNS update prerequisite failed</td><td class="text-sm text-ink-dim">Dynamic nsupdate prerequisite collision</td></tr>
            <tr><td class="font-medium text-ink">RCODE 9: NOTAUTH (Not Authoritative)</td><td class="font-mono text-xs text-ink-dim">9 / 0x9</td><td class="text-sm text-ink-dim">RFC 2136 &amp; RFC 8945</td><td class="text-sm text-ink-dim">Server not authoritative for the zone, or TSIG failed</td><td class="text-sm text-ink-dim">Bad TSIG key on a zone transfer (AXFR) or an unconfigured secondary zone</td></tr>
            <tr><td class="font-medium text-ink">EDNS0 Extended DNS Errors (EDE, Info-Codes 0-29)</td><td class="font-mono text-xs text-ink-dim">OPT Code 15</td><td class="text-sm text-ink-dim">RFC 8914</td><td class="text-sm text-ink-dim">Detailed sub-reason attached to SERVFAIL / NXDOMAIN / REFUSED</td><td class="text-sm text-ink-dim">EDE 6 (DNSSEC Bogus), EDE 15 (Blocked), EDE 18 (Prohibited), EDE 22 (No Reachable Authority)</td></tr>
          </tbody>
        </table>
      </div>
      <p>
        The practical reading order starts with RFC 8914 Extended DNS Errors: both 1.1.1.1 and 8.8.8.8 attach EDE sub-codes to their JSON DoH responses, so a bare SERVFAIL that used to be a dead end now often arrives with a machine-readable reason (DNSSEC Bogus, Blocked, Prohibited, No Reachable Authority) that maps straight to the fix.
      </p>

      <h2 id="browser-os-errors">1. Browser, OS, and Runtime DNS Error Strings (Chromium, Windows, macOS, Node.js)</h2>
      <p>Browsers and runtimes translate the wire-level RCODEs (or the absence of any answer) into their own user-facing strings. The table below maps each string back to the RCODE and layer it actually represents:</p>
      <div class="mt-4 overflow-x-auto rounded-xl border border-line bg-panel/60">
        <table class="pdns-table">
          <thead><tr><th>Error String</th><th>Where It Appears</th><th>Underlying DNS Cause</th><th>What It Actually Tells You</th></tr></thead>
          <tbody>
            {browserRows.map(([code, where, cause, tells]) => (
              <tr>
                <td class="font-mono text-xs text-ink">{code}</td>
                <td class="text-sm text-ink-dim">{where}</td>
                <td class="text-sm text-ink-dim">{cause}</td>
                <td class="text-sm text-ink-dim">{tells}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>
        Client-side stub errors like DNS_PROBE_FINISHED_NXDOMAIN and ERR_NAME_NOT_RESOLVED are the browser's rendering of upstream RCODE 3 and stub-resolver timeouts respectively: the fixes range from flushing the local cache to verifying that the authoritative zone still publishes the record. The 7 troubleshooting guides below cover each error string with its own recovery path:
      </p>
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {guideCards.map((card) => (
        <a href={card.href} class="group relative flex flex-col justify-between rounded-2xl border border-slate-800 bg-slate-900/50 p-5 no-underline transition hover:border-cyan-500/40 hover:bg-slate-900/80">
          <div>
            <span class="inline-flex items-center rounded-md border border-cyan-500/20 bg-cyan-500/10 px-2.5 py-0.5 font-mono text-[11px] font-medium uppercase tracking-wider text-cyan-300">
              {card.badge}
            </span>
            <h3 class="mt-3 font-display text-base font-semibold leading-snug text-white transition group-hover:text-cyan-300 break-words [overflow-wrap:anywhere]">
              {card.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-400">
              {card.desc}
            </p>
          </div>
          <span class="mt-4 inline-flex items-center gap-1 text-xs font-semibold text-cyan-400 transition group-hover:translate-x-0.5">
            {card.cta} <span aria-hidden="true">-&gt;</span>
          </span>
        </a>
      ))}
    </div>

    <div class="rich-text mt-8">
      <h2 id="email-ssl-dns-errors">2. Email Authentication (SPF/DMARC) and SSL/TLS DNS Error Guides</h2>
      <p>Email failures carry their own DNS-derived error surface: SPF evaluation codes, signature failures, and SMTP rejections that name a DNS cause. The TLS layer fails on DNS too, because certificates bind to whatever hostname the records actually route to. These guides decode each one:</p>
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {authCards.map((card) => (
        <a href={card.href} class="group relative flex flex-col justify-between rounded-2xl border border-slate-800 bg-slate-900/50 p-5 no-underline transition hover:border-cyan-500/40 hover:bg-slate-900/80">
          <div>
            <span class="inline-flex items-center rounded-md border border-cyan-500/20 bg-cyan-500/10 px-2.5 py-0.5 font-mono text-[11px] font-medium uppercase tracking-wider text-cyan-300">
              {card.badge}
            </span>
            <h3 class="mt-3 font-display text-base font-semibold leading-snug text-white transition group-hover:text-cyan-300 break-words [overflow-wrap:anywhere]">
              {card.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-400">
              {card.desc}
            </p>
          </div>
          <span class="mt-4 inline-flex items-center gap-1 text-xs font-semibold text-cyan-400 transition group-hover:translate-x-0.5">
            {card.cta} <span aria-hidden="true">-&gt;</span>
          </span>
        </a>
      ))}
    </div>

    <div class="rich-text mt-8">
      <h2 id="diagnostic-tools">3. Live Browser-Based DNS Error Diagnostic Tools</h2>
      <p>Every error above reduces to a question one of these tools answers in the browser: which resolvers disagree, whether the delegation chain holds, whether DNSSEC validates, and how long the failing caches persist. Run the one that matches your error string:</p>
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {toolCards.map((card) => (
        <a href={card.href} class="group relative flex flex-col justify-between rounded-2xl border border-slate-800 bg-slate-900/50 p-5 no-underline transition hover:border-cyan-500/40 hover:bg-slate-900/80">
          <div>
            <span class="inline-flex items-center rounded-md border border-cyan-500/20 bg-cyan-500/10 px-2.5 py-0.5 font-mono text-[11px] font-medium uppercase tracking-wider text-cyan-300">
              {card.badge}
            </span>
            <h3 class="mt-3 font-display text-base font-semibold leading-snug text-white transition group-hover:text-cyan-300 break-words [overflow-wrap:anywhere]">
              {card.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-400">
              {card.desc}
            </p>
          </div>
          <span class="mt-4 inline-flex items-center gap-1 text-xs font-semibold text-cyan-400 transition group-hover:translate-x-0.5">
            {card.cta} <span aria-hidden="true">-&gt;</span>
          </span>
        </a>
      ))}
    </div>

    <div class="rich-text mt-8">
      <p>
        Read the RCODE first, confirm it with the matching tool, and the error message stops being a dead end: the code names the failing layer, and the tool shows the failing record.
      </p>
    </div>

    <h2 class="font-display mt-10 text-xl font-semibold text-ink" id="faq">Frequently Asked Questions</h2>
    <div class="mt-3 grid gap-3">
      {faqs.map(([q, a]) => (
        <details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">
            {q}
            <span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-ink-dim">{a}</p>
        </details>
      ))}
    </div>
  </div>
</BaseLayout>
