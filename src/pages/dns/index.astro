---
import BaseLayout from '../../layouts/BaseLayout.astro';

interface HubCard {
  href: string;
  badge: string;
  title: string;
  desc: string;
}

const fundamentalsCards: HubCard[] = [
  {
    href: '/what-is-dns/',
    badge: 'Guide',
    title: 'What Is DNS?',
    desc: 'Architecture of the Domain Name System, the 4 server tiers, port 53 specs, caching layers, and history.',
  },
  {
    href: '/how-dns-works/',
    badge: 'Guide',
    title: 'How DNS Works Step by Step',
    desc: 'The 4 local OS pre-checks, 8-step network lookup, packet header flags (AA, TC=1, AD), and dig +trace.',
  },
  {
    href: '/what-is-ttl-in-dns/',
    badge: 'Guide',
    title: 'DNS TTL Explained',
    desc: 'How Time to Live countdown timers work in seconds and recommended TTL values for every record type.',
  },
  {
    href: '/doh-vs-dot/',
    badge: 'Guide',
    title: 'DNS-over-HTTPS vs DNS-over-TLS',
    desc: 'Compare DoH (port 443), DoT (port 853), and DoQ across lookup speed, firewall visibility, and privacy.',
  },
  {
    href: '/cname-flattening/',
    badge: 'Guide',
    title: 'CNAME Flattening',
    desc: 'How authoritative DNS servers resolve root-domain (@) hostname aliases into standard A and AAAA responses.',
  },
];

const recordCards: HubCard[] = [
  {
    href: '/dns-records/',
    badge: 'Guide',
    title: 'DNS Record Types: The Complete Reference',
    desc: 'Complete guide to A, AAAA, CNAME, ALIAS, MX, TXT, NS, SOA, PTR, SRV, CAA, DS, and DNSKEY.',
  },
  {
    href: '/dns-providers/',
    badge: 'Guide',
    title: 'DNS Provider Playbooks',
    desc: 'Step-by-step DNS management, nameserver changes, and troubleshooting for Cloudflare, Route 53, GoDaddy, and Namecheap.',
  },
  {
    href: '/a-record/',
    badge: 'Guide',
    title: 'A Record (IPv4 Address)',
    desc: 'Map root domains (@), subdomains, and wildcards (*) to 32-bit IPv4 server addresses and Round-Robin pools.',
  },
  {
    href: '/aaaa-record/',
    badge: 'Guide',
    title: 'AAAA Record (IPv6 Quad-A)',
    desc: 'Configure 128-bit IPv6 addresses, shorthand :: compression, and dual-stack Happy Eyeballs routing.',
  },
  {
    href: '/cname-record/',
    badge: 'Guide',
    title: 'CNAME Record (Canonical Name)',
    desc: 'Point alias subdomains (www, shop, DKIM selectors) to target hostnames and avoid apex conflicts.',
  },
  {
    href: '/mx-record/',
    badge: 'Guide',
    title: 'MX Record (Mail Exchange)',
    desc: 'Direct incoming email to Google Workspace, Microsoft 365, or custom mail servers using priority numbers.',
  },
  {
    href: '/txt-record/',
    badge: 'Guide',
    title: 'TXT Record (Text & Verification)',
    desc: 'Publish SPF, DKIM, DMARC, and site-verification tokens within the 255-character string-splitting rules.',
  },
  {
    href: '/how-to-add-mx-record/',
    badge: 'Guide',
    title: 'How to Add MX Records for Email',
    desc: 'Step-by-step instructions for publishing and verifying mail exchange records without losing incoming mail.',
  },
];

const operationsCards: HubCard[] = [
  {
    href: '/dns-propagation/',
    badge: 'Guide',
    title: 'DNS Propagation Explained',
    desc: 'Why record edits take 5 minutes to 24 hours while registrar NS changes take up to 48 hours, and how to speed them up.',
  },
  {
    href: '/flush-dns-cache/',
    badge: 'Guide',
    title: 'How to Flush DNS Cache',
    desc: 'Exact terminal commands and browser steps to clear cached DNS entries on Windows, macOS, Linux, and Chrome.',
  },
  {
    href: '/change-dns-records-safely/',
    badge: 'Guide',
    title: 'Change DNS Records Without Downtime',
    desc: 'Follow the T-48h pre-migration TTL lowering schedule (3600s to 300s) for seamless IP and hostname cutovers.',
  },
  {
    href: '/dns-migration-checklist/',
    badge: 'Guide',
    title: 'The Complete DNS Migration Checklist',
    desc: 'End-to-end checklist for moving a domain between DNS providers safely, including zone parity and DNSSEC handling.',
  },
  {
    href: '/export-dns-records/',
    badge: 'Guide',
    title: 'How to Export and Back Up DNS Records',
    desc: 'Export a clean BIND zone file backup before making bulk edits or transferring domain registrars.',
  },
];

const troubleshootingCards: HubCard[] = [
  {
    href: '/website-not-resolving/',
    badge: 'Guide',
    title: 'Website Not Resolving?',
    desc: '60-second triage for DNS_PROBE_FINISHED_NXDOMAIN, SERVFAIL, REFUSED, and ICANN clientHold suspensions.',
  },
  {
    href: '/site-down-after-dns-change/',
    badge: 'Guide',
    title: 'Site Down After a DNS Change?',
    desc: 'Isolate and fix missing @/www records, broken DNSSEC DS hashes, and CDN SSL mismatches after an edit.',
  },
  { href: '/dns-error-messages/', badge: 'Guide', title: 'DNS Error Messages & RCODEs', desc: 'Every IANA RCODE and browser DNS error string mapped to its root cause and diagnostic tool.' },
  {
    href: '/email-not-working-after-dns-change/',
    badge: 'Guide',
    title: 'Email Stopped Working After DNS Change',
    desc: 'Restore broken inbound and outbound email when a website migration overwrites MX, SPF, or DKIM records.',
  },
  {
    href: '/mx-record-not-working/',
    badge: 'Guide',
    title: 'MX Record Not Working?',
    desc: 'Diagnose and repair MX priority conflicts, CNAME target violations, and Cloudflare proxy mail blocks.',
  },
  {
    href: '/dns-security/',
    badge: 'Guide',
    title: 'DNS Security: Threats, Hardening, and DNSSEC',
    desc: 'Defend your domain against DNS hijacking, cache poisoning, amplification DDoS, tunneling, and rebinding.',
  },
  {
    href: '/what-is-dnssec/',
    badge: 'Guide',
    title: 'What Is DNSSEC?',
    desc: 'How RRSIG, DNSKEY (ZSK 256 / KSK 257), DS, and NSEC3 records cryptographically authenticate DNS data.',
  },
  {
    href: '/dns-server-not-responding/',
    badge: 'Guide',
    title: 'DNS Server Not Responding: Causes and Fixes',
    desc: 'Fix the Windows and macOS resolver error: device-side flushes, resolver switches, and when the fault is upstream.',
  },
];

const toolCards: HubCard[] = [
  {
    href: '/dns-propagation-checker/',
    badge: 'Free Tool',
    title: 'DNS Propagation Checker',
    desc: 'Query all 12 DNS record types live across Cloudflare (1.1.1.1), Google (8.8.8.8), and AliDNS (223.5.5.5).',
  },
  {
    href: '/dns-record-lookup/',
    badge: 'Free Tool',
    title: 'DNS Record Lookup',
    desc: 'Inspect the complete resource record set and raw values published on any domain or subdomain.',
  },
  {
    href: '/ttl-checker/',
    badge: 'Free Tool',
    title: 'DNS TTL Checker',
    desc: 'Compare authoritative starting TTLs against live decrementing cache timers across public resolvers.',
  },
  {
    href: '/delegation-checker/',
    badge: 'Free Tool',
    title: 'DNS Delegation Checker',
    desc: 'Verify that your parent TLD registrar NS records match your child authoritative zone NS records.',
  },
  {
    href: '/dnssec-checker/',
    badge: 'Free Tool',
    title: 'DNSSEC Checker',
    desc: 'Validate your parent DS hash, child DNSKEYs, RRSIG signatures, and Authenticated Data (AD=1) status.',
  },
];

const faqs = [
  {
    q: 'What is the difference between a domain registrar and a DNS hosting provider?',
    a: 'A domain registrar is an ICANN-accredited company where you purchase domain name ownership and maintain official WHOIS registration data. A DNS hosting provider operates the authoritative nameservers that host your active DNS zone file and answer IP lookup queries for visitors. Most domain registrars include basic free DNS hosting, and domain owners frequently register a domain at one company while delegating nameservers to a dedicated DNS provider like Cloudflare or AWS Route 53.',
  },
  {
    q: 'Which DNS records are required for every website and email domain?',
    a: 'Every functioning website requires an A record (for IPv4) or AAAA record (for IPv6) pointing the root domain (@) or www subdomain to a web server IP address. Domains handling outbound or inbound email also require MX records pointing to mail servers, along with SPF (TXT), DKIM (TXT or CNAME), and DMARC (TXT) records to authenticate messages and prevent phishing.',
  },
  {
    q: 'Can I use one company as my domain registrar and a different company for DNS hosting?',
    a: 'Yes, in practice separating your domain registrar from your DNS hosting provider is an engineering best practice. Keeping your domain registered at a low-cost registrar while pointing your NS records to a fast Anycast DNS provider (like Cloudflare or AWS Route 53) gives you sub-20ms global lookup speeds and advanced features without transferring your domain registration.',
  },
  {
    q: "Why did changing my website's nameservers break my company email?",
    a: "In real-world migrations, changing your NS records moves authority for your entire domain, both web and email, to the new DNS provider. Email stops working immediately when a web agency switches nameservers to a new host and adds only the website's A record without copying over existing MX, SPF, and DKIM records, requiring administrators to recreate those mail records in the new DNS zone.",
  },
];

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'DNS: The Complete Guide to the Domain Name System, Records, Propagation, and Security',
  url: 'https://promptdns.com/dns/',
  description: 'Complete technical reference for Domain Name System (DNS) architecture, resource records, TTL caching, zero-downtime migrations, and DNSSEC security.',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://promptdns.com/' },
    { '@type': 'ListItem', position: 2, name: 'DNS Guide', item: 'https://promptdns.com/dns/' },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---

<BaseLayout
  title="DNS: The Complete Guide to the Domain Name System, Records, Propagation, and Security"
  description="Complete technical reference for Domain Name System (DNS) architecture, resource records, TTL caching, zero-downtime migrations, and DNSSEC security."
  schema={[collectionSchema, breadcrumbSchema, faqSchema]}
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent transition-colors">Home</a>
      <span aria-hidden="true" class="mx-2">/</span>
      <span class="text-ink-dim" aria-current="page">DNS Guide</span>
    </nav>

    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
      DNS: The Complete Guide to the Domain Name System, Records, Propagation, and Security
    </h1>

    <div class="pd-answer mt-6" data-vs="answer">
      <p class="text-lg leading-relaxed text-ink-dim">
        The Domain Name System (DNS) is <strong class="text-ink">the hierarchical, distributed naming protocol that translates human-readable domain names into IPv4 and IPv6 addresses, routes inbound email, and publishes cryptographic domain policies</strong>. Recursive resolvers and authoritative nameservers coordinate every lookup in milliseconds. The 4 core layers span resolution, record types, operations, and security.
      </p>
    </div>

    <nav class="pd-toc" aria-label="On this page">
      <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent">On this page</p>
      <ul>
        <li><a href="#overview">Architecture Overview</a></li>
        <li><a href="#fundamentals">1. DNS Fundamentals and Resolution Mechanics</a></li>
        <li><a href="#records-providers">2. DNS Record Types and Provider Setup Playbooks</a></li>
        <li><a href="#operations">3. DNS Operations: Propagation, Cache Flushing, and Migrations</a></li>
        <li><a href="#troubleshooting-security">4. DNS Troubleshooting, Security Hardening, and Live Diagnostic Tools</a></li>
        <li><a href="#faq">Frequently Asked Questions</a></li>
      </ul>
    </nav>

    <div class="mt-12 space-y-16">
      <!-- Section 1: Overview & Table -->
      <section id="overview" class="scroll-mt-24">
        <h2 class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
          How the 4 Layers of the Domain Name System Fit Together (Architecture Overview)
        </h2>
        <p class="mt-4 text-base leading-relaxed text-ink-dim">
          Managing a production domain requires coordinating both sides of the DNS resolution boundary: the recursive resolvers (<code>1.1.1.1</code>, <code>8.8.8.8</code>, and ISP servers) that cache answers for visitors, and the authoritative nameservers that store your master zone file. Every web connection, email delivery, and TLS certificate check depends on 4 interconnected DNS subsystems. The table below maps the 4 subsystems of DNS by core infrastructure job, key protocol mechanics, and primary operational scope.
        </p>

        <div class="mt-6 overflow-x-auto">
          <table class="pdns-table border-collapse rounded-xl border border-line bg-panel/40 text-left text-sm text-ink-dim">
            <thead>
              <tr class="border-b border-line bg-panel/80 text-xs font-semibold uppercase tracking-wider text-ink">
                <th class="px-4 py-3">DNS Subsystem</th>
                <th class="px-4 py-3">Core Infrastructure Job</th>
                <th class="px-4 py-3">Key Protocol Mechanics</th>
                <th class="px-4 py-3">Operational Scope</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              <tr>
                <td class="px-4 py-3 font-medium text-ink">1. Resolution Architecture</td>
                <td class="px-4 py-3">Translates hostnames to IPs across stub, recursive, root, TLD, and authoritative servers.</td>
                <td class="px-4 py-3"><code>UDP/TCP Port 53</code>, <code>EDNS0 (4,096B)</code>, <code>DoH (Port 443)</code>, <code>DoT (Port 853)</code>, TTL caching.</td>
                <td class="px-4 py-3">Client devices, ISP recursors, and global Anycast hierarchy.</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium text-ink">2. Zone Resource Records</td>
                <td class="px-4 py-3">Stores typed routing, aliasing, mail, and verification instructions in the zone file.</td>
                <td class="px-4 py-3"><code>A</code>, <code>AAAA</code>, <code>CNAME</code>, <code>ALIAS</code>, <code>MX</code>, <code>TXT</code>, <code>NS</code>, <code>SOA</code>, <code>PTR</code>, <code>SRV</code>, <code>CAA</code>, <code>DS</code>, <code>DNSKEY</code>.</td>
                <td class="px-4 py-3">Authoritative DNS zone tables and provider control panels.</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium text-ink">3. Operations &amp; Migrations</td>
                <td class="px-4 py-3">Controls cache lifetimes, provider cutovers, zone backups, and registrar delegations.</td>
                <td class="px-4 py-3">Pre-migration <code>300s</code> TTL lowering, <code>SOA</code> serial increments, <code>172,800s</code> TLD NS caches.</td>
                <td class="px-4 py-3">Server migrations, registrar transfers, and cache flushing.</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium text-ink">4. Security &amp; Hardening</td>
                <td class="px-4 py-3">Authenticates DNS responses cryptographically and defends against hijacking and spoofing.</td>
                <td class="px-4 py-3"><code>DNSSEC</code> (<code>RRSIG</code>, <code>DNSKEY</code>, <code>DS</code>, <code>NSEC3</code>), Registrar/Registry locks, CAA allowlists.</td>
                <td class="px-4 py-3">Zone signing, parent DS delegation, and drift monitoring.</td>
              </tr>
            </tbody>
          </table>
        </div>

        <p class="mt-4 text-base leading-relaxed text-ink-dim">
          Beginners learning how domain lookups work start with <strong class="text-ink">Section 1 (Fundamentals)</strong>, administrators configuring zone files use <strong class="text-ink">Section 2 (Record Types &amp; Providers)</strong>, and engineers executing cutovers or fixing outages jump to <strong class="text-ink">Section 3 (Operations)</strong> and <strong class="text-ink">Section 4 (Troubleshooting &amp; Security)</strong>.
        </p>
      </section>

      <!-- Section 2: Fundamentals Grid -->
      <section id="fundamentals" class="scroll-mt-24">
        <h2 class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
          1. DNS Fundamentals and Resolution Mechanics (Start Here)
        </h2>
        <p class="mt-4 text-base leading-relaxed text-ink-dim">
          Five foundational guides explain what the Domain Name System is, how local operating systems and recursive resolvers trace a lookup from the root zone down, how Time to Live (TTL) timers govern caching, and how modern encrypted DNS works. Select a guide below based on the resolution layer you are investigating:
        </p>

        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {fundamentalsCards.map((card) => (
            <a
              href={card.href}
              class="group block rounded-2xl border border-line bg-panel/60 p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/40 hover:bg-panel/80"
            >
              <span class="inline-block rounded-md border border-accent/30 bg-accent/10 px-2 py-0.5 text-xs font-medium text-accent">
                {card.badge}
              </span>
              <h3 class="mt-2.5 text-base font-semibold text-ink transition-colors group-hover:text-accent">
                {card.title}
              </h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-dim">
                {card.desc}
              </p>
            </a>
          ))}
        </div>
      </section>

      <!-- Section 3: Records & Providers Grid -->
      <section id="records-providers" class="scroll-mt-24">
        <h2 class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
          2. DNS Record Types and Provider Setup Playbooks
        </h2>
        <p class="mt-4 text-base leading-relaxed text-ink-dim">
          Every routing, email, and verification rule in DNS is published as a specific resource record type inside your DNS hosting provider's zone panel. Explore the complete DNS record guides, provider-specific playbooks, and the 6 most common everyday record guides below:
        </p>

        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {recordCards.map((card) => (
            <a
              href={card.href}
              class="group block rounded-2xl border border-line bg-panel/60 p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/40 hover:bg-panel/80"
            >
              <span class="inline-block rounded-md border border-accent/30 bg-accent/10 px-2 py-0.5 text-xs font-medium text-accent">
                {card.badge}
              </span>
              <h3 class="mt-2.5 text-base font-semibold text-ink transition-colors group-hover:text-accent">
                {card.title}
              </h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-dim">
                {card.desc}
              </p>
            </a>
          ))}
        </div>
      </section>

      <!-- Section 4: Operations Grid -->
      <section id="operations" class="scroll-mt-24">
        <h2 class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
          3. DNS Operations: Propagation, Cache Flushing, and Migrations
        </h2>
        <p class="mt-4 text-base leading-relaxed text-ink-dim">
          Changing web hosts, editing IP addresses, or switching authoritative nameservers requires coordinating TTL cache timers so visitors never hit a dead server. Use these 5 operational guides to flush local caches, back up zones, and execute zero-downtime cutovers:
        </p>

        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {operationsCards.map((card) => (
            <a
              href={card.href}
              class="group block rounded-2xl border border-line bg-panel/60 p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/40 hover:bg-panel/80"
            >
              <span class="inline-block rounded-md border border-accent/30 bg-accent/10 px-2 py-0.5 text-xs font-medium text-accent">
                {card.badge}
              </span>
              <h3 class="mt-2.5 text-base font-semibold text-ink transition-colors group-hover:text-accent">
                {card.title}
              </h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-dim">
                {card.desc}
              </p>
            </a>
          ))}
        </div>
      </section>

      <!-- Section 5: Troubleshooting, Security & Tools Grid -->
      <section id="troubleshooting-security" class="scroll-mt-24">
        <h2 class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
          4. DNS Troubleshooting, Security Hardening, and Live Diagnostic Tools
        </h2>
        <p class="mt-4 text-base leading-relaxed text-ink-dim">
          Start with these 9 troubleshooting and security guides alongside our live browser-based DNS-over-HTTPS tools when a domain fails to resolve, email bounces after a nameserver switch, or you harden your zone against cache poisoning:
        </p>

        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {troubleshootingCards.map((card) => (
            <a
              href={card.href}
              class="group block rounded-2xl border border-line bg-panel/60 p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/40 hover:bg-panel/80"
            >
              <span class="inline-block rounded-md border border-accent/30 bg-accent/10 px-2 py-0.5 text-xs font-medium text-accent">
                {card.badge}
              </span>
              <h3 class="mt-2.5 text-base font-semibold text-ink transition-colors group-hover:text-accent">
                {card.title}
              </h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-dim">
                {card.desc}
              </p>
            </a>
          ))}
        </div>

        <h3 class="mt-10 text-xl font-bold text-ink">
          Live DNS Tools
        </h3>

        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {toolCards.map((card) => (
            <a
              href={card.href}
              class="group block rounded-2xl border border-line bg-panel/60 p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/40 hover:bg-panel/80"
            >
              <span class="inline-block rounded-md border border-accent/30 bg-accent/10 px-2 py-0.5 text-xs font-medium text-accent">
                {card.badge}
              </span>
              <h3 class="mt-2.5 text-base font-semibold text-ink transition-colors group-hover:text-accent">
                {card.title}
              </h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-dim">
                {card.desc}
              </p>
            </a>
          ))}
        </div>

        <p class="mt-8 text-base leading-relaxed text-ink-dim">
          Every guide and live diagnostic tool in this <strong class="text-ink">Domain Name System (DNS) reference guide</strong> works together to help you configure <strong class="text-ink">DNS record types</strong>, manage <strong class="text-ink">TTL caching and zero-downtime migrations</strong>, troubleshoot <strong class="text-ink">resolution failures</strong>, and enforce <strong class="text-ink">DNSSEC security</strong>.
        </p>
      </section>

      <!-- Section 6: FAQs -->
      <section id="faq" class="scroll-mt-24">
        <h2 class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
          Frequently Asked Questions
        </h2>
        <div class="mt-6 space-y-3">
          {faqs.map((faq) => (
            <details class="group rounded-xl border border-line bg-panel/40 p-4 transition-colors open:bg-panel/70">
              <summary class="flex cursor-pointer items-center justify-between font-medium text-ink">
                <span>{faq.q}</span>
                <span class="ml-2 text-ink-faint transition-transform group-open:rotate-180">▾</span>
              </summary>
              <div class="mt-3 text-sm leading-relaxed text-ink-dim">
                <p>{faq.a}</p>
              </div>
            </details>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
