 "rows": [
  [
   "Pricing",
   "Free records; paid plans add features",
   "~$0.50/zone/mo + per-query charges"
  ],
  [
   "Records model",
   "Flat records; proxy toggle per record",
   "Record sets; Alias records to AWS resources"
  ],
  [
   "Propagation",
   "Near-instant on edge",
   "Fast; TTL-driven caching"
  ],
  [
   "CDN/Security",
   "Bundled (CDN, WAF, bot fights)",
   "Separate products (CloudFront, WAF)"
  ],
  [
   "API/Infrastructure",
   "REST API, Terraform",
   "Deep AWS integration, IAM, health-checked failover"
  ],
  [
