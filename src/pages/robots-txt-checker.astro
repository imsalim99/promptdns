---
import BaseLayout from '../layouts/BaseLayout.astro';
import Diagram from '../components/Diagram.astro';
import ToolPanel from '../components/ToolPanel.astro';

const faqSchema = {
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
  {
   "@type": "Question",
   "name": "Is the robots.txt Checker really free?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Yes: every tool on PromptDNS is free forever, with no account, no limits, and no trial timers. The robots.txt validation runs entirely in your browser."
   }
  },
  {
   "@type": "Question",
   "name": "How accurate are the results?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "The robots.txt validation queries public DNS-over-HTTPS resolvers (Cloudflare, Google, Quad9) in real time. Results reflect what those resolvers actually serve, which is the same data the wider internet receives."
   }
  },
  {
   "@type": "Question",
   "name": "Do you store the domains I look up?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "No. Lookups happen client-side in your browser. Domains are not sent to our servers, stored, or logged. See the privacy policy for details."
   }
  },
  {
   "@type": "Question",
   "name": "Can I use this tool for client work?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Yes: the tools are free for commercial use. Agencies on the Business plan can also generate white-label automated reports."
   }
  },
  {
   "@type": "Question",
   "name": "How often should I run this check?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "After any DNS or infrastructure change, and periodically (weekly or monthly) as part of routine health monitoring. The paid plans automate this."
   }
  },
  {
   "@type": "Question",
   "name": "What if the results look wrong?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Compare with a second tool or dig from a terminal. If results differ between tools, one may be showing a cached answer: the propagation checker reveals which resolvers disagree."
   }
  }
 ]
}
---
<BaseLayout
  title="robots.txt Checker, Validate Your robots.txt"
  description="Free robots.txt checker and validator: fetch any site's robots.txt, find syntax errors and unknown directives, and preview how crawlers read it."
  schema={[faqSchema]}
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a>
       <span aria-hidden="true">/</span>
      <a href="/tools/" class="hover:text-accent">Tools</a>
       <span aria-hidden="true">/</span>
      <span class="text-ink-dim">robots.txt Checker</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">robots.txt Checker</h1>
    <p class="mt-4 text-lg text-ink-dim">Fetch any site's robots.txt, validate its syntax line by line, catch directives crawlers ignore, and see the AI-bot verdicts.</p>

    <ToolPanel>
      <form id="rt-form" class="flex flex-col gap-3 sm:flex-row">
        <label class="sr-only" for="rt-domain">Domain</label>
        <input id="rt-domain" type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder="example.com"
          class="flex-1 rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30" />
        <button type="submit" class="btn-cta btn-shimmer px-6 py-2.5 text-sm">Check robots.txt</button>
      </form>

      <div id="rt-status" class="mt-4 hidden rounded-md px-4 py-3 text-sm font-medium"></div>

      <div id="rt-issues" class="mt-4 hidden grid gap-2"></div>

      <div id="rt-ai" class="mt-4 hidden grid gap-2"></div>

      <div id="rt-raw-wrap" class="mt-6 hidden">
        <p class="mb-2 text-sm font-semibold text-ink">robots.txt content</p>
        <pre id="rt-raw" class="max-h-96 overflow-auto rounded-lg border border-line bg-panel-2 p-4 font-mono text-xs leading-relaxed text-ink-dim"></pre>
      </div>
    </ToolPanel>

    <article class="rich-text mt-14 max-w-none">
      <h2>What the validator checks</h2>
      <p>Malformed lines (no colon), unknown directives crawlers silently ignore, empty <code>Disallow:</code> values (they allow everything, usually a mistake), oversized files (some crawlers stop reading), missing Sitemap lines, and how the 12 major AI bots interpret your rules.</p>
      
      

      <h2 class="font-display mt-10 text-xl font-semibold text-ink">AI bot verdicts</h2>
      <div class="mt-3 overflow-x-auto rounded-xl border border-line bg-panel/60">
        <table class="pdns-table"><tbody><tr><td class="font-mono text-xs text-accent">GPTBot</td><td class="text-sm text-ink-dim">OpenAI training crawler</td></tr><tr><td class="font-mono text-xs text-accent">ClaudeBot</td><td class="text-sm text-ink-dim">Anthropic training + retrieval</td></tr><tr><td class="font-mono text-xs text-accent">PerplexityBot</td><td class="text-sm text-ink-dim">Perplexity answer engine</td></tr></tbody></table>
    </div>

      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Frequently asked questions</h2>
      <div class="mt-3 grid gap-3"><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Is the robots.txt Checker really free?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Yes: every tool on PromptDNS is free forever, with no account, no limits, and no trial timers. The robots.txt validation runs entirely in your browser.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">How accurate are the results?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">The robots.txt validation queries public DNS-over-HTTPS resolvers (Cloudflare, Google, Quad9) in real time. Results reflect what those resolvers actually serve, which is the same data the wider internet receives.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Do you store the domains I look up?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">No. Lookups happen client-side in your browser. Domains are not sent to our servers, stored, or logged. See the privacy policy for details.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Can I use this tool for client work?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Yes: the tools are free for commercial use. Agencies on the Business plan can also generate white-label automated reports.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">How often should I run this check?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">After any DNS or infrastructure change, and periodically (weekly or monthly) as part of routine health monitoring. The paid plans automate this.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">What if the results look wrong?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Compare with a second tool or dig from a terminal. If results differ between tools, one may be showing a cached answer: the propagation checker reveals which resolvers disagree.</p></details></div>
      <h2>Related tools</h2>
      <ul>
        <li><a href="/ai-crawler-checker/">AI Crawler Checker</a>, the AI-focused deep audit</li>
        <li><a href="/llms-txt-generator/">llms.txt Generator</a></li>
        <li><a href="/robots-txt-guide/">robots.txt: the complete guide</a></li>
      </ul>
    </article>
  </div>
</BaseLayout>

<script>
  import { fetchText, hostOf } from '../lib/proxy';
  import { parseRobots, verdictsFor, looksLikeHtml } from '../lib/robots';

  const KNOWN_FIELDS = new Set(['user-agent', 'disallow', 'allow', 'crawl-delay', 'sitemap', 'host', 'clean-param', 'cache-control', 'comment']);

  const form = document.getElementById('rt-form') as HTMLFormElement;
  const input = document.getElementById('rt-domain') as HTMLInputElement;
  const statusEl = document.getElementById('rt-status')!;
  const issuesEl = document.getElementById('rt-issues')!;
  const aiEl = document.getElementById('rt-ai')!;
  const rawWrap = document.getElementById('rt-raw-wrap')!;
  const rawEl = document.getElementById('rt-raw')!;

  const setStatus = (cls: string, text: string) => {
    statusEl.className = `mt-4 rounded-md px-4 py-3 text-sm font-medium ${cls}`;
    statusEl.textContent = text;
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const host = hostOf(input.value);
    if (!host.includes('.')) { setStatus('bg-fail/10 text-fail border border-fail/30', 'Enter a valid domain, e.g. example.com'); return; }
    [issuesEl, aiEl, rawWrap].forEach((el) => el.classList.add('hidden'));
    setStatus('bg-panel-2 text-accent border border-line', `Fetching https://${host}/robots.txt…`);

    const res = await fetchText(`https://${host}/robots.txt`);
    if (!res.ok || looksLikeHtml(res.text)) {
      setStatus('bg-warn/10 text-warn border border-warn/30', res.status === 0 ? `Could not reach ${host} — fetch blocked or proxies rate-limited; try again shortly.` : `No robots.txt found at ${host}, all crawlers are allowed by default.`);
      return;
    }
    const txt = res.text;
    rawEl.textContent = txt.length > 100000 ? txt.slice(0, 100000) + '\n… (truncated for display)' : txt;
    rawWrap.classList.remove('hidden');

    const issues: [string, 'err' | 'warn'][] = [];
    const lines = txt.split(/\r?\n/);
    lines.forEach((raw, i) => {
      const line = raw.replace(/#.*$/, '').trim();
      if (!line) return;
      const colon = line.indexOf(':');
      if (colon < 0) {
        issues.push([`Line ${i + 1}: no colon, “${line.slice(0, 50)}”. Crawlers ignore malformed lines.`, 'err']);
        return;
      }
      const field = line.slice(0, colon).trim().toLowerCase();
      const value = line.slice(colon + 1).trim();
      if (!KNOWN_FIELDS.has(field)) issues.push([`Line ${i + 1}: unknown directive “${field}:”, most crawlers ignore it.`, 'warn']);
      if ((field === 'disallow' || field === 'allow') && !value) issues.push([`Line ${i + 1}: empty ${field}: value ${field === 'disallow' ? 'allows everything (usually a mistake)' : 'does nothing'}.`, 'warn']);
    });
    const { groups, sitemaps } = parseRobots(txt);
    if (!sitemaps.length) issues.push(['No Sitemap: directive, add one so crawlers find all your pages.', 'warn']);
    if (txt.length > 500000) issues.push([`File is ${(txt.length / 1024).toFixed(0)} KB, some crawlers stop reading robots.txt after 500 KB.`, 'err']);
    if (!groups.some((g) => g.agents.includes('*'))) issues.push(['No User-agent: * group, rules may not apply to unlisted bots.', 'warn']);

    issuesEl.innerHTML = '';
    for (const [msg, kind] of issues) {
      issuesEl.insertAdjacentHTML('beforeend', `<div class="rounded-md border ${kind === 'err' ? 'border-fail/30 bg-fail/10 text-fail' : 'border-warn/30 bg-warn/10 text-warn'} px-4 py-2 text-sm">${kind === 'err' ? '✕' : '▲'} ${msg}</div>`);
    }
    if (issues.length) issuesEl.classList.remove('hidden');

    aiEl.innerHTML = '<p class="text-sm font-semibold text-ink">AI bot verdicts</p>';
    for (const v of verdictsFor(groups)) {
      const badge = v.status === 'blocked' ? '<span class="rounded bg-fail/15 px-2 py-0.5 text-xs font-semibold text-fail">BLOCKED</span>'
        : v.status === 'partial' ? '<span class="rounded bg-warn/15 px-2 py-0.5 text-xs font-semibold text-warn">PARTIAL</span>'
        : '<span class="rounded bg-pass/15 px-2 py-0.5 text-xs font-semibold text-pass">ALLOWED</span>';
      aiEl.insertAdjacentHTML('beforeend', `<div class="flex items-center justify-between rounded-lg border border-line bg-panel/60 px-4 py-2"><span class="font-mono text-xs text-ink">${v.bot.name}</span>${badge}</div>`);
    }
    aiEl.classList.remove('hidden');

    setStatus(issues.some(([, k]) => k === 'err') ? 'bg-fail/10 text-fail border border-fail/30'
      : issues.length ? 'bg-warn/10 text-warn border border-warn/30'
      : 'bg-pass/10 text-pass border border-pass/30',
      `robots.txt found (${txt.split(/\r?\n/).length} lines, ${(txt.length / 1024).toFixed(1)} KB), ${issues.length ? `${issues.length} issue${issues.length > 1 ? 's' : ''}` : 'no issues found'}.`);
  });
</script>
