---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolArticle from '../components/ToolArticle.astro';
import ToolPanel from '../components/ToolPanel.astro';
---
<BaseLayout
  title="DNS Speed Test, Which Resolver Is Fastest?"
  description="Free DNS speed test: compare Cloudflare, Google, and AliDNS response times from your network with repeated lookups and averaged latency."
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a>
       <span aria-hidden="true">/</span>
      <a href="/tools/" class="hover:text-accent">Tools</a>
       <span aria-hidden="true">/</span>
      <span class="text-ink-dim">DNS Speed Test</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">DNS Speed Test: Benchmark Public Resolvers From Your Network</h1>
    <p class="mt-4 text-lg text-ink-dim">Free DNS speed test: benchmark resolver latency across Cloudflare, Google and AliDNS with repeated lookups.</p>

    <ToolPanel>
      <form id="st-form" class="flex flex-col gap-3 sm:flex-row">
        <label class="sr-only" for="st-domain">Test domain</label>
        <input id="st-domain" type="text" inputmode="url" autocomplete="off" spellcheck="false" value="example.com"
          class="flex-1 rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30" />
        <button type="submit" class="btn-cta btn-shimmer px-6 py-2.5 text-sm">Run Speed Test</button>
      </form>

      <div id="st-status" class="mt-4 hidden rounded-md px-4 py-3 text-sm font-medium"></div>

      <p id="st-sample-note" data-vs="example" class="mt-6 text-xs text-ink-faint">
        Sample diagnostic for <code>example.com</code>. Enter your own domain above for live results.
      </p>
<div id="st-results" class="pd-results mt-6 grid gap-4" aria-live="polite"><div class="rounded-lg border border-line bg-panel/60 p-4"><div class="font-display text-2xl font-bold text-accent">12 ms</div><div class="text-xs text-ink-faint">Cloudflare, ranked fastest</div></div><div class="rounded-lg border border-line bg-panel/60 p-4"><div class="font-display text-2xl font-bold text-ink">24 ms</div><div class="text-xs text-ink-faint">Google</div></div><div class="rounded-lg border border-line bg-panel/60 p-4"><div class="font-display text-2xl font-bold text-ink">48 ms</div><div class="text-xs text-ink-faint">AliDNS</div></div></div>

      <p class="mt-4 text-xs text-ink-faint">Each resolver is queried 4 times over DNS-over-HTTPS from your browser; the chart shows the average and best latency. First queries are typically slower (cold caches).</p>
    </ToolPanel>

    <h2 class="font-display mt-10 text-xl font-semibold text-ink">Metrics the speed test measures</h2>
    <section class="not-prose my-4" aria-label="Reference table">
      <div class="glass rounded-2xl p-5 shadow-lg sm:p-7 overflow-x-auto">
        <table class="pdns-table" style="width:100%">
          <thead><tr><th>Metric</th><th>Method</th><th>Note</th></tr></thead>
          <tbody><tr><td class="font-medium text-ink">Cold latency</td><td class="text-sm text-ink-dim">Fresh query per resolver</td><td class="text-sm text-ink-dim">Cache-miss cost</td></tr><tr><td class="font-medium text-ink">Warm latency</td><td class="text-sm text-ink-dim">Repeated query</td><td class="text-sm text-ink-dim">Cached cost</td></tr><tr><td class="font-medium text-ink">Ranking</td><td class="text-sm text-ink-dim">Fastest average wins</td><td class="text-sm text-ink-dim">Results vary by your network</td></tr></tbody>
        </table>
      </div>
    </section>

    <ToolArticle slug="dns-speed-test" />
    </div>
</BaseLayout>

<script>
  import { lookup, RESOLVERS, normalizeDomain } from '../lib/doh';

  const RUNS = 4;
  const form = document.getElementById('st-form') as HTMLFormElement;
  const input = document.getElementById('st-domain') as HTMLInputElement;
  const statusEl = document.getElementById('st-status')!;
  const resultsEl = document.getElementById('st-results')!;

  const setStatus = (cls: string, text: string) => {
    statusEl.className = `mt-4 rounded-md px-4 py-3 text-sm font-medium ${cls}`;
    statusEl.textContent = text;
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const domain = normalizeDomain(input.value) || 'example.com';
    const btn = form.querySelector('button') as HTMLButtonElement;
    btn.disabled = true;
    document.getElementById('st-sample-note')?.classList.add('hidden');
    resultsEl.innerHTML = '';
    resultsEl.classList.remove('hidden');

    const avgs: { name: string; avg: number; best: number }[] = [];
    for (const resolver of RESOLVERS) {
      setStatus('bg-panel-2 text-accent border border-line', `Testing ${resolver.name} (${RUNS} queries)…`);
      const times: number[] = [];
      for (let i = 0; i < RUNS; i++) {
        const res = await lookup(domain, 'A', resolver);
        times.push(res.ms);
      }
      const avg = Math.round(times.reduce((s, t) => s + t, 0) / times.length);
      const best = Math.min(...times);
      avgs.push({ name: resolver.name, avg, best });
    }

    const slowest = Math.max(...avgs.map((a) => a.avg), 1);
    const winner = [...avgs].sort((a, b) => a.avg - b.avg)[0];

    resultsEl.innerHTML = '';
    for (const r of [...avgs].sort((a, b) => a.avg - b.avg)) {
      const pct = Math.round((r.avg / slowest) * 100);
      resultsEl.insertAdjacentHTML('beforeend', `
        <div>
          <div class="mb-1 flex items-baseline justify-between">
            <span class="text-sm font-medium text-ink">${r.name}</span>
            <span class="font-mono text-xs text-ink-dim">avg ${r.avg} ms · best ${r.best} ms</span>
          </div>
          <div class="h-3 overflow-hidden rounded-full bg-panel-2">
            <div class="h-full rounded-full bg-gradient-to-r from-accent to-violet transition-all duration-700" style="width: ${pct}%"></div>
          </div>
        </div>`);
    }
    setStatus('bg-pass/10 text-pass border border-pass/30', `Fastest from your network: ${winner.name} (avg ${winner.avg} ms).`);
    btn.disabled = false;
  });
</script>
