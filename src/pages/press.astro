---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Press & Media Kit"
  description="PromptDNS press kit: boilerplate description, logo, and media contact."
>
  <div class="mx-auto max-w-3xl px-4 py-16">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">Press</p>
    <h1 class="font-display mt-3 text-4xl font-bold tracking-tight text-ink">Press &amp; media kit</h1>

    <div class="rich-text mt-8">
      <h2>Boilerplate</h2>
      <div class="rounded-xl border border-line bg-panel/60 p-5">
        <p>
          <strong>PromptDNS</strong> (promptdns.com) provides free, browser-based tools for
          checking DNS records, email authentication (SPF, DKIM, DMARC), and AI crawler
          accessibility, alongside guides for setting up email authentication with every major
          provider. All lookups run client-side against public DNS-over-HTTPS resolvers — no
          account required, nothing stored. Continuous domain and email security monitoring is
          in development.
        </p>
      </div>

      <h2>Facts</h2>
      <ul>
        <li>Launched 2026</li>
        <li>56 free tools, 240+ guides and reference pages</li>
        <li>Static delivery on Cloudflare Pages; no lookup data collected</li>
        <li>Founder-led, independent</li>
      </ul>

      <h2>Logo</h2>
      <p>
        <a href="/favicon.svg" class="text-accent">SVG logo (favicon.svg)</a>. Use as-is on light
        or dark backgrounds; don't recolor or stretch.
      </p>

      <h2>Media contact</h2>
      <p>
        <a href="/contact/" class="text-accent">Contact form</a> — press enquiries are answered
        within 2 business days.
      </p>
    </div>
  </div>
</BaseLayout>
