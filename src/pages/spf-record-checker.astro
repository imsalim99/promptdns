---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolPanel from '../components/ToolPanel.astro';

const faqSchema = {
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
  {
   "@type": "Question",
   "name": "Is the SPF Record Checker really free?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Yes: every tool on PromptDNS is free forever, with no account, no limits, and no trial timers. The SPF validation runs entirely in your browser."
   }
  },
  {
   "@type": "Question",
   "name": "How accurate are the results?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "The SPF validation queries public DNS-over-HTTPS resolvers (Cloudflare, Google, Quad9) in real time. Results reflect what those resolvers actually serve, which is the same data the wider internet receives."
   }
  },
  {
   "@type": "Question",
   "name": "Do you store the domains I look up?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "No. Lookups happen client-side in your browser. Domains are not sent to our servers, stored, or logged. See the privacy policy for details."
   }
  },
  {
   "@type": "Question",
   "name": "Can I use this tool for client work?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Yes: the tools are free for commercial use. Agencies on the Business plan can also generate white-label automated reports."
   }
  },
  {
   "@type": "Question",
   "name": "How often should I run this check?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "After any DNS or infrastructure change, and periodically (weekly or monthly) as part of routine health monitoring. The paid plans automate this."
   }
  },
  {
   "@type": "Question",
   "name": "What if the results look wrong?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Compare with a second tool or dig from a terminal. If results differ between tools, one may be showing a cached answer: the propagation checker reveals which resolvers disagree."
   }
  }
 ]
}
---
<BaseLayout
  title="SPF Record Checker, Validate Your SPF"
  description="Free SPF record checker: validate syntax, count DNS lookups against the 10-lookup limit, and find errors that break email deliverability."
  schema={[faqSchema]}
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a>
       <span aria-hidden="true">/</span>
      <a href="/tools/" class="hover:text-accent">Tools</a>
       <span aria-hidden="true">/</span>
      <span class="text-ink-dim">SPF Record Checker</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">SPF Record Checker</h1>
    <p class="mt-4 text-lg text-ink-dim">Check any domain's SPF record: syntax validation, mechanism-by-mechanism breakdown, and the all-important 10-DNS-lookup limit.</p>

    <ToolPanel>
      <form id="spf-form" class="flex flex-col gap-3 sm:flex-row">
        <label class="sr-only" for="spf-domain">Domain</label>
        <input id="spf-domain" type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder="example.com"
          class="flex-1 rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30" />
        <button type="submit" class="btn-cta btn-shimmer px-6 py-2.5 text-sm">Check SPF</button>
      </form>

      <div id="spf-status" class="mt-4 hidden rounded-md px-4 py-3 text-sm font-medium"></div>

      <div id="spf-lookup" class="mt-4 hidden rounded-lg border border-line bg-panel/60 p-4">
        <div class="flex items-baseline justify-between">
          <span class="text-sm text-ink-dim">Top-level DNS lookup terms</span>
          <span id="spf-lookup-val" class="font-display text-3xl font-bold text-accent"></span>
        </div>
        <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-panel-2">
          <div id="spf-lookup-bar" class="h-full rounded-full bg-gradient-to-r from-accent to-violet transition-all duration-700"></div>
        </div>
        <p class="mt-2 text-xs text-ink-faint">SPF allows a maximum of 10 DNS lookup terms in evaluation. This count reflects the terms in this record only; nested <code>include:</code> domains may consume additional lookups during actual mail evaluation.</p>
      </div>

      <div id="spf-results" class="mt-6 hidden overflow-x-auto rounded-lg border border-line/60">
        <table class="pdns-table">
          <thead><tr><th>Term</th><th>Type</th><th>Explanation</th></tr></thead>
          <tbody id="spf-tbody"></tbody>
        </table>
    </div>

      <div id="spf-issues" class="mt-4 hidden grid gap-2"></div>

      <div id="spf-scope" class="mt-4 hidden rounded-lg border border-line bg-panel/40 px-4 py-3">
        <p class="text-xs leading-relaxed text-ink-faint">
          <strong class="text-ink-dim">Scope:</strong> This checker inspects the published SPF record's syntax and counts its top-level DNS lookup terms. It does not send mail, evaluate a specific sender IP, or recursively follow include chains. A "valid" result means the record's syntax is well-formed and within the top-level term count, not that every sender will pass. For sender-level verification, send a test message and inspect the <code>Authentication-Results</code> header.
        </p>
      </div>

      <div id="spf-next-steps" class="mt-4 hidden rounded-lg border border-line bg-panel/60 p-4">
        <p class="text-sm font-semibold text-ink mb-2">Next steps</p>
        <div id="spf-next-steps-content" class="grid gap-1.5 text-sm"></div>
      </div>
    </ToolPanel>

    <article class="rich-text mt-14 max-w-none">
      <h2>What this SPF checker validates</h2>
      <p>It fetches your domain's TXT records over DNS-over-HTTPS and parses the <code>v=spf1</code> record term by term: every <code>include:</code>, <code>a</code>, <code>mx</code>, and <code>redirect=</code> counts toward the 10-DNS-lookup limit, the single most common way SPF breaks.</p>
      <h2>Common problems it finds</h2>
      <ul>
        <li>More than 10 DNS lookups (permerror, receivers ignore your SPF)</li>
        <li>Missing or weak <code>all</code> qualifier (<code>~all</code> vs <code>-all</code>)</li>
        <li>Deprecated <code>ptr</code> mechanisms and unknown syntax</li>
      </ul>
      
      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Frequently asked questions</h2>
      <div class="mt-3 grid gap-3"><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Is the SPF Record Checker really free?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Yes: every tool on PromptDNS is free forever, with no account, no limits, and no trial timers. The SPF validation runs entirely in your browser.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">How accurate are the results?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">The SPF validation queries public DNS-over-HTTPS resolvers (Cloudflare, Google, Quad9) in real time. Results reflect what those resolvers actually serve, which is the same data the wider internet receives.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Do you store the domains I look up?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">No. Lookups happen client-side in your browser. Domains are not sent to our servers, stored, or logged. See the privacy policy for details.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Can I use this tool for client work?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Yes: the tools are free for commercial use. Agencies on the Business plan can also generate white-label automated reports.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">How often should I run this check?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">After any DNS or infrastructure change, and periodically (weekly or monthly) as part of routine health monitoring. The paid plans automate this.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">What if the results look wrong?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Compare with a second tool or dig from a terminal. If results differ between tools, one may be showing a cached answer: the propagation checker reveals which resolvers disagree.</p></details></div>
<h2>Related tools</h2>
      <ul>
        <li><a href="/spf-flattener/">SPF Flattener</a>, fix the 10-lookup limit automatically</li>
        <li><a href="/dmarc-record-checker/">DMARC Record Checker</a></li>
        <li><a href="/dkim-record-checker/">DKIM Record Checker</a></li>
        <li><a href="/spf-record/">SPF records explained</a> (guide)</li>
      </ul>
    </article>
  </div>
</BaseLayout>

<script>
  import { fetchSpf, parseSpf } from '../lib/spf';
  import { normalizeDomain } from '../lib/doh';

  const form = document.getElementById('spf-form') as HTMLFormElement;
  const input = document.getElementById('spf-domain') as HTMLInputElement;
  const statusEl = document.getElementById('spf-status')!;
  const lookupBox = document.getElementById('spf-lookup')!;
  const lookupVal = document.getElementById('spf-lookup-val')!;
  const lookupBar = document.getElementById('spf-lookup-bar')!;
  const resultsEl = document.getElementById('spf-results')!;
  const tbody = document.getElementById('spf-tbody')!;
  const issuesEl = document.getElementById('spf-issues')!;
  const scopeEl = document.getElementById('spf-scope')!;
  const nextStepsEl = document.getElementById('spf-next-steps')!;
  const nextStepsContent = document.getElementById('spf-next-steps-content')!;

  const setStatus = (cls: string, text: string) => {
    statusEl.className = `mt-4 rounded-md px-4 py-3 text-sm font-medium ${cls}`;
    statusEl.textContent = text;
  };

  const setNextSteps = (steps: string[]) => {
    nextStepsContent.innerHTML = '';
    for (const s of steps) {
      const li = document.createElement('div');
      li.textContent = s;
      li.className = 'text-sm text-ink-dim';
      nextStepsContent.appendChild(li);
    }
    nextStepsEl.classList.remove('hidden');
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const domain = normalizeDomain(input.value);
    if (!domain.includes('.')) { setStatus('bg-fail/10 text-fail border border-fail/30', 'Enter a valid domain, e.g. example.com'); return; }
    setStatus('bg-panel-2 text-accent border border-line', `Fetching TXT records for ${domain}…`);
    [lookupBox, resultsEl, issuesEl, scopeEl, nextStepsEl].forEach((el) => el.classList.add('hidden'));
    tbody.innerHTML = '';

    let fetchResult: { found: boolean; record: string; txtCount: number };
    try {
      fetchResult = await fetchSpf(domain);
    } catch {
      setStatus('bg-warn/10 text-warn border border-warn/30',
        `Could not reach the DNS resolver for ${domain}. This is an inconclusive result — not a pass or fail. Check your connection and retry.`);
      setNextSteps([
        'Retry the check (transient network issues are common).',
        'Verify the domain exists: try the DNS Record Lookup tool with type A.',
      ]);
      return;
    }

    const { found, record, txtCount } = fetchResult;

    if (!found) {
      setStatus('bg-warn/10 text-warn border border-warn/30',
        txtCount === 0
          ? `No TXT records returned for ${domain}. This is inconclusive: the domain may not publish SPF, or the DNS query may not have completed.`
          : `No SPF record found on ${domain} (TXT records exist, but none start with v=spf1).`);
      if (txtCount === 0) {
        setNextSteps([
          'Verify the domain has any DNS records: use the DNS Record Lookup tool.',
          'If the domain sends email, publish a v=spf1 TXT record.',
        ]);
      } else {
        setNextSteps([
          'If this domain sends email, publish a v=spf1 TXT record.',
          'If it does not send email, no SPF is needed.',
        ]);
      }
      return;
    }

    // RFC 7208: multiple v=spf1 records is an error, but this tool only parses the first one
    if (txtCount > 1) {
      const multi = document.createElement('div');
      multi.className = 'rounded-md border border-warn/30 bg-warn/10 px-4 py-2 text-sm text-warn';
      multi.textContent = `▲ ${txtCount} v=spf1 records found. RFC 7208 requires exactly one; multiple records cause evaluation to fail. This tool parsed the first record only.`;
      issuesEl.appendChild(multi);
      issuesEl.classList.remove('hidden');
    }

    const parse = parseSpf(record);

    // State-aware status
    const overLimit = parse.lookupCount > 10;
    const nearLimit = parse.lookupCount > 8 && parse.lookupCount <= 10;
    const hasErrors = parse.errors.length > 0;

    if (hasErrors || overLimit) {
      setStatus('bg-fail/10 text-fail border border-fail/30',
        overLimit
          ? `SPF record has ${parse.lookupCount} top-level DNS lookup terms (evaluation limit is 10). This exceeds the limit before counting nested includes — receivers will stop evaluating the policy at the 10th lookup term.`
          : 'SPF record found — with errors that must be fixed.');
    } else if (parse.warnings.length > 0) {
      setStatus('bg-warn/10 text-warn border border-warn/30',
        nearLimit
          ? `SPF record is syntactically valid but uses ${parse.lookupCount}/10 top-level lookup terms — close to the limit.`
          : 'SPF record is syntactically valid, with warnings.');
    } else {
      setStatus('bg-pass/10 text-pass border border-pass/30',
        'SPF record found and syntactically valid.');
    }

    // Lookup meter
    lookupBox.classList.remove('hidden');
    lookupVal.textContent = `${parse.lookupCount}/10`;
    lookupBar.style.width = `${Math.min(100, parse.lookupCount * 10)}%`;
    lookupBar.className = `h-full rounded-full transition-all duration-700 ${overLimit ? 'bg-fail' : nearLimit ? 'bg-warn' : 'bg-gradient-to-r from-accent to-violet'}`;

    // Term table (escaped)
    tbody.innerHTML = `<tr><td colspan="3"><code>${record.replace(/</g, '&lt;')}</code></td></tr>`;
    for (const t of parse.terms) {
      const td = document.createElement('td');
      td.className = 'font-mono text-xs ' + (t.countsLookup ? 'text-warn' : 'text-accent');
      td.textContent = t.term;
      const tr = document.createElement('tr');
      tr.appendChild(td);
      const td2 = document.createElement('td');
      td2.className = 'text-ink-dim';
      td2.textContent = t.kind;
      tr.appendChild(td2);
      const td3 = document.createElement('td');
      td3.className = 'text-ink-dim';
      td3.textContent = t.note;
      tr.appendChild(td3);
      tbody.appendChild(tr);
    }
    resultsEl.classList.remove('hidden');

    // Issues
    issuesEl.innerHTML = '';
    for (const err of parse.errors) {
      const d = document.createElement('div');
      d.className = 'rounded-md border border-fail/30 bg-fail/10 px-4 py-2 text-sm text-fail';
      d.textContent = '✕ ' + err;
      issuesEl.appendChild(d);
    }
    for (const w of parse.warnings) {
      const d = document.createElement('div');
      d.className = 'rounded-md border border-warn/30 bg-warn/10 px-4 py-2 text-sm text-warn';
      d.textContent = '▲ ' + w;
      issuesEl.appendChild(d);
    }
    if (parse.errors.length || parse.warnings.length) issuesEl.classList.remove('hidden');

    // Scope note
    scopeEl.classList.remove('hidden');

    // State-aware next steps
    if (overLimit) {
      setNextSteps([
        'Review each include: mechanism — is every listed sender still needed?',
        'Remove any include: entries for services you no longer use.',
        'Check your email provider\u2019s current SPF guidance (they may have changed their records).',
        'Retest after removing obsolete entries.',
        'Do not flatten automatically — flattening replaces includes with IPs that can become stale if the provider changes their infrastructure.',
      ]);
    } else if (nearLimit) {
      setNextSteps([
        'Review each include: mechanism — remove any you no longer need.',
        'Monitor this record for changes that could push it over the limit.',
        'Retest after any DNS change.',
      ]);
    } else if (hasErrors) {
      setNextSteps([
        'Fix the unrecognized terms listed above (check for typos in mechanism names).',
        'Retest after publishing the corrected record.',
      ]);
    } else if (parse.warnings.length > 0) {
      setNextSteps([
        'Review the warnings above — they indicate potential issues but not broken SPF.',
        'Retest after any changes.',
      ]);
    } else {
      setNextSteps([
        'This record is syntactically valid. To verify actual sender authorization, send a test message and check the Authentication-Results header.',
        'Retest after any DNS or email infrastructure change.',
      ]);
    }
  });
</script>
