  mainEntity: [
    {
      '@type': 'Question',
      name: 'Do I need both SPF and DKIM to set up DMARC?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Technically DMARC evaluates if at least one protocol (SPF or DKIM) is published and aligned, but deploying both SPF and DKIM is required by Gmail, Yahoo, and Microsoft bulk-sender mandates and prevents forwarded emails from failing DMARC.',
      },
    },
    {
      '@type': 'Question',
      name: 'Will publishing DMARC at p=none block any of my legitimate emails?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No, p=none is a monitoring-only policy that instructs receiving mail servers to deliver failing messages normally while sending daily XML aggregate reports to your rua= address so you can audit senders safely.',
      },
    },
    {
      '@type': 'Question',
      name: 'Where does a DMARC record live in DNS?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A DMARC record is published as a DNS TXT resource record (Type 16) at the subdomain host _dmarc.<yourdomain> (for example, _dmarc.example.com), including the mandatory leading underscore.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does DMARC stop all phishing and display-name spoofing?',
      acceptedAnswer: {
        '@type': 'Answer',
