---
import BaseLayout from '../layouts/BaseLayout.astro';
const faqSchema = {
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
  {
   "@type": "Question",
   "name": "Does this site use TLS?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Yes: promptdns.com is served over HTTPS with automated certificates, like every modern site should be."
   }
  },
  {
   "@type": "Question",
   "name": "SSL vs TLS in one line?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Same family: SSL is the retired name, TLS 1.2/1.3 is the living protocol."
   }
  }
 ]
}
---
<BaseLayout
  title="SSL/TLS and Web Security Basics | PromptDNS"
  description="SSL/TLS hub: certificates, HTTPS, encryption basics, and the guides that secure your connection from browser to server."
  schema={[faqSchema]}
>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a> <span aria-hidden="true">/</span>
      <span class="text-ink-dim">SSL/TLS and Web Security Basics</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">SSL/TLS and Web Security Basics</h1>
    <p class="mt-5 text-lg leading-relaxed text-ink-dim">TLS is the encryption and authentication layer that turns HTTP into HTTPS. This hub collects everything a webmaster needs: what certificates are, how encryption works, and the configurations that keep connections trusted.</p>
    <div class="rich-text mt-8">
      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Core guides</h2>
      <ul class="list-disc space-y-1.5 pl-5"><li class="leading-relaxed"><a href="/what-is-ssl-tls/">What is SSL/TLS?</a> — the protocol and the handshake</li><li class="leading-relaxed"><a href="/certificate-authorities-explained/">Certificate authorities</a> — who vouches for certificates</li><li class="leading-relaxed"><a href="/https-vs-dnssec/">HTTPS vs DNSSEC</a> — encryption vs DNS authentication</li></ul>
      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Practical setup</h2>
      <ul class="list-disc space-y-1.5 pl-5"><li class="leading-relaxed"><a href="/free-ssl-lets-encrypt/">Free certificates with Let’s Encrypt</a> — automated via ACME</li><li class="leading-relaxed"><a href="/tls-versions-explained/">TLS versions explained</a> — 1.0 through 1.3</li><li class="leading-relaxed"><a href="/ssl-certificate-errors/">Certificate errors fixed</a> — every common cause</li><li class="leading-relaxed"><a href="/mixed-content-fix/">Mixed content fixes</a> — when HTTPS pages load HTTP resources</li><li class="leading-relaxed"><a href="/hsts-explained/">HSTS explained</a> — forcing HTTPS permanently</li></ul>
      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Verify</h2>
      <ul class="list-disc space-y-1.5 pl-5"><li class="leading-relaxed"><a href="/dns-record-lookup/">CAA record lookup</a> — restrict who may issue your certificates</li><li class="leading-relaxed"><a href="/ai-readiness-checker/">Security scanner</a> — TLS alongside DNS and auth checks</li></ul>
      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Frequently asked questions</h2>
      <div class="mt-3 grid gap-3"><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Does this site use TLS?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Yes: promptdns.com is served over HTTPS with automated certificates, like every modern site should be.</p></details><details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">SSL vs TLS in one line?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-relaxed text-ink-dim">Same family: SSL is the retired name, TLS 1.2/1.3 is the living protocol.</p></details></div>
      <h2 class="font-display mt-10 text-xl font-semibold text-ink">Related</h2>
      <ul class="mt-3 grid gap-2"><li><a href="/what-is-dnssec/" class="text-accent hover:text-accent-soft">DNSSEC guide →</a></li><li><a href="/email-authentication/" class="text-accent hover:text-accent-soft">Email authentication hub →</a></li></ul>
    </div>
  </div>
</BaseLayout>
