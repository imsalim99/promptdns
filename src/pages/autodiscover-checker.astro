---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolArticle from '../components/ToolArticle.astro';
import ToolPanel from '../components/ToolPanel.astro';
---
<BaseLayout title="Autodiscover / Autoconfig Checker" description="Free autodiscover checker: verify the DNS records mail clients use to auto-configure (autodiscover CNAME, autoconfig, MX).">
  <div class="mx-auto max-w-4xl px-4 py-12">
        <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a>
       <span aria-hidden="true">/</span>
      <a href="/tools/" class="hover:text-accent">Tools</a>
       <span aria-hidden="true">/</span>
      <span class="text-ink-dim">Autodiscover / Autoconfig Checker</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">Autodiscover Checker: Verify Outlook Autoconfiguration</h1>
    <p class="mt-4 text-lg text-ink-dim">Check the DNS records mail clients probe for automatic setup: autodiscover CNAME, autoconfig subdomain, and the SRV fallback.</p>
    <div class="mt-8">
<ToolPanel>
  <form id="ad-form" class="flex flex-col gap-3 sm:flex-row">
    <input id="ad-domain" type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder="example.com" class="flex-1 rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none" />
    <button type="submit" class="btn-cta btn-shimmer px-6 py-2.5 text-sm">Check Autodiscover</button>
  </form>
  <div id="ad-status" class="mt-4 hidden rounded-md px-4 py-3 text-sm font-medium"></div>
  <div id="ad-results" class="mt-6 hidden overflow-x-auto rounded-lg border border-line/60">
    <table class="pdns-table"><thead><tr><th>Record</th><th>Result</th></tr></thead><tbody id="ad-tbody"></tbody></table>
  </div>
</ToolPanel>

    <ToolArticle slug="autodiscover-checker" />
    </div>
</div>
</BaseLayout>
<script>
  import { lookup, RESOLVERS, normalizeDomain } from '../lib/doh';
  const form = document.getElementById('ad-form') as HTMLFormElement;
  const input = document.getElementById('ad-domain') as HTMLInputElement;
  const statusEl = document.getElementById('ad-status')!;
  const resultsEl = document.getElementById('ad-results')!;
  const tbody = document.getElementById('ad-tbody')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const domain = normalizeDomain(input.value);
    if (!domain.includes('.')) { statusEl.textContent = 'Enter a valid domain.'; return; }
    statusEl.textContent = `Checking autodiscover for ${domain}…`; statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-panel-2 text-accent border border-line'; statusEl.classList.remove('hidden');
    const checks: [string, string][] = [];
    const [ad, ac, srv, mx] = await Promise.all([
      lookup(`autodiscover.${domain}`, 'CNAME', RESOLVERS[0]),
      lookup(`autoconfig.${domain}`, 'CNAME', RESOLVERS[0]),
      lookup(`_autodiscover._tcp.${domain}`, 'SRV', RESOLVERS[0]),
      lookup(domain, 'MX', RESOLVERS[0]),
    ]);
    checks.push(['autodiscover CNAME', ad.answers.find(a => a.type === 5)?.data ?? (ad.status === 3 ? 'NXDOMAIN' : 'none')]);
    checks.push(['autoconfig CNAME', ac.answers.find(a => a.type === 5)?.data ?? (ac.status === 3 ? 'NXDOMAIN' : 'none')]);
    checks.push(['_autodiscover._tcp SRV', srv.answers.find(a => a.type === 33)?.data ?? 'none']);
    checks.push(['MX (fallback hint)', mx.answers.find(a => a.type === 15)?.data ?? 'none']);
    tbody.innerHTML = '';
    for (const [k, v] of checks) {
      const found = v !== 'NXDOMAIN' && v !== 'none';
      tbody.insertAdjacentHTML('beforeend', `<tr><td class="font-mono text-xs text-accent">${k}</td><td class="font-mono text-xs ${found ? 'text-ink' : 'text-ink-faint'}">${v}</td></tr>`);
    }
    statusEl.textContent = 'Autodiscover check complete. Missing records mean clients fall back to manual setup or SRV.';
    statusEl.className = 'mt-4 rounded-md px-4 py-3 text-sm font-medium bg-pass/10 text-pass border border-pass/30';
    resultsEl.classList.remove('hidden');
  });
</script>
