---
import BaseLayout from '../layouts/BaseLayout.astro';

const faq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I tell if I have a dynamic or static IP?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "On Windows, open Command Prompt and run ipconfig /all: if DHCP Enabled says Yes under your active adapter, your IP is dynamic. On macOS, System Settings > Network > TCP/IP shows 'Using DHCP' for dynamic addresses. On Linux, ip a displays the word 'dynamic' with a lease countdown. For your public WAN IP, check your router's status page or compare your IP before and after a router restart: if it changes, your ISP assigns dynamic addresses."
      }
    },
    {
      "@type": "Question",
      "name": "Is 192.168 a static IP?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No, 192.168.x.x is not automatically a static IP; it is a private local network (LAN) IP range defined in RFC 1918. Your Wi-Fi router assigns 192.168.x.x addresses to devices inside your home, and that assignment can be dynamic (DHCP lease) or static (a DHCP reservation pinning a specific IP to a device MAC address). This is entirely separate from whether your ISP gives your router a static or dynamic public WAN IP."
      }
    },
    {
      "@type": "Question",
      "name": "Is DHCP the same as a dynamic IP?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, in everyday networking a dynamic IP address is an IP address assigned automatically by a DHCP (Dynamic Host Configuration Protocol, RFC 2131) server for a temporary lease period. The one edge case is a DHCP reservation (also called a static lease), where the DHCP server always assigns the exact same IP to a specific MAC address: the mechanism is still DHCP, but the outcome mimics a static assignment."
      }
    },
    {
      "@type": "Question",
      "name": "Why does an outbound email server need a static IP with matching PTR?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Receiving mail gateways perform reverse DNS lookups on every connecting IP: if the PTR hostname does not resolve back to the connecting IP (FCrDNS), or if the IP sits on a known dynamic range listed in the Spamhaus PBL, the message is rejected or spam-foldered. A static IP lets you publish a custom PTR record matching your mail server hostname and avoids the PBL listing that dynamic ranges carry."
      }
    },
    {
      "@type": "Question",
      "name": "What is Dynamic DNS (DDNS) and when do I need it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Dynamic DNS (DDNS) is a service that automatically updates a domain name's DNS A record whenever your ISP assigns a new dynamic public IP. A background client on your router or server detects the change and pushes the new address to the DDNS provider via API. Use DDNS when you need to reach a home lab, NAS, or self-hosted service behind a dynamic ISP IP but do not want to pay for a static IP or business line."
      }
    }
  ]
};
---
<BaseLayout
  title="Static vs Dynamic IP Address: Key Differences, How to Check Yours, and Which You Need"
  description="Static vs dynamic IP explained: key differences, how DHCP leases work, how to check your IP on Windows, Mac, and Linux, and whether you need a static IP."
  schema={[faq]}
  breadcrumb={[["Home", "/"], ["IP & Networking", "/ip-and-networking/"], ["Static vs Dynamic IP"]]}
>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/ip-and-networking/" class="hover:text-accent">IP & Networking</a>
      <span aria-hidden="true">/</span>
      <span class="text-ink-dim">Static vs Dynamic IP</span>
    </nav>

    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">Static vs Dynamic IP Address: Key Differences, How to Check Yours, and Which You Need</h1>

    <div class="pd-answer" data-vs="answer">
      <p class="text-lg leading-relaxed text-ink-dim">
        Use a static IP address when hosting inbound services (an SMTP mail server requiring PTR/FCrDNS alignment, an authoritative DNS nameserver, a site-to-site IPsec VPN, or an enterprise firewall allowlist); use a dynamic IP address when connecting standard home or office client devices, or when hosting self-managed services behind Dynamic DNS (DDNS) or a Cloudflare Tunnel.
      </p>
    </div>

    <nav class="pd-toc" aria-label="On this page">
      <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent">On this page</p>
      <ul>
        <li><a href="#static-ip-vs-dynamic-ip-side-by-side-comparison-table">Static vs dynamic IP comparison table</a></li>
        <li><a href="#how-do-you-check-if-your-ip-address-is-static-or-dynamic-windows-mac-linux-and-public-wan">How to check if your IP is static or dynamic</a></li>
        <li><a href="#what-is-a-static-ip-address-and-how-does-it-work-advantages-and-trade-offs">What is a static IP (advantages &amp; trade-offs)</a></li>
        <li><a href="#what-is-a-dynamic-ip-address-and-how-does-dhcp-work-is-dhcp-the-same-as-dynamic-ip">What is a dynamic IP &amp; how DHCP works</a></li>
        <li><a href="#why-do-dns-records-web-servers-and-email-servers-need-a-static-ip">Why DNS &amp; email servers need static IPs</a></li>
        <li><a href="#when-should-you-use-a-static-ip-vs-a-dynamic-ip-business-and-home-decision-matrix">When to use static vs dynamic IP (decision matrix)</a></li>
        <li><a href="#frequently-asked-questions">Frequently asked questions</a></li>
      </ul>
    </nav>

    <div class="rich-text mt-8">
      <h2 id="static-ip-vs-dynamic-ip-side-by-side-comparison-table">Static IP vs Dynamic IP: Side-by-Side Comparison Table</h2>
      <p>
        A static IP address differs from a dynamic IP address across <strong class="text-ink">8 dimensions: assignment method, permanence, ISP cost, DNS compatibility, email deliverability, remote access, maintenance, and target audience</strong>. The table below compares both types side by side.
      </p>

      <section class="not-prose my-4" aria-label="Reference table">
        <div class="glass rounded-2xl p-5 shadow-lg sm:p-7 overflow-x-auto">
          <table class="pdns-table" style="width:100%">
            <thead><tr><th>Feature / Dimension</th><th>Static IP Address</th><th>Dynamic IP Address</th></tr></thead>
            <tbody>
              <tr><td class="font-medium text-ink">Assignment Method</td><td class="text-sm text-ink-dim">Configured manually or pinned via static ISP allocation</td><td class="text-sm text-ink-dim">Assigned automatically by a <abbr class="pd-term" data-tip="Dynamic Host Configuration Protocol (DHCP): a network management protocol that automatically assigns IP addresses and network parameters to client devices">DHCP</abbr> server</td></tr>
              <tr><td class="font-medium text-ink">Does the Address Change?</td><td class="text-sm font-semibold text-emerald-400">Never changes (Fixed permanently)</td><td class="text-sm font-semibold text-accent">Changes periodically (Upon lease expiration)</td></tr>
              <tr><td class="font-medium text-ink">ISP Cost</td><td class="text-sm text-ink-dim">Paid add-on ($5 to $30/month)</td><td class="text-sm text-ink-dim">Included free on residential internet plans</td></tr>
              <tr><td class="font-medium text-ink">DNS A / AAAA Hosting</td><td class="text-sm font-semibold text-emerald-400">Ideal (DNS records point permanently to the IP)</td><td class="text-sm font-semibold text-rose-400">Poor (Requires Dynamic DNS software to update records)</td></tr>
              <tr><td class="font-medium text-ink">Reverse DNS (PTR) &amp; Email</td><td class="text-sm font-semibold text-emerald-400">Supports custom PTR records for outbound mail servers</td><td class="text-sm font-semibold text-rose-400">Blocked by Spamhaus PBL without custom PTR support</td></tr>
              <tr><td class="font-medium text-ink">VPNs &amp; IP Allowlisting</td><td class="text-sm font-semibold text-emerald-400">Supports site-to-site VPNs and firewall allowlists</td><td class="text-sm font-semibold text-rose-400">Breaks firewall allowlists when the ISP rotates the address</td></tr>
              <tr><td class="font-medium text-ink">Configuration Effort</td><td class="text-sm text-ink-dim">Requires manual IP and gateway tracking</td><td class="text-sm text-ink-dim">Zero manual setup (Automated network configuration)</td></tr>
              <tr><td class="font-medium text-ink">Best For</td><td class="text-sm text-ink-dim">Web servers, mail servers, and VPN gateways</td><td class="text-sm text-ink-dim">Web browsing, streaming, gaming, and mobile devices</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <p>
        Address assignment applies to public and private network boundaries. The division between <a href="/public-vs-private-ip/">Public vs Private IP Addresses</a> and <a href="/nat-explained/">NAT Explained</a> shows that home networks run dynamic public IPs on the <abbr class="pd-term" data-tip="Wide Area Network (WAN): the external telecommunications network connecting a local router to the broader internet">WAN</abbr> interface while issuing private IPs across the local <abbr class="pd-term" data-tip="Local Area Network (LAN): a private computer network interconnecting devices within a limited physical area like a home or office">LAN</abbr>, using static DHCP reservations for local printers and storage servers.
      </p>

      <h2 id="how-do-you-check-if-your-ip-address-is-static-or-dynamic-windows-mac-linux-and-public-wan">How Do You Check If Your IP Address Is Static or Dynamic? (Windows, Mac, Linux, and Public WAN)</h2>
      <p>
        To check whether your IP address is static or dynamic, inspect <strong class="text-ink">DHCP status for local private IPs, and check router WAN settings or reverse DNS for public IPs</strong> across <strong class="text-ink">4 methods</strong>.
      </p>
      <p>
        Verifying IP permanence proceeds through these 4 steps:
      </p>
      <ol>
        <li><strong>Check Your Local IP on Windows 10 and 11 (<code>ipconfig /all</code>):</strong> Open Command Prompt, run <code>ipconfig /all</code>, and examine <code>DHCP Enabled</code> under your active network adapter:
          <pre class="my-2 rounded-lg border border-line bg-panel-2 p-3 font-mono text-xs text-accent-soft"><code>C:\> ipconfig /all
Wireless LAN adapter Wi-Fi:
   DHCP Enabled. . . . . . . . . . . : Yes    <-- Dynamic IP (Assigned by DHCP)
   IPv4 Address. . . . . . . . . . . : 192.168.1.42(Preferred)
   Lease Obtained. . . . . . . . . . : Thursday, October 29, 2026 9:00:00 AM
   Lease Expires . . . . . . . . . . : Friday, October 30, 2026 9:00:00 AM</code></pre>
          <code>DHCP Enabled: Yes</code> indicates a dynamic address, whereas <code>DHCP Enabled: No</code> confirms a static IP.
        </li>
        <li><strong>Check Your Local IP on macOS (System Settings or Terminal):</strong> Open System Settings, navigate to Network, select your active adapter, choose Details, and view TCP/IP. Setting Using DHCP confirms a dynamic address, whereas Manually indicates static. Running <code>ipconfig getpacket en0</code> in Terminal outputs active lease data.</li>
        <li><strong>Check Your Local IP on Linux (<code>ip a</code> or <code>nmcli</code>):</strong> Run <code>ip a</code> in your terminal. Dynamic interfaces display the word <code>dynamic</code> alongside a <code>valid_lft</code> countdown, whereas static interfaces omit the tag and display <code>valid_lft forever</code>.</li>
        <li><strong>Check Whether Your Public ISP IP Address Is Static or Dynamic:</strong> Open <a href="/my-ip/">What Is My IP Address</a> to identify your public IP, then enter it into <a href="/ip-lookup/">IP Lookup</a> to inspect reverse DNS hostnames. Residential dynamic IPs contain tokens like <code>dhcp</code>, <code>dyn</code>, or <code>pool</code> in their hostname. Checking router WAN settings confirms Dynamic IP (DHCP) or Static IP.</li>
      </ol>
      <p>
        Residential internet accounts operate under dynamic addressing defaults. Unless an account holder pays an ongoing fee for a commercial allocation, internet providers assign dynamic public IP addresses to consumer accounts.
      </p>

      <div id="sd-widget" class="my-6 rounded-xl border border-accent/30 bg-accent/5 p-5">
        <p class="text-sm font-semibold text-ink">Is My Public IP Static or Dynamic? (Live Check)</p>
        <div id="sd-widget-status" class="mt-2 text-sm text-ink-dim">Detecting your public IP...</div>
        <div id="sd-widget-detail" class="mt-2 hidden text-sm text-ink-dim"></div>
        <div id="sd-widget-compare" class="mt-2 hidden text-sm text-ink-dim"></div>
        <button type="button" id="sd-snapshot-btn" class="mt-3 hidden rounded-md border border-accent/40 px-3 py-1.5 text-xs font-medium text-accent hover:bg-accent/10">Save / Reset IP Snapshot</button>
      </div>

      <h2 id="what-is-a-static-ip-address-and-how-does-it-work-advantages-and-trade-offs">What Is a Static IP Address and How Does It Work? (Advantages and Trade-Offs)</h2>
      <p>
        A static IP address is <strong class="text-ink">a fixed address permanently assigned to a server, router, or interface</strong>, providing <strong class="text-ink">4 infrastructure advantages alongside 1 operational trade-off</strong>.
      </p>
      <p>
        Production network deployments leverage these core static IP capabilities:
      </p>
      <ol>
        <li><strong>Reliable DNS Resolution Without Stale Cache Failures:</strong> Pointing an <a href="/a-record/">A Record</a> to a static IP ensures recursive resolvers cache the authentic server location without routing visitors to disconnected addresses.</li>
        <li><strong>Custom Reverse DNS (PTR) for Email Deliverability:</strong> Mail servers require a matching <abbr class="pd-term" data-tip="Pointer (PTR) Record: a DNS resource record used for reverse DNS lookups, mapping an IP address back to its associated domain name"><a href="/ptr-record/">PTR Record</a></abbr> to establish sender authenticity. Internet providers permit custom PTR records exclusively on commercial static IP allocations.</li>
        <li><strong>Permanent IP Allowlisting for Firewalls, SSH, and Databases:</strong> Corporate cloud environments and payment processors restrict access to recognized IP addresses. A static IP prevents administrator lockouts across secure firewall perimeters.</li>
        <li><strong>Stable Site-to-Site VPNs and SSL/TLS Endpoints:</strong> Hardware IPsec tunnels connecting branch offices require fixed gateway endpoints that remain permanent across device reboots.</li>
        <li><strong>Higher Monthly Cost and Manual Address Tracking (Trade-Off):</strong> Internet providers charge recurring fees for scarce IPv4 allocations, requiring administrators to document manual assignments to prevent IP conflicts.</li>
      </ol>
      <p>
        Local networks balance convenience and stability through static DHCP reservations. Routers bind a device's physical MAC address to an assigned local IP, delivering permanent private addressing without manual on-device configuration.
      </p>

      <h2 id="what-is-a-dynamic-ip-address-and-how-does-dhcp-work-is-dhcp-the-same-as-dynamic-ip">What Is a Dynamic IP Address and How Does DHCP Work? (Is DHCP the Same as Dynamic IP?)</h2>
      <p>
        A dynamic IP address is <strong class="text-ink">a temporary IP address leased to a device from a shared pool of available addresses</strong>, while <strong class="text-ink">DHCP (Dynamic Host Configuration Protocol) is the automated network protocol that assigns and renews that dynamic IP across 4 handshake steps (DORA)</strong>.
      </p>
      <p>
        This distinction resolves a common question: DHCP represents the delivery protocol, whereas a dynamic IP represents the leased address output.
      </p>
      <p>
        Automated address assignment executes through the 4-step DHCP DORA sequence:
      </p>
      <ol>
        <li><strong>Discover:</strong> The connecting device broadcasts a DHCP Discover packet across the local network segment to locate active configuration servers.</li>
        <li><strong>Offer:</strong> The DHCP server transmits a DHCP Offer packet containing an available IP address, subnet mask, gateway, DNS servers, and an assigned <abbr class="pd-term" data-tip="DHCP Lease: the specific time duration for which a network device holds permission to use an assigned dynamic IP address">DHCP lease</abbr> duration.</li>
        <li><strong>Request:</strong> The client device broadcasts a DHCP Request packet formally accepting the offered network parameters.</li>
        <li><strong>Acknowledge:</strong> The DHCP server sends a DHCP Acknowledge (ACK) packet committing the lease to its database and enabling network communication.</li>
      </ol>
      <p>
        Lease renewal timers prevent most disruptions: clients request renewal at the T1 threshold (50 percent of lease duration) and again at T2 (87.5 percent) if the first attempt fails. Many broadband providers place residential users behind <abbr class="pd-term" data-tip="Carrier-Grade NAT (CGNAT): large-scale network address translation where an ISP shares a single public IPv4 address across hundreds of subscriber homes">CGNAT</abbr> (Carrier-Grade NAT, RFC 6598 shared address space 100.64.0.0/10), sharing a single public address across multiple customer households.
      </p>
      <p>
        Sticky dynamic IPs are common: a residential DHCP lease often renews the same address for weeks as long as the modem stays powered on, because the router's DHCP client requests renewal before the lease expires and ISPs typically honor the request with the same address. Only a power-off past the lease expiry (or a MAC address change) forces the ISP to assign a different IP.
      </p>

      <h2 id="private-vs-public-ip-disambiguation">Private (192.168.x.x) vs Public IP: Two Different Scopes</h2>
      <p>
        The addresses <code>192.168.x.x</code>, <code>10.x.x.x</code>, and <code>172.16.0.0/12</code> are <strong>private LAN addresses (RFC 1918)</strong> assigned inside your local network by your Wi-Fi router, whereas your <strong>public WAN IP</strong> is assigned by your ISP. A private <code>192.168.1.x</code> address can be either a dynamic DHCP lease from your router or a manual static LAN reservation, independent of whether your ISP gives your router a dynamic or static public WAN IP. The two scopes are independent: a dynamic 192.168.1.42 LAN lease can coexist with a static public WAN IP, and a static 192.168.1.10 LAN reservation can coexist with a dynamic public WAN IP. For the full range table, see <a href="/reserved-ip-ranges/">Reserved and Private IP Ranges</a>.
      </p>

      <h2 id="why-do-dns-records-web-servers-and-email-servers-need-a-static-ip">Why Do DNS Records, Web Servers, and Email Servers Need a Static IP?</h2>
      <p>
        Running a public website, authoritative DNS server, or outbound mail server on a dynamic IP address causes <strong class="text-ink">3 severe infrastructure failures across DNS caching, spam blocklists, and nameserver glue records</strong>.
      </p>
      <p>
        Internet server infrastructure requires address stability across these 3 operational vectors:
      </p>
      <ol>
        <li><strong>DNS TTL Caching Directs Visitors to Dead IP Addresses:</strong> Rotating a server's dynamic IP causes recursive resolvers worldwide to route visitor traffic to the expired address until the <a href="/what-is-ttl-in-dns/">DNS TTL Explained</a> cache interval expires.</li>
        <li><strong>Outbound Mail from Dynamic IPs Faces Automatic Spamhaus PBL Rejection:</strong> Internet providers register residential dynamic IP ranges on the <abbr class="pd-term" data-tip="Spamhaus Policy Block List (PBL): an anti-spam database of dynamic and residential IP address ranges not authorized to send unauthenticated SMTP email directly to the internet">Spamhaus PBL</abbr> to suppress botnet spam. Inbound mail gateways reject unauthenticated SMTP traffic from dynamic ranges. Administrators audit address listings through the <a href="/blacklist-checker/">MX and IP Blacklist Checker</a> and follow <a href="/remove-from-spamhaus-blocklist/">How to Get Off the Spamhaus Blocklist</a>.</li>
        <li><strong>Authoritative Nameservers Require Static Glue Record Addresses:</strong> Top-level domain registries cache nameserver glue records for days, making dynamic IP rotation incompatible with authoritative DNS hosting.</li>
      </ol>
      <p>
        Home lab operators address dynamic IP limitations using <abbr class="pd-term" data-tip="Dynamic DNS (DDNS): an automated service that maps dynamic IP addresses to fixed domain names by updating DNS records whenever the underlying IP changes">DDNS</abbr> (Dynamic DNS). A background client detects public IP adjustments and updates domain records via API, while commercial mail operations inspect reverse mappings through the <a href="/ptr-record-lookup/">PTR Record Lookup</a>.
      </p>

      <h2 id="when-should-you-use-a-static-ip-vs-a-dynamic-ip-business-and-home-decision-matrix">When Should You Use a Static IP vs a Dynamic IP? (Business and Home Decision Matrix)</h2>
      <p>
        Most home users and small offices without on-premise servers operate best on <strong class="text-ink">a standard dynamic IP</strong>, while businesses hosting public infrastructure or requiring strict firewall allowlisting need <strong class="text-ink">a static IP</strong>. The table below matches 7 common networking scenarios to the right IP type.
      </p>

      <section class="not-prose my-4" aria-label="Reference table">
        <div class="glass rounded-2xl p-5 shadow-lg sm:p-7 overflow-x-auto">
          <table class="pdns-table" style="width:100%">
            <thead><tr><th>Network Scenario / Use Case</th><th>Recommended IP Type</th><th>Why This Choice Works Best</th></tr></thead>
            <tbody>
              <tr><td class="font-medium text-ink">Home Web Browsing, Streaming &amp; Gaming</td><td class="text-sm font-semibold text-accent">Dynamic IP</td><td class="text-sm text-ink-dim">Zero extra monthly cost, automatic setup, and periodic rotation.</td></tr>
              <tr><td class="font-medium text-ink">Small Office Using Cloud SaaS (Workspace, Slack)</td><td class="text-sm font-semibold text-accent">Dynamic IP</td><td class="text-sm text-ink-dim">All applications live in cloud SaaS; the router requires outbound access only.</td></tr>
              <tr><td class="font-medium text-ink">Remote Workers Accessing Corporate Firewalls</td><td class="text-sm font-semibold text-emerald-400">Static IP (or Corporate VPN)</td><td class="text-sm text-ink-dim">Prevents workers from getting locked out of corporate systems upon lease renewal.</td></tr>
              <tr><td class="font-medium text-ink">Self-Hosted Production Website, API, or Store</td><td class="text-sm font-semibold text-emerald-400">Static IP</td><td class="text-sm text-ink-dim">Ensures domain DNS records resolve reliably 24/7 with zero IP downtime.</td></tr>
              <tr><td class="font-medium text-ink">Self-Hosted Outbound SMTP Email Server</td><td class="text-sm font-semibold text-emerald-400">Static IP (Mandatory)</td><td class="text-sm text-ink-dim">Required to configure matching PTR records and avoid Spamhaus PBL blocklists.</td></tr>
              <tr><td class="font-medium text-ink">Office Site-to-Site Hardware VPN or VoIP PBX</td><td class="text-sm font-semibold text-emerald-400">Static IP</td><td class="text-sm text-ink-dim">Keeps branch-office IPsec tunnels and SIP trunks pinned to a permanent gateway.</td></tr>
              <tr><td class="font-medium text-ink">Home Lab / NAS / Media Server on Residential Net</td><td class="text-sm font-semibold text-accent">Dynamic IP + DDNS</td><td class="text-sm text-ink-dim">Eliminates business line fees by using automated Dynamic DNS scripts on low-TTL records.</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <p>
        Production environments rely on permanent static addressing for DNS A and PTR records, secure access perimeters, and reliable server connectivity, whereas consumer internet plans depend on automated DHCP lease assignments. Evaluating infrastructure requirements clarifies the choice between static IP vs dynamic IP addressing.
      </p>
    </div>

    <h2 class="font-display mt-10 text-xl font-semibold text-ink" id="frequently-asked-questions">Frequently asked questions</h2>
    <div class="mt-3 grid gap-3">
      <details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">How do I tell if I have a dynamic or static IP?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary>
        <p class="mt-3 text-sm leading-relaxed text-ink-dim">On Windows, open Command Prompt and run ipconfig /all: if DHCP Enabled says Yes under your active adapter, your IP is dynamic. On macOS, System Settings > Network > TCP/IP shows 'Using DHCP' for dynamic addresses. On Linux, ip a displays the word 'dynamic' with a lease countdown. For your public WAN IP, check your router's status page or compare your IP before and after a router restart: if it changes, your ISP assigns dynamic addresses.</p>
      </details>
      <details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Is 192.168 a static IP?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary>
        <p class="mt-3 text-sm leading-relaxed text-ink-dim">No, 192.168.x.x is not automatically a static IP; it is a private local network (LAN) IP range defined in RFC 1918. Your Wi-Fi router assigns 192.168.x.x addresses to devices inside your home, and that assignment can be dynamic (DHCP lease) or static (a DHCP reservation pinning a specific IP to a device MAC address). This is entirely separate from whether your ISP gives your router a static or dynamic public WAN IP.</p>
      </details>
      <details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Is DHCP the same as a dynamic IP?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary>
        <p class="mt-3 text-sm leading-relaxed text-ink-dim">Yes, in everyday networking a dynamic IP address is an IP address assigned automatically by a DHCP (Dynamic Host Configuration Protocol, RFC 2131) server for a temporary lease period. The one edge case is a DHCP reservation (also called a static lease), where the DHCP server always assigns the exact same IP to a specific MAC address: the mechanism is still DHCP, but the outcome mimics a static assignment.</p>
      </details>
      <details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">Why does an outbound email server need a static IP with matching PTR?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary>
        <p class="mt-3 text-sm leading-relaxed text-ink-dim">Receiving mail gateways perform reverse DNS lookups on every connecting IP: if the PTR hostname does not resolve back to the connecting IP (FCrDNS), or if the IP sits on a known dynamic range listed in the Spamhaus PBL, the message is rejected or spam-foldered. A static IP lets you publish a custom PTR record matching your mail server hostname and avoids the PBL listing that dynamic ranges carry.</p>
      </details>
      <details class="group rounded-xl border border-line bg-panel/60 px-5 py-4 open:border-accent/40">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink [&::-webkit-details-marker]:hidden">What is Dynamic DNS (DDNS) and when do I need it?<span class="text-accent transition-transform duration-200 group-open:rotate-45">+</span></summary>
        <p class="mt-3 text-sm leading-relaxed text-ink-dim">Dynamic DNS (DDNS) is a service that automatically updates a domain name's DNS A record whenever your ISP assigns a new dynamic public IP. A background client on your router or server detects the change and pushes the new address to the DDNS provider via API. Use DDNS when you need to reach a home lab, NAS, or self-hosted service behind a dynamic ISP IP but do not want to pay for a static IP or business line.</p>
      </details>
    </div>
  </div>
</BaseLayout>

<script>
  // Live widget: detect visitor's public IP, classify PTR pattern, compare snapshot.
  // textContent rendering only; adblock-safe id prefix (sd-).
  const DYNAMIC_TOKENS = /dhcp|dyn|dynamic|pool|dsl|cable|broadband|cpe|res|ppp|dip|fios|lan|wan/i;
  const CLOUD_TOKENS = /cloudflare|amazonaws|google|digitalocean|hetzner|linode|vultr|ovh|azure|oracle/i;

  async function getPublicIp(): Promise<string | null> {
    try {
      const r = await fetch('https://api.ipify.org?format=json', { signal: AbortSignal.timeout(5000) });
      const j = await r.json();
      return j.ip ?? null;
    } catch { return null; }
  }

  async function getPtr(ip: string): Promise<string | null> {
    try {
      const octets = ip.split('.').reverse().join('.');
      const res = await fetch(`https://cloudflare-dns.com/dns-query?name=${octets}.in-addr.arpa&type=PTR`, {
        headers: { Accept: 'application/dns-json' },
        signal: AbortSignal.timeout(5000),
      });
      const j = await res.json();
      const ptr = j.Answer?.find((a: any) => a.type === 12)?.data;
      return ptr ? ptr.replace(/\.$/, '') : null;
    } catch { return null; }
  }

  async function getAsn(ip: string): Promise<string | null> {
    try {
      const octets = ip.split('.').reverse().join('.');
      const res = await fetch(`https://cloudflare-dns.com/dns-query?name=${octets}.origin.asn.cymru.com&type=TXT`, {
        headers: { Accept: 'application/dns-json' },
        signal: AbortSignal.timeout(5000),
      });
      const j = await res.json();
      const txt = j.Answer?.find((a: any) => a.type === 16)?.data?.replace(/^"|"$/g, '');
      if (!txt) return null;
      return 'AS' + txt.split('|')[0].trim();
    } catch { return null; }
  }

  function classify(ptr: string | null, asn: string | null): string {
    if (!ptr) return 'No PTR record published (common on residential and CDN IPs; classification inconclusive).';
    if (DYNAMIC_TOKENS.test(ptr)) return 'Likely Dynamic ISP Assignment (Residential/DHCP pool PTR pattern detected in "' + ptr + '").';
    if (CLOUD_TOKENS.test(ptr)) return 'Likely static or cloud/datacenter allocation (cloud provider PTR pattern detected in "' + ptr + '").';
    if (asn && /15169|13335|16509|14618|14061|62567|24940/.test(asn.replace(/^AS/i, ''))) return 'Likely static or cloud/datacenter allocation (known cloud provider ASN ' + asn + ').';
    return 'Custom PTR hostname detected ("' + ptr + '"): likely a static or business-class assignment, but only your ISP plan or a router-restart comparison proves permanence definitively.';
  }

  async function runWidget() {
    const statusEl = document.getElementById('sd-widget-status')!;
    const detailEl = document.getElementById('sd-widget-detail')!;
    const compareEl = document.getElementById('sd-widget-compare')!;
    const btn = document.getElementById('sd-snapshot-btn')!;

    const ip = await getPublicIp();
    if (!ip) { statusEl.textContent = 'Could not detect your public IP (network or extension blocked the request).'; return; }

    const [ptr, asn] = await Promise.all([getPtr(ip), getAsn(ip)]);
    statusEl.textContent = 'Your public IP: ' + ip + (asn ? ' (' + asn + ')' : '');
    detailEl.textContent = classify(ptr, asn);
    detailEl.classList.remove('hidden');

    const saved = localStorage.getItem('pdns_saved_ip_check');
    compareEl.classList.remove('hidden');
    if (saved) {
      try {
        const s = JSON.parse(saved) as { ip: string; time: string };
        if (s.ip && s.ip !== ip) {
          compareEl.textContent = 'Confirmed Dynamic IP: your public IP changed from ' + s.ip + ' (checked ' + s.time + ') to ' + ip + '.';
        } else {
          compareEl.textContent = 'Unchanged so far: your public IP (' + ip + ') matches the snapshot saved on ' + s.time + '. Restart your modem or router (unplug for 5 minutes) and click "Save / Reset IP Snapshot" to test whether your ISP assigns a new DHCP lease.';
        }
      } catch { localStorage.removeItem('pdns_saved_ip_check'); }
    } else {
      compareEl.textContent = 'No snapshot saved yet. Click "Save / Reset IP Snapshot" to record your current IP, then restart your router later and compare.';
    }
    btn.classList.remove('hidden');
    btn.onclick = () => {
      localStorage.setItem('pdns_saved_ip_check', JSON.stringify({ ip, time: new Date().toISOString().slice(0, 16).replace('T', ' ') + ' UTC' }));
      runWidget();
    };
  }

  if (document.getElementById('sd-widget')) runWidget();
</script>

