---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolArticle from '../components/ToolArticle.astro';
import ToolPanel from '../components/ToolPanel.astro';
---
<BaseLayout
  title="IP Lookup, Location, ASN & Reverse DNS"
  description="Free IP lookup: geolocation, ASN and network owner, plus reverse DNS (PTR) resolved through our own DNS-over-HTTPS engine."
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <nav class="mb-4 text-sm text-ink-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent">Home</a>
       <span aria-hidden="true">/</span>
      <a href="/tools/" class="hover:text-accent">Tools</a>
       <span aria-hidden="true">/</span>
      <span class="text-ink-dim">IP Lookup</span>
    </nav>
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">IP Lookup: Geolocation, ASN and PTR for Any Address</h1>
    <p class="mt-4 text-lg text-ink-dim">Free IP lookup: get geolocation, ASN, ISP and reverse DNS for any IP address.</p>

    <ToolPanel>
      <form id="ipl-form" class="flex flex-col gap-3 sm:flex-row">
        <label class="sr-only" for="ipl-input">IP address</label>
        <input id="ipl-input" type="text" autocomplete="off" spellcheck="false" placeholder="8.8.8.8 or 2606:4700::1111"
          class="flex-1 rounded-md border border-line bg-transparent px-3 py-2.5 font-mono text-sm text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30" />
        <button type="submit" class="btn-cta btn-shimmer px-6 py-2.5 text-sm">Lookup IP</button>
      </form>

      <div id="ipl-status" class="mt-4 hidden rounded-md px-4 py-3 text-sm font-medium"></div>

      <div id="ipl-cards" class="mt-6 hidden grid gap-3 sm:grid-cols-2"></div>

      <div id="ipl-results" class="mt-6 hidden overflow-x-auto rounded-lg border border-line/60">
        <table class="pdns-table">
          <thead><tr><th>Property</th><th>Value</th></tr></thead>
          <tbody id="ipl-tbody"></tbody>
        </table>
</div>
    </ToolPanel>

    <ToolArticle slug="ip-lookup" />
    </div>
</BaseLayout>

<script>
  import { ipInfo } from '../lib/ipinfo';

  const form = document.getElementById('ipl-form') as HTMLFormElement;
  const input = document.getElementById('ipl-input') as HTMLInputElement;
  const statusEl = document.getElementById('ipl-status')!;
  const cardsEl = document.getElementById('ipl-cards')!;
  const resultsEl = document.getElementById('ipl-results')!;
  const tbody = document.getElementById('ipl-tbody')!;

  const setStatus = (cls: string, text: string) => {
    statusEl.className = `mt-4 rounded-md px-4 py-3 text-sm font-medium ${cls}`;
    statusEl.textContent = text;
  };

  const validIp = (s: string) =>
    /^(\d{1,3}\.){3}\d{1,3}$/.test(s) || s.includes(':');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const ip = input.value.trim();
    if (!validIp(ip)) { setStatus('bg-fail/10 text-fail border border-fail/30', 'Enter a valid IPv4 or IPv6 address.'); return; }
    [cardsEl, resultsEl].forEach((el) => el.classList.add('hidden'));
    setStatus('bg-panel-2 text-accent border border-line', `Looking up ${ip}…`);

    const info = await ipInfo(ip);
    setStatus('bg-pass/10 text-pass border border-pass/30', `Results for ${ip}`);

    cardsEl.innerHTML = '';
    const cards: [string, string][] = [
      ['Location', [info.city, info.region, info.country].filter(Boolean).join(', ') || 'unknown'],
      ['Network', info.org ?? 'unknown'],
      ['ASN', info.asn ?? 'unknown'],
      ['Reverse DNS', info.ptr ?? 'none set'],
    ];
    for (const [l, v] of cards) {
      cardsEl.insertAdjacentHTML('beforeend', `<div class="rounded-lg border border-line bg-panel/60 p-4"><div class="text-xs text-ink-faint">${l}</div><div class="mt-1 break-words font-mono text-sm text-ink">${v}</div></div>`);
    }
    cardsEl.classList.remove('hidden');

    const rows: [string, string][] = [
      ['IP address', info.ip],
      ['Reverse DNS (PTR)', info.ptr ?? 'none set'],
      ['Country', info.country ?? 'unknown'],
      ['Region', info.region ?? 'unknown'],
      ['City', info.city ?? 'unknown'],
      ['Coordinates', info.lat != null ? `${info.lat}, ${info.lon}` : 'unknown'],
      ['ASN', info.asn ?? 'unknown'],
      ['Organization', info.org ?? 'unknown'],
      ['ISP', info.isp ?? 'unknown'],
      ['Type', info.type ?? 'unknown'],
    ];
    tbody.innerHTML = '';
    for (const [l, v] of rows) {
      tbody.insertAdjacentHTML('beforeend', `<tr><td class="text-ink-dim">${l}</td><td class="font-mono text-sm text-ink">${v}</td></tr>`);
    }
    resultsEl.classList.remove('hidden');
  });
</script>
